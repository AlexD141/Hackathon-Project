  "recipes": [
    {
      "name": "True Wisconsin Bloody Mary",
      "ingredients_raw": [
        "4 ice cubes",
        "1 (1.5 fluid ounce) jigger vodka",
        "3 pimento-stuffed green olives",
        "1 tablespoon brine from olive jar",
        "0.5 teaspoon celery salt",
        "0.5 teaspoon ground black pepper",
        "3 dashes Dash Worcestershire sauce",
        "3 dashes hot pepper sauce (e.g. Texas Pete's™)",
        "1 cup tomato and clam juice cocktail",
        "1 stalk celery, with leaves"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Fill a large tumbler with ice cubes."
        },
        {
          "id": 2,
          "text": "Pour in vodka, then add olives and brine. Season with celery salt, pepper, Worcestershire sauce, and hot pepper sauce. Top with tomato and clam juice cocktail."
        },
        {
          "id": 3,
          "text": "Stir with celery stalk and leave in as a garnish. Sprinkle with additional celery salt before serving."
        }
      ],
