  "recipes": [
    {
      "name": "Ham and Egg Salad Sandwich Spread",
      "ingredients_raw": [
        "4 (1/4 inch thick) slices ham",
        "4 large hard-boiled eggs, peeled and chopped",
        "3 stalks celery, minced",
        "1.5 cups light mayonnaise",
        "0.5 cup dill pickle relish",
        "0.25 cup minced onion",
        "2 tablespoons Dijon mustard",
        "ground black pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Shred ham using the shredding blade on a food processor. Transfer to a large bowl."
        },
        {
          "id": 2,
          "text": "Add eggs and celery to ham in the bowl. Stir in mayonnaise, relish, onion, mustard, and pepper until well combined."
        },
        {
          "id": 3,
          "text": "Refrigerate for 2 hours before serving."
        }
      ],
