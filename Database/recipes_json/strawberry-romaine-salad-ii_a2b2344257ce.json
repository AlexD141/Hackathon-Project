  "recipes": [
    {
      "name": "Strawberry Romaine Summer Salad",
      "ingredients_raw": [
        "1 head romaine lettuce, torn into bite-size pieces",
        "1 red onion, sliced",
        "1 pint fresh strawberries, sliced",
        "1 (11 ounce) can mandarin oranges",
        "1 cup mayonnaise",
        "2 tablespoons maraschino cherry juice",
        "2 tablespoons honey",
        "1 tablespoon poppy seeds",
        "0.125 teaspoon lemon juice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine romaine lettuce, red onion, strawberries, and mandarin oranges in a large bowl."
        },
        {
          "id": 2,
          "text": "Whisk mayonnaise, cherry juice, honey, poppy seeds, and lemon juice together in a bowl until well combined; pour over salad and toss to coat."
        }
      ],
