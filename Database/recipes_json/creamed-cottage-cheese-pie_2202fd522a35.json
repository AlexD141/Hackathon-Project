  "recipes": [
    {
      "name": "Creamed Cottage Cheese Pie",
      "ingredients_raw": [
        "1 (9 inch) pie shell",
        "1.5 cups cottage cheese, creamed",
        "4 tablespoons melted butter",
        "0.5 cup white sugar",
        "0.25 teaspoon salt",
        "1 tablespoon all-purpose flour",
        "1 tablespoon lemon zest",
        "2 eggs",
        "0.5 cup raisins",
        "0.5 cup chopped walnuts",
        "0.25 cup milk"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 400 degrees F (205 degrees C)."
        },
        {
          "id": 2,
          "text": "Separate the eggs."
        },
        {
          "id": 3,
          "text": "Press the cheese through a sieve 2 times. Add the butter, sugar, salt, flour, lemon zest, unbeaten egg yolks, raisins, chopped walnuts and milk. Stir well."
        },
        {
          "id": 4,
          "text": "Beat the egg whites until stiff peaks form. Fold the egg whites into the cream cheese mixture."
        },
        {
          "id": 5,
          "text": "Bake at 400 degrees F (205 degrees C) for 30 minutes or until browned and firm."
        }
      ],
