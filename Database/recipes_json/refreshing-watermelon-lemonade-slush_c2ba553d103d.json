      "name": "Refreshing Watermelon Lemonade Slush",
      "ingredients_raw": [
        "1 cup cubed seeded watermelon",
        "1.25 cups water",
        "3 tablespoons sweetened strawberry lemonade drink mix"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place the watermelon pieces onto a plastic-wrapped baking sheet, and freeze until solid, about 45 minutes."
        },
        {
          "id": 2,
          "text": "Place the frozen watermelon, water, and strawberry lemonade drink mix in a blender; blend until slushy."
        }
