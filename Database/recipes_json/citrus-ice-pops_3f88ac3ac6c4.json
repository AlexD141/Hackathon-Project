  "recipes": [
    {
      "name": "Citrus Ice Pops",
      "ingredients_raw": [
        "1 cup orange juice",
        "0.5 cup grapefruit juice",
        "0.25 cup water",
        "2 tablespoons lemon juice",
        "2 tablespoons white sugar",
        "1 (8 ounce) container vanilla yogurt",
        "0.5 cup chopped strawberries"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place orange juice, grapefruit juice, water, lemon juice, and sugar in a saucepan over medium heat; bring to a boil. Cook, stirring occasionally, until sugar dissolves, about 5 minutes. Cool juice mixture, then freeze until very cold, about 10 minutes."
        },
        {
          "id": 2,
          "text": "Meanwhile, combine yogurt with strawberries in a bowl; chill in the refrigerator, about 10 minutes."
        },
        {
          "id": 3,
          "text": "Spoon about 1 ½ tablespoons juice mixture into 6 pop molds; freeze until frozen, 30 to 60 minutes. Spoon about 1 tablespoon strawberry yogurt mixture into each pop mold; top with remaining juice. Freeze until hard, 1 to 1 ½ hours."
        }
      ],
