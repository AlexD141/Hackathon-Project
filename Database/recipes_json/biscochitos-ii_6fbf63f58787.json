  "recipes": [
    {
      "name": "Biscochitos II",
      "ingredients_raw": [
        "1 cup shortening",
        "1 cup margarine",
        "1.5 cups white sugar",
        "2 eggs",
        "1 teaspoon anise extract",
        "1 teaspoon vanilla extract",
        "6 cups all-purpose flour",
        "1 teaspoon salt",
        "0.5 cup wine",
        "3 teaspoons baking powder"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Mix together shortening, margarine and sugar with a mixture until well blended. Mix in the rest of the ingredients until smooth."
        },
        {
          "id": 3,
          "text": "Roll out on a floured board to 1/2 or 1/4 inch thickness."
        },
        {
          "id": 4,
          "text": "Cut into desired shapes and place on baking sheets. Bake until golden brown, about 10 - 12 minutes. Garnish as desired or leave plain."
        }
      ],
