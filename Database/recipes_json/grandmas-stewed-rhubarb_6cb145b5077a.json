  "recipes": [
    {
      "name": "Grandma&#39;s Stewed Rhubarb",
      "ingredients_raw": [
        "8 quarts diced fresh rhubarb",
        "1 cup white sugar, or more to taste",
        "1 tablespoon lemon juice",
        "8 whole cloves",
        "1 (3 ounce) package red Jell-O® dessert mix",
        "0.25 cup honey, warmed"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place rhubarb, sugar, lemon juice, and cloves in a large stockpot over low heat; cover the pot. Cook, stirring occasionally, until rhubarb begins to release its juices, softens, and breaks apart, about 10 minutes."
        },
        {
          "id": 2,
          "text": "Increase heat to medium; bring rhubarb mixture to a full rolling boil. Stir in gelatin mix until dissolved."
        },
        {
          "id": 3,
          "text": "Cool mixture to room temperature, about 30 minutes; sweeten with honey."
        }
      ],
