  "recipes": [
    {
      "name": "Cucumber-Watermelon Salad",
      "ingredients_raw": [
        "6 cups cubed seeded watermelon",
        "4 cups cubed English cucumber",
        "1 teaspoon salt",
        "1 tablespoon white sugar",
        "0.5 cup balsamic vinegar"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place the watermelon and cucumber cubes in a large bowl, and gently toss with the salt and sugar. Drizzle with balsamic vinegar and toss to coat. Refrigerate for 15 minutes, then gently toss one last time before serving."
        }
      ],
