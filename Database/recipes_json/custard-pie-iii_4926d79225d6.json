  "recipes": [
    {
      "name": "Easy Egg Custard Pie",
      "ingredients_raw": [
        "1 prepared 8 inch pie crust",
        "4 eggs",
        "1 cup white sugar",
        "1 cup milk",
        "0.66670000553131 cup evaporated milk",
        "2 tablespoons butter, melted",
        "2 tablespoons vanilla extract",
        "0.5 teaspoon ground cinnamon"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Beat eggs for approximately 2 minutes in a medium mixing bowl. Gradually mix in sugar, milk, evaporated milk, melted butter, and vanilla until well combined, then pour into pastry shell."
        },
        {
          "id": 3,
          "text": "Bake in the preheated oven until lightly browned on top, 45 to 60 minutes. Sprinkle with ground cinnamon. Serve warm or chilled."
        }
      ],
