            "author": {
              "@type": "Person",
              "name": "hokiejennifer"
            },
            "reviewBody": "I thought this was great! Loved the mix of flavors and textures. Easy, quick, versatile snack!",
            "datePublished": "2009-04-20T15:25:58.377Z"
          },
          {
            "@type": "Review",
            "reviewRating": {
              "@type": "Rating",
