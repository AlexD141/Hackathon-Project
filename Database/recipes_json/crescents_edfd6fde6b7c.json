  "recipes": [
    {
      "name": "Crescents",
      "ingredients_raw": [
        "2 cups all-purpose flour",
        "1 cup chopped walnuts",
        "3 tablespoons ice water",
        "0.5 teaspoon salt",
        "0.75 cup butter",
        "1 teaspoon vanilla extract",
        "3 tablespoons white sugar",
        "2 cups confectioners' sugar"
      ],
      "steps": [
        {
          "id": 1,
          "text": "If using butter it must be cold. Mix butter with flour until it resembles fine crumbs. Add white sugar, nuts, and salt. Mix well, adding ice water till you make stiff dough."
        },
        {
          "id": 2,
          "text": "Add vanilla extract and knead lightly. Roll out on floured board 1/4 inch thick."
        },
        {
          "id": 3,
          "text": "Cut into crescent shapes using a whiskey glass coated with flour."
        },
        {
          "id": 4,
          "text": "Bake at 350 degrees F (180 degrees C) until bottoms are lightly browned. While hot, roll in confectioner&#39;s sugar, (I usually use a brown bag or baggie bag to roll the cookies in with the powdered sugar)."
        }
      ],
