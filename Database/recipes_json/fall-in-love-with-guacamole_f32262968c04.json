    {
      "name": "Fall in Love (with) Guacamole",
      "ingredients_raw": [
        "3 avocados, peeled and pitted",
        "1 teaspoon sea salt",
        "1 teaspoon garlic powder",
        "2 tablespoons fresh lime juice",
        "0.5 cup diced onion",
        "2 roma (plum) tomatoes, diced",
        "3 tablespoons chopped cilantro",
        "1 pinch cayenne pepper, or more to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Mash avocados, sea salt, garlic powder, and lime juice in a bowl using a fork."
        },
        {
          "id": 2,
          "text": "Mix onion, tomatoes, and cilantro into avocado mixture; season with cayenne pepper."
        }
      ],
