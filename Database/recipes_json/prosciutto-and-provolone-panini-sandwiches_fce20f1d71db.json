  "recipes": [
    {
      "name": "Prosciutto and Provolone Panini Sandwiches",
      "ingredients_raw": [
        "0.5 cup CARAPELLI® Extra Virgin Olive Oil",
        "8 slices rustic Italian or sourdough bread",
        "0.25 cup prepared basil pesto",
        "16 thin slices Provolone cheese",
        "12 thin slices prosciutto",
        "4 whole, well-drained bottled roasted red peppers, cut into strips"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Heat a panini grill or waffle iron. Brush oil over bread slices. Turn 4 slices over; spread pesto evenly over bread. Top with half of the cheese, tearing to fit if necessary, all of the prosciutto and pepper strips and remaining cheese. Close sandwiches with remaining bread oiled sides up."
        },
        {
          "id": 2,
          "text": "Cook (in batches) in panini maker* or waffle iron 3 to 4 minutes or until golden brown and cheese is melted."
        }
      ],
