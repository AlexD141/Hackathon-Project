  "recipes": [
    {
      "name": "Bourbon Little Smokies",
      "ingredients_raw": [
        "1.5 cups ketchup",
        "0.75 cup brown sugar",
        "0.25 cup bourbon whiskey",
        "0.25 cup water",
        "1 (14 ounce) package beef smoky cocktail sausages"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a large saucepan, whisk the ketchup, brown sugar, bourbon whiskey, and water together until the sugar has dissolved."
        },
        {
          "id": 2,
          "text": "Stir in the cocktail sausages, and place over medium heat."
        },
        {
          "id": 3,
          "text": "Bring the sausages and sauce to a simmer; serve."
        }
      ],
