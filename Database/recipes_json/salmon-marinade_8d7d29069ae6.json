  "recipes": [
    {
      "name": "Salmon Marinade",
      "ingredients_raw": [
        "0.25 cup lime juice",
        "0.25 cup Worcestershire sauce",
        "1 pinch dried thyme",
        "1 tablespoon vegetable oil"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a small bowl, stir together the lime juice, Worcestershire sauce, thyme and vegetable oil. Mix well."
        },
        {
          "id": 2,
          "text": "Cover all surfaces of fish fillet with marinade. Refrigerate and let stand as little as 30 minutes or as long as overnight."
        }
      ],
