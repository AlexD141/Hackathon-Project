  "recipes": [
    {
      "name": "Candy Strawberries",
      "ingredients_raw": [
        "1 cup ground pecans",
        "1 cup flaked coconut",
        "2 (3 ounce) packages strawberry flavored Jell-O®",
        "0.75 cup sweetened condensed milk",
        "0.5 teaspoon vanilla extract",
        "1 (2.25 ounce) jar red decorator sugar",
        "0.25 cup sliced almonds",
        "5 drops green food coloring"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place pecans, coconut, and gelatin in a large bowl. Stir in condensed milk and vanilla; mix well to combine. Cover and chill for one hour."
        },
        {
          "id": 2,
          "text": "Shape mixture into &#34;strawberries&#34; and roll in red sugar. Tint sliced almonds with green food coloring and insert on the top of the &#34;strawberries&#34; to form leaves."
        }
      ],
