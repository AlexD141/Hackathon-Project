  "recipes": [
    {
      "name": "Candy Apple Martini",
      "ingredients_raw": [
        "1 fluid ounce vanilla vodka",
        "1 fluid ounce sour apple schnapps",
        "1 fluid ounce butterscotch schnapps",
        "1 fluid ounce cranberry juice",
        "1 maraschino cherry"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Fill a cocktail shaker with ice; add vodka, apple schnapps, butterscotch schnapps, and cranberry juice."
        },
        {
          "id": 3,
          "text": "Cover and shake until the outside of the shaker has frosted."
        },
        {
          "id": 4,
          "text": "Strain into a chilled glass and garnish with marachino cherry."
        }
      ],
