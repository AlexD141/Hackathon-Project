  "recipes": [
    {
      "name": "Jar Doo Chicken Wings",
      "ingredients_raw": [
        "0.25 cup soy sauce",
        "2 tablespoons water",
        "1 tablespoon dry gin",
        "2 teaspoons minced fresh ginger root",
        "2 teaspoons white sugar",
        "0.5 teaspoon salt",
        "1.5 pounds chicken wings, tips removed and wings cut in half at joint",
        "2 cups vegetable oil for frying, or as needed"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Whisk together soy sauce, water, gin, ginger, and sugar in a small bowl."
        },
        {
          "id": 2,
          "text": "Arrange wings in a single layer in a baking dish and pour soy sauce mixture over top. Cover and marinate in the refrigerator for 30 minutes."
        },
        {
          "id": 3,
          "text": "Pour oil into a 2-quart saucepan and heat oil 375 degrees F (190 degrees C). Drain and discard marinade from wings."
        },
        {
          "id": 4,
          "text": "Fry wings in batches in the hot oil until browned on the outside and no longer pink at the bone, 10 to 15 minutes. An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C)."
        },
        {
          "id": 5,
          "text": "Drain cooked wings on paper towels before serving."
        }
      ],
      "warnings": [],
