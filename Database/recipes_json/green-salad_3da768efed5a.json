  "recipes": [
    {
      "name": "Green Salad",
      "ingredients_raw": [
        "0.5 cup chopped onion",
        "0.5 cup chopped green bell pepper",
        "2 (10 ounce) packages mixed salad greens",
        "4 thinly sliced chicken deli meat, chopped",
        "1 tomato, chopped",
        "0.25 teaspoon onion powder",
        "3 dashes garlic powder",
        "2 pinches salt and ground black pepper to taste",
        "3 tablespoons balsamic vinaigrette salad dressing"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather the ingredients."
        },
        {
          "id": 2,
          "text": "Place onion and bell pepper in a microwave-safe bowl; heat in the microwave on high until soft, 1 to 2 minutes. Set aside to cool."
        },
        {
          "id": 3,
          "text": "Combine onion, bell pepper, salad greens, deli meat, and tomato in a large salad bowl. Sprinkle with onion powder, garlic powder, salt, and black pepper; toss well to mix."
        },
        {
          "id": 4,
          "text": "Pour on salad dressing; toss well and serve."
        },
        {
          "id": 5,
          "text": "Enjoy!"
        }
      ],
