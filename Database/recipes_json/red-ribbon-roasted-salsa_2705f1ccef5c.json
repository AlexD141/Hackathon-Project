  "recipes": [
    {
      "name": "Red-Ribbon Roasted Salsa",
      "ingredients_raw": [
        "10 dried chipotle peppers",
        "12 roma (plum) tomatoes",
        "0.25 yellow onion, coarsely chopped",
        "2 cloves garlic, or more to taste",
        "2 tablespoons white vinegar",
        "2 teaspoons salt",
        "1 pinch ground black pepper, or to taste",
        "1 lime, juiced, or more to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Fill a saucepan with water, stir in dried chipotle peppers, and bring to a boil. Reduce heat to low and simmer until peppers are soft, about 30 minutes. Drain and let cool. When peppers are cool, remove stems, cut open peppers, and remove seeds. Set peppers aside."
        },
        {
          "id": 2,
          "text": "Preheat an outdoor grill for high heat and lightly oil the grate."
        },
        {
          "id": 3,
          "text": "Grill tomatoes on hot grate until skin blackens and begins to peel, turning tomatoes often to blacken all sides, about 10 minutes. Set grilled tomatoes aside to cool."
        },
        {
          "id": 4,
          "text": "Place grilled tomatoes, chipotle peppers, yellow onion, white vinegar, salt, black pepper, and lime juice into a food processor; pulse a few times, then process until almost pureed."
        },
        {
          "id": 5,
          "text": "Refrigerate until flavors have blended, at least 2 hours to overnight."
        }
      ],
      "warnings": [],
