      "name": "Strawberry Daiquiri by Request",
      "ingredients_raw": [
        "0.5 cup rum",
        "2 tablespoons sweetened lime juice (such as Rose's®)",
        "2 tablespoons grenadine syrup (such as Rose's®)",
        "0.5 cup confectioners' sugar",
        "2 cups ice cubes",
        "0.5 (16 ounce) package frozen strawberries",
        "1 tablespoon whipped cream, divided"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place the rum, lime juice, grenadine, confectioners&#39; sugar, ice cubes, and strawberries into a blender. Cover, and puree until smooth. Pour into glasses and top each with a dollop of whipped cream, if desired."
        }
      ],
