  "recipes": [
    {
      "name": "Salmon with Mustard-Cream Sauce",
      "ingredients_raw": [
        "1 (270 g) tub PHILADELPHIA Herb & Garlic Cooking Creme Cream Cheese Product",
        "0.5 cup 25%-less-sodium chicken broth",
        "3 tablespoons grainy Dijon mustard, divided",
        "6 (4 ounce) salmon fillets, skin removed"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Heat greased barbecue to medium heat."
        },
        {
          "id": 2,
          "text": "Cook and stir cooking creme, broth and 1 Tbsp. mustard in saucepan on medium heat 3 min. or until heated through. Remove from heat; cover to keep warm."
        },
        {
          "id": 3,
          "text": "Brush fish with remaining mustard; grill 2 to 3 min. on each side or until fish flakes easily with fork. Serve with warm sauce."
        }
      ],
