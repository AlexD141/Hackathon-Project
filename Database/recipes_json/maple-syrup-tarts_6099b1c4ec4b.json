  "recipes": [
    {
      "name": "Maple Syrup Tarts",
      "ingredients_raw": [
        "12 (3 inch) unbaked tart shells",
        "1 egg",
        "1 cup real maple syrup",
        "1 tablespoon butter, melted",
        "0.25 cup packed brown sugar",
        "1 tablespoon lemon juice",
        "0.5 cup chopped walnuts"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 375 degrees F (190 degrees C)."
        },
        {
          "id": 2,
          "text": "Beat the egg gently with a fork, and then mix with maple syrup, melted butter, brown sugar, lemon juice, and nuts. Fill tarts 2/3 full."
        },
        {
          "id": 3,
          "text": "Bake for 20 to 25 minutes."
        }
      ],
