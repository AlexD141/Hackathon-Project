  "recipes": [
    {
      "name": "The Perfect Simplified Sushi Vinegar",
      "ingredients_raw": [
        "2 cups rice vinegar (such as Marukan®)",
        "1.5 cups white sugar",
        "1.5 tablespoons salt",
        "0.125 lemon, juiced"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Stir together rice vinegar, sugar, salt, and lemon juice in a saucepan over low heat until sugar and salt dissolve; do not boil."
        },
        {
          "id": 2,
          "text": "Remove from heat and allow to cool completely. Store in the refrigerator."
        }
      ],
