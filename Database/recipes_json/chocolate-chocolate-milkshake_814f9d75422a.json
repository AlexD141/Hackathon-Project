  "recipes": [
    {
      "name": "Chocolate Chocolate Milkshake",
      "ingredients_raw": [
        "2 cups premium quality chocolate ice cream",
        "2 (1.65 ounce) bars dark chocolate candy bars, diced",
        "0.5 cup whipped cream",
        "1 tablespoon chocolate shavings, for garnish",
        "0.25 cup whipped cream"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine ice cream, diced chocolate, and 1/2 cup whipped cream in a blender. Blend until smooth."
        },
        {
          "id": 2,
          "text": "Pour into 2 glasses; garnish with chocolate shavings and 1/4 cup whipped cream."
        }
      ],
