  "recipes": [
    {
      "name": "Lemon Butter",
      "ingredients_raw": [
        "0.25 cup white sugar",
        "1 tablespoon cornstarch",
        "0.25 teaspoon grated lemon zest",
        "0.5 cup water",
        "1 tablespoon lemon juice",
        "2 teaspoons butter"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a saucepan over medium heat, combine sugar, cornstarch, and lemon zest. Stir in water and lemon juice, and continue stirring. After the mixture thickens and bubbles, continue to heat and stir for another two minutes."
        },
        {
          "id": 2,
          "text": "Remove the sauce from the heat and stir in the butter. Serve warm."
        }
      ],
