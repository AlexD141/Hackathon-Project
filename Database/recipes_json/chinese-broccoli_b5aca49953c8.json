            "author": {
              "@type": "Person",
              "name": "Zachary Ryan Smith"
            },
            "reviewBody": "My variation on the sauce: \n1T Worcestershire Sauce\n1T Lite Soy Sauce\n1T Vinegar\n1T Sesame Oil\n1/2t Ground Ginger\n2T Minced Garlic\n1t Black Pepper\n\nAdd sauteed mushroom/onions into sauce, if desired.",
            "datePublished": "2014-03-31T10:50:31.290Z"
