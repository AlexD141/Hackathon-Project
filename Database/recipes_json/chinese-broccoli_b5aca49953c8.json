  "recipes": [
    {
      "name": "Chinese Broccoli",
      "ingredients_raw": [
        "1 bunch Gai Lan (Chinese broccoli), trimmed",
        "3 tablespoons hoisin sauce",
        "2 tablespoons white sugar",
        "2 tablespoons soy sauce",
        "1 tablespoon cornstarch",
        "1 tablespoon rice vinegar",
        "1 tablespoon sesame oil",
        "2 cloves garlic, minced",
        "1 teaspoon minced fresh ginger root"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Bring a large pot of lightly salted water to a boil. Cook Chinese broccoli in boiling water, uncovered, until just tender, about 4 minutes."
        },
        {
          "id": 3,
          "text": "Drain and place in a shallow bowl."
        },
        {
          "id": 4,
          "text": "Whisk together hoisin sauce, sugar, soy sauce, cornstarch, rice vinegar, sesame oil, garlic, and ginger in a small saucepan over medium heat until sauce is thickened and no longer cloudy, 5 to 7 minutes."
        },
        {
          "id": 5,
          "text": "Pour sauce over broccoli; toss to coat and serve."
        }
      ],
