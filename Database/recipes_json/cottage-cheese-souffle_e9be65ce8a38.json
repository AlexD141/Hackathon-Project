  "recipes": [
    {
      "name": "Cottage Cheese Souffle",
      "ingredients_raw": [
        "4 eggs",
        "6.5 tablespoons whole wheat flour",
        "1 teaspoon baking powder",
        "1 pinch salt to taste",
        "0.5 teaspoon minced garlic, or to taste",
        "1 pinch crushed red pepper flakes, or to taste",
        "1 pinch ground nutmeg, or to taste",
        "2.25 cups cottage cheese",
        "1 (8 ounce) package shredded Cheddar cheese",
        "5 slices bacon, finely diced"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 325 degrees F (165 degrees C). Grease a 9x9-inch baking dish."
        },
        {
          "id": 2,
          "text": "In a large bowl, beat the eggs, and slowly whisk in whole wheat flour, baking powder, salt, garlic, red pepper flakes, and nutmeg. Mix in the cottage cheese, Cheddar cheese, and bacon. Transfer the mixture to the prepared baking dish."
        },
        {
          "id": 3,
          "text": "Bake in the preheated oven until the top is browned and crispy, and a toothpick inserted into the center of the souffle comes out clean, 55 minutes to 1 hour."
        }
      ],
