  "recipes": [
    {
      "name": "Winter Fruit Salad",
      "ingredients_raw": [
        "1.3333333730698 cups quinoa, rinsed",
        "1.5 cups water",
        "2 kumquats - seeded and chopped",
        "2 tablespoons chopped fresh cilantro",
        "0.25 cup olive oil",
        "2.5 tablespoons lemon juice",
        "0.5 teaspoon kosher salt",
        "1 Bosc pear - peeled, cored and chopped",
        "1 cucumber - peeled, seeded and chopped",
        "1 cup trimmed and coarsely chopped watercress"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a medium saucepan, combine the quinoa and water and bring to a boil. Simmer over low heat stirring often, until tender, about 12 minutes. Drain and cool completely."
        },
        {
          "id": 2,
          "text": "In a small bowl, combine the kumquats, cilantro, olive oil, lemon juice and salt. Allow to steep for 5 minutes."
        },
        {
          "id": 3,
          "text": "In a large bowl, combine the quinoa, pear and cucumber. Add the dressing and toss well. Add the watercress and toss again and serve."
        }
      ],
