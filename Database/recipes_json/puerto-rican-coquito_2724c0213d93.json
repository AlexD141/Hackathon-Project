  "recipes": [
    {
      "name": "Puerto Rican Coquito",
      "ingredients_raw": [
        "2 (15 ounce) cans coconut milk",
        "1 (14 ounce) can sweetened condensed milk",
        "1 cup dark rum",
        "0.5 cup water",
        "0.5 teaspoon ground cinnamon",
        "1 pinch salt"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Add canned coconut milk, sweetened condensed milk, rum, water, cinnamon, and salt to a blender."
        },
        {
          "id": 2,
          "text": "Blend until smooth and well combined. Transfer to a covered pitcher or bottle and refrigerate for at least 1 hour. Stir or shake well before pouring into small glasses."
        }
      ],
