  "recipes": [
    {
      "name": "Pink Fruit Dip",
      "ingredients_raw": [
        "2 (6 ounce) containers vanilla yogurt",
        "1 cup mayonnaise",
        "1 cup sour cream",
        "0.25 cup white sugar",
        "0.25 cup grenadine"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a bowl, stir together yogurt, mayonnaise, sour cream, sugar, and grenadine; mix well. Cover and refrigerate 2 hours to overnight to allow flavors to meld."
        }
      ],
