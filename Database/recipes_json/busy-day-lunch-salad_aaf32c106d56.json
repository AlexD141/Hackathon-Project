      "ingredients_raw": [
        "1 (15 ounce) can garbanzo beans, drained and rinsed",
        "1 tomato, cut into small dice",
        "1 canned heart of palm, minced",
        "0.25 red onion, minced",
        "0.33333334326744 cup grated reduced-fat mozzarella cheese",
        "4 sprigs fresh thyme leaves",
        "2 tablespoons extra-virgin olive oil",
        "1 tablespoon fresh lemon juice",
        "salt and pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Toss together garbanzo beans, tomato, hearts of palm, onion, mozzarella cheese, thyme, olive oil, and lemon juice in a large bowl until evenly mixed. Season with salt and pepper. Toss once more."
        }
