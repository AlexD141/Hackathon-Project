    {
      "name": "Konbu Dashi",
      "ingredients_raw": [
        "1 (4 inch) piece dashi kombu (dried kelp)",
        "4 cups water"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Wipe kombu with a damp cloth to clean it. Cut into 1-inch pieces and place in a saucepan with water. Bring to a boil; reduce the heat to medium-low and simmer for 20 minutes. Remove from the heat and let stand for a few minutes. Strain through a mesh strainer before using."
        }
