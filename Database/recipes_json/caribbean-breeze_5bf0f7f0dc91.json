      "name": "Caribbean Breeze",
      "ingredients_raw": [
        "1 cup ice, or as needed",
        "2 fluid ounces orange juice",
        "2 fluid ounces pineapple juice",
        "1 fluid ounce orange vodka",
        "1 fluid ounce raspberry vodka",
        "0.5 fluid ounce coconut-flavored rum",
        "1 dash grenadine",
        "1 orange wedge, for garnish"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Fill a tall glass with ice. Pour in orange juice, pineapple juice, orange vodka, raspberry vodka, rum, and grenadine. Stir well, then garnish with orange wedge."
        }
      ],
