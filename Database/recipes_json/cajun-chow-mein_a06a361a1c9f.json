  "recipes": [
    {
      "name": "Cajun Chow Mein",
      "ingredients_raw": [
        "1 pound lean ground beef",
        "0.5 teaspoon minced garlic",
        "1 onion, finely chopped",
        "1 small green bell pepper, finely chopped",
        "1 (14.5 ounce) can diced tomatoes",
        "1 (15 ounce) can dark red kidney beans, undrained",
        "1 cup converted long-grain white rice",
        "1 cup water",
        "1.5 teaspoons chili powder",
        "salt and black pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat an oven to 375 degrees F (190 degrees C)."
        },
        {
          "id": 2,
          "text": "Heat a large saucepan over medium-high heat and stir in the ground beef. Cook and stir until the beef is crumbly, evenly browned, and no longer pink. Drain and discard any excess grease. Stir in the garlic, onion, and green bell pepper; cook and stir until the onion has softened and turned translucent, about 7 minutes. Pour in the tomatoes, and simmer until the liquid has been absorbed, about 5 minutes."
        },
        {
          "id": 3,
          "text": "Once the liquid from the tomatoes has been absorbed, stir in the kidney beans, rice, and water. Season with the chili powder and salt and pepper to taste. Pour into a 9x13-inch baking dish and cover tightly with aluminum foil."
        },
        {
          "id": 4,
          "text": "Bake in the preheated oven until the rice has absorbed the liquid and is tender, 45 minutes to 1 hour."
        }
      ],
