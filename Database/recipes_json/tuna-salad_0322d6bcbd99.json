  "recipes": [
    {
      "name": "Tuna Salad",
      "ingredients_raw": [
        "1 (5 ounce) can tuna, drained",
        "1 (15 ounce) can chickpeas (garbanzo beans), drained",
        "2 hard-boiled eggs, chopped",
        "1 cucumber, peeled and diced",
        "1 head iceberg lettuce, torn into bite-sized pieces",
        "0.5 cup French dressing"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a large mixing bowl, combine tuna, chickpeas (garbanzo beans), chopped hard-boiled eggs, diced cucumber, and iceberg lettuce."
        },
        {
          "id": 2,
          "text": "Toss well and add French dressing to taste."
        }
      ],
