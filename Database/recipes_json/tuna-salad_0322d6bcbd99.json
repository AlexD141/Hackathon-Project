            "author": {
              "@type": "Person",
              "name": "Carol"
            },
            "reviewBody": "I used ginger/sesame flavored tuna, and ginger dressing instead of French, topped with toasted sesame seeds. Very good.",
            "datePublished": "2025-01-26T23:45:18.501Z"
          },
          {
            "@type": "Review",
            "reviewRating": {
              "@type": "Rating",
