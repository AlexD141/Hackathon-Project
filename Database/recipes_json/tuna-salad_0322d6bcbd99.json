            "author": {
              "@type": "Person",
              "name": "ilkaisha"
            },
            "reviewBody": "This is a good salad! I skipped the cucumbers, as I didn't have any, but added some red onion. I actually ate it rolled up in the lettuce rather than tossed in it. Little salad burrito. Mmm.",
            "datePublished": "2012-01-30T15:11:37.967Z"
