  "recipes": [
    {
      "name": "Game Day Jalapeno Cheese Dip",
      "ingredients_raw": [
        "1 pound ground beef",
        "1 pound bulk spicy pork sausage",
        "2 pounds American cheese, cut into 1 inch cubes",
        "1 (15 ounce) can tomato sauce",
        "1 (6 ounce) can tomato paste",
        "1 (4 ounce) can canned diced green chiles, drained",
        "1 (4 ounce) can canned diced jalapeno peppers, drained"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Brown ground beef and sausage in a large skillet over medium-high heat. Drain fat. Stir in the cheese cubes; cook over medium heat until melted, stirring constantly. Mix in the tomato sauce, tomato paste, green chiles, and jalapeno peppers. Stir well."
        },
        {
          "id": 2,
          "text": "Transfer dip to a slow cooker set to Low to serve."
        }
      ],
