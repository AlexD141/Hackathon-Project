  "recipes": [
    {
      "name": "Grilled Southwestern Shish Kebabs",
      "ingredients_raw": [
        "3 cups Mexican lager (such as Negra™ Modelo)",
        "0.75 cup coarsely chopped white onion",
        "0.75 cup chopped cilantro",
        "0.25 cup lime juice",
        "0.25 cup minced garlic",
        "1 tablespoon hot salsa",
        "1.5 teaspoons red pepper flakes",
        "0.5 teaspoon kosher salt",
        "0.5 teaspoon freshly cracked black pepper",
        "4 pounds beef tenderloin, cut into 1-inch cubes, or more as needed",
        "1 fresh pineapple, cored and cut into 1-inch pieces",
        "2 green bell peppers, cut into 1-inch pieces",
        "2 cups coarsely chopped red onion",
        "12 white mushrooms",
        "12 cherry tomatoes",
        "(12-inch) skewers, soaked in water for at least 30 minutes"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine lager, white onion, cilantro, lime juice, garlic, salsa, red pepper flakes, salt, and black pepper in a large bowl; mix well. Add beef; toss to coat in marinade. Cover the bowl with plastic wrap; marinate in the refrigerator, 6 hours to overnight."
        },
        {
          "id": 2,
          "text": "Alternately thread beef, pineapple, bell peppers, red onions, mushrooms, and tomatoes onto skewers. Place kebabs on a baking sheet."
        },
        {
          "id": 3,
          "text": "Preheat the grill for medium heat and lightly oil the grate."
        },
        {
          "id": 4,
          "text": "Grill kebabs until beef is firm and reddish-pink in center, about 4 minutes per side."
        }
      ],
