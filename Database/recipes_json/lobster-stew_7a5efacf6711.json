  "recipes": [
    {
      "name": "Lobster Stew",
      "ingredients_raw": [
        "1 pound cooked lobster meat",
        "1 cup butter",
        "2 quarts half-and-half cream"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Saute the lobster meat gently in butter until butter turns pink. Add half and half slowly. Heat over medium heat until hot. Do not boil. Serve with oyster crackers and enjoy!"
        }
      ],
