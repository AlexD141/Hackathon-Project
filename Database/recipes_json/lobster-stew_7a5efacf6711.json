              "@type": "Person",
              "name": "pj"
            },
            "reviewBody": "This is a great base but for color and sweetness add paprika and sherry to taste.",
            "datePublished": "2010-12-02T07:28:40.513Z"
          },
          {
            "@type": "Review",
            "reviewRating": {
              "@type": "Rating",
