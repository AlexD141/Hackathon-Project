            "author": {
              "@type": "Person",
              "name": "Linda Parker"
            },
            "reviewBody": "I added about 1/2 C walnuts without chopping them. Added taste and texture. Instead of large loaves, I made 8 mini loaves to share. Excellent!",
            "datePublished": "2019-02-05T17:50:32.723Z"
          },
          {
            "@type": "Review",
            "reviewRating": {
              "@type": "Rating",
              "ratingValue": "5"
