{
  "source_url": "https://www.allrecipes.com/recipe/217315/grilled-shrimp-salad-with-sesame-ginger-vinaigrette/",
  "extracted_at": "2026-10-18T03:02:31.993563+00:00",
  "recipes": [
    {
      "name": "Grilled Shrimp Salad with Sesame Ginger Vinaigrette",
      "ingredients_raw": [
        "1/3 cup rice vinegar",
        "1/4 cup toasted sesame seeds",
        "1 tablespoon soy sauce",
        "2 teaspoons finely chopped ginger",
        "2 teaspoons minced garlic",
        "2/3 cup canola oil",
        "1/3 cup sesame oil",
        "8 medium-large raw shrimp, peeled and deveined",
        "1 (12 ounce) package DOLE® Very Veggie™",
        "10 cherry tomatoes, cut in half",
        "2 green onions, diagonally sliced",
        "2 medium mushrooms, thinly sliced"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate."
        },
        {
          "id": 2,
          "text": "Meanwhile, combine vinegar, sesame seeds, soy sauce, ginger, and garlic in a blender; blend until smooth. Add canola oil and sesame oil in a thin stream with the blender running until dressing is emulsified. Brush shrimp with 2 to 3 tablespoons vinaigrette; set remaining vinaigrette aside."
        },
        {
          "id": 3,
          "text": "Cook shrimp on the preheated grill until pink, 3 to 4 minutes, flipping once."
        },
        {
          "id": 4,
          "text": "Divide veggies, shrimp, tomatoes, green onions, and mushrooms between 2 large plates; drizzle with reserved vinaigrette."
        }
      ],
