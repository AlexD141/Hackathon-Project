    {
      "name": "Kitchen Sink Salad Dressing",
      "ingredients_raw": [
        "1 cup vegetable oil",
        "1 (10.75 ounce) can condensed tomato soup",
        "0.5 cup packed brown sugar",
        "0.33329999446869 cup red wine vinegar",
        "1 teaspoon ground mustard",
        "1 teaspoon garlic salt",
        "0.5 teaspoon onion salt",
        "0.5 teaspoon celery salt",
        "0.25 teaspoon Worcestershire sauce",
        "0.25 teaspoon paprika",
        "1 dash hot pepper sauce",
        "1 cup mayonnaise"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a blender, combine oil, tomato soup, brown sugar, wine or white vinegar, dry mustard, garlic salt, onion salt, celery salt, Worcestershire sauce, paprika, hot sauce, and mayonnaise. Cover, and blend on low speed. Increase speed, and blend until thoroughly mixed. Refrigerate, covered, until ready to use."
        }
      ],
