  "recipes": [
    {
      "name": "Ranch Potatoes",
      "ingredients_raw": [
        "5 pounds peeled and cubed potatoes",
        "1 (8 ounce) package cream cheese, softened",
        "1 (1 ounce) package ranch dressing mix",
        "4 tablespoons heavy cream",
        "1 pinch salt"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Bring a pot of salted water to a boil. Add potatoes; cook until tender but still firm. Drain, and transfer to a large bowl."
        },
        {
          "id": 2,
          "text": "Before mashing potatoes, add the cream cheese, salad dressing, cream and salt."
        },
        {
          "id": 3,
          "text": "Beat with a mixer until smooth. Serve immediately."
        }
      ],
