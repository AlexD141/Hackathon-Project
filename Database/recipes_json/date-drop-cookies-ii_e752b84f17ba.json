  "recipes": [
    {
      "name": "Date Drop Cookies II",
      "ingredients_raw": [
        "1.25 cups all-purpose flour",
        "0.5 teaspoon baking powder",
        "0.5 teaspoon baking soda",
        "0.25 teaspoon salt",
        "0.25 cup shortening",
        "0.75 cup packed brown sugar",
        "1 egg",
        "0.5 cup sour cream",
        "2.5 cups dates, pitted and chopped",
        "1 cup walnut halves"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Pre-heat oven to 400 degrees F (205 degrees C). Lightly grease two baking sheets."
        },
        {
          "id": 2,
          "text": "Combine flour, baking powder, baking soda and salt and set aside."
        },
        {
          "id": 3,
          "text": "In a large bowl, cream together shortening and brown sugar. Beat in the egg and the sour cream. Gradually blend in flour mixture. Fold in dates."
        },
        {
          "id": 4,
          "text": "Drop dough by teaspoonfuls 1-1/2 inches apart onto baking sheets. Press a walnut half into the center of each cookie."
        },
        {
          "id": 5,
          "text": "Bake for 8-10 minutes until lightly colored. Cool cookies on wire racks."
        }
      ],
