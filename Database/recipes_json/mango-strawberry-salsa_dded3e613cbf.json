    {
      "name": "Mango Strawberry Salsa",
      "ingredients_raw": [
        "0.66666668653488 cup orange juice",
        "0.25 cup lemon juice",
        "2 tablespoons balsamic vinegar",
        "2 tablespoons lime juice",
        "2 pints strawberries, diced",
        "2 diced fresh mango"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine orange juice, lemon juice, balsamic vinegar, and lime juice in a large bowl until well mixed. Gently stir in strawberries and mango until evenly coated; set aside before serving for at least 20 minutes."
        }
      ],
