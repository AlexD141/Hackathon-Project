  "recipes": [
    {
      "name": "Mango Pina Colada Smoothie",
      "ingredients_raw": [
        "1 mango - peeled, seeded, and cubed",
        "1 (14 ounce) can coconut milk",
        "1.25 cups ice cubes",
        "1.25 cups pineapple juice",
        "0.5 cup heavy cream",
        "2 tablespoons white sugar"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Purée mango, coconut milk, ice, pineapple juice, cream, and sugar in a blender until smooth."
        },
        {
          "id": 2,
          "text": "Pour into glasses and serve."
        }
      ],
