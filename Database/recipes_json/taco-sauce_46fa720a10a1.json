  "recipes": [
    {
      "name": "Taco Sauce",
      "ingredients_raw": [
        "1 clove garlic, minced",
        "1 teaspoon white sugar",
        "1 teaspoon ground cumin",
        "0.5 teaspoon salt",
        "0.5 teaspoon ground mustard",
        "1 dash cayenne pepper",
        "1 tablespoon distilled white vinegar",
        "0.5 cup olive oil"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Whisk together the garlic, sugar, cumin, salt, mustard, cayenne pepper, and vinegar in a bowl. Whisk in the olive oil until incorporated."
        }
      ],
