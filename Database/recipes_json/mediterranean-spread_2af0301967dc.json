  "recipes": [
    {
      "name": "Mediterranean Spread",
      "ingredients_raw": [
        "1 (8 ounce) package cream cheese, softened",
        "0.25 cup sour cream",
        "1 (4 ounce) container crumbled feta cheese",
        "2 teaspoons garlic powder",
        "2 teaspoons dried dill weed"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Mix cream cheese, sour cream, feta cheese, garlic powder, and dill weed in a bowl until well blended."
        },
        {
          "id": 2,
          "text": "Cover and refrigerate for 30 minutes before serving."
        }
      ],
