  "recipes": [
    {
      "name": "Avocado and Black Eyed Pea Salsa",
      "ingredients_raw": [
        "2 ripe but firm avocados, diced",
        "1 (15 ounce) can black-eyed peas, rinsed and drained",
        "1 (11 ounce) can shoepeg corn, drained",
        "1 cup chopped roma (plum) tomatoes",
        "0.5 cup chopped fresh cilantro",
        "0.5 cup chopped green onion",
        "0.25 cup red wine vinegar",
        "0.25 cup olive oil",
        "1 teaspoon ground cumin",
        "0.5 teaspoon minced garlic",
        "salt and black pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Mix together avocados, peas, corn, tomatoes, cilantro, and green onion lightly in a salad bowl until well combined."
        },
        {
          "id": 2,
          "text": "Whisk together red wine vinegar, olive oil, cumin, and garlic in a medium bowl and pour over salad. Season with salt and pepper; lightly toss salad again. Chill in the refrigerator to blend the flavors before serving, about 1 hour."
        }
      ],
