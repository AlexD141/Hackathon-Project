  "recipes": [
    {
      "name": "Vermicelli Soup",
      "ingredients_raw": [
        "12 ounces vermicelli pasta",
        "2 tablespoons vegetable oil",
        "2 cups water",
        "0.25 yellow onion",
        "2 tomatoes",
        "1 clove garlic",
        "salt to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Using a large sauté pan, fry vermicelli in vegetable oil until golden brown."
        },
        {
          "id": 2,
          "text": "In a food processor or blender, blend water, onion, tomatoes, garlic, and salt. Strain."
        },
        {
          "id": 3,
          "text": "Pour blended mixture over vermicelli and allow to simmer until all the liquid has been absorbed or evaporated."
        }
      ],
