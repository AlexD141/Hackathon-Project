  "recipes": [
    {
      "name": "Humungous Cookies",
      "ingredients_raw": [
        "1 cup unsalted butter",
        "1 (8 ounce) package cream cheese",
        "1 cup packed brown sugar",
        "0.5 cup white sugar",
        "2 eggs",
        "2.3333299160004 cups all-purpose flour",
        "1 teaspoon baking soda",
        "0.25 teaspoon salt",
        "2 cups chopped semisweet chocolate",
        "1 cup coarsely chopped walnuts"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 375 degrees F. Lightly grease two 12 inch pizza pans."
        },
        {
          "id": 2,
          "text": "Stir together flour, baking soda and salt and set aside."
        },
        {
          "id": 3,
          "text": "Using a large bowl, cream together butter, cream cheese and sugars. Add eggs and beat until fluffy. Add flour mixture to creamed mixture, blending until dough becomes stiff. Stir in chocolate chunks and nuts until well blended."
        },
        {
          "id": 4,
          "text": "Divide dough in two. Press each half into the prepared pans. Bake 20-25 minutes or until lightly browned around the edges. Centers should be firm. Cool in the pan on wire rack. Serve by cutting into wedges."
        }
      ],
