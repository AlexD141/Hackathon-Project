  "recipes": [
    {
      "name": "Mama D&#39;s Very Berry Margaritas",
      "ingredients_raw": [
        "3 cups ice",
        "1 cup gold tequila",
        "0.66666668653488 cup triple sec",
        "0.5 cup orange juice",
        "0.66666668653488 cup frozen strawberries",
        "0.66666668653488 cup frozen blueberries",
        "0.66666668653488 cup frozen raspberries",
        "3 tablespoons white sugar"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place the ice into a blender pitcher. Pour in the tequila, triple sec, and orange juice. Add the strawberries, blueberries, raspberries, and sugar. Cover, and blend until the mixture is smooth, or to your desired consistency. Pour into chilled glasses to serve."
        }
      ],
