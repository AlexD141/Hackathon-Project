  "recipes": [
    {
      "name": "Roasted Asparagus with Balsamic Vinegar",
      "ingredients_raw": [
        "2 pounds fresh asparagus, trimmed",
        "2 tablespoons olive oil",
        "0.5 pinch ground sea salt",
        "0.125 teaspoon ground black pepper",
        "3 tablespoons balsamic vinegar"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 400 degrees F (205 degrees C)."
        },
        {
          "id": 2,
          "text": "Place asparagus in a shallow 9x13-inch baking dish. Sprinkle with oil, salt, and pepper; toss to coat."
        },
        {
          "id": 3,
          "text": "Bake in the preheated oven until lightly browned, 15 to 20 minutes. Drizzle with vinegar just before serving."
        }
      ],
