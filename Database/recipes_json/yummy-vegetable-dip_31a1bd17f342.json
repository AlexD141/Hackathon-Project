    {
      "name": "Yummy Vegetable Dip",
      "ingredients_raw": [
        "1 cup mayonnaise",
        "1 teaspoon ground turmeric",
        "1 teaspoon garlic salt",
        "1 teaspoon white sugar",
        "2 teaspoons dried minced onion",
        "1 teaspoon prepared horseradish",
        "1 teaspoon white vinegar"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Stir together mayonnaise, turmeric, garlic salt, sugar, onion, horseradish, and vinegar in a small bowl. Chill 2 hours before serving."
        }
      ],
