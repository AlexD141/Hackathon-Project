              "@type": "Person",
              "name": "margie"
            },
            "reviewBody": "Delicious. Instead of plain chicken broth I used soy ginger by simply Asian and I added sliced water chestnuts.",
            "datePublished": "2019-03-27T22:07:03.627Z"
          },
          {
            "@type": "Review",
            "reviewRating": {
              "@type": "Rating",
