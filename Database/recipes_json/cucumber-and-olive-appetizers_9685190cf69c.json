  "recipes": [
    {
      "name": "Cucumber and Olive Appetizers",
      "ingredients_raw": [
        "1 large cucumber",
        "1 (3 ounce) package cream cheese, softened",
        "0.25 cup blue cheese salad dressing",
        "1 (1 pound) loaf cocktail rye bread",
        "15 pimento-stuffed green olives, chopped"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Using the tines of a fork, score the unpeeled cucumber lengthwise on all sides. Slice the cucumber into 1/4-inch thick rounds."
        },
        {
          "id": 2,
          "text": "In a small bowl, combine the cream cheese and blue cheese dressing. Spread the cheese mixture on the rye bread slices. Top with a slice of cucumber and a slice of olive."
        }
      ],
