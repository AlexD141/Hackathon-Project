  "recipes": [
    {
      "name": "Apple Betty",
      "ingredients_raw": [
        "4 cups thinly sliced apples",
        "0.25 cup orange juice",
        "1 cup white sugar",
        "0.75 cup all-purpose flour",
        "0.5 teaspoon ground cinnamon",
        "0.25 teaspoon ground nutmeg",
        "1 pinch salt",
        "0.5 cup cold butter, cubed"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather the ingredients. Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a 9-inch pie plate."
        },
        {
          "id": 2,
          "text": "Mound apples in the prepared pie plate. Sprinkle with orange juice."
        },
        {
          "id": 3,
          "text": "Mix together sugar, flour, cinnamon, nutmeg, and salt in a large bowl."
        },
        {
          "id": 4,
          "text": "Cut in butter with 2 knives or a pastry blender until mixture resembles coarse crumbs."
        },
        {
          "id": 5,
          "text": "Scatter streusel over apples."
        },
        {
          "id": 6,
          "text": "Bake in the preheated oven until streusel is browned and filling is hot, about 40 to 45 minutes. It will thicken as it cools; serve warm."
        }
      ],
