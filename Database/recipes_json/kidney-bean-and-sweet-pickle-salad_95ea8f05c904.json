  "recipes": [
    {
      "name": "Kidney Bean and Sweet Pickle Salad",
      "ingredients_raw": [
        "1 (20 ounce) can dark red kidney beans, drained and rinsed",
        "0.5 white onion, diced",
        "2 hard-boiled eggs, diced",
        "1 cup diced sweet pickles",
        "1 cup mayonnaise",
        "2 stalks celery, diced",
        "salt and ground black pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine kidney beans, onion, hard-boiled eggs, pickles, mayonnaise, and celery in a large bowl until well combined. Season with salt and black pepper."
        },
        {
          "id": 2,
          "text": "Refrigerate 8 hours to overnight to allow flavors to combine."
        }
      ],
