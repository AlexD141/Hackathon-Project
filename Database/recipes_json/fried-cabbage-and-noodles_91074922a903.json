  "recipes": [
    {
      "name": "Fried Cabbage and Noodles",
      "ingredients_raw": [
        "1 (8 ounce) package kluski noodles",
        "1 pound bacon, chopped",
        "1 head cabbage, chopped",
        "1 onion, chopped",
        "1 dash hot pepper sauce (such as Frank's RedHot®), or to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Bring a large pot of lightly salted water to a boil. Cook noodles according to package directions until tender but still slightly firm, 7 to 10 minutes. Drain well and set aside."
        },
        {
          "id": 2,
          "text": "Place bacon in a large, deep skillet over medium-high heat. Cook, stirring often, until evenly browned, 5 to 8 minutes."
        },
        {
          "id": 3,
          "text": "Add cabbage and onion to the skillet and cook until cabbage is wilted and tender, about 10 minutes."
        },
        {
          "id": 4,
          "text": "Gently mix noodles into cabbage mixture. Season with hot sauce."
        }
      ],
