  "recipes": [
    {
      "name": "Jomama&#39;s Big Game Dip",
      "ingredients_raw": [
        "0.5 cup sour cream",
        "1 (8 ounce) package cream cheese, softened",
        "1 (12 ounce) jar medium salsa (such as Pace®)",
        "1 (4.5 ounce) can small shrimp, drained",
        "2 cups shredded Cheddar cheese",
        "1 tomato, chopped",
        "1 (6 ounce) can pitted black olives, drained and quartered",
        "2 green onions, chopped"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Beat the sour cream and cream cheese together in a bowl with an electric mixer until smooth."
        },
        {
          "id": 2,
          "text": "Spoon the mixture in an even layer across the bottom of an 8x8-inch pan."
        },
        {
          "id": 3,
          "text": "Spread the salsa over the cream cheese mixture in one layer."
        },
        {
          "id": 4,
          "text": "Follow with layers of shrimp and Cheddar cheese."
        },
        {
          "id": 5,
          "text": "Sprinkle top with chopped tomato, black olives, and green onions."
        },
        {
          "id": 6,
          "text": "Refrigerate for 2 hours to chill and blend flavors before serving."
        }
      ],
