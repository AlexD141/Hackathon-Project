    {
      "name": "French Watermelon",
      "ingredients_raw": [
        "1 large watermelon, cubed",
        "1 cup vodka",
        "0.5 cup white sugar",
        "15 fresh mint leaves, chopped"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Toss the watermelon, vodka, sugar, and mint together in a large bowl. Cover the bowl with plastic wrap and refrigerate 1 to 2 hours."
        }
      ],
