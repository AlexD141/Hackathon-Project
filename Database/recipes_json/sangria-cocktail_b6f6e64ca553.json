  "recipes": [
    {
      "name": "Sangria Cocktail",
      "ingredients_raw": [
        "0.75 cup superfine sugar",
        "1 cup tap water",
        "1 orange, sliced",
        "1 lime, sliced",
        "5 (750 milliliter) bottles red wine",
        "12 cubes ice cubes",
        "6 fluid ounces sparkling water",
        "1 cup fresh raspberries, blackberries, blueberries, or halved strawberries"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Dissolve sugar in tap water in a large pitcher. Add orange slices, lime slices, and wine. Stir in ice cubes until cold. Top with sparkling water. Serve in red-wine glasses, with fresh berries in each glass."
        }
      ],
