  "recipes": [
    {
      "name": "Cucumber Sandwich Appetizers",
      "ingredients_raw": [
        "1 (8 ounce) package spreadable cream cheese",
        "0.25 cup sour cream",
        "1 (.7 ounce) package dry Italian-style salad dressing mix",
        "1 (1 pound) loaf sliced pumpernickel party bread",
        "2 cucumbers, peeled and thinly sliced"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine cream cheese, sour cream, and salad dressing mix in a bowl until well blended."
        },
        {
          "id": 2,
          "text": "Spread cream cheese mixture onto pumpernickel party slices; top each with 1 to 2 cucumber slices."
        }
      ],
