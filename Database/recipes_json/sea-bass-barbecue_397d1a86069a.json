  "recipes": [
    {
      "name": "Sea Bass Barbecue",
      "ingredients_raw": [
        "1 tablespoon lemon juice",
        "1 teaspoon olive oil",
        "1 bay leaf",
        "salt and pepper to taste",
        "1 pound fresh sea bass"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat an outdoor grill for medium heat and lightly oil the grate."
        },
        {
          "id": 2,
          "text": "Combine lemon juice, oil, bay leaf, salt, and black pepper in a small bowl; rub on fish, inside and out."
        },
        {
          "id": 3,
          "text": "Cook on the preheated grill until fish flakes easily with a fork, 8 to 10 minutes, flipping halfway through."
        }
      ],
