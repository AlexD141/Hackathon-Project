  "recipes": [
    {
      "name": "Chicken Easy Delight",
      "ingredients_raw": [
        "0.5 cup raisins",
        "1 tablespoon chopped peanuts",
        "0.5 cup honey",
        "1 teaspoon prepared mustard",
        "0.33333334326744 cup maple syrup",
        "0.25 cup butter",
        "3 tablespoons brown sugar",
        "1 (3 pound) whole chicken"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 375 degrees F (190 degrees C)."
        },
        {
          "id": 2,
          "text": "In a medium saucepan over low heat combine the raisins, peanuts, honey, mustard, syrup and butter; stir all together until a medium thick glaze has formed, then leave on burner to cook slowly. Stir occasionally to keep from burning."
        },
        {
          "id": 3,
          "text": "Bake hen at 375 degrees F (190 degrees C) for about 1 hour or until bird is cooked through and juices run clear. Baste hen thoroughly with prepared glaze every 10 to 15 minutes while baking; when hen is cooked through and ready to serve, garnish with orange zest."
        }
      ],
