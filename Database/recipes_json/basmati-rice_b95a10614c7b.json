  "recipes": [
    {
      "name": "Basmati Rice",
      "ingredients_raw": [
        "1.75 cups water",
        "1 cup basmati rice",
        "0.25 cup frozen green peas",
        "1 teaspoon cumin seeds"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a saucepan bring water to a boil. Add rice and stir. Reduce heat, cover and simmer for 20 minutes."
        },
        {
          "id": 2,
          "text": "When rice is cooked, stir in peas and cumin. Cover and let stand for 5 minutes."
        }
      ],
