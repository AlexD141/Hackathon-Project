  "recipes": [
    {
      "name": "Fresh Sangrita",
      "ingredients_raw": [
        "0.25 cup fresh lime juice",
        "1 paper-thin onion slice",
        "1 cup fresh orange juice",
        "1 dash Mexican-style hot sauce (such as Valentina® or Cholula®), or to taste",
        "salt to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine the lime juice and onion slice in a bowl, making sure the onion is completely covered with the juice. Allow to soak 2 to 3 hours; remove the onion and discard."
        },
        {
          "id": 2,
          "text": "Stir the orange juice, hot sauce, and salt into the lime juice; chill the sangrita before serving."
        }
      ],
