  "recipes": [
    {
      "name": "Pecan Chocolate Chip Pie",
      "ingredients_raw": [
        "2.5 cups all-purpose flour",
        "0.125 teaspoon salt",
        "0.5 cup butter, chilled and diced",
        "5 tablespoons ice water",
        "3 eggs",
        "0.75 cup white sugar",
        "0.75 cup light corn syrup",
        "0.25 cup butter, melted",
        "0.5 cup semisweet chocolate chips",
        "0.5 cup chopped pecans"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "To Make Crust: In a medium bowl combine flour and salt. Stir well, then cut in butter until mixture is the size of small peas. Add ice water and mix just until dough forms a ball."
        },
        {
          "id": 3,
          "text": "Allow dough to rest in refrigerator for 20 minutes, then roll out and fit into a 9-inch pie plate. Set aside."
        },
        {
          "id": 4,
          "text": "To Make Filling: In a medium bowl mix eggs and sugar. Add corn syrup and melted butter or margarine. Mix until all ingredients are thoroughly combined."
        },
        {
          "id": 5,
          "text": "Spread chocolate chips and pecan pieces across bottom of pie shell. Pour egg mixture over chocolate chip and pecan layer."
        },
        {
          "id": 6,
          "text": "Bake in preheated oven for 35 minutes. Serve warm or cool with a dollop of whipped cream and a sprinkling of chocolate chips if desired."
        }
      ],
      "warnings": [],
