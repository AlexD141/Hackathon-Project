  "recipes": [
    {
      "name": "Banana Shake",
      "ingredients_raw": [
        "1 banana",
        "1 tablespoon lemon juice",
        "4 tablespoons white sugar",
        "1 cup milk",
        "1 cup plain yogurt",
        "0.25 cup whipped cream, garnish"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a blender, combine banana, lemon juice and sugar. Process until smooth. Blend in the milk and yogurt. Pour into glasses, top with a dab of whipped cream and serve."
        }
      ],
