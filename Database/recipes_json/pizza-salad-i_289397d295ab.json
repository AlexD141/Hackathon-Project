  "recipes": [
    {
      "name": "Pizza Salad",
      "ingredients_raw": [
        "1 head iceberg lettuce, torn into bite-sized pieces",
        "0.5 pound salami, cut into strips",
        "1 cup shredded mozzarella cheese",
        "1 cup shredded Cheddar cheese",
        "1 tomato, chopped",
        "0.5 cup pitted black olives, halved",
        "1 tablespoon chopped fresh chives",
        "1 (8 ounce) can tomato sauce",
        "0.5 cup vegetable oil",
        "0.25 cup white wine vinegar",
        "1 teaspoon white sugar",
        "1 teaspoon dried oregano",
        "1 teaspoon salt",
        "0.25 teaspoon garlic powder",
        "0.125 teaspoon ground black pepper"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine lettuce, salami, mozzarella cheese, Cheddar cheese, tomato, olives, and chives in a large bowl. Mix well to combine."
        },
        {
          "id": 2,
          "text": "Make dressing: Whisk together tomato sauce, oil, vinegar, sugar, oregano, salt, garlic powder, and pepper in a medium bowl."
        },
        {
          "id": 3,
          "text": "Pour enough dressing over lettuce mixture to coat; toss and serve."
        }
      ],
