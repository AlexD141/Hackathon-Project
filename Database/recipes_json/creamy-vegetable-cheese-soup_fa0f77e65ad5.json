  "recipes": [
    {
      "name": "Creamy Vegetable Cheese Soup",
      "ingredients_raw": [
        "2 quarts water",
        "2 cups diced potatoes",
        "0.5 cup chopped onion",
        "2 cups chopped celery",
        "1 (16 ounce) package frozen mixed vegetables",
        "2 (10.75 ounce) cans condensed cream of chicken soup",
        "1 pound processed cheese food (eg. Velveeta)"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a large saucepan, combine the water, potatoes, onions and celery. Bring to a boil and then reduce heat to low. Simmer for 20 minutes. Add frozen vegetables and simmer 10 more minutes. Add the cans of soup and the cheese and cook slowly, until the cheese melts."
        }
      ],
