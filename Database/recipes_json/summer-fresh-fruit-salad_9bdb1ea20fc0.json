  "recipes": [
    {
      "name": "Summer Fresh Fruit Salad",
      "ingredients_raw": [
        "2 cups watermelon, seeded and cut into bite-size pieces",
        "2 cups cantaloupe, cut into bite-size pieces",
        "2 cups fresh pineapple chunks",
        "2 cups strawberries, hulled and halved if large",
        "2 cups fresh peaches - peeled, pitted, and cut into bite-size pieces",
        "1 cup seedless grapes",
        "1 cup kiwi fruit, peeled and cut into bite-size pieces",
        "0.25 cup cold water",
        "0.25 cup frozen orange juice concentrate, thawed",
        "0.25 cup frozen limeade concentrate, thawed",
        "0.25 cup frozen lemonade concentrate, thawed",
        "1 cup toasted pecans",
        "12 lettuce leaves"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a large salad bowl, gently toss together the watermelon, cantaloupe, pineapple, strawberries, peaches, grapes, and kiwi until thoroughly combined."
        },
        {
          "id": 2,
          "text": "Combine the water and orange juice, limeade, and lemonade concentrates in a small bowl. Pour the dressing over the fruit salad. Gently toss, and sprinkle the salad with toasted pecans. Serve salad scooped on lettuce leaves."
        }
      ],
