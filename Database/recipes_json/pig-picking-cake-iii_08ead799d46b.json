            "author": {
              "@type": "Person",
              "name": "Jennifer Rosette"
            },
            "reviewBody": "I was a rock star at work with this cake. I used a 9x13 pan and added both chopped strawberries and coconut to the topping. Moist and fabulous.",
            "datePublished": "2014-09-26T15:35:16.640Z"
          },
          {
            "@type": "Review",
            "reviewRating": {
              "@type": "Rating",
