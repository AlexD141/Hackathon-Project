  "recipes": [
    {
      "name": "Tasty Sweet Potatoes",
      "ingredients_raw": [
        "5 sweet potatoes, sliced",
        "0.5 cup orange juice",
        "0.25 cup raisins"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 9x13 inch baking dish."
        },
        {
          "id": 2,
          "text": "Evenly arrange the sweet potato slices in the baking dish. Pour the juice over the potatoes. Sprinkle on the raisins."
        },
        {
          "id": 3,
          "text": "Bake in preheated oven 45 minutes, or until the potatoes are tender."
        }
      ],
