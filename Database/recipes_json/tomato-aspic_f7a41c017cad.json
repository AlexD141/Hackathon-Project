            },
            "author": {
              "@type": "Person",
              "name": "Robert Carr"
            },
            "reviewBody": "Pretty good cold tomato soup. I added green pepper and jalapeno pepper to the vegetables, but it never gelled. I've added 2 more envelopes of gelatin to see if that will kick it.",
            "datePublished": "2019-06-10T01:18:40.000Z"
