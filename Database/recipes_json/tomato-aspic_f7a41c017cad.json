  "recipes": [
    {
      "name": "Tomato Aspic",
      "ingredients_raw": [
        "1 (.25 ounce) envelope unflavored gelatin",
        "0.25 cup boiling water",
        "2 cups vegetable juice (such as V-8®)",
        "1 dash Worcestershire sauce, or to taste",
        "2 cloves",
        "1 bay leaf",
        "0.5 cup chopped onion",
        "0.5 cup chopped celery"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Fully dissolve gelatin in boiling water in a mixing bowl."
        },
        {
          "id": 2,
          "text": "Combine vegetable juice, Worcestershire sauce, cloves, and bay leaf in a saucepan; bring to a boil, reduce heat to low, and simmer for 10 minutes. Remove and discard the bay leaf and cloves."
        },
        {
          "id": 3,
          "text": "Stir onion and celery into vegetable juice."
        },
        {
          "id": 4,
          "text": "Pour vegetable juice mixture over dissolved gelatin; stir gently to blend."
        },
        {
          "id": 5,
          "text": "Refrigerate until set completely, about 1 hour."
        }
      ],
      "warnings": [],
