  "recipes": [
    {
      "name": "Orange, Mango, and Ginger Sorbet",
      "ingredients_raw": [
        "1.5 cups water",
        "1.5 cups white sugar",
        "1 (2 inch) piece fresh ginger, peeled and thinly sliced",
        "1 pinch sea salt",
        "1 teaspoon lime zest",
        "2 cups orange juice",
        "1 cup mango juice",
        "0.33333334326744 cup lemon juice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine the water, sugar, ginger, salt, and lime zest in a saucepan; bring to a boil. Reduce heat to low and simmer 5 minutes. Allow mixture to cool; strain. Stir in the orange juice, mango juice, and lemon juice. Cover and chill 3 hours."
        },
        {
          "id": 2,
          "text": "Fill an ice cream maker with the mixture, and freeze according to the manufacturer&#39;s instructions."
        }
      ],
