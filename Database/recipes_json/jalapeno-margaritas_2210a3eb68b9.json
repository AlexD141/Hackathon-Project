  "recipes": [
    {
      "name": "Jalapeño Margaritas",
      "ingredients_raw": [
        "kosher salt",
        "ice cubes",
        "4 fluid ounces tequila",
        "2 fluid ounces triple sec",
        "2 limes, juiced",
        "1 tablespoon agave nectar",
        "0.5 jalapeno pepper, seeded and diced",
        "1 limes, cut into wedges"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Pour 1/4 to 1/2 inch of salt onto a small, shallow plate. Moisten the rim of 2 margarita glasses with water and dip into salt. Fill with ice and set aside."
        },
        {
          "id": 2,
          "text": "Fill a shaker with ice. Pour tequila, triple sec, lime juice, agave nectar, and jalapeño into the shaker. Cover and shake vigorously until the outside of the shaker has frosted."
        },
        {
          "id": 3,
          "text": "Strain into the prepared glasses. Garnish with lime wedges to serve."
        }
      ],
