  "recipes": [
    {
      "name": "Citrus Amaretto",
      "ingredients_raw": [
        "1 fluid ounce amaretto liqueur",
        "1 fluid ounce citron vodka",
        "0.5 fluid ounce sweet and sour mix",
        "3 fluid ounces ginger ale",
        "5 ice cubes",
        "1 lemon wedge"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Pour the amaretto, vodka, sour mix, and ginger ale into a cocktail shaker over ice. Cover, and shake until the outside of the shaker has frosted. Strain into an ice filled rocks glass, and garnish with a lemon wedge to serve."
        }
      ],
