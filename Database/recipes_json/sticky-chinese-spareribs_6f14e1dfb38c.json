  "recipes": [
    {
      "name": "Sticky Chinese Spareribs",
      "ingredients_raw": [
        "4 pounds pork spareribs",
        "0.5 cup Kikkoman Soy Sauce",
        "0.33333334326744 cup honey",
        "0.25 cup dry sherry",
        "1 clove garlic, crushed",
        "0.25 teaspoon ground ginger"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Cut ribs into serving pieces; place in shallow, foil-lined pan, meaty side down."
        },
        {
          "id": 2,
          "text": "Combine remaining ingredients; brush ribs thoroughly with sauce."
        },
        {
          "id": 3,
          "text": "Cover and bake at 350 degrees F. 1 hour."
        },
        {
          "id": 4,
          "text": "Turn ribs over, pour remaining sauce over ribs and brush with sauce. Bake, uncovered, 30 minutes longer; brush occasionally."
        }
      ],
