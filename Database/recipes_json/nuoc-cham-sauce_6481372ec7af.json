  "recipes": [
    {
      "name": "Nuoc Cham Sauce",
      "ingredients_raw": [
        "2 cloves garlic, minced",
        "1 teaspoon crushed red pepper flakes",
        "3 tablespoons white sugar",
        "2 tablespoons lime juice",
        "4 tablespoons fish sauce",
        "1 cup water"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a medium bowl combine the garlic, red pepper flakes, sugar, lime juice, fish sauce and water. Mix all together, adjusting to taste."
        }
      ],
