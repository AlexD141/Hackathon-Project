  "recipes": [
    {
      "name": "Healthier Hot Artichoke and Spinach Dip II",
      "ingredients_raw": [
        "1 (8 ounce) package Neufchatel cheese, softened",
        "0.25 cup light mayonnaise",
        "0.25 cup grated Parmesan cheese",
        "0.25 cup grated Romano cheese",
        "1 clove garlic, peeled and minced",
        "0.5 teaspoon dried basil",
        "salt and ground black pepper to taste",
        "1 (14 ounce) can artichoke hearts, drained and chopped",
        "1 cup frozen chopped spinach, thawed and drained",
        "0.25 cup shredded mozzarella cheese"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a small baking dish."
        },
        {
          "id": 2,
          "text": "Mix together Neufchatel cheese, mayonnaise, Parmesan cheese, Romano cheese, garlic, basil, salt, and pepper in a bowl. Gently stir in artichoke hearts and spinach."
        },
        {
          "id": 3,
          "text": "Transfer mixture to prepared baking dish. Top with mozzarella cheese. Bake in preheated oven until bubbly and lightly browned, about 25 minutes."
        }
      ],
