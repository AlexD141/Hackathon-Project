  "recipes": [
    {
      "name": "Marinated Beet Salad",
      "ingredients_raw": [
        "1 (16 ounce) can whole beets",
        "0.25 cup white sugar",
        "1 teaspoon prepared mustard",
        "0.25 cup white wine vinegar",
        "0.25 cup diced red onion"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Drain beets, reserving 1/4 cup liquid, and slice into 1/4 to 1/2 inch slivers. Add onions and toss."
        },
        {
          "id": 2,
          "text": "In a saucepan over medium heat, cook the sugar, mustard and reserved 1/4 cup liquid until dissolved. Add vinegar and bring to boil; remove from heat and allow to cool."
        },
        {
          "id": 3,
          "text": "Pour over the beet slices and onions, toss and refrigerate for 4 to 6 hours. Remove from refrigerator and serve at room temperature."
        }
      ],
