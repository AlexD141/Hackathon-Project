  "recipes": [
    {
      "name": "Cosmo-Style Pomegranate Martini",
      "ingredients_raw": [
        "ice cubes",
        "2 fluid ounces citron vodka",
        "2 fluid ounces pomegranate juice",
        "1 fluid ounce Cointreau or other orange liqueur",
        "0.5 fluid ounce lemon juice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Fill a cocktail shaker with ice."
        },
        {
          "id": 3,
          "text": "Pour vodka, pomegranate juice, Cointreau, and lemon juice over ice in the cocktail shaker. Cover and shake until the outside of the shaker has frosted."
        },
        {
          "id": 4,
          "text": "Strain into a chilled martini glass."
        }
      ],
      "warnings": [],
