  "recipes": [
    {
      "name": "Red and Green Velvet Cake!",
      "ingredients_raw": [
        "0.5 cup vegetable shortening",
        "1.5 cups white sugar",
        "2 eggs",
        "1 cup buttermilk",
        "2 tablespoons unsweetened cocoa powder",
        "1 teaspoon salt",
        "1 teaspoon vanilla extract",
        "2.5 cups sifted all-purpose flour",
        "2 tablespoons red food coloring, or as needed",
        "2 tablespoons green food coloring, or as needed",
        "0.75 teaspoon baking soda",
        "1.5 teaspoons distilled white vinegar",
        "0.75 teaspoon baking soda",
        "1.5 teaspoons distilled white vinegar"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Grease a 9x13-inch sheet pan."
        },
        {
          "id": 3,
          "text": "Mash vegetable shortening and sugar together in a large bowl until smooth and creamy; beat in eggs until fully incorporated."
        },
        {
          "id": 4,
          "text": "Stir buttermilk, cocoa powder, salt, and vanilla extract into the shortening mixture until the liquid ingredients are an even color and texture."
        },
        {
          "id": 5,
          "text": "Sift flour into the liquid ingredients until combined."
        },
        {
          "id": 6,
          "text": "Pour half the batter into a separate bowl."
        },
        {
          "id": 7,
          "text": "Lightly stir red food color into one bowl of batter and green food color into the other bowl of batter."
        },
        {
          "id": 8,
          "text": "Quickly fold 3/4 teaspoon baking soda and 1 1/2 teaspoon white vinegar into the bowl of red batter; quickly fold 3/4 teaspoon baking soda and 1 1/2 teaspoon white vinegar into the bowl of green batter."
        },
        {
          "id": 9,
          "text": "Pour the red and green batters into the prepared sheet pan in alternating colors."
        },
        {
          "id": 10,
          "text": "Bake in the preheated oven until the cake is lightly browned on top and a toothpick inserted in the center comes out clean, 25 to 30 minutes. Allow to cool completely before frosting."
        }
      ],
