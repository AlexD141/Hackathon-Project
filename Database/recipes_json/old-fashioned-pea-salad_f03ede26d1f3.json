      "name": "Old Fashioned Pea Salad",
      "ingredients_raw": [
        "1 (16 ounce) package frozen peas, thawed",
        "1 onion, finely chopped",
        "2 hard-cooked eggs, chopped",
        "0.5 cup mayonnaise",
        "salt and ground black pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine peas, onion, hard-cooked eggs, and mayonnaise in a large bowl. Stir well to combine. Season with salt and pepper. Chill for one hour before serving."
        }
