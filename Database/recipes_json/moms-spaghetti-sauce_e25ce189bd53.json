  "recipes": [
    {
      "name": "Mom&#39;s Spaghetti Sauce",
      "ingredients_raw": [
        "1 pound lean ground beef",
        "1 medium onion, chopped",
        "7 tablespoons olive oil",
        "0.25 cup chopped fresh parsley",
        "1 (46 fluid ounce) can tomato juice",
        "1.5 (15 ounce) cans tomato sauce",
        "2 teaspoons Worcestershire sauce",
        "2 teaspoons salt",
        "0.25 teaspoon garlic salt",
        "ground black pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine ground beef, onion, olive oil, and parsley in a large skillet over medium heat. Cook and stir until onions are soft and ground beef is cooked through, 8 to 10 minutes."
        },
        {
          "id": 2,
          "text": "Pour tomato juice and tomato sauce into a large pot over medium heat. Add ground beef mixture, Worcestershire sauce, salt, garlic salt, and pepper. Simmer for 1 hour."
        }
      ],
