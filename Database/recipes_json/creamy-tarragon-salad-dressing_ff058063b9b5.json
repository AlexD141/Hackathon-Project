  "recipes": [
    {
      "name": "Creamy Tarragon Salad Dressing",
      "ingredients_raw": [
        "1 tablespoon Dijon mustard",
        "2 tablespoons white sugar",
        "0.33333334326744 cup white vinegar",
        "1 clove garlic",
        "1 teaspoon salt",
        "1 teaspoon xanthan gum",
        "0.33333334326744 cup vegetable oil",
        "0.75 cup water",
        "0.125 teaspoon celery seed",
        "0.125 teaspoon red pepper flakes",
        "0.5 teaspoon cracked black pepper",
        "0.75 teaspoon dried tarragon",
        "2 teaspoons brown mustard seed"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place the Dijon mustard, sugar, vinegar, garlic clove, and salt into a blender. Cover, and puree until the garlic has blended smooth. Sprinkle in the xanthan gum, and blend about 15 seconds to mix well. With the blender running, pour in the vegetable oil alternately with the water; blend until thick and creamy. Add the celery seed, red pepper flakes, black pepper, tarragon, and mustard seed; pulse until the spices are evenly distributed."
        }
      ],
