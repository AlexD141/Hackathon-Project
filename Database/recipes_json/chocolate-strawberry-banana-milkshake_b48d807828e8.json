  "recipes": [
    {
      "name": "Chocolate Strawberry Banana Milkshake",
      "ingredients_raw": [
        "1 cup low-fat milk",
        "0.5 cup frozen unsweetened strawberries",
        "0.5 ripe banana",
        "2 tablespoons powdered chocolate drink mix",
        "0.5 teaspoon vanilla extract",
        "2 teaspoons white sugar"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a blender combine milk, strawberries, banana, chocolate milk powder, vanilla, and sugar. Blend until smooth."
        }
      ],
