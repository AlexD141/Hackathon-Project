  "recipes": [
    {
      "name": "Mom&#39;s Ice Cream Dessert",
      "ingredients_raw": [
        "1 (20 ounce) package chocolate sandwich cookies",
        "0.5 cup margarine, melted",
        "1.5 cups chopped Spanish peanuts",
        "0.5 gallon vanilla ice cream, softened",
        "2 cups confectioners' sugar",
        "1 (12 fluid ounce) can evaporated milk",
        "0.66000002622604 cup semisweet chocolate chips",
        "0.5 cup margarine",
        "1 teaspoon vanilla extract"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Crush all but 10 of the cookies. Combine crushed cookies in large bowl with 1/2 cup melted butter and peanuts."
        },
        {
          "id": 3,
          "text": "Press mixture into a 9x13-inch baking dish and freeze until cold."
        },
        {
          "id": 4,
          "text": "Spread softened ice cream over cold crust and freeze until set."
        },
        {
          "id": 5,
          "text": "Combine confectioners&#39; sugar, evaporated milk, chocolate chips, 1/2 cup butter and vanilla in large saucepan and bring to a boil over medium heat. Boil for 7 minutes, stirring constantly."
        },
        {
          "id": 6,
          "text": "Remove from heat and cool completely; pour mixture over ice cream and freeze until set."
        }
      ],
