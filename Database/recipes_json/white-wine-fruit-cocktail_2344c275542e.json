  "recipes": [
    {
      "name": "White Wine Fruit Cocktail",
      "ingredients_raw": [
        "1.25 cups dry white wine",
        "0.33333334326744 cup white sugar",
        "1 tablespoon chopped fresh mint",
        "0.5 cantaloupe, cut into bite-size pieces",
        "1 cup seedless green grapes, halved",
        "1 pint fresh strawberries, hulled and halved"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine the wine and sugar in a saucepan. Place the saucepan over medium heat and bring to a boil; stirring to dissolve sugar. Remove the saucepan from the heat and add the mint; set aside."
        },
        {
          "id": 2,
          "text": "Combine the cantaloupe, grapes, and strawberries in a large bowl. Pour the wine mixture over the fruit; toss together until all the fruit is covered with the wine mixture; cover and chill. Store in the refrigerator up to 8 hours before serving."
        }
      ],
