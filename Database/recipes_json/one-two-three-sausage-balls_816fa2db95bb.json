  "recipes": [
    {
      "name": "3-Ingredient Sausage Balls",
      "ingredients_raw": [
        "1 pound breakfast sausage",
        "2 cups shredded Cheddar cheese",
        "3 cups buttermilk baking mix"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather the ingredients. Preheat the oven to 400 degrees F (200 degrees C)."
        },
        {
          "id": 2,
          "text": "Combine sausage, cheese, and about 2 cups of baking mix; use hands to mix well. Gradually add in as much of the remaining 1 cup baking mix as possible."
        },
        {
          "id": 3,
          "text": "Roll into balls about 1 to 1 ½ inches in diameter. Roll balls in any excess baking mix to coat."
        },
        {
          "id": 4,
          "text": "Place on a nonstick baking sheet and bake in the preheated oven until golden brown and cooked through, about 18 to 22 minutes."
        }
      ],
