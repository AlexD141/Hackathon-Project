  "recipes": [
    {
      "name": "Sweet and Sour Spinach Jicama Salad",
      "ingredients_raw": [
        "1 cup white sugar",
        "0.75 cup olive oil",
        "0.66666668653488 cup distilled white vinegar",
        "1 tablespoon onion juice",
        "2 teaspoons prepared yellow mustard",
        "2 teaspoons salt",
        "1 teaspoon onion powder",
        "1 (16 ounce) bag fresh spinach",
        "1 jicama, peeled and diced",
        "0.5 onion, thinly sliced",
        "0.25 cup bacon bits",
        "0.25 cup sesame seeds",
        "0.25 cup pine nuts"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Whisk sugar, olive oil, vinegar, onion juice, mustard, salt, and onion powder together in a bowl until sugar is dissolved."
        },
        {
          "id": 2,
          "text": "Mix spinach, jicama, onion, bacon bits, sesame seeds, and pine nuts in a large bowl."
        },
        {
          "id": 3,
          "text": "Pour olive oil dressing over the salad; toss to combine."
        }
      ],
