  "recipes": [
    {
      "name": "Curried Winter Squash",
      "ingredients_raw": [
        "3 cups cooked, mashed winter squash",
        "1.5 tablespoons curry powder",
        "2 tablespoons butter or trans fat-free margarine",
        "2 tablespoons maple syrup",
        "0.5 teaspoon salt, or to taste",
        "0.25 teaspoon cayenne pepper, or to taste",
        "3 tablespoons sweetened coconut flakes, toasted"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a medium bowl, combine first six ingredients. Microwave on high until heated through, about 5 minutes. Sprinkle on coconut, if desired. Serve."
        }
      ],
