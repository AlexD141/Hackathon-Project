  "recipes": [
    {
      "name": "Sam&#39;s Kicking Cranberry Sauce",
      "ingredients_raw": [
        "1 (12 ounce) package fresh cranberries",
        "1 (16 ounce) can whole cranberry sauce",
        "1 (12 ounce) jar orange marmalade",
        "0.33333298563957 cup diced onion",
        "1 apple - peeled, cored, and chopped",
        "1 green bell pepper, chopped",
        "0.75 teaspoon salt",
        "1 jalapeno pepper, seeded and minced",
        "1 lime, juiced",
        "0.33333298563957 cup orange liqueur"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a saucepan over medium heat, combine the fresh whole cranberries, cranberry sauce, orange marmalade, onion, apple, green bell pepper, salt, jalapeno, lime juice and liqueur."
        },
        {
          "id": 2,
          "text": "Cook until cranberries crack open. Reduce heat and simmer until contents reduce by one third (approximately 3 hours). Remove from heat, cover and allow to cool overnight."
        }
      ],
