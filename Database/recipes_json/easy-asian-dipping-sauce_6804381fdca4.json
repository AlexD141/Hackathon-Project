      "name": "Easy Asian Dipping Sauce",
      "ingredients_raw": [
        "0.5 cup soy sauce",
        "0.5 cup rice wine vinegar",
        "3 cloves minced garlic",
        "2 tablespoons honey",
        "2 tablespoons minced fresh ginger root",
        "2 teaspoons sesame seeds",
        "2 teaspoons sesame oil"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Whisk together soy sauce, vinegar, garlic, honey, ginger, sesame seeds, and sesame oil in a bowl."
        }
      ],
