{
  "source_url": "https://www.allrecipes.com/recipe/216751/elegant-coconut-bavarian-cream/",
  "extracted_at": "2026-10-18T03:00:39.846958+00:00",
  "recipes": [
    {
      "name": "Elegant Coconut Bavarian Cream",
      "ingredients_raw": [
        "1 (.25 ounce) envelope unflavored gelatin",
        "0.25 cup cold water",
        "2 cups milk",
        "2 eggs, separated",
        "0.25 cup white sugar",
        "0.125 teaspoon salt",
        "1 teaspoon vanilla extract",
        "0.25 cup cold heavy whipping cream",
        "0.5 cup flaked coconut"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Sprinkle the gelatin over the cold water and set aside to soften for 10 minutes. In a saucepan over medium-high heat, bring the milk just to the boiling point."
        },
        {
          "id": 2,
          "text": "Whisk the egg yolks with the sugar and salt. In a steady stream, pour the hot milk into the egg yolks, whisking constantly."
        },
        {
          "id": 3,
          "text": "Add the softened gelatin to the hot custard and stir until fully dissolved. Stir in the vanilla extract. Let the mixture cool to room temperature."
        },
        {
          "id": 4,
          "text": "Preheat an oven to 350 degrees F (175 degrees C). Toast the coconut on a baking sheet until golden, about 4 minutes, stirring once or twice. (You may use a toaster oven for this step). Transfer to a plate to cool, reserving about 1 tablespoon toasted coconut for garnishing."
        },
        {
          "id": 5,
          "text": "Whip the egg whites until medium-stiff peaks form; gently fold the egg whites into the cooled custard mixture."
        },
        {
          "id": 6,
          "text": "Whip the cream until medium-stiff peaks form. Fold the cream into the custard mixture, along with the toasted coconut. Pour the Bavarian cream into serving glasses and chill for at least three hours before serving. Garnish with the reserved toasted coconut."
        }
      ],
