  "recipes": [
    {
      "name": "Punjabi Sukha Urad Dal",
      "ingredients_raw": [
        "1 cup skin-on, split black lentils (urad dal)",
        "1 cup water",
        "2 tablespoons cooking oil",
        "1 onion, chopped",
        "4 green chile peppers, cut into large chunks",
        "4 cloves garlic, minced",
        "1 tablespoon minced fresh ginger root",
        "salt to taste",
        "1 large tomato, chopped",
        "1 teaspoon garam masala",
        "0.5 teaspoon ground turmeric",
        "0.25 cup chopped fresh cilantro"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place lentils in a large bowl; cover with several inches of cool water. Soak for 4 hours or overnight. Drain and rinse."
        },
        {
          "id": 2,
          "text": "Heat oil in a heavy-bottomed saucepan over medium heat. Add onion, chile peppers, garlic, and ginger; cook until onion is golden brown, about 5 minutes."
        },
        {
          "id": 3,
          "text": "Stir lentils and 1 cup water into onion mixture; season with salt. Reduce heat to low; simmer until lentils are mostly cooked, about 30 minutes."
        },
        {
          "id": 4,
          "text": "Add tomato, garam masala, and turmeric; cook until lentils are tender, about 10 minutes more."
        },
        {
          "id": 5,
          "text": "Garnish servings with cilantro."
        }
      ],
