  "recipes": [
    {
      "name": "Mom&#39;s Venison Barbeque Sauce",
      "ingredients_raw": [
        "0.25 cup butter",
        "1 small onion, minced",
        "1 cup ketchup",
        "3 tablespoons lemon juice",
        "3 tablespoons brown sugar",
        "2 tablespoons Worcestershire sauce",
        "2 tablespoons prepared yellow mustard",
        "salt and ground black pepper to taste",
        "4 (4 ounce) venison steaks",
        "1 tablespoon water",
        "2 teaspoons cornstarch"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 325 degrees F (165 degrees C)."
        },
        {
          "id": 2,
          "text": "Melt butter in a large skillet over medium heat. Add onion; cook and stir until softened, about 5 minutes. Stir in ketchup, lemon juice, brown sugar, Worcestershire sauce, and yellow mustard until completely warmed."
        },
        {
          "id": 3,
          "text": "Heat a separate skillet over medium-high heat. Season steaks with salt and black pepper; cook in the skillet until browned on each side, 3 to 4 minutes per side. Transfer steaks to a 9x13-inch baking dish; pour ketchup mixture over steaks."
        },
        {
          "id": 4,
          "text": "Bake in the preheated oven until steaks are cooked through and no longer pink in centers, about 1 hour."
        },
        {
          "id": 5,
          "text": "Transfer steaks to a platter, shaking off any excess sauce back into the baking dish. Whisk water and cornstarch together in a small bowl until smooth; stir into hot sauce remaining in the baking dish until barbecue sauce begins to thicken. Pour sauce over steaks."
        }
      ],
