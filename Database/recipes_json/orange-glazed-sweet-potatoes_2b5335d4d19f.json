  "recipes": [
    {
      "name": "Orange Glazed Sweet Potatoes",
      "ingredients_raw": [
        "6 sweet potatoes",
        "0.75 cup boiling water",
        "1 teaspoon salt",
        "3 tablespoons butter",
        "0.5 tablespoon orange zest",
        "1 tablespoon orange juice",
        "0.75 cup light corn syrup",
        "0.25 cup packed brown sugar",
        "3 orange slices, halved"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Pare and halve sweet potatoes."
        },
        {
          "id": 2,
          "text": "Combine peel, juice, corn syrup, and brown sugar."
        },
        {
          "id": 3,
          "text": "Add sweet potatoes, boiling water, and salt to a large saucepan. Simmer, covered, until tender; this should take about 15 minutes. Drain off liquid, leaving 1/4 cup in skillet. Dot potatoes with butter or margarine. Pour orange juice mixture over potatoes, and add orange slices. Cook, uncovered, over low heat until glazed, an additional 15 minutes. Baste often, and turn once while cooking."
        }
      ],
