  "recipes": [
    {
      "name": "Grandma&#39;s Creamy Ham Casserole",
      "ingredients_raw": [
        "1 (8 ounce) package egg noodles",
        "1 (12 fluid ounce) can evaporated milk",
        "1 (10.75 ounce) can condensed cream of chicken soup",
        "1 small onion, minced",
        "1 cup cubed fully cooked ham",
        "0.33333334326744 pound processed cheese food (such as Velveeta®), cubed",
        "0.5 cup crushed potato chips"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Bring a large pot of lightly salted water to a boil. Cook egg noodles in boiling water, stirring occasionally, until tender yet firm to the bite, about 5 minutes. Drain."
        },
        {
          "id": 3,
          "text": "Mix together cooked egg noodles, evaporated milk, condensed soup, onion, ham, and processed cheese food in a 9x13-inch baking dish until evenly distributed."
        },
        {
          "id": 4,
          "text": "Bake in the preheated oven until bubbly and cheese is melted, about 1 hour. About 5 minutes before the end of baking, sprinkle potato chips over the top of casserole and return to the oven; bake for 5 minutes more."
        }
      ],
