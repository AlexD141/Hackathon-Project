  "recipes": [
    {
      "name": "Exotic Fruit Drink",
      "ingredients_raw": [
        "1 cup orange juice",
        "1 cup cranberry juice",
        "0.5 cup lemon juice",
        "1 (32 fluid ounce) bottle carbonated water"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Put the orange juice, cranberry juice and lemon juice in 3 separate cups. Without mixing the juices, pour them into ice cube trays and freeze."
        },
        {
          "id": 2,
          "text": "When frozen, place one of each juice cube into a tall glass and fill the glass with carbonated water."
        }
      ],
