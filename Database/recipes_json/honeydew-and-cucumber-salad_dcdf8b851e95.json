  "recipes": [
    {
      "name": "Honeydew and Cucumber Salad",
      "ingredients_raw": [
        "3 large cucumbers - peeled, seeded, and cut into 1-inch pieces",
        "1 honeydew melon - peeled, seeded and cut into 1 1/2 inch chunks",
        "0.5 cup vegetable oil",
        "0.5 cup lemon juice",
        "0.25 cup white sugar"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place cucumber and honeydew in a large bowl."
        },
        {
          "id": 2,
          "text": "Whisk oil, lemon juice, and sugar together in a small bowl until well blended; pour over cucumber and melon and toss until evenly coated."
        },
        {
          "id": 3,
          "text": "Cover the bowl; refrigerate before serving, 1 hour."
        }
      ],
