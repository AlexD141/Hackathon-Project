  "recipes": [
    {
      "name": "Horchata Made Easy",
      "ingredients_raw": [
        "1 cup water",
        "0.5 cup white sugar",
        "0.25 teaspoon ground cinnamon",
        "2 quarts rice milk"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Heat water, sugar, and cinnamon in a saucepan over medium heat. Simmer until sugar is dissolved, whisking occasionally, about 5 minutes. Allow mixture to cool for 10 minutes."
        },
        {
          "id": 2,
          "text": "Pour rice milk into a large pitcher."
        },
        {
          "id": 3,
          "text": "Stir sugar water into rice milk. Serve chilled or over ice."
        }
      ],
