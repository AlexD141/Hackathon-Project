  "recipes": [
    {
      "name": "Bill&#39;s Famous Mai Tai",
      "ingredients_raw": [
        "0.75 fluid ounce light rum",
        "0.75 fluid ounce amber rum",
        "0.75 fluid ounce orange Curacao liqueur",
        "3 fluid ounces pineapple juice",
        "2 fluid ounces sweet and sour mix",
        "0.75 fluid ounce dark rum"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Fill a large glass with ice; use a stir stick to mix in the light rum, amber rum, orange Curacao, pineapple juice, and sweet and sour mix."
        },
        {
          "id": 2,
          "text": "Slowly and gently drizzle the dark rum on top of the cocktail so it floats on top of the drink."
        }
      ],
