  "recipes": [
    {
      "name": "Lori&#39;s Awesome Cookies",
      "ingredients_raw": [
        "1 cup butter",
        "1 cup packed brown sugar",
        "1 cup white sugar",
        "2 eggs",
        "1 teaspoon vanilla extract",
        "1 teaspoon coffee flavored liqueur",
        "2.5 cups rolled oats",
        "2 cups all-purpose flour",
        "1 teaspoon baking soda",
        "1 teaspoon baking powder",
        "0.5 teaspoon salt",
        "1.5 cups candy-coated milk chocolate pieces"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease cookie sheets."
        },
        {
          "id": 2,
          "text": "In a large bowl, cream the butter and the sugars using an electric mixer. Mix in the eggs, vanilla and coffee flavored liqueur."
        },
        {
          "id": 3,
          "text": "Measure the oatmeal and blend in a blender to a fine powder. In a separate bowl, mix together the flour, oatmeal, baking powder, baking soda and salt. Stir the dry ingredients into the butter mixture until blended, then stir in the candy pieces. Roll into balls and place two inches apart on cookie sheets."
        },
        {
          "id": 4,
          "text": "Bake for 10 to 12 minutes in the preheated oven, until the edges start to turn golden."
        }
      ],
      "warnings": [],
