      "name": "No-Salt Vinaigrette",
      "ingredients_raw": [
        "0.5 cup red wine vinegar",
        "0.33333334326744 cup olive oil",
        "1 tablespoon Italian seasoning",
        "2 cloves garlic, crushed",
        "1 teaspoon lemon juice",
        "0.125 teaspoon white pepper"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Whisk together red wine vinegar, olive oil, Italian seasoning, garlic, lemon juice, and white pepper in a small bowl until well combined. Let stand for at least 15 minutes before serving."
        }
      ],
