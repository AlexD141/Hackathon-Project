  "recipes": [
    {
      "name": "Chocolate Pie",
      "ingredients_raw": [
        "2 cups low-fat milk",
        "1 (5.9 ounce) package instant chocolate pudding mix",
        "waxed paper",
        "1 (9 inch) pie shell, baked",
        "1 (8 ounce) container frozen whipped topping, thawed",
        "0.25 cup chocolate shavings"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Whisk milk and pudding mix together in a large bowl until smooth; cover pudding with waxed paper and set aside for 5 minutes."
        },
        {
          "id": 3,
          "text": "Pour pudding into pie shell and refrigerate until set, at least 1 hour."
        },
        {
          "id": 4,
          "text": "Top with whipped topping before serving and garnish with chocolate shavings."
        }
      ],
