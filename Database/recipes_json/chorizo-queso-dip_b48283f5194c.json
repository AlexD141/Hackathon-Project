  "recipes": [
    {
      "name": "Chorizo Queso Dip",
      "ingredients_raw": [
        "10 ounces bulk chorizo sausage",
        "1 (10 ounce) can diced tomatoes with green chile peppers (such as RO*TEL®), drained",
        "1 (8 ounce) package cream cheese, cubed",
        "1 (8 ounce) package processed cheese (such as Velveeta®), cubed"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Heat a large skillet over medium-high heat. Cook and stir chorizo in the hot skillet until well browned and crumbly, 5 to 7 minutes; drain well and transfer to a slow cooker."
        },
        {
          "id": 2,
          "text": "Add diced tomatoes with chiles, cream cheese, and processed cheese to slow cooker; stir well. Cover and cook on Low until cheese has melted, stirring occasionally, about 1 ½ to 2 hours."
        }
      ],
