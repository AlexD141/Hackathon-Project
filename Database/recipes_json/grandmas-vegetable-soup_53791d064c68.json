  "recipes": [
    {
      "name": "Grandma&#39;s Vegetable Soup",
      "ingredients_raw": [
        "1 pound ground beef",
        "1 (46 ounce) can tomato juice",
        "2 potatoes, diced",
        "2 carrots, chopped",
        "1 onion, chopped",
        "1 (14.5 ounce) can green beans",
        "1 (14 ounce) can whole kernel corn",
        "1 pinch ground ginger",
        "salt and ground black pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather ingredients."
        },
        {
          "id": 2,
          "text": "Cook and stir ground beef in a hot saucepan over medium heat until browned and crumbly, 5 to 7 minutes."
        },
        {
          "id": 3,
          "text": "Drain off grease and pour in tomato juice."
        },
        {
          "id": 4,
          "text": "Add potatoes, carrots, and onion, then pour in undrained green beans and corn. Season with ginger, salt, and pepper. Reduce the heat to low and simmer for 1 hour."
        }
      ],
