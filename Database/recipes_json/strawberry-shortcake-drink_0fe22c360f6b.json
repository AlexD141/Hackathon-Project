  "recipes": [
    {
      "name": "Strawberry Shortcake Drink",
      "ingredients_raw": [
        "0.25 cup frozen strawberries, thawed",
        "1.25 fluid ounces amaretto liqueur",
        "2 (1/2 cup) scoops vanilla ice cream",
        "1 dash vanilla extract",
        "0.5 cup crushed ice",
        "0.25 fluid ounce vanilla-flavored vodka",
        "1 tablespoon whipped cream",
        "1 fresh strawberry"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place thawed frozen strawberries, amaretto liqueur, vanilla ice cream, vanilla extract, crushed ice, and vanilla vodka into a blender."
        },
        {
          "id": 2,
          "text": "Cover and blend until smooth."
        },
        {
          "id": 3,
          "text": "Pour into a glass and garnish with whipped cream and a fresh strawberry."
        }
      ],
