      "name": "Chocolate Hazelnut Raspberry Goodness",
      "ingredients_raw": [
        "1 fluid ounce Chambord (raspberry liqueur)",
        "1 fluid ounce Frangelico (hazelnut liqueur)",
        "1 fluid ounce chocolate vodka",
        "1 teaspoon chocolate shavings, for garnish"
      ],
      "steps": [
        {
