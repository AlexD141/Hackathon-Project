  "recipes": [
    {
      "name": "Mom’s Wontons",
      "ingredients_raw": [
        "0.5 pound ground pork",
        "0.75 pound cooked shrimp, shelled, deveined and coarsely chopped",
        "2 tablespoons minced green onions",
        "2 tablespoons chopped water chestnuts",
        "1 tablespoon minced fresh ginger root",
        "1 teaspoon cornstarch",
        "0.25 teaspoon garlic salt",
        "1 pinch white sugar",
        "1 tablespoon dry sherry",
        "1 tablespoon soy sauce",
        "1 teaspoon chili oil",
        "0.25 teaspoon sesame oil",
        "1 (16 ounce) package wonton skins",
        "1 egg white"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Cook ground pork in a large skillet over medium heat until no longer pink."
        },
        {
          "id": 2,
          "text": "Combine pork, shrimp, green onions, water chestnuts, ginger, cornstarch, garlic salt, and white sugar in a large bowl. Add dry sherry, soy sauce, chili oil, and sesame oil; mix until well combined."
        },
        {
          "id": 3,
          "text": "Place about one teaspoon of mixture in center of each wonton wrapper. Rub egg white lightly around rim of each wrapper. Bring points of each wrapper together into a triangular shape; pinch edges to seal."
        },
        {
          "id": 4,
          "text": "Meanwhile, bring a large pot of water to a boil. Working in batches if necessary, add wontons to boiling water without crowding. When wontons float to surface, add 1 cup of cold water; allow water to boil again. Immediately remove wontons from water."
        }
      ],
