  "recipes": [
    {
      "name": "Spinach Pomegranate Salad",
      "ingredients_raw": [
        "1 (10 ounce) bag baby spinach leaves, rinsed and drained",
        "0.5 cup walnut pieces",
        "0.5 cup crumbled feta",
        "0.25 medium red onion, sliced very thin",
        "0.25 cup alfalfa sprouts",
        "0.5 cup pomegranate seeds, or to taste",
        "4 tablespoons balsamic vinaigrette"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Place spinach into a salad bowl. Top with walnuts, feta, red onion, alfalfa sprouts, and pomegranate seeds."
        },
        {
          "id": 3,
          "text": "Drizzle with vinaigrette. Enjoy!"
        }
      ],
