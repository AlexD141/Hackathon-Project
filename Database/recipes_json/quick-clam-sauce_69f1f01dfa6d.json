  "recipes": [
    {
      "name": "Quick Clam Sauce",
      "ingredients_raw": [
        "5 tablespoons olive oil",
        "2 cloves garlic, minced",
        "4 tablespoons chopped fresh parsley",
        "2 (6.5 ounce) cans minced clams, with juice",
        "2 (16 ounce) cans crushed tomatoes",
        "salt and pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a large saucepan, lightly brown garlic in olive oil. Stir in parsley, clams with juice, crushed tomatoes, salt and pepper to taste."
        },
        {
          "id": 2,
          "text": "Simmer for 45 minutes. Serve over cooked pasta."
        }
      ],
