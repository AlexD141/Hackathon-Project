  "recipes": [
    {
      "name": "Zucchini Bread with Dried Cranberries",
      "ingredients_raw": [
        "1.5 cups all-purpose flour",
        "1.5 cups whole wheat flour",
        "2 tablespoons ground flax seed",
        "1 tablespoon ground cinnamon",
        "1 teaspoon salt",
        "1 teaspoon baking powder",
        "0.25 teaspoon baking soda",
        "0.5 cup applesauce",
        "0.5 cup vegetable oil",
        "0.5 cup white sugar",
        "0.5 cup brown sugar",
        "3 eggs",
        "1 tablespoon vanilla extract",
        "2 cups shredded zucchini",
        "1 cup dried cranberries",
        "0.5 cup chopped walnuts",
        "0.25 cup shredded carrots"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour two 9x5-inch loaf pans."
        },
        {
          "id": 2,
          "text": "Whisk all-purpose flour, whole wheat flour, flax seed, cinnamon, salt, baking powder, and baking soda together in a bowl until well combined; set aside."
        },
        {
          "id": 3,
          "text": "Beat applesauce, oil, white sugar, brown sugar, eggs, and vanilla together in a large bowl until smooth. Fold in flour mixture, zucchini, cranberries, walnuts, and carrots until no dry spots remain. Divide batter between the prepared loaf pans."
        },
        {
          "id": 4,
          "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, about 1 hour. Cool in the pans for 10 minutes before transferring to a wire rack to cool completely."
        }
      ],
      "warnings": [],
