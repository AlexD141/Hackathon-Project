  "recipes": [
    {
      "name": "Beets on the Grill",
      "ingredients_raw": [
        "cooking spray",
        "6 beets, scrubbed",
        "2 tablespoons butter",
        "salt and pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients. Preheat an outdoor grill for high heat."
        },
        {
          "id": 2,
          "text": "Coat one side of a large piece of aluminum foil with cooking spray. Place beets and butter on foil; season with salt and pepper."
        },
        {
          "id": 3,
          "text": "Wrap foil over beets. Place packet on the grill grate. Cook until beets are very tender, about 30 minutes."
        },
        {
          "id": 4,
          "text": "Allow beets to cool before serving, about 5 minutes. You don&#39;t even need to peel to enjoy!"
        }
      ],
