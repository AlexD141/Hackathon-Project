  "recipes": [
    {
      "name": "Bloody Mary Ceviche",
      "ingredients_raw": [
        "1 pound cooked, peeled, and deveined shrimp",
        "1 pound roma (plum) tomatoes, chopped",
        "0.5 red onion, chopped",
        "1 cucumber, chopped",
        "1 bunch cilantro, chopped",
        "0.75 cup bottled Bloody Mary mix",
        "2 limes",
        "hot pepper sauce to taste",
        "salt and black pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Lightly mix the shrimp, tomatoes, red onion, cucumber, and cilantro in a bowl, and pour in the Bloody Mary mix. Squeeze the limes over the mixture, add a dash of hot pepper sauce, and sprinkle with salt and pepper. Toss again, cover the bowl, and refrigerate for 3 to 4 hours, stirring occasionally."
        }
      ],
