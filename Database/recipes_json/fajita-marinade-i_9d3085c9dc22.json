  "recipes": [
    {
      "name": "Fajita Marinade",
      "ingredients_raw": [
        "0.33333334326744 cup water",
        "0.25 cup lime juice",
        "2 tablespoons olive oil",
        "4 cloves garlic, crushed",
        "2 teaspoons soy sauce",
        "1 teaspoon salt",
        "0.5 teaspoon liquid smoke flavoring",
        "0.5 teaspoon cayenne pepper",
        "0.5 teaspoon ground black pepper"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Whisk water, lime juice, olive oil, garlic, soy sauce, salt, and liquid smoke flavoring together in a bowl until well combined."
        },
        {
          "id": 3,
          "text": "Stir in cayenne and black pepper until combined."
        },
        {
          "id": 4,
          "text": "Use to marinate 2 pounds of meat; marinate in the refrigerator for at least 2 hours to overnight before cooking as desired."
        },
        {
          "id": 5,
          "text": "Enjoy!"
        }
      ],
