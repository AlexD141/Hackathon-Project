            "reviewRating": {
              "@type": "Rating",
              "ratingValue": "4"
            },
            "author": {
              "@type": "Person",
              "name": "jolley900"
            },
            "reviewBody": "I don't like a lot of fish but this was goooooood! it was a tiny tad too watery so I'll probably vent the foil next time but overall it was great.",
            "datePublished": "2007-10-25T17:39:56.560Z"
          },
