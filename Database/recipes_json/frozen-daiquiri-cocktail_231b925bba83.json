  "recipes": [
    {
      "name": "Frozen Daiquiri Cocktail",
      "ingredients_raw": [
        "1.5 fluid ounces light rum",
        "1 tablespoon triple sec",
        "1.5 fluid ounces lime juice",
        "1 teaspoon white sugar",
        "1 cup crushed ice",
        "1 maraschino cherry"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine light rum, triple sec, lime juice, and ice in blender with 1 cup crushed ice; blend until smooth. Pour into a Champagne flute."
        },
        {
          "id": 2,
          "text": "Garnish with maraschino cherry."
        }
      ],
