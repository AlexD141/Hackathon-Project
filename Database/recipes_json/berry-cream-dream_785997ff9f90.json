  "recipes": [
    {
      "name": "Berry Cream Dream",
      "ingredients_raw": [
        "0.25 cup raspberry rum",
        "0.25 cup raspberry schnapps",
        "0.5 cup frozen strawberry juice concentrate",
        "12 frozen strawberries",
        "12 ice cubes",
        "0.25 cup cold water",
        "1 tablespoon white sugar",
        "0.5 cup heavy cream"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place raspberry rum, raspberry schnapps, strawberry juice concentrate, strawberries, ice cubes, water, and sugar in a blender. Blend until smooth then add cream. Blend until just incorporated. Serve in tall glasses."
        }
      ],
