  "recipes": [
    {
      "name": "Mom&#39;s Shredded Elk Sandwiches",
      "ingredients_raw": [
        "1.5 cups ketchup",
        "3 tablespoons brown sugar",
        "1 tablespoon dry mustard powder",
        "1 tablespoon lemon juice",
        "1 tablespoon liquid smoke flavoring",
        "2 teaspoons celery salt",
        "2 teaspoons ground black pepper",
        "2 teaspoons Worcestershire sauce",
        "1 teaspoon onion powder",
        "1 teaspoon garlic powder",
        "3 drops hot pepper sauce",
        "0.125 teaspoon ground nutmeg",
        "1 (4 pound) elk roast, cut in half",
        "10 hamburger buns, split"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Whisk ketchup, brown sugar, mustard powder, lemon juice, liquid smoke, celery salt, black pepper, Worcestershire sauce, onion powder, garlic powder, hot sauce, and nutmeg together in a bowl. Place elk roast into a large slow cooker; pour sauce over top."
        },
        {
          "id": 2,
          "text": "Cover slow cooker. Cook on High until meat shreds easily with a fork, about 5 hours; shred. Serve on hamburger buns."
        }
      ],
