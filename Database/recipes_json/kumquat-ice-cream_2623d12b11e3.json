  "recipes": [
    {
      "name": "Kumquat Ice Cream",
      "ingredients_raw": [
        "2 pints kumquats, halved and seeded",
        "5 cups milk",
        "4 cups heavy whipping cream",
        "3 cups sugar",
        "2 tablespoons lemon juice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Add kumquats to the bowl of a food processor; pulse until smooth. Transfer kumquat purée to a large bowl; stir in milk, cream, sugar, and lemon juice."
        },
        {
          "id": 2,
          "text": "Pour kumquat mixture into an ice cream maker and freeze according to manufacturer&#39;s instructions. Transfer to an airtight container and freeze."
        }
      ],
