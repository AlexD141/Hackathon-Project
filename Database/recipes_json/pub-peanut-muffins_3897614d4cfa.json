  "recipes": [
    {
      "name": "Pub Peanut Muffins",
      "ingredients_raw": [
        "4 cups all-purpose flour",
        "0.5 cup white sugar",
        "1.5 teaspoons baking powder",
        "1.5 teaspoons salt",
        "2 cups pale ale or lager beer",
        "1 cup chopped peanuts",
        "2 tablespoons butter, melted"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease the cups of a muffin tin."
        },
        {
          "id": 2,
          "text": "In a large bowl, stir together the flour, sugar, baking powder, and salt. Pour in the beer and stir until evenly moistened. The dough will be slightly sticky. Stir in peanuts. Fill muffin cups 3/4 full with the batter and spoon about 1/2 teaspoon of butter over the top of each one."
        },
        {
          "id": 3,
          "text": "Bake for 25 minutes in the preheated oven, or until browned and firm. Cool in the pan for about 5 minutes before removing and cooling on a wire rack."
        }
      ],
