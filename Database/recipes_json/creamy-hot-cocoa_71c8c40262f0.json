          },
          {
            "@type": "Review",
            "reviewRating": {
              "@type": "Rating",
              "ratingValue": "5"
            },
            "author": {
              "@type": "Person",
              "name": "Michael"
            },
            "reviewBody": "This is exactly the hot chocolate recipe that I want. It is an American version of hot chocolate. It is not thick, it’s more drinkable, especially if using 2% milk. The half-and-half is optional to cut the heat and add a little bit of creaminess. You could also use whipping cream.",
            "datePublished": "2025-12-02T04:29:05.085Z"
          },
          {
            "@type": "Review",
            "reviewRating": {
              "@type": "Rating",
