  "recipes": [
    {
      "name": "Easy Cheesy SPAM-wiches",
      "ingredients_raw": [
        "1 (12 ounce) can fully cooked luncheon meat (such as SPAM®), cubed",
        "2 cups shredded Cheddar cheese",
        "0.5 cup creamy salad dressing (such as Miracle Whip™)",
        "4 hamburger buns, split"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven&#39;s broiler and set the oven rack about 6 inches from the heat source."
        },
        {
          "id": 2,
          "text": "Stir together the luncheon meat, Cheddar cheese, and salad dressing in a bowl. Spread the filling onto the cut side of each hamburger bun, and place onto a baking sheet, filling-side up."
        },
        {
          "id": 3,
          "text": "Broil the open-faced sandwiches in the preheated oven until the tops are browned and bubbly, about 5 minutes."
        }
      ],
