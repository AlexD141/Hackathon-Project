  "recipes": [
    {
      "name": "Pan-Fried Asparagus",
      "ingredients_raw": [
        "0.25 cup butter",
        "2 tablespoons olive oil",
        "1 teaspoon coarse salt",
        "0.25 teaspoon ground black pepper",
        "3 cloves garlic, minced",
        "1 pound fresh asparagus spears, trimmed"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Melt butter in a skillet over medium heat. Add olive oil, salt, and pepper; cook and stir until garlic is fragrant, about 30 seconds."
        },
        {
          "id": 3,
          "text": "Add asparagus and cook until fork-tender, turning asparagus often to ensure even cooking, about 8 to 10 minutes."
        },
        {
          "id": 4,
          "text": "Serve and enjoy!"
        }
      ],
