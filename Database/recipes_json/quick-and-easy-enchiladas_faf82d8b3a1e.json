  "recipes": [
    {
      "name": "Quick and Easy Enchiladas",
      "ingredients_raw": [
        "3 tablespoons corn oil",
        "1 onion, chopped",
        "1 tomato, chopped",
        "2 (10 ounce) cans chicken chunks, drained",
        "salt and pepper to taste",
        "12 (6 inch) corn tortillas",
        "1 cup tomato sauce",
        "8 ounces rancherito cheese, shredded",
        "0.25 cup grated Romano cheese",
        "1 cup shredded lettuce",
        "1 tomato, diced",
        "0.25 cup sour cream"
      ],
      "steps": [
        {
          "id": 1,
          "text": "To Make Chicken Mixture: In a medium skillet heat oil. Add onion and saute until translucent. Add tomato, chicken and salt and pepper to taste. Cook until heated through. Set aside."
        },
        {
          "id": 2,
          "text": "To Make Cheese Mixture: Mix together rancherito cheese and Romano cheese."
        },
        {
          "id": 3,
          "text": "Pour tomato sauce into a shallow dish or bowl. In a separate medium skillet, heat oil. One by one, dip corn tortillas in tomato sauce, covering both sides. Then slip carefully into hot oil in skillet. Fry for only about 30 seconds on each side. Set on clean dish and fill with chicken mix and a sprinkle of cheese mix. Roll up. Repeat until all tortillas are filled OR filling runs out, whichever comes first. Top with shredded lettuce, diced tomato and sour cream and serve."
        }
      ],
