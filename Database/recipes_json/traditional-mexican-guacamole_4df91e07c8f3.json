  "recipes": [
    {
      "name": "Traditional Mexican Guacamole",
      "ingredients_raw": [
        "2 avocados, peeled and pitted",
        "1 cup chopped tomatoes",
        "0.25 cup chopped onion",
        "0.25 cup chopped cilantro",
        "2 tablespoons lemon juice",
        "1 jalapeno pepper, seeded and minced",
        "salt and ground black pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Mash avocados in a bowl until creamy."
        },
        {
          "id": 2,
          "text": "Mix tomatoes, onion, cilantro, lemon juice, and jalapeño pepper into mashed avocado until well combined. Season with salt and pepper."
        }
      ],
