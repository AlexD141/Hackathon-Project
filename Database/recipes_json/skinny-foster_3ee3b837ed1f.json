  "recipes": [
    {
      "name": "Skinny Foster",
      "ingredients_raw": [
        "2 teaspoons butter",
        "2 teaspoons brown sugar",
        "1 orange, juiced",
        "1 banana, split lengthwise",
        "2 scoops vanilla ice cream",
        "2 tablespoons sliced almonds, toasted"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Heat butter, brown sugar, and orange juice in a skillet over medium heat. Once the butter has melted, add the banana. Cook until the banana has softened and the sauce is slightly syrupy, flipping the banana occasionally, about 2 minutes."
        },
        {
          "id": 2,
          "text": "Serve each slice of banana with a scoop of vanilla ice cream. Drizzle with the sauce and sprinkle with almond slices."
        }
      ],
