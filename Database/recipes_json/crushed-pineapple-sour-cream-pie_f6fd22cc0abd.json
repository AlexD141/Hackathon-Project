  "recipes": [
    {
      "name": "Crushed Pineapple Sour Cream Pie",
      "ingredients_raw": [
        "1 (9 inch) pie crust, baked",
        "1 (8 ounce) can crushed pineapple with juice",
        "1 (3.5 ounce) package instant vanilla pudding mix",
        "2 tablespoons white sugar",
        "1 cup sour cream"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a large mixing bowl, combine pineapple, dry pudding mix, and sugar. Stir well, then add sour cream. Beat on low speed for 2 minutes."
        },
        {
          "id": 2,
          "text": "Pour mixture into prepared pie shell. Chill before serving. Garnish as desired."
        }
      ],
