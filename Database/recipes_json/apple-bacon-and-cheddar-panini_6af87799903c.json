  "recipes": [
    {
      "name": "Apple, Bacon, and Cheddar Panini",
      "ingredients_raw": [
        "2 tablespoons butter, or to taste",
        "3 slices bread",
        "0.25 cup shredded Cheddar cheese",
        "4 slices cooked bacon",
        "0.25 apple, peeled and sliced thinly"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat a panini press."
        },
        {
          "id": 2,
          "text": "Butter 2 of the bread slices. Place 1 slice on the panini press, buttered-side-down. Arrange Cheddar cheese on the bread; lay unbuttered bread on top. Place bacon and apple on top; cover with the remaining slice of bread, buttered side-up. Close the press and cook until panini is browned, about 4 minutes."
        }
      ],
