  "recipes": [
    {
      "name": "Solid Gold Pie",
      "ingredients_raw": [
        "1 prepared 8 inch pastry shell, baked and cooled",
        "0.5 cup butter, melted and cooled",
        "1.25 cups white sugar",
        "2 eggs, beaten",
        "1 teaspoon vanilla extract",
        "1 tablespoon distilled white vinegar"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 300 degrees F (150 degrees C)."
        },
        {
          "id": 2,
          "text": "In a medium bowl combine butter, sugar, eggs, vanilla extract, and vinegar. Mix until smooth. Pour mixture into pastry shell."
        },
        {
          "id": 3,
          "text": "Bake in preheated oven for 10 minutes. Raise temperature to 325 degrees F (165 degrees C) and bake an additional 20 to 30 minutes, until center is set and top is golden brown."
        }
      ],
