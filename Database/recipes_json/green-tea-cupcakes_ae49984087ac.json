  "recipes": [
    {
      "name": "Green Tea Cupcakes",
      "ingredients_raw": [
        "0.5 cup unsalted butter, softened",
        "1.25 cups white sugar",
        "2 eggs",
        "0.5 cup milk",
        "0.5 teaspoon vanilla extract",
        "2.5 cups all-purpose flour",
        "2 tablespoons green tea powder (matcha)"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Line 12 muffin cups with paper liners."
        },
        {
          "id": 3,
          "text": "Cream unsalted butter in a mixing bowl with an electric mixer on medium speed until soft and creamy. Gradually beat in sugar, about 1/3 cup at a time, beating until the mixture is fluffy."
        },
        {
          "id": 4,
          "text": "Beat in eggs, beating well after each egg; mix in flour and green tea powder until thoroughly combined."
        },
        {
          "id": 5,
          "text": "Spoon batter into the prepared muffin cups, filling them about 3/4 full."
        },
        {
          "id": 6,
          "text": "Bake in the preheated oven until a toothpick inserted into the center of a cupcake comes out with moist crumbs or clean, 20 to 25 minutes."
        },
        {
          "id": 7,
          "text": "Allow cupcakes to cool in muffin tins for 15 minutes before removing to finish cooling."
        }
      ],
