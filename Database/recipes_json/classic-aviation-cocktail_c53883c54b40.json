      "name": "Classic Aviation Cocktail",
      "ingredients_raw": [
        "ice cubes",
        "2 fluid ounces gin",
        "0.5 fluid ounce maraschino liqueur",
        "0.5 fluid ounce fresh lemon juice",
        "1 maraschino cherry"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Chill a cocktail martini glass in the freezer. Add ice to a shaker. Pour in gin, cherry liqueur, and lemon juice. Shake well for 1 minute (not kidding), then strain into the chilled glass. Garnish with a maraschino cherry."
        }
      ],
