  "recipes": [
    {
      "name": "Baby Carrot Bars",
      "ingredients_raw": [
        "1 cup white sugar",
        "0.75 teaspoon ground cinnamon",
        "0.75 cup vegetable oil",
        "1 teaspoon baking soda",
        "2 eggs",
        "0.5 teaspoon salt",
        "1 teaspoon vanilla extract",
        "1 cup all-purpose flour",
        "7.5 ounces junior baby food carrots",
        "0.5 cup fresh carrots, ground",
        "0.25 cup raisins",
        "0.25 cup chopped walnuts",
        "1 (12 ounce) container softened cream cheese",
        "0.25 cup butter, softened",
        "2 cups confectioners' sugar",
        "2 teaspoons vanilla extract"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Mix together the sugar, cinnamon, eggs, vanilla and oil in a large bowl. Add in the baking soda, salt and flour. Stir in the jar of baby carrots, raw carrots, raisins and walnuts. Mix well."
        },
        {
          "id": 2,
          "text": "Bake in a greased and floured 13x9 inch pan at 350 degrees F (175 degrees C) for 20 minutes. Check after 20 minutes by inserting clean knife into center. Knife should come out clean. Cool thoroughly before cutting."
        },
        {
          "id": 3,
          "text": "To Make Frosting: Cream together the cream cheese, 1/4 cup butter, confectioners&#39; sugar and vanilla. Frost cooled bars."
        }
      ],
