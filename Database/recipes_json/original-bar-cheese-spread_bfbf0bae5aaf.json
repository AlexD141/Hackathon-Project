      "name": "Original Bar Cheese Spread",
      "ingredients_raw": [
        "1 (15 ounce) jar pasteurized process cheese spread (such as Cheez Whiz®)",
        "0.33333334326744 cup prepared horseradish, or to taste",
        "1 teaspoon Worcestershire sauce",
        "0.5 teaspoon dry mustard",
        "0.25 teaspoon garlic powder, or more to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Mix cheese spread, horseradish, Worcestershire sauce, dry mustard, and garlic powder in a mixing bowl."
        },
        {
          "id": 2,
          "text": "Refrigerate 8 hours to overnight."
        }
