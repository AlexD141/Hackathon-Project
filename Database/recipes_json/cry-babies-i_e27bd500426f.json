  "recipes": [
    {
      "name": "Cry Babies I",
      "ingredients_raw": [
        "1 cup shortening",
        "2 eggs",
        "2 teaspoons baking soda",
        "1 cup brewed coffee",
        "1 cup molasses",
        "1 tablespoon distilled white vinegar",
        "0.5 cup unsweetened cocoa powder",
        "1 teaspoon ground cinnamon",
        "1 teaspoon ground ginger",
        "0.5 teaspoon ground nutmeg",
        "0.5 teaspoon ground cloves",
        "4.5 cups all-purpose flour",
        "2 cups confectioners' sugar",
        "0.25 cup unsweetened cocoa powder",
        "5 tablespoons water as needed",
        "2 cups white sugar"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Dissolve the baking soda in the coffee."
        },
        {
          "id": 3,
          "text": "Cream the shortening with the white sugar. Beat in the eggs, coffee mixture, molasses, vinegar, 1/2 cup of the cocoa powder, spices, and flour. Dough should be thick and slightly sticky. Drop rounded spoonfuls of dough onto a greased cookie sheet."
        },
        {
          "id": 4,
          "text": "Bake for 10 to 12 minutes. Let cookies cool, then glaze."
        },
        {
          "id": 5,
          "text": "To Make Glaze: Combine the confectioner&#39;s sugar, 1/4 cup cocoa, and enough water to achieve a desired spreading consistency. Beat until smooth."
        }
      ],
