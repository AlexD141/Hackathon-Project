  "recipes": [
    {
      "name": "Birds&#39; Nest Cookies",
      "ingredients_raw": [
        "1 cup butter, softened",
        "0.5 cup white sugar",
        "2 eggs",
        "2 cups all-purpose flour",
        "2 cups chopped pecans",
        "0.25 cup warm water",
        "0.75 cup shortening",
        "1 teaspoon vanilla extract",
        "0.25 cup butter, softened",
        "4 cups confectioners' sugar"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease cookie sheets."
        },
        {
          "id": 2,
          "text": "Beat 1 cup softened butter and  ½ cup sugar together in a large bowl with an electric mixer until smooth. Add egg yolks, and beat well. Add flour and mix until combined."
        },
        {
          "id": 3,
          "text": "Roll dough into walnut-size balls; roll balls in egg white, and then in the chopped nuts. Place cookies 2 inches apart onto prepared cookie sheets; press center of cookie with thumb."
        },
        {
          "id": 4,
          "text": "Bake cookies in the preheated oven for 8 minutes; press center of cookie again and continue to bake until lightly browned, 4 to 6 minutes. Cool cookies on racks."
        },
        {
          "id": 5,
          "text": "To make the frosting: Blend water, shortening, vanilla, and 1/4 cup softened butter together; slowly add confectioners&#39; sugar and mix until smooth and creamy. More water may be needed to make desired consistency."
        }
      ],
