  "recipes": [
    {
      "name": "Soup La Angelena",
      "ingredients_raw": [
        "12 cups water",
        "2 large potatoes, peeled and quartered",
        "1 (14.5 ounce) can whole peeled tomatoes, mashed",
        "0.25 cup pearl barley",
        "0.25 cup uncooked white rice",
        "2 tablespoons margarine",
        "0.25 teaspoon salt",
        "0.25 teaspoon ground black pepper",
        "1 large carrot, diced",
        "1 onion, chopped",
        "1 large stalk celery, with leaves, finely chopped",
        "0.5 cup fresh green beans, cut into 1/2 inch pieces",
        "1 large potato, peeled and diced",
        "0.5 cup frozen petite peas, thawed",
        "0.5 cup broccoli florets",
        "0.25 cup barley flakes"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a large stock pot, add water and 2 large potatoes, peeled and quartered. Bring to boil, then add mashed tomatoes. Cook for 10 minutes, add barley and rice and cook until potatoes are tender."
        },
        {
          "id": 2,
          "text": "Remove potatoes and mash together with margarine, set aside."
        },
        {
          "id": 3,
          "text": "Add salt, pepper, carrots and beans and cook for 10 minutes or until carrots are tender."
        },
        {
          "id": 4,
          "text": "Add onions, cubed potatoes, celery, peas and broccoli and cook for 5 minutes."
        },
        {
          "id": 5,
          "text": "Add the mashed potatoes and stir. Add barley flakes and cook for an additional 5 minutes and serve."
        }
      ],
