      "name": "Beau Monde Dip",
      "ingredients_raw": [
        "0.75 cup sour cream",
        "0.75 cup mayonnaise",
        "1 tablespoon minced onion",
        "1 teaspoon Beau Monde ™ seasoning",
        "1 teaspoon dried dill weed",
        "1 teaspoon dried parsley"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a small mixing bowl, combine sour cream, mayonnaise, onion, Beau Monde seasoning, dill, and dried parsley. Chill before serving."
        }
      ],
