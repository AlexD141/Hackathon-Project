  "recipes": [
    {
      "name": "Pumpkin Pie I",
      "ingredients_raw": [
        "3 eggs",
        "0.75 cup white sugar",
        "1 teaspoon ground cinnamon",
        "0.5 teaspoon ground nutmeg",
        "0.25 teaspoon ground cloves",
        "1 (14 ounce) can sweetened condensed milk",
        "0.66666668653488 cup half-and-half",
        "1 (29 ounce) can pumpkin puree",
        "1 recipe pastry for a 9 inch single crust pie"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Brown the pie crusts ahead of time, and cool."
        },
        {
          "id": 2,
          "text": "Mix together eggs, sugar, spices, sweetened condensed milk, half and half, and pumpkin; mix until lumps are gone. Do not overbeat."
        },
        {
          "id": 3,
          "text": "Bake pies at 400 degrees F (205 degrees C) for 45 minutes. Let cool, and serve. Store leftovers in refrigerator."
        }
      ],
