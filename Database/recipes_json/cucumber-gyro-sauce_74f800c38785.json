      "name": "Cucumber Gyro Sauce",
      "ingredients_raw": [
        "1 cup sour cream",
        "0.66666668653488 cup peeled and grated cucumber",
        "0.5 teaspoon minced garlic",
        "0.5 teaspoon chopped fresh dill",
        "0.25 teaspoon prepared mustard",
        "0.25 teaspoon garlic powder"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Stir sour cream, cucumber, garlic, dill, mustard, and garlic powder together in a bowl until well combined. Cover and chill for at least 1 hour before serving, or overnight for best results."
        }
      ],
