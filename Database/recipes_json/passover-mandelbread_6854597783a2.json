  "recipes": [
    {
      "name": "Passover Mandelbread",
      "ingredients_raw": [
        "1.5 cups matzo cake meal",
        "1 cup white sugar",
        "0.75 cup potato starch",
        "3 eggs",
        "0.25 cup chocolate chips, or to taste",
        "0.25 cup chopped walnuts, or to taste",
        "2 tablespoons lemon juice",
        "2 teaspoons cinnamon sugar, or to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a baking sheet."
        },
        {
          "id": 2,
          "text": "Stir matzo cake meal, sugar, potato starch, eggs, chocolate chips, walnuts, and lemon juice together to make a dough."
        },
        {
          "id": 3,
          "text": "Divide the dough into thirds. Shape each piece of dough into a log and place on the prepared baking sheet."
        },
        {
          "id": 4,
          "text": "Bake in the preheated oven until browned, about 30 minutes."
        },
        {
          "id": 5,
          "text": "Remove logs from oven and cut into slices."
        },
        {
          "id": 6,
          "text": "Arrange the slices on the baking sheet; sprinkle with cinnamon sugar."
        },
        {
          "id": 7,
          "text": "Return to oven and bake until the mandelbread are browned and crisp, about 10 more minutes. Turn the mandelbread after 5 minutes to crisp both sides."
        }
      ],
