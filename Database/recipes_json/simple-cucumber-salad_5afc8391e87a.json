      "name": "Simple Cucumber Salad",
      "ingredients_raw": [
        "1 large cucumber",
        "1 small onion, chopped",
        "1 (8 ounce) container sour cream",
        "1 teaspoon white sugar",
        "0.5 teaspoon distilled white vinegar",
        "0.25 teaspoon ground black pepper"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Toss cucumber, onion, sour cream, sugar, vinegar, and black pepper together in a bowl."
        },
        {
          "id": 2,
          "text": "Chill completely in refrigerator to serve."
        }
