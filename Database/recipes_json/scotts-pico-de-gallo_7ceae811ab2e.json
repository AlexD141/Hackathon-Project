  "recipes": [
    {
      "name": "Scott&#39;s Pico de Gallo",
      "ingredients_raw": [
        "3 large tomatoes, diced",
        "1 white onion, diced",
        "1 bunch cilantro, chopped",
        "6 limes, juiced",
        "1 tablespoon salt, or to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Toss tomatoes, white onion, and cilantro together in a large bowl. Pour lime juice over tomato mixture; mix to coat. Season with salt. Chill completely before serving."
        }
      ],
