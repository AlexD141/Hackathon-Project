    {
      "name": "Pumpkin Syrup",
      "ingredients_raw": [
        "0.25 cup maple syrup",
        "0.25 cup reduced-calorie cranberry juice",
        "2 tablespoons milk",
        "0.25 teaspoon ground cinnamon",
        "0.25 teaspoon ground allspice",
        "0.5 cup canned pumpkin",
        "0.5 cup confectioners' sugar"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Stir the maple syrup, cranberry juice, milk, cinnamon, and allspice together in a bowl until smooth. Add the pumpkin and confectioners&#39; sugar; stir again until no lumps of confectioners&#39; sugar remain."
        }
      ],
