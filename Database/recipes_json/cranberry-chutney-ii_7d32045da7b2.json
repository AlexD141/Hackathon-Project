  "recipes": [
    {
      "name": "Cranberry Chutney II",
      "ingredients_raw": [
        "2 cups cranberries",
        "2 tomatoes - blanched, peeled and chopped",
        "0.33333298563957 cup golden raisins",
        "0.25 cup chopped onion",
        "1 teaspoon salt",
        "1 cup packed brown sugar",
        "0.5 cup cider vinegar",
        "0.5 teaspoon ground ginger",
        "0.5 teaspoon ground cloves",
        "0.5 teaspoon ground black pepper",
        "0.75 cup water"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a 3-quart saucepan, combine cranberries, tomatoes, water, raisins, onion, and salt. Bring mixture to a boil. Reduce heat to simmer. Cook, covered, for 15 minutes or until cranberries pop."
        },
        {
          "id": 2,
          "text": "Stir in brown sugar, vinegar, ginger, cloves, and pepper. Cover. Cook for 35 to 40 minutes, or until the consistency of relish, stirring occasionally. Ladle into jars or freezer containers. Refrigerate or freeze until ready to use."
        }
      ],
