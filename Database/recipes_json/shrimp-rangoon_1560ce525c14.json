  "recipes": [
    {
      "name": "Shrimp Rangoon",
      "ingredients_raw": [
        "0.5 cup vegetable oil for frying",
        "1 (8 ounce) package cream cheese, softened",
        "0.25 pound cooked shrimp, roughly chopped",
        "2 tablespoons minced white onion",
        "0.5 teaspoon garlic powder",
        "0.5 teaspoon ground black pepper",
        "12 (7 inch square) wonton wrappers"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Heat oil in a deep fryer or large saucepan to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Meanwhile, mix cream cheese, shrimp, onion, garlic powder, and pepper together in a bowl. Place a spoonful of cream cheese mixture onto each wonton. Dampen wonton edges with water; fold edges over the filling and press together to seal."
        },
        {
          "id": 3,
          "text": "Fry wontons in hot oil until golden brown, about 3 minutes."
        }
      ],
