  "recipes": [
    {
      "name": "Butter Tarts",
      "ingredients_raw": [
        "30 (2 inch) unbaked tart shells",
        "1.5 cups packed brown sugar",
        "0.5 cup butter",
        "2 eggs",
        "2 cups raisins",
        "1 cup chopped walnuts",
        "2 tablespoons heavy cream"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 325 degrees F (170 degrees C). Arrange tart shells on a baking sheet."
        },
        {
          "id": 2,
          "text": "Beat sugar, butter, and eggs together in a large bowl with an electric mixer until creamy."
        },
        {
          "id": 3,
          "text": "Stir in raisins, walnuts, and cream until thoroughly combined. Spoon batter into tart shells, no more than half full."
        },
        {
          "id": 4,
          "text": "Bake tarts in the preheated oven until pastry is golden and filling is set, 20 to 25 minutes. Allow tarts to cool on a wire rack."
        }
      ],
