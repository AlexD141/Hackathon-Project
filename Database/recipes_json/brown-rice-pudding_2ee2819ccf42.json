  "recipes": [
    {
      "name": "Brown Rice Pudding",
      "ingredients_raw": [
        "1.5 cups heavy cream",
        "1.25 cups water",
        "0.5 cup short-grain brown rice",
        "0.25 teaspoon salt",
        "0.5 cup raisins",
        "3 egg yolks",
        "0.25 cup white sugar",
        "0.5 teaspoon ground cinnamon",
        "1 tablespoon butter, softened",
        "2 teaspoons vanilla extract"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Bring the heavy cream, water, brown rice, and salt to a boil in a pot; reduce heat to low, cover, and simmer until the liquid is completely absorbed, about 80 minutes. Fold the raisins into the mixture and continue cooking until the raisins plump, about 10 minutes more."
        },
        {
          "id": 2,
          "text": "Whisk the egg yolks, sugar, and cinnamon together in a bowl; slowly pour into the pot with the rice while stirring. Cook and stir until the mixture thickens, about 6 minutes. Remove from heat and stir in the butter and vanilla extract."
        }
      ],
