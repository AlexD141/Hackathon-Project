  "recipes": [
    {
      "name": "Crunchy Fried Shrimp",
      "ingredients_raw": [
        "0.33333334326744 cup all-purpose flour",
        "0.75 teaspoon salt",
        "0.5 teaspoon ground black pepper",
        "3 large eggs",
        "1.5 cups Kikkoman Panko Bread Crumbs",
        "1 pound uncooked jumbo shrimp, peeled and deveined, tails left intact",
        "1 cup vegetable oil for frying, or as needed"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Mix flour, salt, and pepper in a medium bowl. Beat eggs in a second medium bowl until frothy. Place bread crumbs in a third bowl."
        },
        {
          "id": 3,
          "text": "Dredge shrimp in the flour mixture, then shake off excess."
        },
        {
          "id": 4,
          "text": "Dip shrimp into beaten eggs ensuring it’s all covered; lift shrimp and let excess egg drips down."
        },
        {
          "id": 5,
          "text": "Press shrimp into panko bread crumbs, turning to coat both sides. Transfer shrimp to a plate."
        },
        {
          "id": 6,
          "text": "Heat 2 inches oil in a large, heavy pot to 350 degrees F (175 degrees C). Deep-fry shrimp in batches in the hot oil until cooked through, about 1 minute. Use tongs or a large slotted spoon to transfer shrimp to a paper towel-lined plate to drain. Repeat to cook remaining shrimp, making sure oil is at the right temperature."
        },
        {
          "id": 7,
          "text": "Arrange shrimp on a platter to serve."
        }
      ],
