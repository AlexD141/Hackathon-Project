  "recipes": [
    {
      "name": "Rhubarb Dum Dum",
      "ingredients_raw": [
        "2 cups chopped rhubarb",
        "1 pinch ground cinnamon, or more to taste",
        "0.75 cup white sugar",
        "0.25 cup butter, softened",
        "0.5 cup milk",
        "2 eggs",
        "1 teaspoon vanilla extract",
        "1.25 cups all-purpose flour",
        "1 teaspoon baking powder"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a deep dish pie plate."
        },
        {
          "id": 2,
          "text": "Place rhubarb in the prepared pie dish; sprinkle with cinnamon. Set aside."
        },
        {
          "id": 3,
          "text": "Mash sugar and butter together in a large bowl until creamy and well blended. Beat in milk, eggs, and vanilla with an electric mixture until smooth. Combine flour and baking powder in a small bowl; gently stir into egg mixture until well combined. Spread batter over rhubarb in the pie dish."
        },
        {
          "id": 4,
          "text": "Bake in the preheated oven until crust is lightly browned and rhubarb is bubbling, about 45 minutes. Serve warm."
        }
      ],
