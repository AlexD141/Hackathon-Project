  "recipes": [
    {
      "name": "Pique (Puerto Rican Hot Sauce)",
      "ingredients_raw": [
        "2 tablespoons olive oil",
        "1 onion, roughly chopped, divided",
        "20 habanero peppers, halved",
        "5 aji dulce peppers, halved",
        "8 cloves garlic, chopped",
        "1 cup pineapple juice",
        "6 tablespoons lime juice",
        "0.25 cup tequila",
        "0.25 cup white vinegar",
        "8 sprigs cilantro, chopped",
        "2 sprigs culantro",
        "1 teaspoon white sugar",
        "1 teaspoon dried oregano",
        "0.5 teaspoon salt",
        "0.5 teaspoon ground black pepper",
        "0.5 teaspoon cacao powder",
        "0.5 teaspoon ground cumin"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Heat olive oil in a large saucepan over medium heat. Add 1/4 of the onion, habanero peppers, aji dulce, and garlic. Cook and stir until tender, about 3 minutes. Let cool for at least 5 minutes."
        },
        {
          "id": 2,
          "text": "Transfer cooled pepper mixture to a blender. Add pineapple juice, lime juice, tequila, vinegar, cilantro, culantro, sugar, oregano, salt, black pepper, cacao powder, and cumin. Blend until sauce is smooth."
        },
        {
          "id": 3,
          "text": "Pour sauce into a glass bottle with a lid; let stand for a least 1 week to allow flavors to blend."
        }
      ],
      "warnings": [],
