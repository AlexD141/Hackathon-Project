  "recipes": [
    {
      "name": "Chocolate Coconut Candy Bars",
      "ingredients_raw": [
        "2 cups graham cracker crumbs",
        "0.5 cup butter, melted",
        "0.25 cup white sugar",
        "2 cups flaked coconut",
        "1 (14 ounce) can sweetened condensed milk",
        "0.5 cup chopped pecans",
        "1 (8 ounce) chocolate candy bar, chopped",
        "3 tablespoons creamy peanut butter"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat an oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish."
        },
        {
          "id": 2,
          "text": "Mix the graham cracker crumbs, butter, and sugar in a bowl. Press the mixture into the prepared baking dish to form a crust. Combine the coconut, sweetened condensed milk, and pecans in another bowl until well mixed. Spread coconut mixture over the cracker crust."
        },
        {
          "id": 3,
          "text": "Bake in the preheated oven until set, about 15 minutes. Set aside to cool completely, about 1 hour."
        },
        {
          "id": 4,
          "text": "Melt the chocolate bar and peanut butter in a small saucepan over very low heat, cooking and stirring until smooth, about 2 minutes. Spread the chocolate mixture evenly over the cooled coconut bars. Cool until set, about 15 minutes. Cut into bars before serving."
        }
      ],
