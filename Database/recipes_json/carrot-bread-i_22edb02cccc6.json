  "recipes": [
    {
      "name": "Carrot Bread",
      "ingredients_raw": [
        "2.5 cups all-purpose flour",
        "1 cup white sugar",
        "1 teaspoon baking powder",
        "1 teaspoon baking soda",
        "1 teaspoon ground cinnamon",
        "0.5 teaspoon salt",
        "3 eggs, beaten",
        "0.5 cup vegetable oil",
        "0.5 cup milk",
        "2 cups shredded carrots",
        "1 (3.5 ounce) package flaked coconut",
        "0.5 cup maraschino cherries, chopped",
        "0.5 cup raisins",
        "0.5 cup chopped walnuts"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x5-inch loaf pan."
        },
        {
          "id": 2,
          "text": "Sift flour, sugar, baking powder, baking soda, cinnamon, and salt together in a large bowl."
        },
        {
          "id": 3,
          "text": "Combine eggs, oil, and milk in a separate bowl; stir into flour mixture until well blended."
        },
        {
          "id": 4,
          "text": "Stir in carrots, coconut, cherries, raisins, and walnuts."
        },
        {
          "id": 5,
          "text": "Pour batter into prepared loaf pan."
        },
        {
          "id": 6,
          "text": "Bake in the preheated oven until a toothpick inserted into center of the loaf comes out clean, about 50 to 60 minutes. Let cool on a wire rack for 10 minutes before removing from the pan to cool completely."
        }
      ],
