  "recipes": [
    {
      "name": "Patricia&#39;s Peanut Butter Pie",
      "ingredients_raw": [
        "1 cup peanut butter",
        "0.5 cup white sugar",
        "2 eggs, separated",
        "0.5 cup milk",
        "0.25 cup honey",
        "1 tablespoon vanilla extract",
        "1 cup crushed peanuts",
        "1 cup peanut butter chips",
        "1 (9 inch) prepared graham cracker crust"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Beat egg whites until white peaks form."
        },
        {
          "id": 2,
          "text": "In a second bowl, beat together egg yolks and sugar. Mix in peanut butter, vanilla, honey, and milk. Fold in the egg whites."
        },
        {
          "id": 3,
          "text": "Evenly distribute the peanut butter chips on the bottom of the graham cracker crust. Pour filling into the crust, and sprinkle the chopped peanuts on the top."
        },
        {
          "id": 4,
          "text": "Bake at 350 degree F (175 degrees C) for 30 to 35 minutes."
        }
      ],
      "warnings": [],
