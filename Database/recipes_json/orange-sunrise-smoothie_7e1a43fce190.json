      "name": "Orange Sunrise Smoothie",
      "ingredients_raw": [
        "0.5 cup orange juice",
        "1 banana, frozen and chunked",
        "1 peach, peeled and sliced",
        "0.5 cup honeydew melon, cubed",
        "1 (8 ounce) container orange yogurt",
        "1 teaspoon white sugar",
        "0.5 cup ice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine the orange juice, banana, peach, honeydew melon, yogurt, sugar, and ice in a blender. Blend until smooth, or chunky, as desired. Pour into two glasses and serve."
        }
      ],
