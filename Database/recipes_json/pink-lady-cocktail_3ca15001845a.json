  "recipes": [
    {
      "name": "Pink Lady Cocktail",
      "ingredients_raw": [
        "1 egg white",
        "1 teaspoon grenadine syrup",
        "1 teaspoon half-and-half cream",
        "1 (1.5 fluid ounce) jigger gin",
        "1 cup crushed ice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Pour the egg white, grenadine syrup, half-and-half, and gin into a cocktail shaker over ice. Cover, and shake like crazy until the outside of the shaker has frosted. Strain into a chilled glass to serve."
        }
      ],
