  "recipes": [
    {
      "name": "Mango Corn Salsa",
      "ingredients_raw": [
        "2 small tomatoes, chopped",
        "1 bunch cilantro, chopped",
        "3 serrano peppers",
        "0.25 cup coarsely chopped red onion",
        "3 tablespoons rice vinegar",
        "1 tablespoon olive oil",
        "1 mango - peeled, seeded and diced",
        "0.5 cup chopped green bell pepper",
        "0.5 cup fresh corn kernels",
        "0.5 teaspoon white sugar",
        "0.25 teaspoon ground cumin",
        "salt and ground black pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine 1 tomato, ½ bunch chopped cilantro, serranos (including seeds), and onion in the bowl of a food processor; pulse until smooth. Add rice wine vinegar and oil; pulse until smooth."
        },
        {
          "id": 2,
          "text": "Combine mango, remaining 1 tomato, remaining ½ bunch chopped cilantro, bell pepper, corn, sugar, and cumin in a medium bowl; stir in serrano mixture; season with salt and black pepper. Chill before serving for 1 hour."
        }
      ],
