    {
      "name": "Iced Latte",
      "ingredients_raw": [
        "1 cup boiling water",
        "4 teaspoons instant espresso granules",
        "0.33333331346512 cup SPLENDA® No Calorie Sweetener, Granulated",
        "2 cups fat free half-and-half",
        "2 cups 2% reduced-fat milk"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Pour boiling water over instant espresso granules stirring until granules dissolve. Add SPLENDA® Granulated Sweetener and remaining ingredients, stirring well."
        },
        {
          "id": 2,
          "text": "Chill 4 hours or overnight. Serve over ice."
        }
      ],
