  "recipes": [
    {
      "name": "Sylvia&#39;s Easy Greek Salad",
      "ingredients_raw": [
        "0.75 cup red bell pepper, chopped",
        "0.75 cup chopped green bell pepper",
        "1 cup cucumber - peeled, seeded and chopped",
        "1 tomato, chopped",
        "0.5 cup diced red onion",
        "4 large black olives, quartered",
        "0.5 cup crumbled feta cheese",
        "0.5 cup vegetable oil",
        "2 teaspoons white wine vinegar",
        "salt to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a large bowl, combine the red bell pepper, green bell pepper, cucumber, tomato, red onion, and olives."
        },
        {
          "id": 2,
          "text": "Whisk together the oil and vinegar. Before serving add the oil and vinegar, feta cheese and salt. Toss together and serve."
        }
      ],
