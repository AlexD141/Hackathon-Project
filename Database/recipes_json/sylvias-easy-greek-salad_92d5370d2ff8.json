            "author": {
              "@type": "Person",
              "name": "Helen"
            },
            "reviewBody": "I used 1/4 c of olive oil &amp; 2tsp of red wine vinegar &amp;1 tsp of balsamic vinegar and salt to taste.",
            "datePublished": "2024-11-30T01:23:35.718Z"
