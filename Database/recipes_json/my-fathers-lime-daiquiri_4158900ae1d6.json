  "recipes": [
    {
      "name": "My Father&#39;s Lime Daiquiri",
      "ingredients_raw": [
        "3 limes, juiced",
        "0.5 cup white sugar",
        "10 fluid ounces white rum",
        "4 maraschino cherries",
        "6 cups ice cubes"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a blender combine lime juice, sugar and rum. Blend and add ice one cube at a time until mixture is thick and smooth. Pour into 4 glasses and garnish with maraschino cherries."
        }
      ],
