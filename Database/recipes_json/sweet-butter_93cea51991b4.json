  "recipes": [
    {
      "name": "Sweet Butter",
      "ingredients_raw": [
        "0.5 cup softened butter",
        "0.25 cup brown sugar",
        "2 tablespoons honey",
        "1 pinch ground cinnamon",
        "1 pinch ground nutmeg",
        "0.5 pinch ground ginger"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place the butter into a bowl, and stir together with brown sugar, honey, cinnamon, nutmeg, and ginger until the mixture is completely blended."
        }
      ],
