  "recipes": [
    {
      "name": "Semi-Homemade Stuffing",
      "ingredients_raw": [
        "1 teaspoon butter, or as needed",
        "2 tablespoons olive oil",
        "0.25 cup diced yellow onion",
        "0.25 cup chopped celery",
        "0.25 cup chopped scallions",
        "1 medium pear, cored and diced",
        "0.25 teaspoon minced garlic",
        "2 (6 ounce) boxes dry bread stuffing mix",
        "0.25 cup chopped fresh parsley",
        "1 (32 ounce) container chicken broth"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Butter a 9x13-inch baking dish."
        },
        {
          "id": 2,
          "text": "Heat olive oil in a skillet over medium heat. Add onion, celery, scallions, pear, and garlic; cook and stir until vegetables are tender, about 10 minutes."
        },
        {
          "id": 3,
          "text": "Place stuffing mix into a large mixing bowl. Stir in cooked vegetables and parsley. Add chicken broth, 1 cup a time, and stir until broth has been absorbed by the stuffing mix and stuffing is desired consistency."
        },
        {
          "id": 4,
          "text": "Spoon stuffing into the prepared pan."
        },
        {
          "id": 5,
          "text": "Bake in the preheated oven until golden brown on top, about 30 minutes."
        },
        {
          "id": 6,
          "text": "Serve and enjoy!"
        }
      ],
