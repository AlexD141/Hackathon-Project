  "recipes": [
    {
      "name": "Laura Shirk&#39;s Shortbread",
      "ingredients_raw": [
        "1 cup butter",
        "0.5 cup white sugar",
        "2.3333332538605 cups all-purpose flour",
        "0.25 teaspoon salt"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 300 degrees F (150 degrees C)."
        },
        {
          "id": 2,
          "text": "Cream butter and sugar together. Add flour and salt, stir until blended. Roll out 1/2 inch thick on floured board and cut into shapes with small (2 inch) cutters."
        },
        {
          "id": 3,
          "text": "Bake for 50 minutes. Sprinkle with sugar."
        }
      ],
