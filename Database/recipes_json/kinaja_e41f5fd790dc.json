  "recipes": [
    {
      "name": "Kinaja",
      "ingredients_raw": [
        "1 cup orange juice",
        "2 kiwis, peeled and sliced",
        "3 ripe bananas, sliced",
        "3 pineapple rings",
        "0.5 cup unsweetened pineapple juice",
        "2 cups crushed ice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In an electric blender, mix together orange juice, kiwi, bananas, pineapple, and pineapple juice until well blended. Pour the mixture into a pitcher."
        },
        {
          "id": 2,
          "text": "Place the ice in the blender, then pour the fruit mixture over the ice. Process until the ice is blended in with the fruit juices."
        }
      ],
