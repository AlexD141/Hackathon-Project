  "recipes": [
    {
      "name": "Curried Cottage Fries",
      "ingredients_raw": [
        "6 potatoes, cut into wedges",
        "2 tablespoons vegetable oil",
        "2 tablespoons shredded Parmesan cheese",
        "2 teaspoons curry powder",
        "1 teaspoon paprika",
        "1 teaspoon salt",
        "0.5 teaspoon garlic powder"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 400 degrees F (200 degrees C). Grease a baking sheet."
        },
        {
          "id": 2,
          "text": "Place potatoes, vegetable oil, Parmesan cheese, curry powder, paprika, salt, and garlic powder in a resealable plastic bag; shake to coat. Spread seasoned potatoes over prepared baking sheet."
        },
        {
          "id": 3,
          "text": "Bake in preheated oven until tender, about 20 minutes."
        }
      ],
