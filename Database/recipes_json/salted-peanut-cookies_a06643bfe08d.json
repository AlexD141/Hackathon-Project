  "recipes": [
    {
      "name": "Salted Peanut Cookies",
      "ingredients_raw": [
        "1.5 cups packed brown sugar",
        "1 cup shortening",
        "2 eggs",
        "2 teaspoons vanilla extract",
        "3 cups all-purpose flour",
        "1 teaspoon salt",
        "0.5 teaspoon baking soda",
        "2 cups salted peanuts"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease baking sheets."
        },
        {
          "id": 2,
          "text": "Beat brown sugar, shortening, eggs, and vanilla extract in a large bowl until light and fluffy, 3 to 4 minutes. Sift flour into a separate bowl; whisk in salt and baking soda. Stir flour mixture into brown sugar mixture; stir in peanuts."
        },
        {
          "id": 3,
          "text": "Drop dough by rounded teaspoons 2 inches apart onto the prepared baking sheets. Flatten dough with the bottom of a greased glass dipped in sugar."
        },
        {
          "id": 4,
          "text": "Bake in the preheated oven until golden brown, 8 to 10 minutes."
        }
      ],
