  "recipes": [
    {
      "name": "Mom&#39;s Goulash",
      "ingredients_raw": [
        "2 pounds beef stew meat, diced into 1 inch pieces",
        "salt and pepper to taste",
        "0.25 teaspoon paprika",
        "1 onion, chopped",
        "1 tablespoon vegetable oil",
        "8 large potatoes, scrubbed and chopped",
        "1 (16 ounce) can chili without beans"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Season beef with salt, pepper, and paprika."
        },
        {
          "id": 2,
          "text": "Brown seasoned beef and onion in oil until all sides are brown. Cover with water and simmer for 3 to 4 hours or until tender. Add water whenever level goes below the ingredients."
        },
        {
          "id": 3,
          "text": "An hour before serving, add potatoes and chili."
        }
      ],
