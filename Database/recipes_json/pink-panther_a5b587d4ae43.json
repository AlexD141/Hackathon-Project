  "recipes": [
    {
      "name": "Pink Panther",
      "ingredients_raw": [
        "1 cup crushed ice",
        "1 fluid ounce amaretto liqueur",
        "1 fluid ounce vodka",
        "8 fluid ounces pineapple juice",
        "1 teaspoon grenadine syrup",
        "1 slice fresh pineapple",
        "1 maraschino cherry"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a blender combine ice, amaretto, vodka, pineapple juice and grenadine. Blend well and pour into a tall chilled glass. garnish with an umbrella, pineapple slice and cherry."
        }
      ],
