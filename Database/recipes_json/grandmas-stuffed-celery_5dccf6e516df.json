  "recipes": [
    {
      "name": "Grandma&#39;s Stuffed Celery",
      "ingredients_raw": [
        "1 bunch celery - large stalks washed, trimmed, and cut into 3 sections",
        "2 (8 ounce) packages cream cheese at room temperature",
        "0.75 cup chopped pimento-stuffed green olives",
        "2 cloves garlic, finely minced",
        "1 pinch salt and freshly cracked black pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather the ingredients."
        },
        {
          "id": 2,
          "text": "Thoroughly dry each piece of celery with paper towels. Mix the cream cheese, olives, garlic, salt, and black pepper in a bowl."
        },
        {
          "id": 3,
          "text": "Using a knife, spread a generous amount of cream cheese filling down the center indentation of each celery piece."
        },
        {
          "id": 4,
          "text": "Serve immediately or refrigerate."
        }
      ],
