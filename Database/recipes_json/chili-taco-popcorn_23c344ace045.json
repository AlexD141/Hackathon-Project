    {
      "name": "Chili Taco Popcorn",
      "ingredients_raw": [
        "0.5 cup butter, melted",
        "0.5 (1 ounce) package taco seasoning mix",
        "1 dash hot pepper sauce (such as Tabasco®)",
        "0.5 teaspoon chili powder",
        "1 teaspoon seasoned salt",
        "5 cups popped popcorn"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Mix butter, taco seasoning, hot pepper sauce, chili powder, and seasoned salt in a large bowl. Stir in popcorn and mix well. Serve immediately."
        }
      ],
