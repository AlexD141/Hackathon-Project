  "recipes": [
    {
      "name": "Margarita Dip",
      "ingredients_raw": [
        "1 (8 ounce) package cream cheese, softened",
        "0.33333334326744 cup frozen margarita mix, thawed",
        "0.25 cup confectioners' sugar",
        "2 tablespoons orange juice",
        "0.25 cup whipped cream"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Beat cream cheese, margarita mix, confectioners&#39; sugar, and orange juice together in a large bowl with an electric mixer until smooth; fold in whipped cream until incorporated."
        },
        {
          "id": 2,
          "text": "Cover the bowl; chill in the refrigerator for 1 hour to blend flavors."
        }
      ],
