  "recipes": [
    {
      "name": "Garlic and Ham Spaghetti",
      "ingredients_raw": [
        "8 ounces spaghetti",
        "5 tablespoons butter",
        "3 cloves garlic, chopped",
        "1 onion, chopped",
        "16 ounces fresh mushrooms, sliced",
        "1 (16 ounce) package frozen chopped broccoli",
        "1 (6 ounce) can black olives, drained",
        "12 slices ham, chopped"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Bring a large pot of lightly salted water to a boil. Add spaghetti and cook for 8 to 10 minutes or until al dente; drain and set aside."
        },
        {
          "id": 2,
          "text": "In a large skillet over medium heat, melt butter and add garlic, onion, mushrooms, broccoli, olives, and ham. Saute mixture until onions are translucent."
        },
        {
          "id": 3,
          "text": "In a large bowl toss cooked spaghetti with vegetable mixture."
        }
      ],
