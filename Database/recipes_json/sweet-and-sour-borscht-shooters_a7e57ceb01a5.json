  "recipes": [
    {
      "name": "Sweet and Sour Borscht Shooters",
      "ingredients_raw": [
        "2 (15 ounce) cans whole baby beets",
        "0.75 cup vegetable broth, or more if needed",
        "0.5 cup sour cream",
        "0.33333334326744 cup fresh lemon juice",
        "0.33333334326744 cup white sugar",
        "salt to taste",
        "5 tablespoons sour cream, or as desired"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place beets and their juices, 3/4 cup vegetable broth, 1/2 cup sour cream, lemon juice, and sugar into a blender. Blend until smooth; thin with more vegetable broth, if desired. Taste and season with salt as needed."
        },
        {
          "id": 2,
          "text": "Transfer borscht to a bowl. Cover and chill at least 3 hours or overnight."
        },
        {
          "id": 3,
          "text": "Whisk borscht; spoon 3 to 4 teaspoons into each shooter. Top each shooter with about 1/2 teaspoon of sour cream."
        }
      ],
