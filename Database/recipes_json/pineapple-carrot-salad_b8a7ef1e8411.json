  "recipes": [
    {
      "name": "Pineapple Carrot Salad",
      "ingredients_raw": [
        "0.5 cup raisins",
        "2 cups pineapple tidbits, drained",
        "1 pound carrots, grated",
        "1 cup pineapple yogurt",
        "2 tablespoons white sugar",
        "0.125 teaspoon salt"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Soak raisins in hot water for 30 minutes. Drain and dry."
        },
        {
          "id": 2,
          "text": "In a mixing bowl, combine the raisins, pineapple and carrots."
        },
        {
          "id": 3,
          "text": "Mix together the yogurt, sugar and salt. Add to carrot mixture; mix well, cover and refrigerate."
        }
      ],
