  "recipes": [
    {
      "name": "Nancy&#39;s Boiled Gazpacho",
      "ingredients_raw": [
        "3 cups tomato juice",
        "2 beef bouillon cubes",
        "1 large tomato, chopped",
        "0.5 cup chopped cucumber",
        "6 tablespoons chopped onion",
        "0.25 cup chopped green bell pepper",
        "0.25 cup red wine vinegar",
        "2 tablespoons vegetable oil",
        "1 tablespoon chopped celery",
        "1.5 teaspoons Worcestershire sauce",
        "1 dash hot pepper sauce (such as Tabasco®)"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Simmer tomato juice in a medium saucepan over medium-high heat; stir in bouillon cubes until dissolved, about 5 minutes. Off heat, add tomato, cucumber, onion, bell pepper, vinegar, oil, celery, Worcestershire sauce, and hot sauce. Cover soup; chill in the refrigerator before serving, 6 to 8 hours."
        }
      ],
