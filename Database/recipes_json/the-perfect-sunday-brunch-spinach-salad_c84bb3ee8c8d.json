  "recipes": [
    {
      "name": "Brunch Spinach Salad",
      "ingredients_raw": [
        "2 (10 ounce) bags baby spinach",
        "2 bananas, sliced",
        "12 fresh strawberries, sliced",
        "1 (10 ounce) can mandarin oranges, drained",
        "0.5 cup dried cranberries",
        "0.5 cup pine nuts",
        "1 cup poppy seed salad dressing"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather the ingredients."
        },
        {
          "id": 2,
          "text": "Place spinach in a large bowl. Arrange bananas, strawberries, mandarin oranges, cranberries, and pine nuts on top."
        },
        {
          "id": 3,
          "text": "Toss with poppy seed dressing before serving."
        }
      ],
