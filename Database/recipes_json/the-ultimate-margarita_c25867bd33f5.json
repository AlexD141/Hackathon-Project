  "recipes": [
    {
      "name": "The Ultimate Margarita",
      "ingredients_raw": [
        "0.5 fluid ounce Gran Gala Triple Orange Liqueur",
        "2 fluid ounces Corazon Blanco Tequila",
        "1 fluid ounce fresh lime juice",
        "1 fluid ounce agave nectar or simple syrup"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Shake together all ingredients with ice and strain into a margarita glass."
        },
        {
          "id": 2,
          "text": "Optional: rub the cut side of a lime on the glass rim and dip it into salt; and add a lime wedge to the rim of the glass as a garnish."
        }
      ],
