      "name": "Crab &#39;n Shrimp Dip",
      "ingredients_raw": [
        "1 (8 ounce) package cream cheese, softened",
        "1 tablespoon mayonnaise",
        "1 (6 ounce) can crab meat, drained",
        "1 (4.5 ounce) can small shrimp, drained",
        "1 green onion, chopped"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Mix cream cheese and mayonnaise together in a bowl until well combined. Stir in crab, shrimp, and green onion. Cover and chill, 8 hours to overnight."
        }
      ],
