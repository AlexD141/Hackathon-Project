      "name": "Cubacrany",
      "ingredients_raw": [
        "4 fluid ounces Puerto Rican white rum",
        "0.5 lemon, juiced",
        "6 fluid ounces cranberry juice",
        "4 cubes ice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place 4 ice cubes in each 6-ounce glass. Pour 2 ounces of Puerto Rican white rum in each glass. Squeeze the juice of 1/4 of lemon in each glass. Pour in 3 ounces of cranberry juice. Stir."
        }
