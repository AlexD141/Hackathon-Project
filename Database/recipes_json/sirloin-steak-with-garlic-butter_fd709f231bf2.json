  "recipes": [
    {
      "name": "Sirloin Steak with Garlic Butter",
      "ingredients_raw": [
        "0.5 cup butter",
        "4 cloves garlic, minced",
        "2 teaspoons garlic powder",
        "4 pounds beef top sirloin steaks",
        "salt and pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients. Preheat an outdoor grill for high heat and lightly oil the grate."
        },
        {
          "id": 2,
          "text": "Melt butter in a small saucepan over medium-low heat."
        },
        {
          "id": 3,
          "text": "Stir in minced garlic and garlic powder. Set aside."
        },
        {
          "id": 4,
          "text": "Season steaks on both sides with salt and pepper."
        },
        {
          "id": 5,
          "text": "Place steaks on the preheated grill and cook for 4 to 5 minutes per side. An instant-read thermometer inserted into the center of a steak should read 140 degrees F (60 degrees C) for medium doneness."
        },
        {
          "id": 6,
          "text": "Transfer steaks to warmed plates; brush the tops liberally with garlic butter and allow to rest for 2 to 3 minutes before serving."
        }
      ],
