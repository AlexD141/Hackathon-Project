  "recipes": [
    {
      "name": "Italian Rice Pie ",
      "ingredients_raw": [
        "butter for greasing",
        "9 eggs",
        "1.5 cups white sugar",
        "2 pounds ricotta cheese",
        "1 teaspoon vanilla extract",
        "2 cups heavy whipping cream",
        "1 cup cooked white rice",
        "1 (15 ounce) can crushed pineapple, drained"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients. Preheat the oven to 325 degrees F (165 degrees C). Butter a 9x13-inch baking dish; set aside."
        },
        {
          "id": 2,
          "text": "Beat eggs in very large bowl. Add sugar, mixing well. Stir in ricotta cheese and vanilla until smooth and creamy; stir in heavy cream."
        },
        {
          "id": 3,
          "text": "Fold in cooked rice and crushed pineapple; pour into prepared dish."
        },
        {
          "id": 4,
          "text": "Bake in the preheated oven until top is golden brown and a knife inserted into the center comes out clean, at least 1 hour. Refrigerate until thoroughly cooled."
        }
      ],
