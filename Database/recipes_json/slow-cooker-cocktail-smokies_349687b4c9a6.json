  "recipes": [
    {
      "name": "Slow Cooker Cocktail Smokies",
      "ingredients_raw": [
        "1 (12 ounce) bottle barbeque sauce",
        "1 (8 ounce) jar grape jelly",
        "2 (14 ounce) packages miniature smoked sausage links"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Stir barbecue sauce and grape jelly together in a 4-quart slow cooker until well combined."
        },
        {
          "id": 2,
          "text": "Add sausages and stir to coat. Cover and cook on High, stirring once halfway through, until the sausages are hot and the sauce is thick and glossy, 2 to 3 hours."
        },
        {
          "id": 3,
          "text": "Switch the slow cooker to Warm and set out toothpicks and small plates so guests can serve themselves."
        }
      ],
      "warnings": [],
