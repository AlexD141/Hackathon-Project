  "recipes": [
    {
      "name": "Irmik Helvasi (Turkish Semolina Halva)",
      "ingredients_raw": [
        "5 cups water",
        "3 cups white sugar",
        "2 cups butter",
        "2.5 cups semolina flour",
        "0.5 cup pine nuts"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine water and sugar in a saucepan. Bring syrup to a boil."
        },
        {
          "id": 2,
          "text": "Melt butter in a separate saucepan over medium-low heat, about 5 minutes. Add semolina and pine nuts. Cook, stirring continuously, until golden brown, 20 to 30 minutes."
        },
        {
          "id": 3,
          "text": "Pour syrup carefully over the semolina mixture. Reduce heat to low. Cover and simmer until nicely thickened, about 5 minutes. Let rest for 15 minutes. Divide halva over several small dishes."
        }
      ],
