  "recipes": [
    {
      "name": "Nicole&#39;s Balsamic Beet and Fresh Spinach Salad",
      "ingredients_raw": [
        "0.25 cup aged balsamic vinegar",
        "0.25 cup white wine vinegar",
        "1 tablespoon Chardonnay wine",
        "2 tablespoons white sugar",
        "1 (15 ounce) can sliced beets, drained and cut into 1/4 inch slivers",
        "0.25 cup thinly sliced red onions",
        "4 cups chopped fresh spinach"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Whisk together the balsamic vinegar, white wine vinegar, Chardonnay, and sugar in a small bowl. Place the beets and onions in a small, sealable container. Pour the vinegar mixture over the beets and onions to completely cover. Seal top; marinate in refrigerator for 4 to 5 hours."
        },
        {
          "id": 2,
          "text": "When ready to serve, divide spinach leaves between four salad plates. Top with beet mixture, and drizzle salads with a bit of the marinating liquid."
        }
      ],
