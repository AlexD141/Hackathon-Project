  "recipes": [
    {
      "name": "Passover Mushroom Dressing",
      "ingredients_raw": [
        "2 cups matzo meal",
        "1 tablespoon sugar",
        "1 teaspoon salt",
        "1 teaspoon ground black pepper, or to taste",
        "0.25 teaspoon poultry seasoning",
        "3 1/2 cups chicken broth",
        "10 tablespoons canola oil",
        "2 tablespoons canola oil",
        "2 tablespoons butter or margarine",
        "3 cups onion, chopped",
        "2 bunches green onions, chopped",
        "1 (8 ounce) package sliced fresh mushrooms",
        "0.5 cup chopped celery",
        "4 extra large eggs"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 375 degrees F (190 degrees C)."
        },
        {
          "id": 2,
          "text": "Combine matzo meal, sugar, salt, black pepper, and poultry seasoning in a large bowl; set aside."
        },
        {
          "id": 3,
          "text": "Boil 2 cups broth and 1/2 cup canola oil in a large saucepan; stir in matzo meal mixture. Set aside to cool."
        },
        {
          "id": 4,
          "text": "Meanwhile, heat 2 tablespoons canola oil and butter in a large cast-iron skillet over medium heat. Add onions and green onions; cook until onions soften and become translucent, about 7 minutes. Stir in mushrooms and celery; cook until celery begins to soften, about 10 minutes."
        },
        {
          "id": 5,
          "text": "Whisk remaining 1 1/2 cups chicken broth and eggs together in a bowl; stir into matzo meal mixture. Fold in cooked vegetables; return mixture to the cast-iron skillet."
        },
        {
          "id": 6,
          "text": "Bake in the preheated oven until brown, about 50 minutes, stirring once to ensure even cooking."
        }
      ],
