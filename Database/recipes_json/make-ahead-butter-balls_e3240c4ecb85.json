  "recipes": [
    {
      "name": "Make Ahead Butter Balls",
      "ingredients_raw": [
        "2 cups Make Ahead Cookie Mix",
        "1 cup brown sugar",
        "0.5 cup white sugar",
        "2 tablespoons butter",
        "1 teaspoon vanilla extract",
        "0.5 cup chopped walnuts",
        "1 egg",
        "0.33333334326744 cup confectioners' sugar for decoration"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 375 degrees F (190 degrees C)."
        },
        {
          "id": 2,
          "text": "Combine Make Ahead Cookie Mix with sugar, butter, vanilla, egg and chopped nuts. Mix well."
        },
        {
          "id": 3,
          "text": "Shape dough into balls. Bake 11 to 16 minutes. Let cool. Roll in confectioners&#39; sugar."
        }
      ],
