  "recipes": [
    {
      "name": "Half-Red Half-Sweet Potato Salad",
      "ingredients_raw": [
        "3 pounds red potatoes",
        "2.5 pounds sweet potatoes",
        "0.25 cup white wine vinegar",
        "0.25 cup olive oil",
        "1 clove garlic, minced",
        "0.25 cup dill pickle relish",
        "0.5 cup chopped red onion",
        "0.33333334326744 cup mayonnaise",
        "1 pinch ground black pepper",
        "0.33333334326744 cup sour cream",
        "0.5 cup chopped parsley"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Bring a large pot of salted water to a boil. Add potatoes; cook until tender but still firm, about 15 minutes. Drain, cool and slice."
        },
        {
          "id": 2,
          "text": "In a large bowl, combine the vinegar, olive oil, garlic, dill pickle relish and onion. Mix and cover with sliced potatoes."
        },
        {
          "id": 3,
          "text": "Whisk together mayonnaise, pepper, sour cream and parsley. Pour over potatoes and chill at least 8 hours."
        }
      ],
