  "recipes": [
    {
      "name": "Superior Shores Slaw",
      "ingredients_raw": [
        "8 slices bacon",
        "1 cup mayonnaise",
        "0.25 cup red wine vinegar",
        "0.25 cup sugar",
        "1 teaspoon celery seed",
        "1 (16 ounce) bag coleslaw mix",
        "1 green onion, chopped"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Cook bacon in a large skillet over medium-high heat until crisp; drain, crumble, and set aside."
        },
        {
          "id": 2,
          "text": "Make the dressing by whisking together the mayonnaise, vinegar, sugar, and celery seed in a small bowl."
        },
        {
          "id": 3,
          "text": "Toss together the coleslaw mix and green onion in a large bowl; add the dressing and toss to coat; stir in the bacon. Serve immediately."
        }
      ],
