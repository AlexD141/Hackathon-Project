  "recipes": [
    {
      "name": "Peppermintini",
      "ingredients_raw": [
        "1 candy cane, finely crushed",
        "1 (1.5 fluid ounce) jigger vanilla vodka",
        "1 fluid ounce peppermint schnapps",
        "1 fluid ounce half-and-half cream",
        "1 small candy cane"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Wet the rim of a chilled martini glass with water, and dip into crushed candy cane. Pour vodka, schnapps, and half-and-half into a cocktail shaker over ice. Cover, and shake until the outside of the shaker has frosted. Strain into the rimmed martini glass, and garnish with candy cane to serve."
        }
      ],
