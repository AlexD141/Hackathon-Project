  "recipes": [
    {
      "name": "Original Ranch Spinach Dip",
      "ingredients_raw": [
        "1 (1 ounce) packet Hidden Valley® Original Ranch® Salad Dressing & Seasoning Mix",
        "1 (16 ounce) container sour cream",
        "1 (10 ounce) box frozen chopped spinach, thawed and well drained",
        "1 (8 ounce) can water chestnuts, rinsed, drained and chopped",
        "1 round loaf French bread",
        "Assorted, fresh vegetable sticks cut up for dipping"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Stir together dips mix, sour cream, spinach and water chestnuts. Chill 30 minutes or until just before serving."
        },
        {
          "id": 2,
          "text": "Cut top off the bread and remove center (using firm bread pieces as dippers). Fill bread bowl with dip. Serve with cubed bread and vegetables."
        }
      ],
