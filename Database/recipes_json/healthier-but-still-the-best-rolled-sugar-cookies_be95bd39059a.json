  "recipes": [
    {
      "name": "Healthier (but still) The Best Rolled Sugar Cookies",
      "ingredients_raw": [
        "1.5 cups butter, softened",
        "1 cup granular sucralose sweetener (such as Splenda®)",
        "0.33333334326744 cup white sugar",
        "4 eggs",
        "1 teaspoon vanilla extract",
        "5 cups all-purpose flour",
        "2 teaspoons baking powder"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Cream together butter, sweetener, and sugar in a large bowl, until smooth. Beat in eggs and vanilla extract. Stir in flour and baking powder. Cover and chill dough for at least one hour or overnight."
        },
        {
          "id": 2,
          "text": "Preheat oven to 400 degrees F (200 degrees C)."
        },
        {
          "id": 3,
          "text": "Roll out dough on floured surface 1/4- to 1/2-inch thick. Cut into shapes with any cookie cutter. Place cookies 1-inch apart on ungreased baking sheets."
        },
        {
          "id": 4,
          "text": "Bake in preheated oven until golden, about 6 to 8 minutes. Cool completely."
        }
      ],
