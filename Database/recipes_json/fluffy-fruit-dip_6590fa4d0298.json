  "recipes": [
    {
      "name": "Fluffy Fruit Dip",
      "ingredients_raw": [
        "1 (7 ounce) jar marshmallow creme",
        "1 (8 ounce) package cream cheese, softened",
        "1 orange, zested",
        "1 fluid ounce orange liqueur"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a large bowl, fold together the marshmallow creme and cream cheese."
        },
        {
          "id": 2,
          "text": "Stir in grated zest and liqueur or juice. Refrigerate until chilled."
        }
      ],
