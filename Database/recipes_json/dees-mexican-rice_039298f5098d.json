  "recipes": [
    {
      "name": "Dee&#39;s Mexican Rice",
      "ingredients_raw": [
        "1 tablespoon vegetable oil",
        "1 teaspoon ground turmeric",
        "1 teaspoon garlic powder",
        "0.5 teaspoon ground cumin",
        "0.5 teaspoon ground coriander seed",
        "2 teaspoons paprika",
        "1 pinch red pepper flakes",
        "1 pinch cayenne pepper",
        "3 green onions",
        "1 green bell pepper, chopped",
        "1 cup pre-cooked corn kernels",
        "2 small tomatoes, diced",
        "0.25 cup ketchup",
        "2 cups cooked rice",
        "salt to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Heat oil in a wok-style pan with turmeric, garlic powder, cumin, coriander, paprika, chili flakes, and cayenne pepper. Add the green onions and the green peppers; saute 1 to 2 minutes over medium-high heat."
        },
        {
          "id": 2,
          "text": "Add corn and tomatoes and saute until tomatoes release their juices. Add ketchup and stir until mixed."
        },
        {
          "id": 3,
          "text": "Add rice and stir until heated thoroughly. Salt to taste."
        }
      ],
