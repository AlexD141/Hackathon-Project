  "recipes": [
    {
      "name": "Creamy Fruit Dip",
      "ingredients_raw": [
        "1 (8 ounce) package cream cheese, softened",
        "1 (7 ounce) jar marshmallow creme",
        "3 drops vanilla extract"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a mixing bowl or food processor, combine the cream cheese and marshmallow creme . Blend until smooth. Add the vanilla. Continue blending until the mixture is thick and creamy."
        }
      ],
