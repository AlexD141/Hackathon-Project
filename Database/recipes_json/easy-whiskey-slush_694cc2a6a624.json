  "recipes": [
    {
      "name": "Easy Whiskey Slush",
      "ingredients_raw": [
        "1 (46 fluid ounce) can pineapple juice",
        "1 (750 milliliter) bottle whiskey",
        "1 (10 ounce) jar maraschino cherries with juice",
        "1 (2 liter) bottle lemon-lime soda"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Stir pineapple juice, whiskey, and maraschino cherries with their juice in a large freezer-safe container with a lid. Cover container tightly and freeze slush overnight."
        },
        {
          "id": 2,
          "text": "Scoop the whiskey slush into old-fashioned glasses, making sure each glass contains a cherry or two. Top with lemon-lime soda."
        }
      ],
