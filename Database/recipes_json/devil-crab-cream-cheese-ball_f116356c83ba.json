    {
      "name": "Devil Crab Cream Cheese Ball",
      "ingredients_raw": [
        "1 pound imitation crabmeat",
        "1 (8 ounce) package cream cheese, softened",
        "1 onion, chopped",
        "1 cup chopped celery",
        "1 tablespoon Worcestershire sauce"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Mix together imitation crab, cream cheese, onion, celery, and Worcestershire sauce. Form into a ball, place on a plate, and cover loosely with plastic wrap. Refrigerate until firm."
        }
      ],
