      "name": "Easy Avocado Spread",
      "ingredients_raw": [
        "2 ripe avocados - peeled, pitted, and mashed",
        "1 (1 ounce) package ranch dressing mix",
        "2 tablespoons fresh lemon juice",
        "1 tablespoon light mayonnaise"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Stir avocados, ranch dressing mix, lemon juice, and light mayonnaise together in a bowl. Chill for 1 hour."
        }
