  "recipes": [
    {
      "name": "Quick Pasta Carbonara",
      "ingredients_raw": [
        "0.5 pound medium-size pasta",
        "4 slices OSCAR MAYER Bacon, chopped",
        "4 ounces PHILADELPHIA Cream Cheese, cubed",
        "1 cup frozen peas",
        "0.75 cup milk",
        "0.5 cup KRAFT Grated Parmesan Cheese",
        "0.5 teaspoon garlic powder"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Cook pasta as directed on the package. Drain pasta and set aside."
        },
        {
          "id": 2,
          "text": "Meanwhile, cook bacon in a large skillet until crisp. Drain bacon on paper towels. Reserve 2 tablespoons drippings in the skillet."
        },
        {
          "id": 3,
          "text": "Add cream cheese, peas, milk, Parmesan cheese, and garlic powder to reserved drippings. Cook on low heat until cream cheese is melted and mixture is heated through."
        },
        {
          "id": 4,
          "text": "Place pasta in a large bowl. Add cream cheese sauce and bacon; mix lightly."
        }
      ],
