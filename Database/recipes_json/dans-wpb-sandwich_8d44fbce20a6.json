    {
      "name": "Dan&#39;s W.P.B. Sandwich",
      "ingredients_raw": [
        "0.25 teaspoon white sugar",
        "0.25 teaspoon ground cinnamon",
        "2 tablespoons peanut butter",
        "2 slices white bread",
        "1 slice watermelon"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine sugar and cinnamon in a small bowl; set aside."
        },
        {
          "id": 2,
          "text": "Spread 1 tablespoon peanut butter on each slice bread; sprinkle cinnamon sugar over peanut butter. Place watermelon between bread slices."
        }
      ],
