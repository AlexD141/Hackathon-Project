  "recipes": [
    {
      "name": "Rooibos Brulee Pancakes",
      "ingredients_raw": [
        "3 rooibos tea bags",
        "2 cups boiling water",
        "2 cups complete pancake mix (such as Aunt Jemima's Buttermilk Complete®)",
        "0.25 cup butter, or as needed",
        "0.25 cup brown sugar",
        "0.5 cup pecan halves"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Steep the rooibos tea bags in the water for 5 minutes; remove tea bags and allow tea to cool."
        },
        {
          "id": 2,
          "text": "Heat a skillet over medium-low heat until a drop of water on the surface sizzles for a moment before disappearing. Whisk together 1 1/2 cups cooled tea with the pancake mix."
        },
        {
          "id": 3,
          "text": "Melt 1 teaspoon butter in the center of the skillet. Place 4 to 5 pecan halves into the melting butter. Pour about 1/3 cup pancake batter directly over pecans and butter. Sprinkle 1/2 tablespoon brown sugar over the top of the pancake, and add another thin pat of butter over the sugar."
        },
        {
          "id": 4,
          "text": "When the edges of the pancake appear dry and bubbles form on the top, turn and cook until lightly browned, about 40 seconds. Remove from pan; add any melted sugar from the pan to the top of the pancake. Repeat with remaining pancake mix, butter, pecans, and sugar."
        }
      ],
