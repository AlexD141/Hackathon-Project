  "recipes": [
    {
      "name": "Peach Surprise Pie",
      "ingredients_raw": [
        "1 (9 inch) pie crust, baked",
        "2 (8 ounce) packages cream cheese, softened",
        "0.25 cup white sugar",
        "0.5 teaspoon vanilla extract",
        "2 cups sliced peaches, drained",
        "0.25 cup raspberry preserves",
        "1 teaspoon lemon juice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Combine softened cream cheese, sugar, and vanilla extract in a medium mixing bowl. Mix until smooth."
        },
        {
          "id": 3,
          "text": "Spread onto bottom of baked pie shell. Chill several hours or overnight."
        },
        {
          "id": 4,
          "text": "Before serving, top cream cheese layer with drained peach slices."
        },
        {
          "id": 5,
          "text": "Mix raspberry preserves with lemon juice until well combined. Spoon over peaches. Garnish with mint sprigs."
        }
      ],
