{
  "source_url": "https://www.allrecipes.com/recipe/10202/strufoli-i/",
  "extracted_at": "2026-10-18T01:41:10.790416+00:00",
  "recipes": [
    {
      "name": "Strufoli I",
      "ingredients_raw": [
        "4 eggs",
        "2.5 cups all-purpose flour",
        "16 ounces honey",
        "0.5 vanilla bean, halved lengthwise",
        "4 tablespoons chopped semisweet chocolate",
        "0.5 cup blanched slivered almonds",
        "1 (1.75 ounce) package multicolored sprinkles (jimmies)",
        "1 cup vegetable oil for frying",
        "0.33333334326744 cup confectioners' sugar for decoration"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place eggs in bowl and beat until they have tripled in volume. Add flour gradually until well blended (do not use all the flour). The dough should remain slightly sticky."
        },
        {
          "id": 2,
          "text": "Transfer to floured board. Cut off a piece at a time. Using a little flour, if needed, roll between your hands to form pencil shapes."
        },
        {
          "id": 3,
          "text": "Cut into 1/4 inch pieces. Place each on floured cloth. In a large pan on top of the stove, heat oil to 375 degrees F (190 degrees C). Deep-fry pieces about 1/2 cup at a time, turning constantly until golden. Drain and set aside. (Note: after several batches, dough begins to turn brown quickly. This means it is time to change the oil)"
        },
        {
          "id": 4,
          "text": "In large pan, bring honey to boil with vanilla bean. Discard bean. Place deep-fried pieces into hot honey and toss until all are coated. Cool and stir in chocolate, nuts, and multi-colored jimmies. Place on plate, shaping firmly into tall cone. Sprinkle with confectioner&#39;s sugar."
        }
      ],
