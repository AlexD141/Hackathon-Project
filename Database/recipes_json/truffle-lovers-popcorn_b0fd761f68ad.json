  "recipes": [
    {
      "name": "Truffle Lovers&#39; Popcorn",
      "ingredients_raw": [
        "4 teaspoons white truffle oil",
        "2 tablespoons dried parsley",
        "0.25 cup grated Parmesan cheese",
        "1 (3.5 ounce) package microwave popcorn, popped",
        "0.25 teaspoon sea salt, or to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Mix the truffle oil, parsley, and Parmesan cheese in a heat-safe bowl."
        },
        {
          "id": 2,
          "text": "Place unopened package of popcorn into center of microwave oven; cook on High power until the bag fills with popped corn and the pops occur about 2 seconds apart (1 1/2 to 4 minutes, depending on oven&#39;s power). Open hot bag carefully and pour into bowl. Toss with truffle oil mixture; season to taste with sea salt."
        }
      ],
