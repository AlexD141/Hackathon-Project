  "recipes": [
    {
      "name": "Artichoke Bread",
      "ingredients_raw": [
        "1 (14 ounce) can artichoke hearts, drained and chopped",
        "1 cup freshly grated Parmesan cheese",
        "1 cup mayonnaise (such as Hellman's®)",
        "1 clove garlic, finely chopped",
        "1 loaf French bread, cut lengthwise in half"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Combine artichoke hearts, Parmesan cheese, mayonnaise, and garlic in a bowl; spread evenly over bread halves. Transfer bread to a baking sheet."
        },
        {
          "id": 3,
          "text": "Bake in the preheated oven until artichoke spread is hot and bubbling, about 20 minutes."
        }
      ],
