          },
          {
            "@type": "Review",
            "reviewRating": {
              "@type": "Rating",
              "ratingValue": "5"
            },
            "author": {
              "@type": "Person",
              "name": "sgshowers"
            },
            "reviewBody": "This is by far the best pumpkin pie I have ever had. It was so easy to make and everybody loved it. I put mine in the freezer overnight and in the morning, it was done! Absolutely fabulous. Do not change anything about this recipe until you have tried it as written.",
            "datePublished": "2010-09-26T16:32:44.167Z"
          },
