      "name": "Banana Blast I",
      "ingredients_raw": [
        "1 banana",
        "1 pinch ground nutmeg",
        "0.5 teaspoon vanilla extract",
        "1 cup milk",
        "2 cups crushed ice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a blender combine banana, nutmeg, vanilla, milk and crushed ice. Blend until smooth. Pour into glasses and serve."
        }
