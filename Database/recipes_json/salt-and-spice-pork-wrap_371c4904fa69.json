  "recipes": [
    {
      "name": "Salt and Spice Pork Wrap",
      "ingredients_raw": [
        "1 (5 ounce) boneless pork loin chop",
        "1 teaspoon onion salt, or to taste",
        "0.25 teaspoon cayenne pepper, or to taste",
        "fresh-ground black pepper",
        "1 teaspoon vegetable oil",
        "1 (12 inch) flour tortilla",
        "3 tablespoons salsa or guacamole",
        "0.5 cup shredded Cheddar cheese"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Season pork chop with onion salt, cayenne, and pepper. Heat vegetable oil in a skillet over medium heat. Add the pork chop and cook until lightly browned on both sides, about 4 minutes per side. Cut pork chop into 1/4 inch strips, return to the skillet, and cook until no longer pink."
        },
        {
          "id": 2,
          "text": "Smear the center of the tortilla with salsa or guacamole; sprinkle with Cheddar cheese. Place pork strips on top of the cheese and roll tortilla up into a wrap."
        }
      ],
