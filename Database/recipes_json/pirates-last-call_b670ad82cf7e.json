      "name": "Pirate&#39;s Last Call",
      "ingredients_raw": [
        "4 maraschino cherries",
        "2 teaspoons white sugar",
        "1 (1.5 fluid ounce) jigger rum (dark or light)",
        "1 cup ice cubes",
        "1 cup cherry vanilla carbonated cola"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place cherries and sugar in the bottom of a 12-ounce glass, and mash with a spoon or muddler. Add rum and ice. Pour in soda, stir, and serve."
        }
