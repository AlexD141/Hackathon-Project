  "recipes": [
    {
      "name": "Furikake Snack Mix",
      "ingredients_raw": [
        "0.5 cup butter",
        "0.5 cup white sugar",
        "0.5 cup corn oil",
        "0.5 cup light corn syrup (such as Karo®)",
        "2 (12 ounce) packages crispy corn and rice cereal (such as Crispix®)",
        "1 (1.9 ounce) container aji nori furikake (seasoned seaweed and sesame rice topping)"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 225 degrees F (110 degrees C)."
        },
        {
          "id": 2,
          "text": "Melt the butter and sugar together in a small sauce pan over low heat. Remove from heat, then stir in the corn oil and corn syrup. Place the cereal on a large baking sheet. Pour the butter mixture over the cereal, then sprinkle the furikake while tossing the cereal to coat."
        },
        {
          "id": 3,
          "text": "Bake in the preheated oven until the cereal is dry, stirring every 15 minutes to keep cereal from browning too quickly. Allow to cool, then store in an airtight container."
        }
      ],
