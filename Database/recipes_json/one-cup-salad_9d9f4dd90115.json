      "name": "One Cup Salad",
      "ingredients_raw": [
        "1 cup pineapple chunks, drained",
        "1 cup Mandarin orange segments, drained",
        "1 cup miniature marshmallows",
        "1 cup sour cream",
        "1 cup cornflakes cereal",
        "1 cup flaked coconut"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine the pineapple, Mandarin oranges, marshmallows, and sour cream in a bowl. Gently fold the cornflakes cereal into the mixture. Sprinkle the coconut over the top; stir into the salad just before serving."
        }
