  "recipes": [
    {
      "name": "Bisschopswijn",
      "ingredients_raw": [
        "1 (750 milliliter) bottle red wine",
        "0.5 cup white sugar",
        "1 teaspoon ground cinnamon",
        "1 orange",
        "8 whole cloves"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a large saucepan on medium-low heat, combine wine, sugar, and cinnamon. Cut the orange in half, push the cloves into the outside of the orange halves, and place them into the wine."
        },
        {
          "id": 2,
          "text": "Heat slowly on low heat for about 30 minutes or until steaming; do not let it boil. Heat your glasses in warm water before serving."
        }
      ],
