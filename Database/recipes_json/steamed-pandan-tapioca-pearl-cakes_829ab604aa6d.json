{
  "source_url": "https://www.allrecipes.com/recipe/213813/steamed-pandan-tapioca-pearl-cakes/",
  "extracted_at": "2026-10-18T02:51:45.656877+00:00",
  "recipes": [
    {
      "name": "Steamed Pandan Tapioca Pearl Cakes",
      "ingredients_raw": [
        "1 (8 ounce) package grated coconut",
        "0.5 teaspoon salt",
        "5 pandan leaves, chopped",
        "0.75 cup water",
        "3 cups water",
        "1 (6.5 ounce) package small tapioca pearls",
        "1.5 cups white sugar",
        "3 tablespoons tapioca flour"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Toss the coconut and salt together in a small bowl; set aside."
        },
        {
          "id": 2,
          "text": "Blend the pandan leaves with 3/4 cup water in a blender or food processor until smooth; strain through a piece of cheesecloth. You should get about 1/2 cup pandan juice."
        },
        {
          "id": 3,
          "text": "Bring 3 cups water and the tapioca pearls to a boil in a sauce pan; cook at a boil until the pearls are translucent and soft, about 10 minutes. Stir the sugar and tapioca flour into the mixture until the sugar is completely dissolved; add the pandan juice and stir until you have a thick batter. Remove from heat and pour into foil cups."
        },
        {
          "id": 4,
          "text": "Bring a couple inches of water to boil in a large pot. Place a few of the cups at a time in a steamer insert and place over the boiling water. Steam until the cakes are cooked through, 10 to 15 minutes. Top the cakes with the coconut to serve."
        }
      ],
