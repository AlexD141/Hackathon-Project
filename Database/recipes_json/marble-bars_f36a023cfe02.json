  "recipes": [
    {
      "name": "Marble Bars",
      "ingredients_raw": [
        "1 cup white sugar",
        "1 cup light corn syrup",
        "1 cup peanut butter",
        "6 cups chocolate flavored crispy rice cereal",
        "1 cup semisweet chocolate chips"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a 3 quart saucepan, heat white sugar and corn syrup until bubbles form. Remove from heat, and stir in peanut butter."
        },
        {
          "id": 2,
          "text": "Add chocolate flavored crispy rice cereal; stir to coat well. Gently stir in chocolate chips to give marble effect."
        },
        {
          "id": 3,
          "text": "Press into 9x13 inch pan and cool until firm. Cut into bars."
        }
      ],
