      "name": "Spicy Mango Sauce",
      "ingredients_raw": [
        "0.75 cup finely minced mango",
        "0.25 cup seasoned rice vinegar",
        "1 lemon, juiced",
        "1 clove garlic, crushed",
        "1 teaspoon hot chile paste (such as sambal oelek)",
        "0.5 small Thai chile pepper, minced",
        "1 tablespoon chopped fresh cilantro"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine mango, rice wine vinegar, lime juice, garlic, hot chili paste, and Thai chile pepper in a bowl. Cover and let rest 30 minutes. Stir in cilantro."
        }
      ],
