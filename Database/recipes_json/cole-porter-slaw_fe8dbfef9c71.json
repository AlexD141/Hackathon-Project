  "recipes": [
    {
      "name": "Cole Porter Slaw",
      "ingredients_raw": [
        "3 tablespoons apple cider vinegar",
        "3 tablespoons buttermilk",
        "0.75 cup mayonnaise",
        "0.25 cup light brown sugar",
        "1 tablespoon Dijon mustard",
        "1 teaspoon chopped fresh parsley",
        "0.125 teaspoon salt",
        "0.25 cup diced onion",
        "1 (16 ounce) package packaged coleslaw mix"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Whisk together the vinegar, buttermilk, mayonnaise, and brown sugar until the sugar is dissolved. Stir in the mustard, parsley, and salt. Add the onion and coleslaw mix and stir to coat. Chill in refrigerator at least 15 minutes before serving."
        }
      ],
