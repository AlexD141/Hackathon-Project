  "recipes": [
    {
      "name": "Watermelon Vidalia Salsa",
      "ingredients_raw": [
        "2 cups diced watermelon",
        "1 cup chopped sweet onion (such as Vidalia®)",
        "1 serrano chile pepper, diced",
        "2 tablespoons chopped fresh cilantro",
        "1 clove garlic, minced",
        "0.25 teaspoon coarse salt",
        "2 pinches garlic powder"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine watermelon, onion, serranos, cilantro, and garlic in a large bowl; season with salt and garlic powder."
        },
        {
          "id": 2,
          "text": "Cover the bowl with plastic wrap; refrigerate before serving, at least 1 hour."
        }
      ],
