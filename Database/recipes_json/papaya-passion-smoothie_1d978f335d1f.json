      "name": "Papaya Passion Smoothie",
      "ingredients_raw": [
        "2 cups papaya - peeled, seeded and cubed",
        "2 cups milk",
        "0.25 cup white sugar",
        "0.25 cup sweetened condensed milk",
        "1 cup vanilla yogurt",
        "2 tablespoons cream cheese",
        "2 cups ice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place papaya, milk, sugar, condensed milk, yogurt, cream cheese, and ice in a blender. Blend until smooth. Serve immediately."
        }
      ],
