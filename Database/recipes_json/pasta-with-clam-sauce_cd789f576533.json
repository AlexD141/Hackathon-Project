  "recipes": [
    {
      "name": "Pasta with Clam Sauce",
      "ingredients_raw": [
        "1 pound fresh mushrooms, sliced",
        "1 green bell pepper, diced",
        "2 tablespoons butter",
        "1 pound fettuccini pasta",
        "0.5 large head broccoli, cut into florets",
        "0.75 cup butter, divided",
        "0.25 cup grated Parmesan cheese",
        "0.5 teaspoon dried oregano",
        "0.5 teaspoon dried parsley",
        "0.25 teaspoon garlic powder",
        "0.25 teaspoon ground black pepper",
        "0.25 cup all-purpose flour",
        "1 pint heavy cream",
        "1 (14.5 ounce) can chicken broth",
        "2 (6.5 ounce) cans minced clams, drained"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a large skillet over medium heat, cook mushrooms and bell pepper in 2 tablespoons butter until tender. Remove from heat and set aside."
        },
        {
          "id": 2,
          "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain. Steam broccoli in colander over pasta water, or in steamer, until bright green, 5 to 10 minutes."
        },
        {
          "id": 3,
          "text": "Toss cooked pasta with 1/4 cup butter, Parmesan, oregano, parsley, garlic powder and black pepper. Cover and set aside to keep warm."
        },
        {
          "id": 4,
          "text": "In a medium saucepan over medium heat, melt 1/2 cup butter. Dump in flour all at once and whisk until smooth. Whisk in cream and chicken broth a little at a time and cook until mixture thickens. Stir in clams and reserved broccoli, mushrooms and bell pepper. Heat through and toss with pasta. Serve at once."
        }
      ],
