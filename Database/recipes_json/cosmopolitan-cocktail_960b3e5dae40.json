  "recipes": [
    {
      "name": "Cosmopolitan Cocktail",
      "ingredients_raw": [
        "1.5 fluid ounces vodka",
        "0.25 fluid ounce lime juice",
        "0.25 fluid ounce triple sec",
        "0.25 fluid ounce cranberry juice",
        "1 cup ice",
        "1 lime wedge for garnish"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Combine vodka, lime juice, triple sec, and cranberry juice in a cocktail shaker."
        },
        {
          "id": 3,
          "text": "Add ice, cover and shake until chilled. Strain into a chilled cocktail glass."
        },
        {
          "id": 4,
          "text": "Garnish with a lime wedge."
        }
      ],
