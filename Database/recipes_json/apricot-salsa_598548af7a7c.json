    {
      "name": "Apricot Salsa",
      "ingredients_raw": [
        "3 cups chopped fresh apricot",
        "1 cup shallots, julienned",
        "0.5 cup chopped green bell pepper",
        "0.5 cup chopped red bell pepper",
        "0.5 cup chopped fresh pineapple",
        "0.25 cup chopped cherry tomatoes",
        "0.25 cup fresh lime juice",
        "1 habanero pepper, seeded and minced",
        "2 cloves garlic, minced",
        "1 teaspoon minced fresh cilantro",
        "0.5 teaspoon cumin"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine apricots, shallots, bell peppers, pineapple, cherry tomatoes, lime juice, habanero pepper, garlic, cilantro, and cumin in a bowl. Refrigerate before serving, at least 2 hours."
        }
      ],
