  "extracted_at": "2026-10-18T02:58:51.609916+00:00",
  "recipes": [
    {
      "name": "First Place Apricot-Date Bars",
      "ingredients_raw": [
        "0.5 cup brown sugar",
        "1 cup pitted Medjool dates, cut into small pieces",
        "8 ounces dried apricots, cut into small pieces",
        "0.5 cup apricot nectar (such as Kern's®)",
        "2 cups all-purpose flour",
        "1 teaspoon baking soda",
        "1 teaspoon salt",
        "0.75 cup vegetable shortening, melted",
        "1 teaspoon vanilla extract",
        "1 cup brown sugar",
        "2 cups rolled oats"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place 1/2 cup of brown sugar into a saucepan along with the dates and apricots; pour in the apricot nectar. Bring to a simmer over medium heat, and cook, stirring constantly, until the nectar has mostly evaporated and the mixture is sticky, about 5 minutes. Set aside to cool."
        },
        {
          "id": 2,
          "text": "Preheat an oven to 350 degrees F (175 degrees C). Whisk together the flour, baking soda, and salt in a bowl; set aside. Grease a baking sheet."
        },
        {
          "id": 3,
          "text": "Stir the melted shortening and vanilla extract into 1 cup of brown sugar in a large bowl until no lumps remain. Stir in the flour mixture and oats; work well with your hands until the mixture is evenly combined. Press half of the oat mixture onto the prepared baking sheet. Spread the cooled apricot mixture evenly over the oats, then press the remaining oat mixture evenly over top."
        },
        {
          "id": 4,
          "text": "Bake in the preheated oven until the top is golden brown, about 30 minutes. Cool completely before cutting into bars and serving."
        }
      ],
      "warnings": [],
