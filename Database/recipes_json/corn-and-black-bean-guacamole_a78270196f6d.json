    {
      "name": "Corn and Black Bean Guacamole",
      "ingredients_raw": [
        "0.5 red bell pepper, minced",
        "0.5 red onion, minced",
        "2 cloves garlic, minced",
        "0.5 (15.25 ounce) can sweet corn, drained",
        "0.5 (15 ounce) can black beans, drained and rinsed",
        "3 ripe avocados, peeled, pitted and sliced",
        "2 tablespoons fresh lime juice",
        "0.25 teaspoon salt",
        "1 pinch ground black pepper, or to taste",
        "0.5 cup chopped fresh cilantro, or more to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Stir red bell pepper, red onion, garlic, sweet corn, black beans, and avocado slices together in a large bowl."
        },
        {
          "id": 2,
          "text": "Mix lime juice, salt, black pepper, and cilantro into avocado mixture until desired texture is achieved."
        }
      ],
