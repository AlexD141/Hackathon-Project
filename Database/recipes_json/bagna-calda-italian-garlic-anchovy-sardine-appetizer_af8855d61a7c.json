      "name": "Bagna Càuda (Italian Garlic-Anchovy Appetizer)",
      "ingredients_raw": [
        "1.5 cups vegetable oil",
        "0.75 cup minced garlic",
        "4 (2 ounce) cans anchovy fillets packed in olive oil, drained",
        "3 (4 ounce) cans sardines packed in olive oil, drained",
        "1 cup butter"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place canola oil in a skillet and heat over medium heat. Stir in garlic; cook until golden brown, about 5 minutes. Add butter, anchovies, and sardines; cook and stir until well blended, 10 to 15 minutes. Serve warm."
        }
