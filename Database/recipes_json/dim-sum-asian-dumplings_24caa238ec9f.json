  "recipes": [
    {
      "name": "Dim Sum Asian Dumplings",
      "ingredients_raw": [
        "1 pound ground pork",
        "1 large onion, chopped",
        "0.5 bunch cilantro, chopped",
        "0.5 teaspoon crushed red pepper flakes",
        "2 teaspoons red curry paste",
        "0.5 teaspoon garam masala",
        "0.5 teaspoon chili powder",
        "0.25 teaspoon onion powder",
        "0.25 teaspoon garlic powder",
        "1 cup all-purpose flour",
        "0.25 cup water as needed",
        "3 tablespoons peanut butter",
        "0.5 teaspoon cayenne pepper",
        "1 teaspoon white sugar",
        "1 teaspoon vegetable oil"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine pork, onion, cilantro, red pepper flakes, red curry paste, garam masala, chili powder, onion powder, and garlic powder in a bowl; mix well and set aside."
        },
        {
          "id": 2,
          "text": "Place flour into a separate bowl. Slowly stir in water as needed until a soft dough is achieved; some water may be left over. Roll out walnut-sized balls of dough into thin circles for wrappers."
        },
        {
          "id": 3,
          "text": "Fill each wrapper with about 1 tablespoon pork mixture. Moisten the edges of wrapper, then fold in half, sealing to create a half-moon shape. Repeat with remaining wrappers and filling."
        },
        {
          "id": 4,
          "text": "Place dumplings in a steamer over 1-inch boiling water and cover. Steam until dough becomes glossy, about 10 minutes."
        },
        {
          "id": 5,
          "text": "Combine peanut butter, cayenne pepper, sugar, and vegetable oil in a microwave-safe glass or ceramic bowl. Cook in the microwave on high for 30 seconds; stir. Serve with dumplings."
        }
      ],
