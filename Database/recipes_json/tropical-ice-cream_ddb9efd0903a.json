      "name": "Tropical Ice Cream",
      "ingredients_raw": [
        "2 cups heavy cream",
        "1.3333333730698 cups 2% low-fat milk",
        "0.66666668653488 cup pineapple and orange juice blend",
        "0.75 cup sugar",
        "0.33333334326744 cup flaked sweetened coconut",
        "0.33333334326744 cup walnut pieces",
        "1 large banana, sliced"
