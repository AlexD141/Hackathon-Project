      "steps": [
        {
          "id": 1,
          "text": "Whisk together cream, milk, pineapple-orange juice, and sugar until the sugar has dissolved. Pour into an ice cream maker and freeze according to manufacturer&#39;s instructions."
        },
        {
          "id": 2,
          "text": "Five minutes before the ice cream is done, add the coconut and walnut pieces. Two minutes before the ice cream is done, add the sliced banana."
        }
