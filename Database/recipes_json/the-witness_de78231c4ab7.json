  "recipes": [
    {
      "name": "The Witness",
      "ingredients_raw": [
        "ice cubes",
        "0.75 fluid ounce peach flavored vodka",
        "0.75 fluid ounce grapefruit flavored vodka",
        "1.5 fluid ounces triple sec",
        "1 fluid ounce cranberry juice",
        "1 fluid ounce grapefruit juice",
        "1 fluid ounce sweetened lime juice",
        "2 lime wedges",
        "1 lime twist"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Chill a martini glass by packing it full of ice then filling it with cold water; set aside."
        },
        {
          "id": 2,
          "text": "Fill a martini shaker 3/4 full with ice. Pour in peach and grapefruit vodkas, triple sec, cranberry juice, grapefruit juice, and lime juice; squeeze and drop lime wedges into the shaker. Cover and shake vigorously at least 20 times until outside of shaker is frosted."
        },
        {
          "id": 3,
          "text": "Discard ice from martini glass. Strain cocktail into martini glass and garnish with a twist of lime."
        }
      ],
