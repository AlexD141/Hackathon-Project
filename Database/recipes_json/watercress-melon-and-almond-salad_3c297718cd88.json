  "recipes": [
    {
      "name": "Watercress, Melon and Almond Salad",
      "ingredients_raw": [
        "3 tablespoons fresh lime juice",
        "1 teaspoon white sugar",
        "1 teaspoon minced fresh ginger root",
        "0.25 cup vegetable oil",
        "salt and ground black pepper to taste",
        "2.5 cups cubed watermelon",
        "2.5 cups cubed cantaloupe",
        "2 bunches watercress, trimmed and chopped",
        "0.33333334326744 cup toasted and sliced almonds"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Whisk lime juice, sugar, and ginger together in a large bowl; gradually whisk in oil and season with salt and black pepper."
        },
        {
          "id": 2,
          "text": "Add watermelon, cantaloupe, and watercress to vinaigrette; toss to coat. Sprinkle servings with sliced almonds."
        }
      ],
