      "name": "Daiquiri Cocktail",
      "ingredients_raw": [
        "1.5 fluid ounces light rum",
        "1 fluid ounce lime juice",
        "1 teaspoon simple syrup",
        "1 cup ice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine light rum, lime juice, and simple syrup in a cocktail shaker. Add ice, cover and shake until chilled. Strain into a chilled cocktail glass."
        }
      ],
