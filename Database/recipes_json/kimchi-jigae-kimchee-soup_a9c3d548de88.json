  "recipes": [
    {
      "name": "Kimchi Jigae (Kimchee Soup)",
      "ingredients_raw": [
        "2 cups chopped kimchi",
        "1 cup water",
        "1 tablespoon brown sugar",
        "4 cloves garlic, minced",
        "0.5 pound pork belly, cut into bite-size pieces",
        "1 (12 ounce) can fully cooked luncheon meat (such as SPAM®), cubed",
        "0.25 cup kochujang (Korean hot sauce)",
        "1 (12 ounce) package silken tofu",
        "1 (3 ounce) package enoki mushrooms"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine kimchi, water, sugar, and garlic in a large skillet over medium-high heat. Bring to a boil. Stir in pork belly, luncheon meat, and kochujang. Add tofu and mushrooms; stir carefully so you don&#39;t break up the tofu. Reduce heat to medium-low. Cook until kimchi is softened and pork is slightly pink in the center, 20 to 30 minutes."
        }
      ],
