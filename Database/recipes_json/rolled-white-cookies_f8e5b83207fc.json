  "recipes": [
    {
      "name": "Rolled White Cookies",
      "ingredients_raw": [
        "1 cup butter",
        "1 cup white sugar",
        "2 eggs",
        "4 tablespoons milk",
        "1 teaspoon lemon extract",
        "3 cups all-purpose flour",
        "2 teaspoons cream of tartar",
        "1 teaspoon baking soda",
        "1 tablespoon white sugar"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Cream together 1 cup white sugar and butter. Beat in the eggs, milk and flavoring. Sift flour, cream of tartar and baking soda. Stir into butter mixture."
        },
        {
          "id": 2,
          "text": "Chill for a short time, until firm."
        },
        {
          "id": 3,
          "text": "Roll out on lightly floured board and cut with your favorite cookie cutters. Sprinkle with 1 tablespoon white sugar. Bake at 350 degrees F (175 degrees C) for 8 - 10 minutes."
        }
      ],
