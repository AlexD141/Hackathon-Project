  "recipes": [
    {
      "name": "Keftedes - Greek Meatballs",
      "ingredients_raw": [
        "oil for frying",
        "0.25 cup fresh lemon juice",
        "5 white potatoes, peeled",
        "2 pounds ground beef",
        "1 large onion, grated",
        "0.75 cup dry bread crumbs",
        "1 cup chopped fresh parsley",
        "0.33333334326744 cup dried mint, crushed",
        "0.5 teaspoon ground cinnamon",
        "zest from 1 lemon",
        "2 eggs, beaten",
        "1.5 tablespoons salt",
        "1 teaspoon ground black pepper",
        "lemon wedges"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Heat oil in a deep-fryer or large saucepan to 325 degrees F (165 degrees C)."
        },
        {
          "id": 2,
          "text": "Place the lemon juice in a large bowl. Coarsely grate the potatoes into the lemon juice, stirring well to prevent browning. Stir in the ground beef, onion, bread crumbs, parsley, mint, cinnamon, lemon zest, eggs, and salt and pepper. Mix well, and shape into oblong balls about 1 inch thick and 2 inches wide."
        },
        {
          "id": 3,
          "text": "Place meatballs in hot oil in batches; do not crowd. Fry until golden brown, and cooked through, about 6 to 7 minutes per batch. Serve with lemon wedges."
        }
      ],
