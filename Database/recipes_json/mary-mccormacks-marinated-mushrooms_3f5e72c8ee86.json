      "name": "Mary McCormack&#39;s Marinated Mushrooms",
      "ingredients_raw": [
        "1.5 teaspoons garlic salt",
        "1.5 teaspoons seasoning salt",
        "0.25 cup distilled white vinegar",
        "0.5 cup olive oil",
        "2 (8 ounce) cans mushrooms, drained"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Whisk together the garlic salt, seasoned salt, vinegar and olive oil. Pour over mushrooms and allow to marinate for 24 hours."
        }
      ],
