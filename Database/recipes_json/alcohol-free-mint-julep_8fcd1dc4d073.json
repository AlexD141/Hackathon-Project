  "recipes": [
    {
      "name": "Alcohol-Free Mint Julep",
      "ingredients_raw": [
        "0.25 cup water",
        "0.25 cup white sugar",
        "1 tablespoon chopped fresh mint leaves",
        "2 cups crushed ice",
        "0.5 cup prepared lemonade",
        "Fresh mint sprigs, for garnish"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine water, sugar, and 1 tablespoon of chopped mint in a small saucepan; cook and stir until mixture has boiled and sugar has dissolved. Remove from heat and set aside to cool for about an hour; strain out mint leaves."
        },
        {
          "id": 2,
          "text": "Fill 2 cups or frozen goblets with crushed ice. Pour 1/2 of the lemonade into each glass and top with a splash of cooled sugar syrup. Garnish each with a mint sprig and a straw. Serve on a silver platter."
        }
      ],
