  "recipes": [
    {
      "name": "Yum Yum Veggie Foils",
      "ingredients_raw": [
        "3 white onions, sliced to 1/4 inch thickness",
        "9 frozen small corn cobs",
        "0.5 pound snow peas",
        "3 tablespoons butter",
        "seasoning salt to taste",
        "2 cubes ice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Lightly oil grill and preheat to high."
        },
        {
          "id": 2,
          "text": "Place onion slices on a large sheet of aluminum foil; bring up edges of foil a bit to form a foil &#39;package&#39;. Add corn and snow peas to onions. Place butter or margarine on top, spread out. Season with seasoned salt to taste, then lay ice cubes on top of the whole thing. Seal well in a foil &#39;packet&#39;."
        },
        {
          "id": 3,
          "text": "Place foil packet on top shelf of preheated grill while cooking your favorite meats; grill until corn is firm but tender. Open foil packet and serve!"
        }
      ],
