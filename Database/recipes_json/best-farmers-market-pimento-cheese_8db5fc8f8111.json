    {
      "name": "Best Farmers&#39; Market Pimento Cheese",
      "ingredients_raw": [
        "1 cup grated mild white Cheddar cheese (such as Vermont white Cheddar)",
        "2 tablespoons finely chopped pimento",
        "2.5 tablespoons finely chopped red onion",
        "2.5 tablespoons finely chopped green onion (white and light green parts)",
        "4 drops Worcestershire sauce",
        "2 tablespoons mayonnaise, or as needed"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Stir together the Cheddar cheese, pimento, red onion, green onion, and the Worcestershire sauce. Stir in mayonnaise 1 tablespoon at a time to achieve desired texture."
        }
      ],
