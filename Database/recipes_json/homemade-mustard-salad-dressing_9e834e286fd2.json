  "recipes": [
    {
      "name": "Homemade Mustard Salad Dressing",
      "ingredients_raw": [
        "0.5 cup white sugar",
        "2 tablespoons all-purpose flour",
        "1 teaspoon prepared mustard",
        "0.5 teaspoon salt",
        "0.25 cup white wine vinegar",
        "0.25 cup water",
        "1 egg, beaten"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Whisk together the sugar, flour, mustard, salt, vinegar, water and egg."
        },
        {
          "id": 2,
          "text": "Cook in a double boiler until thick; allow to cool. Mix with equal parts mayonnaise and stir into potato salad."
        }
      ],
