  "recipes": [
    {
      "name": "Sweet Seduction",
      "ingredients_raw": [
        "1 fluid ounce Malibu rum",
        "1 fluid ounce banana liqueur",
        "0.5 cup pineapple juice",
        "ice cubes",
        "1 tablespoon grenadine"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Measure the rum, banana liqueur and pineapple juice into a cocktail shaker. Add a generous scoop of ice. Cover and shake until the outside is frosty, about 30 seconds. Strain into a glass filled with ice and gently pour the grenadine on top. It should float."
        }
      ],
