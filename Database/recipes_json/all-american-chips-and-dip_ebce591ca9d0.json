      "name": "All-American Chips and Dip",
      "ingredients_raw": [
        "1 (16 ounce) container light sour cream",
        "1 (1 ounce) package ranch dressing mix",
        "1 red bell pepper, top and seeds removed",
        "1 (12 ounce) package blue corn tortilla chips"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Mix together the sour cream and ranch dressing mix in a bowl. Spoon the mixture into the bell pepper. Place the pepper in the center of a white serving platter. Arrange the tortilla chips around the pepper."
        }
