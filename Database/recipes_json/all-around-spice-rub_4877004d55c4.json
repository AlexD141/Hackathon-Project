      "ingredients_raw": [
        "0.75 cup paprika",
        "0.25 cup fresh-ground pepper blend",
        "0.25 cup dark brown sugar",
        "2 tablespoons chili powder",
        "2 tablespoons garlic powder",
        "2 tablespoons onion powder",
        "1 tablespoon sea salt",
        "2 teaspoons cayenne pepper"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Stir the paprika, pepper, brown sugar, chili powder, onion powder, sea salt, and cayenne pepper together in a container with a lid. Store in a cool, dark place between uses."
        }
