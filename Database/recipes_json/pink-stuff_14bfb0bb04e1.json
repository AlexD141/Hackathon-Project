  "recipes": [
    {
      "name": "Pink Stuff",
      "ingredients_raw": [
        "1 (21 ounce) can cherry pie filling",
        "1 (14 ounce) can sweetened condensed milk",
        "1 (20 ounce) can crushed pineapple, drained",
        "1 cup chopped pecans",
        "1 (12 ounce) container frozen whipped topping, thawed"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "In a large bowl, mix together pie filling, sweetened condensed milk, crushed pineapple, and pecans."
        },
        {
          "id": 3,
          "text": "Fold in the whipped topping. Refrigerate until chilled."
        }
      ],
