  "recipes": [
    {
      "name": "Lime Cilantro Cauliflower &#34;Rice&#34;",
      "ingredients_raw": [
        "1 head cauliflower, cut into florets",
        "1 tablespoon water",
        "1 lime, juiced and zested",
        "0.5 cup chopped cilantro",
        "2 tablespoons butter"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Grate cauliflower florets or pulse in a food processor until it resembles rice."
        },
        {
          "id": 2,
          "text": "Place grated cauliflower and water in a microwave-safe covered dish."
        },
        {
          "id": 3,
          "text": "Microwave cauliflower on high until tender, about 7 minutes."
        },
        {
          "id": 4,
          "text": "Stir lime zest, lime juice, cilantro, and butter into cauliflower until well blended."
        }
      ],
