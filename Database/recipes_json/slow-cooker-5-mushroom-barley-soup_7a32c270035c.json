  "recipes": [
    {
      "name": "Slow Cooker 5-Mushroom Barley Soup",
      "ingredients_raw": [
        "3 cups water",
        "1 cup barley",
        "4 cups beef broth",
        "1 cup milk",
        "2 tablespoons olive oil",
        "1 cup diced onion",
        "0.5 cup diced celery",
        "0.5 cup diced carrot",
        "1 tablespoon finely chopped garlic",
        "1 (6 ounce) package sliced white mushrooms",
        "0.5 cup chopped brown beech mushrooms",
        "0.5 cup chopped oyster mushrooms",
        "0.25 cup dried shiitake mushrooms",
        "0.25 cup dried black mushrooms, broken into small pieces",
        "1 (10.75 ounce) can condensed cream of mushroom soup",
        "0.5 teaspoon salt",
        "0.5 teaspoon ground mixed peppercorns"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Heat water in a slow cooker set to High until hot; add barley, beef broth, milk, olive oil, onion, celery, carrot, garlic, white mushrooms, brown beech mushrooms, oyster mushrooms, shiitake mushrooms, black mushrooms, cream of mushroom soup, salt, and ground mixed peppercorns to the slow cooker."
        },
        {
          "id": 2,
          "text": "Cover and cook on High for 1 hour."
        },
        {
          "id": 3,
          "text": "Remove shiitake mushrooms with a slotted spoon and chop into 1/2-inch pieces. Reduce heat setting to Low and continue cooking 7 hours more."
        }
      ],
