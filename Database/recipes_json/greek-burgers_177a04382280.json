  "recipes": [
    {
      "name": "Greek Burgers",
      "ingredients_raw": [
        "0.5 cup mayonnaise",
        "1 teaspoon minced garlic",
        "2 pounds ground lamb",
        "0.25 cup breadcrumbs",
        "1 cup trimmed, diced fennel bulb",
        "3 tablespoons shallots, minced",
        "1 teaspoon dried oregano",
        "0.5 teaspoon salt",
        "ground black pepper to taste",
        "1 tablespoon olive oil",
        "8 hamburger buns"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a small bowl, mix together mayonnaise and minced garlic. Cover, and refrigerate for at least 1 hour."
        },
        {
          "id": 2,
          "text": "Preheat grill for high heat."
        },
        {
          "id": 3,
          "text": "Mix together lamb, breadcrumbs, fennel, shallot, oregano, and salt. Form into 3/4-inch-thick patties, and sprinkle black pepper over each."
        },
        {
          "id": 4,
          "text": "Brush grate with olive oil, and place burgers on grill. Cook for 3 to 5 minutes per side, turning once, or until done. Serve on buns with garlic mayonnaise."
        }
      ],
