  "recipes": [
    {
      "name": "Almond Sherbet",
      "ingredients_raw": [
        "2 (10 ounce) cans sweetened condensed milk",
        "7.3333334922791 cups water",
        "0.75 cup white sugar",
        "1 teaspoon almond extract",
        "1 drop green food coloring, or as desired"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Whisk the sweetened condensed milk and water together in a bowl, and stir in the sugar and almond extract until the drink is smooth and the sugar has dissolved. Mix in a drop or two of green food coloring, or as desired; chill to serve."
        }
      ],
