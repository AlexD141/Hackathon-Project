            "author": {
              "@type": "Person",
              "name": "Yoly"
            },
            "reviewBody": "After reading the other reviews, I decided to leave out the sugar. I am glad that I did. I chilled it and served it over ice. I think the colder it got the better it tasted. Very refreshing.",
            "datePublished": "2017-01-09T01:01:53.830Z"
          },
