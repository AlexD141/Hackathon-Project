  "recipes": [
    {
      "name": "Mango Topping",
      "ingredients_raw": [
        "3 cups mangos, peeled, seeded and chopped",
        "1 tablespoon butter",
        "1 tablespoon brown sugar",
        "1 teaspoon lemon juice",
        "1 teaspoon orange juice",
        "3 tablespoons water"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a saucepan over medium heat, combine the mangoes, butter, brown sugar, lemon juice, orange juice, and water. Stir until the mixture thickens. Remove from heat and serve."
        }
      ],
