  "recipes": [
    {
      "name": "Dutch Boterkoek",
      "ingredients_raw": [
        "2.5 cups all-purpose flour",
        "1 teaspoon baking powder",
        "1.25 cups butter",
        "0.75 cup white sugar",
        "1 tablespoon lemon zest",
        "1 teaspoon vanilla extract",
        "1 tablespoon milk"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat an oven to 400 degrees F (200 degrees C). Lightly grease an 8-inch tart tin, or a 9-inch pie pan. Whisk together the flour and baking powder; set aside."
        },
        {
          "id": 2,
          "text": "Beat the butter, sugar, lemon zest, and vanilla extract with an electric mixer in a large bowl until smooth. Mix in the flour mixture until the dough forms ball. Press the dough into the prepared tin, and brush with the milk."
        },
        {
          "id": 3,
          "text": "Bake in the preheated oven until golden brown and still somewhat soft at the center, about 35 minutes. Cool in the pan for 10 minutes, then remove, and cut into 16 wedges. Cool completely on a wire rack."
        }
      ],
