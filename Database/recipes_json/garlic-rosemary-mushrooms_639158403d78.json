  "recipes": [
    {
      "name": "Garlic-Rosemary Mushrooms",
      "ingredients_raw": [
        "1 ounce bacon, chopped",
        "1.5 pounds mixed mushrooms, such as cremini, shiitake (stemmed) and portobello, cut into 1/4-inch slices",
        "2 cloves garlic, finely chopped",
        "1.5 teaspoons chopped fresh rosemary",
        "0.25 teaspoon salt",
        "1 pinch freshly ground pepper to taste",
        "0.25 cup dry white wine"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Cook bacon in a large skillet over medium heat until just beginning to brown, about 4 minutes. Add mushrooms, garlic, rosemary, salt and pepper and cook, stirring occasionally, until almost dry, 8 to 10 minutes. Pour in wine and cook until most of the liquid has evaporated, 30 seconds to 1 minute."
        }
      ],
