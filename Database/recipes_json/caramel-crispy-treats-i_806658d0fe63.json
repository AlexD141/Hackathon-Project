  "recipes": [
    {
      "name": "Caramel Crispy Treats I",
      "ingredients_raw": [
        "3 tablespoons butter",
        "2.5 cups miniature marshmallows",
        "1 (5 ounce) can chow mein noodles",
        "12 individually wrapped caramels, unwrapped",
        "1 tablespoon cold water",
        "2 tablespoons peanut butter"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Melt butter with marshmallows over low heat - stir until smooth."
        },
        {
          "id": 2,
          "text": "Add noodles - toss until coated."
        },
        {
          "id": 3,
          "text": "Drop spoonfuls of noodle mixture onto a greased baking sheet."
        },
        {
          "id": 4,
          "text": "Melt caramels with water over low heat - stir until smooth. Add peanut butter; mix well. Drizzle over treats. Chill."
        }
      ],
