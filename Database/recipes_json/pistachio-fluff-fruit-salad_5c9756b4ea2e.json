  "recipes": [
    {
      "name": "Pistachio Fluff Salad ",
      "ingredients_raw": [
        "1 (3 ounce) package instant pistachio pudding mix",
        "1 (20 ounce) can crushed pineapple with juice",
        "1 (12 ounce) container frozen whipped topping, thawed",
        "2 large bananas, sliced",
        "2 cups miniature marshmallows",
        "1 (15.25 ounce) can fruit cocktail, drained",
        "1 (11 ounce) can mandarin oranges, drained"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Dump instant pudding into a large mixing bowl. Add pineapple with juice; mix well."
        },
        {
          "id": 3,
          "text": "Stir in whipped topping until combined."
        },
        {
          "id": 4,
          "text": "Add bananas, marshmallows, fruit cocktail, and mandarin oranges; mix until incorporated."
        },
        {
          "id": 5,
          "text": "Cover and refrigerate until thoroughly chilled, about 2 to 4 hours."
        },
        {
          "id": 6,
          "text": "Serve and enjoy!"
        }
      ],
