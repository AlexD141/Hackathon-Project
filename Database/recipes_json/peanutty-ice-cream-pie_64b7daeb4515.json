  "recipes": [
    {
      "name": "Peanutty Ice Cream Pie",
      "ingredients_raw": [
        "1.3333333730698 cups finely chopped peanuts",
        "3 tablespoons margarine, melted",
        "2 tablespoons white sugar",
        "0.25 cup peanut butter",
        "0.25 cup light corn syrup",
        "0.25 cup flaked coconut",
        "3 tablespoons chopped peanuts",
        "1 quart vanilla ice cream, softened",
        "0.25 cup mini candy-coated chocolate pieces"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Grease a 9-inch pie plate."
        },
        {
          "id": 2,
          "text": "Combine 1 ⅓ cups peanuts, butter, and sugar in a bowl until well mixed; press into the bottom and up the sides of the prepared pie plate. Cover and refrigerate for 15 minutes."
        },
        {
          "id": 3,
          "text": "Combine peanut butter and corn syrup in a large bowl; stir in coconut and 3 tablespoons peanuts and mix well. Stir in ice cream just until combined; spoon into crust and evenly smooth top."
        },
        {
          "id": 4,
          "text": "Cover and freeze until firm, 8 hours to overnight. Sprinkle with mini candy-coated chocolate pieces before serving."
        }
      ],
