      "name": "Sedation",
      "ingredients_raw": [
        "ice",
        "0.5 (1.5 fluid ounce) jigger vodka",
        "0.25 (1.5 fluid ounce) jigger amaretto liqueur",
        "0.5 (1.5 fluid ounce) jigger peach schnapps",
        "0.5 (1.5 fluid ounce) jigger coconut-flavored rum",
        "0.25 (1.5 fluid ounce) jigger melon liqueur",
        "1 (1.5 fluid ounce) jigger orange juice",
        "0.5 (1.5 fluid ounce) jigger pineapple juice",
        "2 (1.5 fluid ounce) jiggers cranberry juice",
        "1 twist lemon peel"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Fill a pint glass with ice, and pour in the vodka, amaretto, peach schnapps, coconut rum, and melon liqueur; stir. Pour in the orange juice and pineapple juice. Float the cranberry juice on top. Garnish with a lemon twist."
        }
