  "recipes": [
    {
      "name": "Special Cereal Bars II",
      "ingredients_raw": [
        "4 cups high protein crisp rice and wheat cereal",
        "1 cup shredded coconut",
        "1.5 cups creamy peanut butter",
        "1 cup peanuts",
        "1 cup white sugar",
        "1 cup white corn syrup",
        "2 cups butterscotch chips",
        "1 cup semisweet chocolate chips"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine cereal and coconut in a medium size bowl."
        },
        {
          "id": 2,
          "text": "Combine peanut butter and peanuts in a large mixing bowl."
        },
        {
          "id": 3,
          "text": "Heat the sugar and corn syrup over a medium heat and stir constantly until the sugar is dissolved. Pour this mixture into the bowl with the peanut butter; mix well."
        },
        {
          "id": 4,
          "text": "Pour cereal mixture into the liquid mixture; mix well. Press the mixture into an ungreased 10x15 inch pan."
        },
        {
          "id": 5,
          "text": "Melt the butterscotch and chocolate chips over a medium-low heat; mix well. Spread the mixture over the pan of cereal mixture. Let cool before cutting into bars."
        }
      ],
