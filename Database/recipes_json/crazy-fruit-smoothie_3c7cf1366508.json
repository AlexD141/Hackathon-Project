    {
      "name": "Crazy Fruit Smoothie",
      "ingredients_raw": [
        "1.5 cups crushed ice",
        "1 banana, chopped",
        "1 kiwi, peeled and chopped",
        "0.5 cup chopped strawberries",
        "0.5 cup chopped pineapple",
        "0.25 cup cream of coconut",
        "1 tablespoon coconut flakes for garnish"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Blend the ice, banana, kiwi, strawberries, pineapple, and cream of coconut in a blender until smooth; pour into a glass and garnish with the coconut flakes to serve."
        }
      ],
