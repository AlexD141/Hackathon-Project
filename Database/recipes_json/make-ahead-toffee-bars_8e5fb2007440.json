  "recipes": [
    {
      "name": "Make Ahead Toffee Bars",
      "ingredients_raw": [
        "2 cups Make Ahead Cookie Mix",
        "1 cup packed brown sugar",
        "5 tablespoons butter",
        "1 teaspoon vanilla extract",
        "1 egg",
        "1 cup semisweet chocolate chips",
        "0.5 cup chopped walnuts"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (180 degrees C). Grease a 9 x 13 inch pan."
        },
        {
          "id": 2,
          "text": "Combine Make Ahead Cookie Mix with brown sugar, butter, vanilla and egg. Mix well."
        },
        {
          "id": 3,
          "text": "Spread dough in pan. Bake 17 to 24 minutes until top springs back when touched."
        },
        {
          "id": 4,
          "text": "Immediately sprinkle with chocolate chips. Let stand 2-3 minutes to melt then spread chocolate over bars and sprinkle with nuts. Cut when cooled."
        }
      ],
