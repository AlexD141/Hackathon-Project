  "recipes": [
    {
      "name": "Grilled Salmon Steaks Italian-Style",
      "ingredients_raw": [
        "2 salmon steaks",
        "1 tablespoon dried Italian seasoning",
        "1 teaspoon crumbled dried thyme",
        "1 teaspoon crushed dried rosemary",
        "salt and pepper to taste",
        "1 tablespoon fresh lime juice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat an outdoor grill for medium heat and lightly oil grate."
        },
        {
          "id": 2,
          "text": "Season one side of each steak with the Italian seasoning, thyme, rosemary, salt, and pepper."
        },
        {
          "id": 3,
          "text": "Lay the steaks with the seasoned-side down on the prepared grill. Cook on grill until the flesh flakes, turning once, 7 to 8 minutes. Sprinkle each steak with lime juice to serve."
        }
      ],
