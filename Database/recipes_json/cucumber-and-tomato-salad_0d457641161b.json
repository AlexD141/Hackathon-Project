    {
      "name": "Cucumber and Tomato Salad",
      "ingredients_raw": [
        "1 tomato, chopped",
        "1 cucumber, seeded and chopped",
        "0.25 cup thinly sliced red onion",
        "0.25 cup canned kidney beans, drained",
        "0.25 cup diced firm tofu",
        "2 tablespoons chopped fresh basil",
        "0.25 cup balsamic vinaigrette salad dressing",
        "salt and pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine tomato, cucumber, red onion, kidney beans, tofu, and basil in a large bowl."
        },
        {
          "id": 2,
          "text": "Toss with balsamic vinaigrette salad dressing and season with salt and pepper just before serving."
        }
      ],
