    {
      "name": "Pineapple Breeze",
      "ingredients_raw": [
        "1.5 cups ice cubes",
        "2 (1.5 fluid ounce) jiggers coconut-flavored rum (such as Malibu®)",
        "0.5 (12 ounce) can lemon-lime soda (such as Sprite®)",
        "2 fluid ounces pineapple juice, or to taste",
        "2 fluid ounces orange juice, or to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place the ice into a 16-ounce glass. Pour in the rum, lemon-lime soda, pineapple juice, and orange juice. Stir and serve."
        }
      ],
