            },
            "author": {
              "@type": "Person",
              "name": "Soup Loving Nicole"
            },
            "reviewBody": "Not sure about the best ever but this was good. All the flavors worked good together and not too much flare up. I'd probably add more hot pepper sauce next time but that is the only change I'd make.",
            "datePublished": "2025-04-29T02:34:54.244Z"
          },
