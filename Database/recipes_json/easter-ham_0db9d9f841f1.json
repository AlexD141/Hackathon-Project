  "recipes": [
    {
      "name": "Easter Ham",
      "ingredients_raw": [
        "2 cups brown sugar",
        "3 tablespoons prepared yellow mustard, or as needed",
        "1 (7 pound) boneless ham",
        "1 (8 ounce) can pineapple rings in juice, drained and juice reserved",
        "1 cup honey"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Score ham by making 1/2-inch-deep diagonal cuts in a diamond pattern."
        },
        {
          "id": 3,
          "text": "Mix brown sugar with enough mustard to make a smooth, pourable sauce."
        },
        {
          "id": 4,
          "text": "Place ham into a roasting pan. Drizzle honey, reserved pineapple juice, and brown sugar mixture over top."
        },
        {
          "id": 5,
          "text": "Arrange pineapple rings decoratively on ham and secure with wooden toothpicks."
        },
        {
          "id": 6,
          "text": "Bake in the preheated oven, basting every 15 minutes with pan juices, until the diamond pattern on ham splits open, about 1 to 1 ½ hours."
        },
        {
          "id": 7,
          "text": "Serve and enjoy!"
        }
      ],
