  "recipes": [
    {
      "name": "Chocolate Picnic Cake",
      "ingredients_raw": [
        "1 (5 ounce) package non-instant chocolate pudding mix",
        "1 (18.25 ounce) package chocolate cake mix",
        "1 cup semisweet chocolate chips",
        "1.5 cups chopped walnuts"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 9x13 inch pan."
        },
        {
          "id": 2,
          "text": "In a large saucepan, prepare the pudding according to the instructions on the box. Remove from heat. Mix cake mix into the hot pudding and stir until blended."
        },
        {
          "id": 3,
          "text": "Pour batter into prepared pan, and sprinkle with the chocolate chips and walnuts. Bake in the preheated oven for 25 minutes, or until a toothpick inserted into the center of the cake comes out clean. Allow to cool before serving."
        }
      ],
