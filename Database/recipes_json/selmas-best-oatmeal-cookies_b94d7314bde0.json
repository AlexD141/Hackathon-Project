  "recipes": [
    {
      "name": "Selma&#39;s Best Oatmeal Cookies",
      "ingredients_raw": [
        "1 cup shortening",
        "1 cup white sugar",
        "0.5 cup packed brown sugar",
        "1 egg",
        "1.5 cups quick cooking oats",
        "0.75 cup finely chopped walnuts",
        "1 teaspoon vanilla extract",
        "1.5 cups all-purpose flour",
        "1 teaspoon baking soda",
        "1 teaspoon ground cinnamon"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Cream together shortening, white sugar, brown sugar. Then add 1 beaten egg."
        },
        {
          "id": 2,
          "text": "Sift together flour, baking soda, and ground cinnamon and add to first mixture. Then add quick rolled oats, finely crushed walnuts or pecans and vanilla."
        },
        {
          "id": 3,
          "text": "Cover and chill for an hour."
        },
        {
          "id": 4,
          "text": "Preheat oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 5,
          "text": "Place walnut sized pieces of dough on a greased cookie sheet. Butter the bottom of a small glass, dip in sugar and flatten out the little pieces. You need not rebutter each time. Bake for 10 minutes."
        }
      ],
