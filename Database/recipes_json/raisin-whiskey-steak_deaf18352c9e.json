  "recipes": [
    {
      "name": "Raisin Whiskey Steak",
      "ingredients_raw": [
        "0.5 cup raisins",
        "0.25 cup Canadian whiskey (such as Crown Royal®)",
        "2 tablespoons brown sugar",
        "2 (12 ounce) boneless beef sirloin steaks",
        "1 teaspoon canola oil"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place raisins, whiskey, and brown sugar into a resealable plastic bag."
        },
        {
          "id": 2,
          "text": "Place steaks into the bag, coat with marinade, squeeze out excess air, and seal the bag. Marinate in the refrigerator for 10 to 30 minutes."
        },
        {
          "id": 3,
          "text": "Heat canola oil in a large skillet over medium high heat."
        },
        {
          "id": 4,
          "text": "Transfer steaks and marinade to the hot skillet."
        },
        {
          "id": 5,
          "text": "Remove raisins from the skillet with a slotted spoon once they have plumped, about 5 minutes; set aside."
        },
        {
          "id": 6,
          "text": "Cook steaks until they are beginning to firm and are hot and slightly pink in the center, 5 to 8 minutes per side. An instant-read thermometer inserted into the center should read at least 140 degrees F (60 degrees C)."
        },
        {
          "id": 7,
          "text": "Serve the steaks with the raisins."
        }
      ],
      "warnings": [],
