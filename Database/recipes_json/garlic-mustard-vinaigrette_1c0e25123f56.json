  "recipes": [
    {
      "name": "Garlic Mustard Vinaigrette",
      "ingredients_raw": [
        "1 teaspoon white sugar",
        "0.5 teaspoon salt",
        "2 teaspoons red wine vinegar",
        "1 tablespoon Dijon mustard",
        "3 tablespoons extra-virgin olive oil",
        "3 cloves garlic, pressed"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a small bowl, mix sugar, salt, red wine vinegar, Dijon mustard, and olive oil until thoroughly mixed and sugar and salt have dissolved. Stir in garlic."
        }
      ],
