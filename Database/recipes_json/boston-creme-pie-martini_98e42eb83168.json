  "recipes": [
    {
      "name": "Boston Creme Pie Martini",
      "ingredients_raw": [
        "1 (1.5 fluid ounce) jigger vanilla vodka",
        "1 (1.5 fluid ounce) jigger chocolate liqueur",
        "1 (1.5 fluid ounce) jigger Irish cream liqueur",
        "1 cup crushed ice",
        "1 (4 ounce) jar maraschino cherry"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine vodka, chocolate liqueur, Irish cream liqueur, and crushed ice in a cocktail shaker. Shake vigorously to chill. Pour into a martini glass, garnish with a maraschino cherry, and serve."
        }
      ],
