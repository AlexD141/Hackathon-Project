    {
      "name": "Buttermilk Blue Cheese Dressing",
      "ingredients_raw": [
        "1 cup buttermilk",
        "1 cup mayonnaise",
        "1 (4 ounce) package crumbled blue cheese",
        "0.125 teaspoon garlic powder",
        "0.125 teaspoon ground black pepper"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Stir the buttermilk, mayonnaise, blue cheese, garlic powder, and black pepper together in a bowl."
        },
        {
          "id": 2,
          "text": "Cover bowl with plastic wrap and refrigerate overnight before serving."
        }
      ],
