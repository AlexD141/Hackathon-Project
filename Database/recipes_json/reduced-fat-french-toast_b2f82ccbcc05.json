    {
      "name": "Reduced Fat French Toast",
      "ingredients_raw": [
        "0.5 cup egg substitute",
        "0.66666668653488 cup skim milk",
        "1 teaspoon vanilla extract",
        "0.5 teaspoon ground cinnamon",
        "6 slices reduced calorie white bread"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Beat together egg substitute, milk, vanilla and cinnamon. Dip bread slices in egg mixture until both sides are soaked."
        },
        {
          "id": 2,
          "text": "Spray a skillet or frying pan with cooking spray and heat over medium high heat. Place bread slices into pan and cook until golden brown on both sides"
        }
      ],
