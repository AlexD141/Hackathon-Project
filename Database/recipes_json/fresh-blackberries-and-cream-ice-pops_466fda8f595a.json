  "recipes": [
    {
      "name": "Fresh Blackberries and Cream Ice Pops",
      "ingredients_raw": [
        "8 ounces fresh blackberries",
        "2 cups vanilla frozen yogurt, softened",
        "2 tablespoons white sugar",
        "1 6-piece ice pop mold"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place blackberries in a blender or the bowl of a food processor; cover and blend until smooth. Pour blackberry purée through a fine-mesh sieve placed over a large bowl to strain out seeds; discard solids."
        },
        {
          "id": 2,
          "text": "Stir frozen yogurt and sugar into blackberry purée; mix well. Pour mixture into ice pop molds; freeze until solid."
        }
      ],
