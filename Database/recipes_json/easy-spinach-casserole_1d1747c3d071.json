  "recipes": [
    {
      "name": "Easy Spinach Casserole",
      "ingredients_raw": [
        "2 (10 ounce) packages frozen chopped spinach",
        "1 (8 ounce) package cream cheese",
        "1 teaspoon seasoning salt",
        "1 cup dried bread crumbs, seasoned"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Thaw spinach and squeeze out water. Soften cream cheese."
        },
        {
          "id": 2,
          "text": "In a mixing bowl, combine spinach, cream cheese and seasoning salt. Mix well and spoon into 2 quart casserole dish."
        },
        {
          "id": 3,
          "text": "Sprinkle with bread crumbs and bake at 350 degrees F (175 degree C) for 20 minutes."
        }
      ],
