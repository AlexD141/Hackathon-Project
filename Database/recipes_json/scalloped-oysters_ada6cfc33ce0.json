  "recipes": [
    {
      "name": "Scalloped Oysters",
      "ingredients_raw": [
        "25 buttery round crackers, crumbled",
        "0.5 cup bread crumbs",
        "0.5 cup melted butter",
        "1 pint shucked oysters, drained with liquid reserved",
        "salt and ground black pepper to taste",
        "2 tablespoons milk"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 450 degrees F (230 degrees C). Butter a shallow baking dish."
        },
        {
          "id": 2,
          "text": "Combine cracker crumbs and bread crumbs in a medium bowl; stir in melted butter until combined."
        },
        {
          "id": 3,
          "text": "Sprinkle a thin layer of crumb mixture into the bottom of the prepared baking dish. Layer 1/2 of the oysters over crumbs, then sprinkle with salt and pepper. Pour 2 tablespoons oyster liquid and 1 tablespoon milk over the top. Repeat this step once more, covering the top layer with remaining crumb mixture."
        },
        {
          "id": 4,
          "text": "Bake in the preheated oven until the top is golden brown, about 30 minutes."
        }
      ],
