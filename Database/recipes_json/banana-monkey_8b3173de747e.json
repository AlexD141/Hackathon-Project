      "name": "Banana Monkey",
      "ingredients_raw": [
        "1 cup pina colada mix",
        "1 fluid ounce coffee-flavored liqueur (such as Kahlua®)",
        "1 fluid ounce vodka",
        "0.33333334326744 banana, mashed",
        "1 cup ice cubes"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place pina colada mix, coffee-flavored liqueur, vodka, banana, and 1/2 cup of ice into a blender. Cover, and puree until smooth. Add ice a little at a time and repeat until drink reaches desired consistency."
        }
