  "recipes": [
    {
      "name": "Coconut Tarts",
      "ingredients_raw": [
        "12 (2 inch) frozen mini tart shells",
        "0.25 cup melted butter",
        "0.25 cup white sugar",
        "1 egg",
        "2 teaspoons evaporated milk",
        "1 teaspoon vanilla extract",
        "1 cup flaked coconut",
        "2 tablespoons strawberry jam"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 375 degrees F (190 degrees C). Place frozen mini tart shells on a baking sheet."
        },
        {
          "id": 2,
          "text": "Beat the butter, sugar, egg, evaporated milk, and vanilla extract, mixing until fully combined. Stir in the coconut. Place 1/2 teaspoon of jam into each mini tart shell, and fill the shells with about 1 tablespoon of the coconut mixture."
        },
        {
          "id": 3,
          "text": "Bake in the preheated oven until the shells and topping are lightly golden brown, about 20 minutes. Cool on wire rack."
        }
      ],
