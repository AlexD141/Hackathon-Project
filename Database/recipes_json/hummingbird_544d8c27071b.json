            },
            "author": {
              "@type": "Person",
              "name": "duboo"
            },
            "reviewBody": "I followed the recipe exactly and the ladies I made it for loved it. It's a really nice thick consistency. Perfect for those beach chair days.",
            "datePublished": "2016-05-22T14:14:06.087Z"
          },
          {
            "@type": "Review",
            "reviewRating": {
              "@type": "Rating",
