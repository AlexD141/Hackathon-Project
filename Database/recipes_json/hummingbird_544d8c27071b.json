  "recipes": [
    {
      "name": "Hummingbird",
      "ingredients_raw": [
        "1 fluid ounce rum cream liqueur",
        "1 fluid ounce coffee flavored liqueur",
        "1 fluid ounce milk",
        "0.5 fluid ounce strawberry flavored syrup",
        "0.5 banana",
        "1 cup crushed ice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a blender, combine rum cream liqueur, coffee liqueur, milk and strawberry syrup. Add the banana and crushed ice. Blend until smooth. Pour into glasses and serve."
        }
      ],
