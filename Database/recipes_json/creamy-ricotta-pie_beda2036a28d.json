  "recipes": [
    {
      "name": "Creamy Ricotta Pie",
      "ingredients_raw": [
        "2 cups all-purpose flour",
        "0.5 cup white sugar",
        "2 large eggs",
        "0.5 cup shortening",
        "2 teaspoons vanilla extract",
        "1.5 teaspoons baking powder",
        "1 teaspoon salt",
        "2 (16 ounce) containers ricotta cheese",
        "2 teaspoons ground cinnamon"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Combine flour, ½ cup sugar, 2 eggs, shortening, 2 teaspoons vanilla extract, baking powder, and salt in a bowl until dough comes together; press into a 9-inch pie plate, reserving about 1 tablespoon for topping."
        },
        {
          "id": 3,
          "text": "Beat ricotta cheese, remaining ¾ cup sugar, remaining 2 eggs, remaining 2 teaspoons vanilla extract, and cinnamon together in a bowl until smooth; pour into crust."
        },
        {
          "id": 4,
          "text": "Divide reserved 1 tablespoon dough into 3 balls; flatten and arrange on top ricotta filling. Sprinkle 1 pinch cinnamon and 1 pinch sugar over top."
        },
        {
          "id": 5,
          "text": "Bake in the preheated oven until crust is golden brown and filling begins to firm, about 1 hour 15 minutes."
        },
        {
          "id": 6,
          "text": "Chill pie in refrigerator until fully firm, about 3 hours."
        }
      ],
      "warnings": [],
