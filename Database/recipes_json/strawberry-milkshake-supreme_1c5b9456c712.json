      "name": "Strawberry Milkshake Supreme",
      "ingredients_raw": [
        "0.25 cup milk",
        "7 strawberries, hulled and sliced",
        "0.25 cup vanilla ice cream",
        "0.25 cup white sugar"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In the container of a blender, combine milk, strawberries, ice cream, and sugar. Blend until smooth, about 10 seconds. Pour into a glass and drink with a wide straw."
        }
