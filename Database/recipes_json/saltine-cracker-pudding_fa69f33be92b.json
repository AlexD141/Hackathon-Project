  "recipes": [
    {
      "name": "Saltine Cracker Pudding",
      "ingredients_raw": [
        "2 eggs, separated",
        "0.5 cup white sugar",
        "4 cups 2% milk",
        "1 cup flaked coconut",
        "2 cups crushed saltine crackers",
        "1 teaspoon vanilla extract"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Beat egg yolks and sugar together in a bowl with an electric mixer until fluffy and pale yellow, 1 to 3 minutes. Heat milk in a large saucepan over medium heat and whisk in egg yolk mixture until smooth; boil for 1 minute. Mix in coconut and cracker crumbs; bring to boil, reduce heat to low, and simmer mixture until thick, about 5 minutes."
        },
        {
          "id": 2,
          "text": "Beat egg whites in a glass or metal mixing bowl with an electric mixer until they hold stiff peaks; gently fold into coconut mixture and mix in vanilla extract. Serve warm or cold. Refrigerate leftovers."
        }
      ],
