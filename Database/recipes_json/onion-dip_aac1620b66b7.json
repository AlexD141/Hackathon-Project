  "recipes": [
    {
      "name": "Onion Dip",
      "ingredients_raw": [
        "0.25 cup mayonnaise",
        "1 tablespoon distilled white vinegar",
        "1 tablespoon soy sauce",
        "1.5 teaspoons water, or more as needed",
        "1 tablespoon minced onion"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Stir the mayonnaise, white vinegar, soy sauce, and water together in a bowl just until combined. Add more water as desired for thinner consistency. Stir in minced onion."
        },
        {
          "id": 2,
          "text": "Cover with plastic wrap and refrigerate until cold."
        }
      ],
