      "name": "Airmail Cocktail",
      "ingredients_raw": [
        "1 cup ice",
        "1 fluid ounce light rum",
        "0.5 fluid ounce lime juice",
        "0.5 fluid ounce honey syrup",
        "1 tablespoon chilled Champagne"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Fill a cocktail shaker with ice; add rum, lime juice, and honey syrup. Cover and shake until the outside of the shaker has frosted. Strain into a Champagne flute and top with Champagne."
        }
