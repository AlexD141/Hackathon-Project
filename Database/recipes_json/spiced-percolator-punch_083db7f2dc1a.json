  "recipes": [
    {
      "name": "Spiced Percolator Punch",
      "ingredients_raw": [
        "1 (64 fluid ounce) bottle unsweetened pineapple juice",
        "1 (64 fluid ounce) bottle cranberry juice cocktail",
        "4.5 cups water",
        "1 cup brown sugar, packed",
        "2 tablespoons whole cloves",
        "4 (4 inch) cinnamon sticks, broken",
        "0.25 teaspoon salt"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Pour the pineapple juice, cranberry juice, and water into a clean, well-washed coffee percolator. Place the brown sugar, cloves, cinnamon sticks, and salt in the basket of the percolator, and assemble the coffee percolator. Cover, plug in the cord, and perk. Serve hot."
        }
      ],
