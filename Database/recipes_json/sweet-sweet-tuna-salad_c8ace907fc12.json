  "recipes": [
    {
      "name": "Sweet Sweet Tuna Salad",
      "ingredients_raw": [
        "1 (5 ounce) can chunk light tuna in water",
        "4 teaspoons creamy salad dressing (such as Miracle Whip®)",
        "2 tablespoons honey mustard",
        "2 tablespoons sweet pickle relish",
        "2 tablespoons minced celery",
        "1 tablespoon minced carrot",
        "2 teaspoons white sugar, or more to taste",
        "0.5 teaspoon salt, or more to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Drain the tuna, reserving 1 tablespoon of the liquid."
        },
        {
          "id": 2,
          "text": "Put tuna in a serving bowl and mash with a fork until it&#39;s as mushy as you can get it. Stir reserved liquid, salad dressing, honey mustard, relish, celery, carrot, sugar, and salt into the tuna. Adjust seasoning to taste."
        }
      ],
