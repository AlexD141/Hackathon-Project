    {
      "name": "Summertime Wonder",
      "ingredients_raw": [
        "1 cup crushed ice",
        "1 cup milk",
        "1 (1.5 fluid ounce) jigger coffee flavored liqueur (such as Kahlua®)",
        "2 teaspoons powdered non-dairy creamer",
        "1 tablespoon unsweetened cocoa powder",
        "0.5 teaspoon coconut extract"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place the ice, milk, coffee flavored liqueur, powdered creamer, cocoa powder, and coconut extract into a blender. Cover, and puree until smooth."
        }
      ],
