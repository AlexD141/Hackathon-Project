  "recipes": [
    {
      "name": "Indian Lassi",
      "ingredients_raw": [
        "ice cubes",
        "1.75 cups plain yogurt",
        "1.5 cups ice water",
        "6 cubes ice, crushed",
        "2 teaspoons white sugar",
        "1 pinch salt"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Fill 6 tall glasses with ice cubes."
        },
        {
          "id": 3,
          "text": "Place yogurt, ice water, crushed ice, sugar, and salt in a blender; blend until frothy."
        },
        {
          "id": 4,
          "text": "Pour over ice cubes in the glasses to serve."
        }
      ],
