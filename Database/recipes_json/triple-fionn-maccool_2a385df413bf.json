  "recipes": [
    {
      "name": "Triple Fionn MacCool",
      "ingredients_raw": [
        "2 fluid ounces Irish cream liqueur",
        "1 fluid ounce Canadian rye whiskey",
        "0.25 cup cold milk",
        "1 pinch cinnamon",
        "2 cups ice cubes"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a cocktail shaker, shake together Irish cream liqueur and Canadian rye whiskey with several cubes of ice. Strain into a glass filled with ice cubes. Top off with milk and a dash of cinnamon. Give it a gentle stir and serve."
        }
      ],
