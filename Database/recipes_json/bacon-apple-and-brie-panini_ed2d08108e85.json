  "recipes": [
    {
      "name": "Bacon, Apple and Brie Panini",
      "ingredients_raw": [
        "2 tablespoons butter, room temperature",
        "2 slices bread",
        "1 teaspoon Dijon mustard",
        "3 slices Brie cheese",
        "1 Fuji apple, thinly sliced",
        "4 strips cooked bacon"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Heat a panini press to medium-high heat according to manufacturer&#39;s instructions."
        },
        {
          "id": 2,
          "text": "Butter 1 side of each slice of bread. Flip 1 slice and spread mustard on top; add cheese. Place apple slices on the cheese. Lay bacon on top. Cover with the other slice of bread, buttered side-up."
        },
        {
          "id": 3,
          "text": "Place sandwich into the panini press and press down. Grill until lightly browned, about 3 minutes per side."
        }
      ],
