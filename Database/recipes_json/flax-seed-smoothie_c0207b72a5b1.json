        "1 cup frozen strawberries",
        "0.5 frozen banana, peeled and cut into chunks",
        "2 tablespoons flaxseed meal"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place soy milk, strawberries, banana, and flaxseed meal into a blender; blend until smooth."
        }
