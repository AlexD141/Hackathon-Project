  "recipes": [
    {
      "name": "Apple Strudel II",
      "ingredients_raw": [
        "3 cups all-purpose flour",
        "1 egg, beaten",
        "1 cup lukewarm water",
        "1 teaspoon white sugar",
        "1 teaspoon lard, melted",
        "1 pinch salt",
        "1.5 cups butter, melted",
        "1 cup toasted bread crumbs",
        "1 cup ground walnuts",
        "3.5 pounds apples - peeled, cored and thinly sliced",
        "0.75 cup raisins",
        "1 teaspoon ground cinnamon",
        "1.75 cups white sugar"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Sift all-purpose flour into a large bowl. Mix in egg, water, white sugar, lard and salt. Knead until soft and smooth. Lightly brush with approximately 1 tablespoon butter. Cover with a towel and set aside 1 hour."
        },
        {
          "id": 2,
          "text": "Mix bread crumbs and 3/4 cup butter in a medium bowl. Mix in ground walnuts, apples, raisins, cinnamon and sugar."
        },
        {
          "id": 3,
          "text": "Preheat oven to 375 degrees F (190 degrees C). Lightly butter a medium baking dish."
        },
        {
          "id": 4,
          "text": "Spread a clean tablecloth or cotton sheet on a large work surface and dust with flour. Gently stretch the dough into a large, very thin rectangle as thin as tissue paper. Cut away thick edges. Sprinkle with approximately 1/2 cup melted butter. Spread bread crumb mixture across the dough, leaving a two inch border on all sides. Fold one end of the dough over the filling, then roll dough to form strudel. Cut so that it will fit the baking dish."
        },
        {
          "id": 5,
          "text": "Place strudel in baking dish and brush with remaining butter. Bake in the preheated oven until golden brown and apples are tender, about 1 hour."
        }
      ],
