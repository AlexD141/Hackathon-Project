  "recipes": [
    {
      "name": "Whiskey Paralyzer",
      "ingredients_raw": [
        "1 cup ice cubes",
        "0.5 cup root beer",
        "1 fluid ounce Canadian whiskey, such as Crown Royal™",
        "1 fluid ounce Kahlua or other coffee flavored liqueur",
        "2 fluid ounces milk"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Fill a highball glass with ice. Add root beer, Canadian whiskey, and coffee liqueur. Slowly pour in milk so it does not curdle; stir gently. Enjoy immediately."
        }
      ],
