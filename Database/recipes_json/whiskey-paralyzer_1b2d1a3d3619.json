            "author": {
              "@type": "Person",
              "name": "katylan"
            },
            "reviewBody": "Good but I prefer Canadian Club to Crown as it is much smoother. Will make again!",
            "datePublished": "2009-12-27T11:45:38.573Z"
          },
          {
