    {
      "name": "Sugar Cream Pie IV",
      "ingredients_raw": [
        "1 (9 inch) unbaked pie crust",
        "1 cup white sugar",
        "0.5 cup all-purpose flour",
        "0.66670000553131 cup brown sugar",
        "0.5 teaspoon salt",
        "1 cup boiling water",
        "1 cup light whipping cream",
        "0.125 teaspoon ground nutmeg",
        "0.5 teaspoon vanilla extract"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 425 degrees F (220 degrees C)."
        },
        {
          "id": 2,
          "text": "In a medium-size mixing bowl, combine white sugar, flour, brown sugar, and salt. Gradually stir in boiling water until mixture is smooth. Mix in cream, nutmeg, and vanilla. Pour mixture into pastry shell."
        },
        {
          "id": 3,
          "text": "Bake in preheated oven for 10 minutes. Reduce heat to 350 degrees F (175 degrees C) and bake an additional 40 minutes."
        }
      ],
