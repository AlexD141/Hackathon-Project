  "recipes": [
    {
      "name": "Tropical Quinoa",
      "ingredients_raw": [
        "1 cup water",
        "0.5 cup uncooked quinoa, rinsed",
        "0.25 cup chopped dried pineapple",
        "0.25 cup chopped dried mango",
        "0.25 cup sweetened coconut flakes",
        "0.25 cup dry-roasted macadamia nuts, chopped",
        "2 tablespoons regular mango chutney",
        "1 tablespoon hot mango chutney"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Bring water and quinoa to a boil in a saucepan over medium heat. Cover the saucepan, reduce the heat, and simmer until water is absorbed, 10 to 12 minutes."
        },
        {
          "id": 2,
          "text": "Off heat, stir pineapple, mango, coconut, macadamia nuts, and mango chutneys into quinoa until thoroughly combined. Serve hot."
        }
      ],
