  "recipes": [
    {
      "name": "Rachel&#39;s Crab Imperial",
      "ingredients_raw": [
        "1 tablespoon margarine",
        "2 tablespoons all-purpose flour",
        "2 cups milk",
        "1 pound cooked crabmeat",
        "2 teaspoons Worcestershire sauce",
        "0.5 green bell pepper, minced",
        "1 egg, beaten",
        "salt and ground black pepper to taste",
        "cayenne pepper to taste",
        "2 slices white bread, crumbled into fine breadcrumbs",
        "1 tablespoon melted butter"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat an oven to 350 degrees F (175 degrees C). Butter a 9x9-inch baking dish."
        },
        {
          "id": 2,
          "text": "Melt the margarine in a large saucepan over medium heat. Stir in the flour, and cook a few minutes until the bubbles begin to subside. Whisk in the milk, and cook over medium-high heat until thickened. Stir in the crabmeat, Worcestershire sauce, green pepper, and beaten egg. Season to taste with salt, black pepper, and cayenne pepper. Cook, stirring constantly until quite thick. Spoon into the prepared baking dish."
        },
        {
          "id": 3,
          "text": "Place the breadcrumbs into a mixing bowl, and drizzle with the melted butter. Toss together until the breadcrumbs are evenly moistened with butter. Sprinkle the breadcrumbs evenly over the crab mixture."
        },
        {
          "id": 4,
          "text": "Bake in the preheated oven until the casserole has firmed and the bread crumbs are golden brown, 10 to 15 minutes."
        }
      ],
