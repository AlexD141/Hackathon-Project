  "recipes": [
    {
      "name": "Kingfish Enchiladas",
      "ingredients_raw": [
        "1 pound king mackerel fillets - cleaned, washed and cubed",
        "0.5 cup Italian-style salad dressing",
        "0.25 cup all-purpose flour",
        "2 tablespoons olive oil",
        "1 onion, diced",
        "1 green bell pepper, diced",
        "1 (16 ounce) jar salsa",
        "8 (8 inch) flour tortillas",
        "8 ounces shredded Cheddar cheese"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine fish cubes with Italian dressing. Let marinate for at least 30 minutes. Dredge fish cubes in flour and set aside."
        },
        {
          "id": 2,
          "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly oil a 9x13 inch baking pan."
        },
        {
          "id": 3,
          "text": "In a non-stick frying pan, heat olive oil over medium high heat. Add onions and green pepper. Cook slowly, stirring occasionally until vegetables are soft. Stir in fish cubes and cook until fish is soft, about 5 minutes. Stir in half of the salsa and remove mixture from heat."
        },
        {
          "id": 4,
          "text": "Spoon mixture into tortillas, roll up and place seam down in prepared baking pan. Spoon remaining salsa over the enchiladas and sprinkle with shredded cheese."
        },
        {
          "id": 5,
          "text": "Bake in preheated oven for 15 minutes."
        }
      ],
