    {
      "name": "White Chili V",
      "ingredients_raw": [
        "2 (48 ounce) jars Great Northern white beans",
        "1 (28 ounce) can crushed tomatoes (such as Hunt's®)",
        "3 (4 ounce) cans chopped green chilies",
        "2 cups diced cooked chicken",
        "1 (32 ounce) can chicken broth",
        "1 (1.25 ounce) package taco seasoning",
        "1 teaspoon cayenne pepper",
        "1 teaspoon ground cumin",
        "1 teaspoon ground Mexican oregano",
        "1 teaspoon ground marjoram",
        "2 cloves garlic, minced"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine the Great Northern white beans, crushed tomatoes, green chilies, cooked chicken, chicken broth, taco seasoning, cayenne pepper, ground cumin, ground Mexican oregano, ground marjoram, and minced garlic in a slow cooker."
        },
        {
          "id": 2,
          "text": "Cook on Low until the flavors are thoroughly blended, about 8 hours."
        }
      ],
