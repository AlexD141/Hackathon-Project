  "recipes": [
    {
      "name": "French Cream Filling",
      "ingredients_raw": [
        "0.75 cup heavy whipping cream",
        "0.25 cup milk",
        "0.25 cup confectioners' sugar",
        "1 egg white, stiffly beaten",
        "0.5 teaspoon vanilla extract"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Mix heavy cream with milk and beat until stiff. Fold in sugar, beaten egg white, and vanilla. Gently mix until all sugar is incorporated."
        }
      ],
