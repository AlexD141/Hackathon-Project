  "recipes": [
    {
      "name": "Bethany&#39;s Favorite Valentine Cut Out Sugar Cookies",
      "ingredients_raw": [
        "1 cup butter, softened",
        "1 cup white sugar",
        "1 egg, beaten",
        "2 tablespoons milk",
        "1 teaspoon vanilla extract",
        "0.5 teaspoon almond extract",
        "2.5 cups flour",
        "1 teaspoon baking powder"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Cream together the butter, sugar, egg, milk, vanilla extract, and almond extract in a large bowl."
        },
        {
          "id": 2,
          "text": "Stir in the flour and baking powder."
        },
        {
          "id": 3,
          "text": "Cover and refrigerate until firm, about 2 hours."
        },
        {
          "id": 4,
          "text": "Preheat oven to 400 degrees F (200 degrees C)."
        },
        {
          "id": 5,
          "text": "Divide the dough into thirds. On a lightly floured surface, roll out each portion to 1/4-inch thick."
        },
        {
          "id": 6,
          "text": "Cut cookies out using a floured cookie cutter."
        },
        {
          "id": 7,
          "text": "Arrange cookies on an ungreased baking sheet about 1-inch apart."
        },
        {
          "id": 8,
          "text": "Bake until cookies are lightly golden, 6 to 9 minutes."
        },
        {
          "id": 9,
          "text": "Transfer cookies to a wire rack to cool completely."
        }
      ],
      "warnings": [],
