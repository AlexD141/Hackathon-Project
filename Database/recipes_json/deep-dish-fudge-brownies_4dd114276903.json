  "recipes": [
    {
      "name": "Deep Dish Fudge Brownies",
      "ingredients_raw": [
        "0.75 cup all-purpose flour",
        "0.75 cup cake flour",
        "0.25 teaspoon baking powder",
        "0.25 teaspoon salt",
        "1 cup butter, softened",
        "4 (1 ounce) squares unsweetened chocolate",
        "1.75 cups white sugar",
        "4 eggs",
        "2 teaspoons vanilla extract",
        "1 cup semisweet chocolate chips"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350. Grease and flour one 9 inch square baking pan, tapping out excess flour."
        },
        {
          "id": 2,
          "text": "Melt the butter and unsweetened chocolate in the top of a double boiler and then let cool for about 15 minutes."
        },
        {
          "id": 3,
          "text": "Sift together both flours, baking powder and salt. Set aside. In Large bowl, whisk chocolate/butter mixture to blend. Beat in sugar, then vanilla, then eggs. Fold in dry ingredients and mix well. Stir in semisweet chocolate chips. Scrape batter into prepared pan, spreading evenly."
        },
        {
          "id": 4,
          "text": "Bake at 350 degrees F (175 degrees C) for 30 to 35 minutes until set. Do not overbake. Cool in pan on a wire rack. Once cool cut into large squares."
        }
      ],
