  "recipes": [
    {
      "name": "Cherry Delight with Walnut Crust",
      "ingredients_raw": [
        "6 egg whites",
        "2 cups white sugar",
        "0.75 teaspoon cream of tartar",
        "2 cups crushed saltine crackers",
        "1 cup chopped walnuts",
        "2 teaspoons vanilla extract",
        "2 (21 ounce) cans cherry pie filling",
        "1 (16 ounce) package frozen whipped topping, thawed"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13 inch pan."
        },
        {
          "id": 2,
          "text": "Beat egg whites until stiff. Gradually add the sugar and cream of tarter; beat until sugar is dissolved."
        },
        {
          "id": 3,
          "text": "Add crackers, nuts and vanilla. Pour into prepared pan and bake for 25 minutes in the preheated oven."
        },
        {
          "id": 4,
          "text": "Remove from oven, cool and cut into squares. Top each serving with pie filling and whipped topping."
        }
      ],
