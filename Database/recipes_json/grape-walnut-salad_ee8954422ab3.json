      "name": "Grape-Walnut Salad",
      "ingredients_raw": [
        "1 pound seedless green grapes, rinsed and patted dry",
        "6 ounces roughly chopped walnuts",
        "0.5 cup blue cheese dressing"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place grapes in a large bowl. Stir in the walnuts. Pour the blue cheese dressing over the grape mixture and stir until everything is evenly coated. Chill until ready to serve."
        }
