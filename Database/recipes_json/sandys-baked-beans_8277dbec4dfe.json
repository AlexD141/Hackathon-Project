  "recipes": [
    {
      "name": "Sandy&#39;s Baked Beans",
      "ingredients_raw": [
        "4 (15 ounce) cans baked beans with pork",
        "1 small onion, chopped",
        "3 tablespoons bacon grease",
        "0.75 cup brown sugar",
        "1 cup ketchup",
        "2 slices bacon, cut in half"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 300 degrees F (150 degrees C)."
        },
        {
          "id": 2,
          "text": "In a 2 quart casserole dish, combine the pork and beans, onion, bacon grease, brown sugar and ketchup. Mix well and top with the bacon strips."
        },
        {
          "id": 3,
          "text": "Bake at 300 degrees F (150 degrees C) for 1 1/2 to 2 hours."
        }
      ],
      "warnings": [],
