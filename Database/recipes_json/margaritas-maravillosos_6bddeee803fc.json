    {
      "name": "Margaritas Maravillosos",
      "ingredients_raw": [
        "10 (1.5 fluid ounce) jiggers gold tequila",
        "1 (12 ounce) can frozen limeade concentrate",
        "5 (1.5 fluid ounce) jiggers triple sec",
        "1 tablespoon freshly grated lime peel",
        "2 tablespoons fresh lime juice",
        "4 teaspoons white sugar",
        "5 cups ice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Add tequila, limeade concentrate, triple sec, lime zest, lime juice, and sugar to a blender; blend until well combined."
        },
        {
          "id": 2,
          "text": "Serve over ice."
        }
      ],
