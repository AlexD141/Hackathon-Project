  "recipes": [
    {
      "name": "The Best Vegetable Salad",
      "ingredients_raw": [
        "5 romaine lettuce leaves, torn into bite size pieces",
        "2 fresh tomatoes, chopped",
        "1 small jicama, peeled and julienned",
        "1 cucumber, peeled and chopped",
        "1 red bell pepper, chopped",
        "2 green onion, minced",
        "5 radishes, chopped",
        "2 tablespoons olive oil",
        "1.5 tablespoons lemon juice",
        "1 tablespoon pomegranate juice",
        "1.5 teaspoons water",
        "1 teaspoon chopped fresh dill",
        "1 teaspoon chopped fresh basil",
        "1 teaspoon salt",
        "1 teaspoon ground black pepper",
        "1 clove garlic, minced"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Place romaine, tomatoes, jicama, cucumber, bell pepper, green onions, and radishes in a large bowl."
        },
        {
          "id": 3,
          "text": "Whisk olive oil, lemon juice, pomegranate juice, water, dill, basil, salt, black pepper, and garlic together in a small bowl; drizzle over salad just before serving."
        }
      ],
