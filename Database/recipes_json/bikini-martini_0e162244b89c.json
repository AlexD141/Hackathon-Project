    {
      "name": "Bikini Martini",
      "ingredients_raw": [
        "1 fluid ounce coconut rum",
        "0.75 fluid ounce vodka",
        "1 fluid ounce pineapple juice",
        "1 dash grenadine syrup"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine rum, vodka and pineapple juice in a drink shaker. Shake firmly until frothy. Pour in a martini glass, add a touch of grenadine in the middle. Garnish with an orange wheel."
        }
