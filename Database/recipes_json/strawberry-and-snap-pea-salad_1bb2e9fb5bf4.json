  "recipes": [
    {
      "name": "Strawberry and Snap Pea Salad",
      "ingredients_raw": [
        "1 cup sugar snap peas",
        "1.5 tablespoons extra virgin olive oil",
        "2 teaspoons raspberry vinegar",
        "0.5 teaspoon Dijon mustard",
        "4 cups sliced fresh strawberries"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Bring a medium pot of water to boil and place a steamer insert in the pot. Place snap peas in the steamer, cover, and cook until bright green, about 30 seconds. Drain, run under cold water to cool completely, drain, and set aside."
        },
        {
          "id": 2,
          "text": "Whisk oil, vinegar, and mustard together in a bowl until well combined. Set aside for 3 to 5 minutes."
        },
        {
          "id": 3,
          "text": "Combine snap peas and strawberries in a large bowl; pour vinaigrette over top and toss gently. Serve immediately or chill for up to 1 hour."
        }
      ],
