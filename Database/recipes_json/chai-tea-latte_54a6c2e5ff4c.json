  "recipes": [
    {
      "name": "Chai Tea Latte",
      "ingredients_raw": [
        "0.75 cup boiling water",
        "1 chai tea bag",
        "1.5 teaspoons honey",
        "1 teaspoon white sugar",
        "0.75 cup milk"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Pour boiling water over chai tea bag in a mug; let steep 4 to 6 minutes. Remove and discard tea bag."
        },
        {
          "id": 3,
          "text": "Stir honey and sugar into tea to dissolve. Stir milk through tea to serve."
        }
      ],
