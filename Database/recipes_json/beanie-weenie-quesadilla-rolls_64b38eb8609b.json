  "recipes": [
    {
      "name": "Beanie Weenie Quesadilla Rolls",
      "ingredients_raw": [
        "0.25 cup condensed bean with bacon soup",
        "1 (8 inch) flour tortilla",
        "1 turkey hot dog",
        "0.25 cup shredded Cheddar cheese"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Pour soup into a small microwave safe bowl. Wrap tortilla and hot dog with a clean, lightly moist cloth. Place soup, tortilla, and hot dog in microwave and cook on high approximately 30 seconds, or until tortilla is hot and pliable and the soup is hot."
        },
        {
          "id": 2,
          "text": "Place hot dog and soup in center of tortilla; sprinkle with cheese and roll. Microwave for an additional 10 seconds to fully melt the cheese."
        }
      ],
