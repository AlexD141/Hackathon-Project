  "recipes": [
    {
      "name": "Pork Chops with Praline Sauce",
      "ingredients_raw": [
        "4 pork chops",
        "1 tablespoon butter",
        "0.5 cup brown sugar",
        "0.75 cup evaporated milk",
        "0.25 cup light corn syrup",
        "0.25 cup chopped pecans"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a large skillet over medium-high heat, cook the pork chops until no longer pink in the center, 5 to 7 minutes per side. An instant-read thermometer inserted into the center should read 145 degrees F (63 degrees C)."
        },
        {
          "id": 2,
          "text": "Melt the butter in a saucepan; stir the brown sugar into the melted butter until smooth. Add the evaporated milk and stir; bring the mixture to a boil and immediately remove from heat. Stir the corn syrup into the milk mixture; fold the pecans into the sauce. Spoon the sauce over the pork chops to serve."
        }
      ],
