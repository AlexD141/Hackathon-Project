  "recipes": [
    {
      "name": "Derby Day Chocolate Chip Cookies",
      "ingredients_raw": [
        "2.25 cups all-purpose flour",
        "1 teaspoon baking soda",
        "0.5 teaspoon salt",
        "1 cup butter, softened",
        "1 cup packed brown sugar",
        "0.5 cup white sugar",
        "2 eggs",
        "5 tablespoons Kentucky bourbon",
        "1.5 cups chopped pecans",
        "1.5 cups semisweet chocolate chips"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Combine flour, baking soda, and salt in a medium bowl with a fork; set aside."
        },
        {
          "id": 3,
          "text": "Beat butter, brown sugar, and white sugar together in a large bowl until smooth; beat in eggs, one at a time, beating well after each addition. Beat in bourbon. Stir in flour mixture just until blended. Fold in pecans and chocolate chips until evenly distributed. Drop dough by large spoonfuls onto ungreased baking sheets."
        },
        {
          "id": 4,
          "text": "Bake in the preheated oven until edges are lightly browned, about 10 minutes. Cool cookies on the baking sheets for 1 minute, then transfer to wire racks to cool completely."
        }
      ],
