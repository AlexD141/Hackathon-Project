  "recipes": [
    {
      "name": "Spicy Pickled Okra",
      "ingredients_raw": [
        "0.75 pound fresh okra",
        "4.5 cups cider vinegar",
        "2 cups water",
        "3 cloves chopped garlic",
        "0.25 cup crushed red pepper flakes",
        "0.25 cup smoked paprika",
        "4.5 teaspoons salt",
        "1 tablespoon Szechuan peppercorns"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Wash the okra, rubbing lightly to remove any grit and fuzz. Sterilize 2 (1 quart ) canning jars and lids in boiling water for at least 10 minutes, allow to cool before filling with okra."
        },
        {
          "id": 2,
          "text": "Combine the cider vinegar, water, garlic, red pepper flakes, smoked paprika, salt, and peppercorns to a boil in a large pot over medium-high heat. Reduce the temperature and simmer for 15 minutes. Remove from the heat."
        },
        {
          "id": 3,
          "text": "Pack fresh, cleaned okra loosely into the jars. Pour the hot brine over the okra, filling the jars to the top. Seal jars, making sure you have cleaned the jar&#39;s rims of any residue. Store the jars in the refrigerator. Allow contents to pickle at least one week minimum before eating, two weeks is best."
        }
      ],
