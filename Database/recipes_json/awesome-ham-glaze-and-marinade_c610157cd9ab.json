  "recipes": [
    {
      "name": "Awesome Ham Glaze and Marinade",
      "ingredients_raw": [
        "1 cup real maple syrup",
        "2 tablespoons dried minced garlic",
        "2 tablespoons ground ginger",
        "2 teaspoons ground black pepper",
        "1 teaspoon crushed red pepper flakes"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Mix maple syrup, dried garlic, ginger, black pepper, and red pepper flakes in a bowl until thoroughly combined. Let glaze stand about 10 minutes before glazing ham."
        }
      ],
