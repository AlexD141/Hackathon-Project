            "author": {
              "@type": "Person",
              "name": "jessielees"
            },
            "reviewBody": "My family LOVES this. I use half the sugar and gluten-free flour. Bring it to every Thanksgiving and Christmas potluck! :)",
            "datePublished": "2023-10-07T17:19:21.611Z"
          },
          {
