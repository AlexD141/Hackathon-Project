  "recipes": [
    {
      "name": "Sweet Potato Casserole VII",
      "ingredients_raw": [
        "3 cups mashed sweet potatoes",
        "0.5 cup white sugar",
        "2 eggs, beaten",
        "0.25 cup melted butter",
        "0.5 cup milk",
        "1 teaspoon vanilla extract",
        "1 cup packed brown sugar",
        "0.33333298563957 cup all-purpose flour",
        "3 tablespoons butter",
        "1 cup shredded coconut"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C). Spray one 2 1/2 quart casserole dish with non-stick cooking spray."
        },
        {
          "id": 2,
          "text": "In a large bowl, combine the sweet potatoes, sugar, eggs, 1/4 cup butter, milk and vanilla. Pour into prepared casserole dish."
        },
        {
          "id": 3,
          "text": "Mix together the brown sugar, flour, margarine and coconut; sprinkle over casserole."
        },
        {
          "id": 4,
          "text": "Bake at 350 degrees F (175 degrees C) for 25 to 30 minutes."
        }
      ],
