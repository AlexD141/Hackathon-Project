  "recipes": [
    {
      "name": "Barb&#39;s Broccoli-Cauliflower Salad",
      "ingredients_raw": [
        "12 slices bacon",
        "1 head cauliflower, chopped",
        "1 head fresh broccoli, diced",
        "0.75 cup sunflower seeds",
        "0.5 red onion, diced",
        "1 cup creamy salad dressing",
        "1.5 tablespoons white wine vinegar",
        "0.25 cup white sugar"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels; crumble."
        },
        {
          "id": 2,
          "text": "Combine bacon, cauliflower, broccoli, sunflower seeds, and onion in a large bowl."
        },
        {
          "id": 3,
          "text": "Whisk salad dressing, sugar, and vinegar together in a jug until blended. Pour over cauliflower mixture and toss to coat."
        },
        {
          "id": 4,
          "text": "Refrigerate salad and allow to chill before serving."
        }
      ],
