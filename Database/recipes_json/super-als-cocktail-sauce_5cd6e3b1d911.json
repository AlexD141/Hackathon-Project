      "name": "Super Al&#39;s Cocktail Sauce",
      "ingredients_raw": [
        "2 tablespoons finely grated raw horseradish",
        "1 teaspoon dark brown sugar",
        "0.125 teaspoon fresh lemon juice",
        "6 tablespoons ketchup"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a small bowl combine horseradish, brown sugar, lemon juice and ketchup. Mix well. Chill in refrigerator."
        }
