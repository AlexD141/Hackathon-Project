  "recipes": [
    {
      "name": "Berry Good Smoothie",
      "ingredients_raw": [
        "16 cubes ice",
        "0.5 cup water",
        "0.5 cup mixed berry fruit juice",
        "0.5 cup frozen red raspberries",
        "2.25 cups frozen mixed berries",
        "0.25 cup frozen blueberries"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Blend ice cubes in a blender until crushed. Pour in water and juice; blend."
        },
        {
          "id": 2,
          "text": "Add frozen raspberries, mixed berries, and blueberries; blend until smooth. Pour into chilled glasses."
        }
      ],
