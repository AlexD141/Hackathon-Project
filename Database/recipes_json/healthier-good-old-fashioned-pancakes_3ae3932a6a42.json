  "recipes": [
    {
      "name": "Healthier Good Old Fashioned Pancakes",
      "ingredients_raw": [
        "1.5 cups all-purpose flour",
        "3.5 teaspoons baking powder",
        "1 teaspoon salt",
        "1 tablespoon white sugar",
        "1.25 cups nonfat milk",
        "2 egg whites",
        "2 tablespoons butter, melted"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Sift flour, baking powder, salt, and sugar together in a large bowl. Make a well in the center and pour in milk, egg whites, and melted butter; mix until smooth."
        },
        {
          "id": 2,
          "text": "Heat a lightly oiled griddle or frying pan over medium-high heat. Using approximately 1/4 cup for each pancake, pour or scoop batter onto griddle. Brown on both sides and serve hot."
        }
      ],
