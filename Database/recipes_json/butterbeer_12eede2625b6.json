  "recipes": [
    {
      "name": "Butterbeer",
      "ingredients_raw": [
        "2 cups ginger ale",
        "1 teaspoon butter",
        "1 tablespoon brown sugar",
        "0.25 teaspoon cinnamon"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place the ginger ale in a 2-cup microwave-safe measuring cup, and microwave on high until the soda is hot but not boiling, 1 to 2 minutes. Gently stir in the butter to melt, then stir in the brown sugar and cinnamon. Don&#39;t stir too vigorously to avoid the soda fizzing up. Pour the drink into mugs, and serve."
        }
      ],
