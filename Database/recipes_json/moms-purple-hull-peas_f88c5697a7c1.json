  "recipes": [
    {
      "name": "Mom&#39;s Purple Hull Peas",
      "ingredients_raw": [
        "1.5 pounds frozen purple hull peas",
        "water to cover",
        "8 ounces fresh okra",
        "4 ounces bacon, cut into 1/2 inch pieces",
        "1 tablespoon white sugar",
        "0.125 teaspoon baking soda",
        "salt and pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Place purple hull peas into a large pot; pour in enough cold water to cover peas. Bring to a boil over high heat."
        },
        {
          "id": 3,
          "text": "Add okra if using and boil for 2 minutes, stirring twice."
        },
        {
          "id": 4,
          "text": "Reduce heat to medium-low; add bacon, sugar, baking soda, salt, and pepper."
        },
        {
          "id": 5,
          "text": "Cover and simmer until tender, 1 1/2 to 2 hours."
        }
      ],
