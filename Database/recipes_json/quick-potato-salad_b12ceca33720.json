  "recipes": [
    {
      "name": "Quick Potato Salad",
      "ingredients_raw": [
        "2 potatoes, peeled and diced",
        "3 hard-cooked eggs, peeled and diced",
        "0.5 cucumber, peeled and diced",
        "1 tomato, diced",
        "1 celery stalk, diced",
        "0.25 onion, diced",
        "0.25 cup chopped green onion",
        "0.75 cup low-fat mayonnaise",
        "1 tablespoon prepared yellow mustard",
        "salt and ground black pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Bring a large pot of lightly salted water to a boil. Add potatoes and cook until soft, 5 to 7 minutes; drain and rinse with cold water."
        },
        {
          "id": 2,
          "text": "Combine the potatoes, eggs, cucumber, tomato, celery, onion, green onion, mayonnaise, and mustard in a large bowl; stir until evenly combined. Season with salt and pepper."
        }
      ],
