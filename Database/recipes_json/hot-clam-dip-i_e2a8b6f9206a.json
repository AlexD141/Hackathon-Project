  "recipes": [
    {
      "name": "Hot Clam Dip",
      "ingredients_raw": [
        "2 (6.5 ounce) cans minced clams, drained",
        "1 teaspoon lemon juice",
        "0.5 cup butter",
        "1 small onion, minced",
        "0.5 green bell pepper, minced",
        "1 teaspoon dried parsley",
        "1 teaspoon dried oregano",
        "1 dash hot pepper sauce",
        "1 pinch ground cayenne pepper",
        "0.5 cup dried bread crumbs, seasoned",
        "0.5 cup shredded Cheddar cheese",
        "1 pinch paprika"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Combine minced clams and lemon juice in a small saucepan. Bring mixture to a simmer. Simmer for 15 minutes."
        },
        {
          "id": 3,
          "text": "Combine butter, onion, bell pepper, parsley, oregano, hot sauce, and red pepper in a medium-sized saucepan. Stir vegetables over medium-low heat until butter is melted. Mix in clams and breadcrumbs."
        },
        {
          "id": 4,
          "text": "Pour mixture into an ovenproof baking dish. Top with shredded Cheddar cheese and sprinkle with paprika."
        },
        {
          "id": 5,
          "text": "Bake in the preheated oven, uncovered, for 20 minutes."
        }
      ],
