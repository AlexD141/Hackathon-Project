              "@type": "Rating",
              "ratingValue": "5"
            },
            "author": {
              "@type": "Person",
              "name": "J"
            },
            "reviewBody": "A friend gave us this recipe and called them \"Beergaritas\" they are a forever favorite! Except we don't usually blend them. So good!",
            "datePublished": "2009-02-25T10:16:59.977Z"
          },
          {
            "@type": "Review",
            "reviewRating": {
              "@type": "Rating",
