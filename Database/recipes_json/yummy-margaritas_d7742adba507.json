  "recipes": [
    {
      "name": "Yummy Margaritas",
      "ingredients_raw": [
        "1 (12 fluid ounce) can frozen limeade concentrate",
        "6 fluid ounces beer",
        "6 fluid ounces tequila",
        "4 cups ice",
        "salt as needed",
        "1 lime, sliced"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine limeade, beer, and tequila in a blender. Fill with ice. Blend until thick and smooth."
        },
        {
          "id": 2,
          "text": "Pour salt onto a small plate, moisten rims of cocktail glasses with a damp towel; press rims into salt."
        },
        {
          "id": 3,
          "text": "Pour margarita into prepared glasses; garnish with a lime slice and serve."
        }
      ],
