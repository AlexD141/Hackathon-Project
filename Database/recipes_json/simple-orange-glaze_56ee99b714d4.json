  "recipes": [
    {
      "name": "Simple Orange Glaze",
      "ingredients_raw": [
        "1 cup confectioners' sugar",
        "1 medium orange, zested and juiced, divided"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Place confectioners&#39; sugar into a bowl. Add 1 tablespoon orange juice and 1/4 teaspoon orange zest."
        },
        {
          "id": 3,
          "text": "Whisk until smooth, adding more juice as needed for desired consistency; reserve remaining zest and juice for another use."
        }
      ],
