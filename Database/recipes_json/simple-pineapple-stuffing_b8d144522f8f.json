    {
      "name": "Simple Pineapple Stuffing",
      "ingredients_raw": [
        "nonstick cooking spray",
        "1 (15.25 ounce) can crushed pineapple, drained",
        "3 beaten egg",
        "1 (5 ounce) can sweetened condensed milk",
        "0.5 cup white sugar",
        "12 slices white bread, cubed"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat a 9x13-inch glass baking dish with cooking spray."
        },
        {
          "id": 2,
          "text": "Combine pineapple, eggs, condensed milk, and sugar in a large bowl; mix well. Gently fold in bread cubes until well moistened; pour into the prepared baking dish."
        },
        {
          "id": 3,
          "text": "Bake in the preheated oven until lightly golden on top, 25 to 30 minutes."
        }
      ],
