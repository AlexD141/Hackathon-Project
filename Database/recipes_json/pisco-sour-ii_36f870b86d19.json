      "name": "Pisco Sour II",
      "ingredients_raw": [
        "2 cups pisco",
        "1 cup fresh lime juice",
        "1 egg white",
        "1.3333333730698 cups confectioners' sugar",
        "2 cups crushed ice",
        "aromatic bitters"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Blend the pisco, lime juice, egg white, sugar, and ice in a blender until smooth, about 1 minute. Pour into fluted glasses and top each with 1 to 2 dashes of the aromatic bitters to serve."
        }
      ],
