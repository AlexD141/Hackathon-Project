      "name": "Old-Fashioned Lemonade",
      "ingredients_raw": [
        "6 lemons",
        "1 cup white sugar",
        "6 cups water, or more as needed"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Juice lemons; you should have 1 cup juice."
        },
        {
          "id": 3,
          "text": "Combine juice, sugar, and water in a 1/2-gallon pitcher. Stir until sugar dissolves. Taste and add more water if desired."
        },
        {
          "id": 4,
          "text": "Chill and serve over ice."
        }
