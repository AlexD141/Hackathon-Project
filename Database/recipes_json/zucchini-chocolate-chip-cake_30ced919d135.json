  "recipes": [
    {
      "name": "Zucchini Chocolate Chip Cake",
      "ingredients_raw": [
        "0.5 cup milk",
        "1 teaspoon distilled white vinegar",
        "2.5 cups all-purpose flour",
        "0.25 cup unsweetened cocoa powder",
        "1 teaspoon baking soda",
        "0.5 teaspoon baking powder",
        "1.5 cups white sugar",
        "0.5 cup butter, softened",
        "0.5 cup vegetable oil",
        "2 eggs",
        "2 teaspoons vanilla extract",
        "2 cups grated zucchini",
        "1 cup chocolate chips"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients. Preheat the oven to 325 degrees F (165 degrees C). Grease and flour a 9x13-inch baking dish."
        },
        {
          "id": 2,
          "text": "Combine milk and vinegar in a large bowl; let stand to sour milk, about 5 minutes."
        },
        {
          "id": 3,
          "text": "Meanwhile, combine flour, cocoa powder, baking soda, and baking powder in a medium bowl."
        },
        {
          "id": 4,
          "text": "Add sugar, butter, oil, eggs, and vanilla to soured milk; beat until incorporated. Add flour mixture; stir until just combined. Fold in zucchini."
        },
        {
          "id": 5,
          "text": "Pour batter into the prepared baking dish. Sprinkle with chocolate chips."
        },
        {
          "id": 6,
          "text": "Bake in the preheated oven until a toothpick inserted into the center of cake comes out clean, about 45 minutes. Transfer to a wire rack to cool completely."
        }
      ],
