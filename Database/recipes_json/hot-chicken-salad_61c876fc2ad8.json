  "recipes": [
    {
      "name": "Hot Chicken Salad",
      "ingredients_raw": [
        "2.5 cups chopped, cooked chicken meat",
        "2 cups chopped celery",
        "0.5 cup chopped salted almonds",
        "0.25 cup chopped green bell pepper",
        "2 tablespoons minced onion",
        "2 tablespoons chopped pimento peppers",
        "0.75 teaspoon salt",
        "2 tablespoons lemon juice",
        "0.5 cup mayonnaise",
        "0.33333298563957 cup shredded Swiss cheese",
        "3 cups crushed potato chips"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Combine the chicken, celery, almonds, bell pepper, onion, pimento, salt, lemon juice, and mayonnaise. Mix well and pour into a 1 1/2 quart casserole dish."
        },
        {
          "id": 3,
          "text": "Top with grated cheese and the crushed potato chips. Bake for 25 minutes or until cheese is melted."
        }
      ],
