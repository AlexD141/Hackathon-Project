  "recipes": [
    {
      "name": "Vegan-Friendly Caramel Buttercream",
      "ingredients_raw": [
        "0.5 cup vegan margarine",
        "1 cup brown sugar, not packed",
        "0.25 cup soy milk",
        "1 teaspoon vanilla extract",
        "0.5 cup shortening",
        "5 cups confectioners' sugar"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Stir the margarine and brown sugar together in a pan. Bring to a boil over medium-high heat, stirring constantly, and cook for 1 minute until dark brown. Remove from heat, and whisk in the soy milk and vanilla extract until smooth."
        },
        {
          "id": 2,
          "text": "Beat the shortening together with 2 cups confectioners&#39; sugar in a mixing bowl until well blended. Continue beating, and gradually add the brown sugar mixture, alternating with the remaining confectioners&#39; sugar."
        }
      ],
