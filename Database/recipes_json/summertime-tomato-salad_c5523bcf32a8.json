    {
      "name": "Summertime Tomato Salad",
      "ingredients_raw": [
        "0.5 cup vegetable oil",
        "0.25 cup white vinegar",
        "0.5 teaspoon white sugar",
        "0.5 teaspoon ground black pepper",
        "1 teaspoon Dijon mustard",
        "2 teaspoons seasoned salt",
        "3 tomatoes, diced",
        "2 onions, diced"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Whisk together the vegetable oil, vinegar, sugar, pepper, mustard, and seasoned salt in a bowl; add the tomato and onion to the bowl and toss to coat; cover and refrigerate overnight."
        }
      ],
