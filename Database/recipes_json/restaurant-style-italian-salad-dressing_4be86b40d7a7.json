      "name": "Restaurant-Style Italian Salad Dressing",
      "ingredients_raw": [
        "1 cup Italian-style salad dressing",
        "1 clove garlic, minced",
        "0.5 teaspoon dried basil",
        "0.5 teaspoon dried oregano",
        "1 tablespoon white sugar"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a mixing bowl, whisk together the bottled dressing, garlic, basil, oregano and sugar. Refrigerate at least 24 hours before serving."
        }
