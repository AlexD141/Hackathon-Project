  "recipes": [
    {
      "name": "Marinated Pasta Salad",
      "ingredients_raw": [
        "1 cup canola oil",
        "0.66666668653488 cup white sugar",
        "0.66666668653488 cup ketchup",
        "0.5 cup white vinegar",
        "2 teaspoons salt",
        "0.5 teaspoon ground black pepper",
        "4 cups rotini pasta",
        "2 tomatoes, chopped",
        "1 small onion, diced",
        "1 green bell pepper, chopped",
        "1 cup chopped cucumber"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Whisk canola oil, sugar, ketchup, vinegar, salt, and black pepper together in a bowl. Set aside to let the flavors blend for 30 minutes."
        },
        {
          "id": 2,
          "text": "Bring a large pot of lightly salted water to a boil; add pasta and cook until tender yet firm to the bite, about 8 minutes; drain. Rinse with cold water to cool; drain."
        },
        {
          "id": 3,
          "text": "Combine cooled pasta, tomatoes, onion, green bell pepper, and cucumber in a bowl."
        },
        {
          "id": 4,
          "text": "Drizzle the dressing over the pasta mixture and toss to coat."
        },
        {
          "id": 5,
          "text": "Chill in refrigerator for 1 hour before serving."
        }
      ],
