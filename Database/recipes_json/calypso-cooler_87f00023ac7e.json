  "recipes": [
    {
      "name": "Calypso Cooler",
      "ingredients_raw": [
        "1 fluid ounce coconut-flavored rum",
        "0.5 fluid ounce peach schnapps",
        "7 fluid ounces orange juice",
        "ice",
        "0.5 fluid ounce grenadine syrup",
        "1 orange slice",
        "2 maraschino cherries"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Pour rum, schnapps, and orange juice into a cocktail shaker over ice. Cover and shake until the outside of the shaker has frosted. Pour into a chilled glass, then top with grenadine syrup. Garnish with orange slice and maraschino cherries."
        }
      ],
