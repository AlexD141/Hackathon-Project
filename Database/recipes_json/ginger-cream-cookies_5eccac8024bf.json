  "recipes": [
    {
      "name": "Ginger Cream Cookies",
      "ingredients_raw": [
        "0.33333298563957 cup shortening",
        "0.5 cup white sugar",
        "1 egg",
        "0.5 cup molasses",
        "0.5 cup water",
        "2 cups self-rising flour",
        "0.5 teaspoon salt",
        "1 teaspoon ground ginger",
        "0.5 teaspoon ground nutmeg",
        "0.5 teaspoon ground cloves",
        "0.5 teaspoon ground cinnamon"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Cream the shortening, sugar, egg, molasses and water. Mix in the flour, salt, ginger, nutmeg, cloves and cinnamon. Cover and chill for 1 hour."
        },
        {
          "id": 2,
          "text": "Preheat oven to 400 degrees F (205 degrees C)."
        },
        {
          "id": 3,
          "text": "Drop teaspoonfuls of dough onto ungreased cookie sheets about 2 inches apart. Bake for about 8 minutes."
        }
      ],
