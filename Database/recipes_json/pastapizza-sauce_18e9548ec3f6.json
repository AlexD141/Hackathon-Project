  "recipes": [
    {
      "name": "Pasta/Pizza Sauce",
      "ingredients_raw": [
        "2 tablespoons olive oil",
        "2 cloves garlic, chopped",
        "1 (6 ounce) can tomato paste",
        "0.66000002622604 cup water",
        "2 tablespoons grated Parmesan cheese",
        "2 tablespoons red wine",
        "2 teaspoons white sugar",
        "0.25 teaspoon dried oregano",
        "0.25 teaspoon dried basil",
        "salt and pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Heat oil in a large skillet over medium heat. Add garlic and sauté until golden and fragrant, about 1 minute. Stir in tomato paste, water, Parmesan cheese, wine, sugar, oregano, basil, salt, and pepper. Reduce the heat to medium-low and simmer for 10 minutes."
        }
      ],
