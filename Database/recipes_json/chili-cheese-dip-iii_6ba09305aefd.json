  "recipes": [
    {
      "name": "Chili Cheese Dip",
      "ingredients_raw": [
        "2 (8 ounce) packages cream cheese, softened",
        "1 (15 ounce) can chili without beans",
        "16 ounces shredded Cheddar cheese",
        "1 (13.5 ounce) package nacho-flavor tortilla chips"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Spread cream cheese on the bottom of a microwave-safe dish. Spread a layer of chili over cream cheese. Finish with a layer of shredded Cheddar cheese."
        },
        {
          "id": 2,
          "text": "Microwave until cheese melts, about 5 minutes. Serve with spicy nacho tortilla chips."
        }
      ],
