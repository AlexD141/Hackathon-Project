      "name": "Creamy Greek Dressing",
      "ingredients_raw": [
        "4 cups crumbled feta cheese",
        "2 cucumbers, seeded and coarsely chopped",
        "1 green bell pepper, coarsely chopped",
        "1 red onion, coarsely chopped",
        "1 cup pitted Kalamata olives",
        "0.25 cup dried oregano",
        "0.25 cup dried basil",
        "2 tablespoons ground black pepper",
        "1 gallon ranch dressing"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place feta cheese, cucumbers, green bell pepper, red onion, olives, oregano, basil, and black pepper in a food processor. Puree until smooth. Stir mixture into the ranch dressing in a large bowl. Cover and refrigerate until ready to use."
        }
      ],
