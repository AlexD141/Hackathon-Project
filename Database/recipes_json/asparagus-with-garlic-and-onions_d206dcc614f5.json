  "recipes": [
    {
      "name": "Asparagus with Garlic and Onions",
      "ingredients_raw": [
        "0.25 cup water",
        "0.5 pound fresh asparagus, trimmed",
        "0.5 cup diced white onion",
        "3 tablespoons butter",
        "salt and black pepper to taste",
        "2 cloves garlic, thinly sliced"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Add water to a large skillet. Place asparagus and onion in the skillet. Bring water to a boil over medium heat. Cover the skillet and steam until slightly tender, 2 to 5 minutes. Add a few tablespoons of extra water, if needed, to maintain steam."
        },
        {
          "id": 2,
          "text": "When water evaporates, immediately place butter in the skillet. Continue cooking until onions and asparagus are lightly brown. Add garlic, and continue cooking, about 30 seconds more. Season with salt and pepper to taste."
        }
      ],
