      "name": "Quenching Creamy Raspberry Punch",
      "ingredients_raw": [
        "2 (64 fluid ounce) bottles raspberry cream soda, chilled",
        "1 (12 fluid ounce) can frozen concentrated raspberry juice",
        "0.5 gallon vanilla ice cream"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In large punch bowl combine both bottles of raspberry cream soda and raspberry juice concentrate. Stir until concentrate is dissolved. Carefully add ice cream. Stir briefly. Best served chilled."
        }
