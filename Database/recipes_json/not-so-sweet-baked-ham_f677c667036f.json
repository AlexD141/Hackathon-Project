  "recipes": [
    {
      "name": "Not-So-Sweet Baked Ham",
      "ingredients_raw": [
        "1 (15 pound) ham",
        "0.75 cup chicken broth"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Place ham in a large baking dish with the fatty side facing up; pour chicken broth over top."
        },
        {
          "id": 3,
          "text": "Bake in the preheated oven, basting with broth every 20 to 30 minutes, until heated through, about 1 1/2 hours. An instant-read thermometer inserted into the center should read at least 145 degrees F (63 degrees C)."
        },
        {
          "id": 4,
          "text": "Discard broth before slicing and serving ham."
        }
      ],
