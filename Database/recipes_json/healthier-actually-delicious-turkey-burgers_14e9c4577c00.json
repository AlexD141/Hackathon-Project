  "recipes": [
    {
      "name": "Healthier Actually Delicious Turkey Burgers",
      "ingredients_raw": [
        "3 pounds ground turkey",
        "1 cup grated zucchini",
        "0.25 cup seasoned bread crumbs",
        "0.25 cup finely diced onion",
        "2 egg whites, lightly beaten",
        "0.25 cup chopped fresh parsley",
        "1 clove garlic, peeled and minced",
        "1 teaspoon salt",
        "0.25 teaspoon ground black pepper"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Mix ground turkey, zucchini, seasoned bread crumbs, onion, egg whites, parsley, garlic, salt, and pepper in a large bowl. Form into 12 patties."
        },
        {
          "id": 2,
          "text": "Heat a skillet over medium heat; arrange patties in skillet and cook until no longer pink in the center and juices run clear, about 4 minutes per side. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C)."
        }
      ],
