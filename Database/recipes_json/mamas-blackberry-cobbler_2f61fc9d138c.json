  "recipes": [
    {
      "name": "Mama&#39;s Blackberry Cobbler",
      "ingredients_raw": [
        "0.5 cup butter, melted",
        "1 cup white sugar",
        "1 cup self-rising flour",
        "0.75 cup milk",
        "2 cups fresh blackberries"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Pour melted butter into the bottom of an 8-inch square baking pan. Mix sugar, self-rising flour, and milk together until moistened; pour mixture over butter. Don&#39;t be tempted to stir. Spread blackberries evenly over batter."
        },
        {
          "id": 3,
          "text": "Bake in the preheated oven until the top is golden brown and the cobbler is bubbling, about 45 minutes."
        }
      ],
