  "recipes": [
    {
      "name": "Vermicelli Salad",
      "ingredients_raw": [
        "8 ounces vermicelli pasta",
        "1 tomato, chopped",
        "0.5 cup chopped green bell pepper",
        "1 (6 ounce) can sliced black olives",
        "0.5 cup chopped red onion",
        "2 tablespoons salad seasoning mix",
        "0.5 cup zesty Italian dressing"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a large pot of salted boiling water, cook pasta until al dente, rinse under cold water and drain."
        },
        {
          "id": 2,
          "text": "In a large bowl, combine the pasta, tomato, bell pepper, olives and onion."
        },
        {
          "id": 3,
          "text": "Whisk together the salad seasoning mix and zesty salad dressing. Pour over salad and toss gently. Refrigerate 4 hours or overnight to blend flavors."
        }
      ],
