  "recipes": [
    {
      "name": "Corn with Bacon and Chili Powder",
      "ingredients_raw": [
        "4 ears corn, husked and cleaned",
        "4 slices bacon",
        "4 dashes chili powder"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat an outdoor grill for medium heat and lightly oil the grate."
        },
        {
          "id": 2,
          "text": "Wrap 1 strip bacon around each ear corn, distributing evenly along cobs; sprinkle with chili powder."
        },
        {
          "id": 3,
          "text": "Wrap each ear in heavy-duty aluminum foil; grill until tender, 20 to 25 minutes."
        }
      ],
