      "name": "Chocolate Banana Latte Shake",
      "ingredients_raw": [
        "0.5 cup milk",
        "0.5 cup cold coffee",
        "1 banana",
        "3 tablespoons vanilla ice cream",
        "3 tablespoons chocolate syrup",
        "2 cups crushed ice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine the milk, coffee, banana, ice cream, chocolate syrup, and ice in a blender; blend until smooth."
        }
      ],
