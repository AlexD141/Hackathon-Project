  "recipes": [
    {
      "name": "Give Away Zucchini Grill Out",
      "ingredients_raw": [
        "2 large zucchini",
        "1 (16 ounce) bottle Italian-style salad dressing"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Rinse zucchini; slice into ½-inch rounds. Place zucchini rounds in a large bowl; cover with dressing. Toss to coat, cover, and refrigerate 2 to 3 hours."
        },
        {
          "id": 2,
          "text": "Preheat an outdoor grill for high heat and lightly oil the grate."
        },
        {
          "id": 3,
          "text": "Cook zucchini on the preheated grill until done, 3 to 4 minutes per side."
        }
      ],
