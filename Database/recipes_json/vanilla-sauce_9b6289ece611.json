  "recipes": [
    {
      "name": "Vanilla Sauce",
      "ingredients_raw": [
        "1 cup white sugar",
        "1 tablespoon cornstarch",
        "2 cups water",
        "0.25 cup butter",
        "2 teaspoons vanilla extract"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine sugar and cornstarch in a small pot. Whisk in water until blended. Bring to a boil and cook for 1 minute, stirring constantly. Remove from heat."
        },
        {
          "id": 2,
          "text": "Mix in butter and vanilla until incorporated. Serve warm."
        }
      ],
