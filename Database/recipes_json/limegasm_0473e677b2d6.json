  "recipes": [
    {
      "name": "Limegasm",
      "ingredients_raw": [
        "1 (6 ounce) can frozen limeade",
        "3 fluid ounces tequila",
        "3 fluid ounces triple sec (orange-flavored liqueur)",
        "2 cups crushed ice",
        "kosher salt"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine the limeade, tequila, and triple sec in a blender; fill with ice; blend until smooth."
        },
        {
          "id": 2,
          "text": "Wet the rims of six glasses and dip in kosher salt. Pour mixture into glasses to serve."
        }
      ],
