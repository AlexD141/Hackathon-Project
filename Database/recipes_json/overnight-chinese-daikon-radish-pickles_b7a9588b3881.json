            "reviewRating": {
              "@type": "Rating",
              "ratingValue": "4"
            },
            "author": {
              "@type": "Person",
              "name": "Mei"
            },
            "reviewBody": "I followed the recipe exactly and the pickles came out quite vinegary. I liked it, but my husband didn't. I'll probably dillute the pickling solution with water next time.",
