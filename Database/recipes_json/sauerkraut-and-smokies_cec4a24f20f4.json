  "recipes": [
    {
      "name": "Sauerkraut and Smokies",
      "ingredients_raw": [
        "8 apples - peeled, cored and sliced",
        "1 (32 ounce) package sauerkraut with juice",
        "4 (16 ounce) packages cocktail-size smoked link sausages",
        "1 (12 fluid ounce) can cola-flavored carbonated beverage",
        "1.5 cups apple juice",
        "0.5 cup brown sugar, or to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place apples, sauerkraut with juice, and smoked sausages into a slow cooker."
        },
        {
          "id": 2,
          "text": "Stir together cola, apple juice, and brown sugar in a large bowl until sugar dissolves; pour over apple mixture in the slow cooker. Stir to combine."
        },
        {
          "id": 3,
          "text": "Cook on High for 2 hours, then on Low for 6 to 8 hours."
        }
      ],
