  "recipes": [
    {
      "name": "Classic Old Fashioned",
      "ingredients_raw": [
        "2 teaspoons simple syrup",
        "1 teaspoon water",
        "2 dashes bitters",
        "1 cup ice cubes",
        "1 (1.5 fluid ounce) jigger bourbon whiskey",
        "1 slice orange",
        "1 maraschino cherry"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Pour simple syrup, water, and bitters into a whiskey glass; stir to combine."
        },
        {
          "id": 3,
          "text": "Add ice cubes and pour in bourbon."
        },
        {
          "id": 4,
          "text": "Garnish with orange slice and maraschino cherry."
        },
        {
          "id": 5,
          "text": "Enjoy!"
        }
      ],
