  "recipes": [
    {
      "name": "Twisty Cookies",
      "ingredients_raw": [
        "0.5 cup white sugar",
        "1 cup packed brown sugar",
        "0.5 cup butter, softened",
        "2 eggs",
        "2 cups all-purpose flour",
        "1 teaspoon baking soda",
        "0.5 teaspoon salt",
        "1 cup chopped almonds",
        "3 cups semi-sweet chocolate chips",
        "2 teaspoons rum",
        "0.5 teaspoon whiskey"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 375 degrees F (190 degrees C). Lightly grease cookie sheets."
        },
        {
          "id": 2,
          "text": "Combine white and brown sugar, butter and eggs. Stir in flour, baking soda and salt. The dough will be stiff."
        },
        {
          "id": 3,
          "text": "Stir in nuts, chocolate chips, rum and whiskey. Drop dough by tablespoonful onto cookie sheet. Bake 8 to 10 minutes."
        }
      ],
