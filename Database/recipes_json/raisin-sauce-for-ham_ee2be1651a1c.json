  "recipes": [
    {
      "name": "Raisin Sauce for Ham",
      "ingredients_raw": [
        "0.5 cup packed light brown sugar",
        "2 tablespoons cornstarch",
        "1 teaspoon dry mustard powder",
        "1.25 cups water",
        "2 tablespoons lemon juice",
        "1 cup dark raisins"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Heat brown sugar, cornstarch, and dry mustard in a 1-quart saucepan over medium heat and stir until sugar dissolves, 3 to 5 minutes."
        },
        {
          "id": 2,
          "text": "Gradually stir water and lemon juice into brown sugar mixture."
        },
        {
          "id": 3,
          "text": "Stir raisins into mixture and bring to a boil, stirring constantly, about 5 minutes."
        }
      ],
