  "recipes": [
    {
      "name": "Raisin Butter Tarts",
      "ingredients_raw": [
        "1 cup packed brown sugar",
        "1 egg",
        "1 cup raisins",
        "3 tablespoons butter, melted",
        "2 tablespoons lemon juice",
        "0.25 teaspoon ground nutmeg",
        "14 (4 inch) prepared tart shells"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 375 degrees F (190 degrees C)."
        },
        {
          "id": 2,
          "text": "Beat sugar and egg with a fork until well combined. Stir in raisins, melted butter, lemon juice, and nutmeg. Fill tart shells halfway."
        },
        {
          "id": 3,
          "text": "Bake until crusts are golden and filling begins to bubble, 15 to 20 minutes. Let tarts stand for a few minutes before removing to racks to cool."
        }
      ],
