  "recipes": [
    {
      "name": "Easy Broccoli Salad I",
      "ingredients_raw": [
        "4 cups fresh broccoli florets",
        "0.25 cup red onion, finely diced",
        "3 tablespoons raisins",
        "2 tablespoons dry roasted sunflower seeds",
        "0.25 cup plain yogurt",
        "2 tablespoons orange juice",
        "1 tablespoon fat-free mayonnaise"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine the broccoli, onions, raisins, and sunflower seeds."
        },
        {
          "id": 2,
          "text": "In a small bowl, whisk the yogurt, orange juice, and mayonnaise until blended. Pour over the broccoli mixture and toss to coat."
        }
      ],
