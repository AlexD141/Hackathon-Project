  "recipes": [
    {
      "name": "Best Smoothie Ever",
      "ingredients_raw": [
        "1 (8 ounce) container plain yogurt",
        "2 scoops vanilla ice cream",
        "8 frozen strawberries",
        "1 banana, frozen and chunked",
        "1 tablespoon white sugar",
        "2 teaspoons vanilla extract",
        "1 tablespoon chocolate syrup",
        "0.5 cup milk"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Blend the yogurt, ice cream, strawberries, banana, sugar, vanilla, chocolate syrup, and milk together in a blender until smooth."
        }
      ],
