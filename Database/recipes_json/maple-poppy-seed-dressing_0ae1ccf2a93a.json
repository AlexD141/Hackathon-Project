      "name": "Maple-Poppy Seed Dressing",
      "ingredients_raw": [
        "2 cups mayonnaise",
        "0.25 cup real maple syrup",
        "2 tablespoons red wine vinegar",
        "2 tablespoons white sugar",
        "1 tablespoon poppy seeds"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Whisk together mayonnaise, maple syrup, vinegar, sugar, and poppy seeds in a bowl until blended."
