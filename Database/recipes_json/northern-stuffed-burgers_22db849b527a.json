  "recipes": [
    {
      "name": "Northern Stuffed Burgers",
      "ingredients_raw": [
        "2 pounds ground beef",
        "garlic powder to taste",
        "ground black pepper to taste",
        "1 dash celery seed"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat an outdoor grill for high heat and lightly oil grate."
        },
        {
          "id": 2,
          "text": "In a large bowl, combine the ground beef with the garlic powder, ground black pepper and celery seed to taste. Mix well and form into 8 flat patties."
        },
        {
          "id": 3,
          "text": "Spread 4 of the patties with your favorite condiments, then place the 4 remaining patties over these and seal the edges."
        },
        {
          "id": 4,
          "text": "Grill over high heat for 5 minutes per side, or to desired doneness. Use either two spatulas to turn, or you could use a fish basket."
        }
      ],
