  "recipes": [
    {
      "name": "Crab and Artichoke Tarts",
      "ingredients_raw": [
        "10 ounces lump crabmeat",
        "6 ounces canned artichoke hearts, drained and chopped",
        "1 red bell pepper, finely chopped",
        "0.25 cup cream cheese, softened",
        "0.25 cup grated Parmesan cheese",
        "3 green onions, finely chopped",
        "3 tablespoons all-purpose flour",
        "1 pinch garlic powder, or to taste",
        "ground black pepper to taste",
        "8 (4 inch) frozen tart shells, thawed"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 325 degrees F (165 degrees C)."
        },
        {
          "id": 2,
          "text": "Combine crabmeat, artichoke hearts, red bell pepper, cream cheese, Parmesan cheese, green onions, flour, garlic powder, and black pepper together in a bowl."
        },
        {
          "id": 3,
          "text": "Spoon crabmeat mixture evenly into tart shells. Place filled shells on a baking sheet."
        },
        {
          "id": 4,
          "text": "Bake in preheated oven until tart is golden and filling is bubbling, 45 minutes to 1 hour."
        }
      ],
