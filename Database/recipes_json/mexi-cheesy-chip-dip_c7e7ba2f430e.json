      "name": "Cheesy Chili Chip Dip",
      "ingredients_raw": [
        "1 (15 ounce) can chili without beans",
        "1 (8 ounce) package cream cheese, softened",
        "8 ounces process cheese food, cubed",
        "1 cup salsa"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine chili, cream cheese, processed cheese food, and salsa in a large saucepan over medium-low heat. Stir until cheese is melted and mixture is well blended."
        }
