  "recipes": [
    {
      "name": "Grilled Okra Salad",
      "ingredients_raw": [
        "1 orange tomato, cubed",
        "0.5 red onion, diced",
        "0.25 cup white wine vinegar",
        "salt to taste",
        "16 pods fresh okra"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat an outdoor grill for medium-high heat, and lightly oil grate."
        },
        {
          "id": 2,
          "text": "Combine tomato, onion, vinegar, and salt in a bowl; set aside."
        },
        {
          "id": 3,
          "text": "Cook okra on the preheated grill until slightly charred with a few black areas on skins, about 5 minutes. Toss okra into tomato mixture; serve."
        }
      ],
