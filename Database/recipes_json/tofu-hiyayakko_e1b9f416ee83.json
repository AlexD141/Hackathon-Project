  "recipes": [
    {
      "name": "Tofu Hiyayakko",
      "ingredients_raw": [
        "1 tablespoon soy sauce",
        "1 teaspoon white sugar",
        "0.5 teaspoon dashi granules",
        "0.5 teaspoon water",
        "0.25 (12 ounce) package silken tofu",
        "1.5 teaspoons grated fresh ginger root",
        "0.25 teaspoon thinly sliced green onion",
        "1 pinch bonito shavings (dry fish flakes)",
        "1 pinch toasted sesame seeds"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Whisk soy sauce, sugar, dashi granules, and water together in small bowl until sugar dissolves."
        },
        {
          "id": 2,
          "text": "Place tofu on a small plate; top with ginger, green onion, and bonito shavings. Drizzle soy sauce mixture on top; sprinkle with sesame seeds."
        }
      ],
