  "recipes": [
    {
      "name": "Garlic Potatoes",
      "ingredients_raw": [
        "1.5 pounds red potatoes, cut into large chunks",
        "1 clove garlic, halved lengthwise",
        "0.5 cup milk",
        "1 teaspoon salt",
        "1 tablespoon chopped fresh parsley"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place potatoes and garlic into a large pot and add just enough salted water to cover. Bring to a boil. Reduce heat to low, cover, and simmer until very tender, about 20 minutes. Drain. Allow to steam dry for 1 to 2 minutes."
        },
        {
          "id": 2,
          "text": "Return potatoes to the pot. Pour in milk and season with salt; mash until smooth. Stir in parsley until incorporated."
        }
      ],
