  "recipes": [
    {
      "name": "Easy Iced Coffee",
      "ingredients_raw": [
        "3 tablespoons warm water",
        "2 teaspoons instant coffee granules",
        "1 teaspoon sugar",
        "1 cup ice, or as needed",
        "6 fluid ounces cold milk"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Combine warm water, instant coffee, and sugar in a sealable jar. Seal and shake until foamy."
        },
        {
          "id": 3,
          "text": "Pour into a glass full of ice; add milk. Adjust to taste if necessary."
        }
      ],
