  "recipes": [
    {
      "name": "Honey Bean Salad",
      "ingredients_raw": [
        "2 (15 ounce) cans kidney beans",
        "1 tablespoon honey",
        "2 tablespoons apple cider vinegar",
        "0.5 teaspoon ground black pepper",
        "1 teaspoon dried basil",
        "1 teaspoon dried sage",
        "2 cloves garlic, minced",
        "0.125 teaspoon hot pepper sauce (such as Tabasco®), or to taste",
        "2 tablespoons olive oil, or to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Pour the beans into a mixing bowl, and stir with honey, vinegar, black pepper, basil, sage, garlic, hot pepper sauce, and olive oil. Stir until evenly coated, serve, and enjoy!"
        }
      ],
