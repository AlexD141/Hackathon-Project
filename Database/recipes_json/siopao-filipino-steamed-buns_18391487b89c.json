  "recipes": [
    {
      "name": "Siopao (Filipino Steamed Buns)",
      "ingredients_raw": [
        "3.3333332538605 cups all-purpose flour",
        "0.5 cup white sugar",
        "0.5 teaspoon salt",
        "1 (.25 ounce) package active dry yeast",
        "1 cup lukewarm water",
        "0.25 cup vegetable oil",
        "1 teaspoon vegetable oil, or as needed"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Mix flour, sugar, salt, and yeast together in a large bowl. Add water and 1/4 cup oil; mix into a dough. Knead until smooth and elastic, at least 10 minutes. Dust with extra flour if necessary."
        },
        {
          "id": 2,
          "text": "Warm up the oven for 1 minute. Turn oven off."
        },
        {
          "id": 3,
          "text": "Oil a large bowl; place dough inside and cover with cheesecloth. Place in the warmed oven until size has doubled, about 1 hour."
        },
        {
          "id": 4,
          "text": "Punch down dough. Keep in the oven until risen, at least 15 minutes more. Knead dough onto a flat work surface and divide into 12 golf-sized balls. Roll out each ball and fill with choice of filling (cook’s note for my chicken and pork filling). Gather and twist the edges together to secure the filling."
        },
        {
          "id": 5,
          "text": "Place each siopao on a 3x3-inch piece of wax paper."
        }
      ],
