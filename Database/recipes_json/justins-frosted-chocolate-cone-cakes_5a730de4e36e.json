  "recipes": [
    {
      "name": "Justin&#39;s Frosted Chocolate Cone Cakes",
      "ingredients_raw": [
        "10 flat-bottomed wafer ice cream cones",
        "1 cup all-purpose flour",
        "1 cup white sugar",
        "0.5 teaspoon baking soda",
        "0.25 teaspoon salt",
        "0.5 cup butter",
        "0.5 cup water",
        "1 tablespoon unsweetened cocoa powder",
        "2 eggs",
        "0.25 cup buttermilk",
        "1 teaspoon vanilla extract",
        "0.33333334326744 cup cream cheese, softened",
        "0.5 cup confectioners' sugar",
        "0.5 teaspoon vanilla extract"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Set ice cream cones upright in 10 muffin cups."
        },
        {
          "id": 3,
          "text": "Whisk flour, white sugar, baking soda, and salt together in a mixing bowl."
        },
        {
          "id": 4,
          "text": "Melt butter in a saucepan over low heat; stir in water and cocoa powder until thoroughly combined."
        },
        {
          "id": 5,
          "text": "Stir melted butter mixture into flour mixture. Stir in eggs, buttermilk, and 1 teaspoon vanilla extract until the batter is moistened."
        },
        {
          "id": 6,
          "text": "Beat batter with an electric mixer on medium speed until thoroughly combined, about 1 minute."
        },
        {
          "id": 7,
          "text": "Spoon chocolate cake batter into ice cream cones, leaving about 1 inch of space at the top."
        },
        {
          "id": 8,
          "text": "Bake immediately in the preheated oven (to avoid cones becoming soggy) until a toothpick inserted into the middle of a cake center comes out clean, about 30 minutes."
        },
        {
          "id": 9,
          "text": "Let cupcakes cool thoroughly, about 1 hour."
        },
        {
          "id": 10,
          "text": "Beat cream cheese, confectioners&#39; sugar, and 1/2 teaspoon vanilla extract together in a bowl until smooth and creamy. Frost cupcakes with the cream cheese frosting."
        }
      ],
