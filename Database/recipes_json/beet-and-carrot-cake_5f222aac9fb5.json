  "recipes": [
    {
      "name": "Beet and Carrot Cake",
      "ingredients_raw": [
        "2 cups all-purpose flour",
        "2 cups brown sugar",
        "1.5 cups raisins",
        "1 cup shredded coconut",
        "0.33333334326744 cup wheat germ",
        "0.25 cup wheat bran",
        "2 teaspoons ground cinnamon",
        "2 teaspoons baking soda",
        "1 pinch salt",
        "1.5 cups vegetable oil",
        "5 eggs, beaten",
        "2 cups grated carrots",
        "1 (16 ounce) can sliced beets, drained and mashed"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Grease a 9x13-inch baking dish."
        },
        {
          "id": 3,
          "text": "Combine flour, brown sugar, raisins, coconut, wheat germ, wheat bran, cinnamon, baking soda, and salt in a bowl."
        },
        {
          "id": 4,
          "text": "Whisk vegetable oil and eggs together in a separate bowl."
        },
        {
          "id": 5,
          "text": "Stir oil mixture, carrots, and beets into flour mixture until just combined."
        },
        {
          "id": 6,
          "text": "Pour batter into prepared baking dish."
        },
        {
          "id": 7,
          "text": "Bake in preheated oven until center of cake bounces back when touched, about 1 hour."
        }
      ],
