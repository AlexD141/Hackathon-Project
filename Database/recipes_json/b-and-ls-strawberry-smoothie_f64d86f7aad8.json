  "recipes": [
    {
      "name": "B and L&#39;s Strawberry Smoothie",
      "ingredients_raw": [
        "8 strawberries, hulled",
        "0.5 cup skim milk",
        "0.5 cup plain yogurt",
        "3 tablespoons white sugar",
        "2 teaspoons vanilla extract",
        "6 cubes ice, crushed"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Combine strawberries, milk, yogurt, sugar, and vanilla in a blender. Add ice and blend until smooth and creamy."
        },
        {
          "id": 3,
          "text": "Pour into glasses and serve immediately. Enjoy!"
        }
      ],
