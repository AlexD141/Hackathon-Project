  "recipes": [
    {
      "name": "Big Game Grape Jelly Barbeque Ham Sandwiches",
      "ingredients_raw": [
        "0.75 cup distilled white vinegar",
        "6 tablespoons grape jelly",
        "1.5 teaspoons paprika",
        "1.5 teaspoons dry mustard powder",
        "6 tablespoons brown sugar",
        "1.5 (12 ounce) bottles bottled sweet chili sauce (such as Heinz® Premium Chili Sauce)",
        "6 tablespoons water",
        "3 pounds chipped chopped ham",
        "12 sandwich buns, split"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Stir together the vinegar, grape jelly, paprika, mustard powder, brown sugar, bottled sweet chili sauce, and water in a 2-quart saucepan over medium heat. Bring to a boil, turn heat to low, and simmer for 5 minutes."
        },
        {
          "id": 2,
          "text": "Mix in the chipped ham and stir to combine with sauce. Refrigerate overnight."
        },
        {
          "id": 3,
          "text": "The next day, bring the sauce and ham slowly to a simmer over low heat and cook 1 hour, stirring occasionally."
        },
        {
          "id": 4,
          "text": "Spoon the ham onto sandwich buns to serve."
        }
      ],
