  "recipes": [
    {
      "name": "Quick Tomato Sandwich",
      "ingredients_raw": [
        "2 tablespoons ketchup",
        "1 tablespoon mayonnaise",
        "0.125 teaspoon salt",
        "0.125 teaspoon hot pepper sauce",
        "4 slices whole wheat bread",
        "2 leaves lettuce",
        "1 tomato, sliced"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine ketchup, mayonnaise, salt, and hot pepper sauce in a bowl; mix well."
        },
        {
          "id": 2,
          "text": "Toast bread in the toaster. Spread ketchup mixture on all 4 slices of toast."
        },
        {
          "id": 3,
          "text": "Arrange lettuce leaves on a piece of toast, then top with 3 to 4 tomato slices. Cover with another piece of toast. Repeat this step to make second sandwich."
        }
      ],
