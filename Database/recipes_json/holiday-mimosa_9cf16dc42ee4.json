  "recipes": [
    {
      "name": "Holiday Mimosa",
      "ingredients_raw": [
        "0.25 cup orange liqueur (such as Grand Marnier®)",
        "2 tablespoons white sugar",
        "1 cup orange juice",
        "1 (750 milliliter) bottle brut champagne, chilled"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Pour orange liqueur in a shallow bowl; put sugar in a saucer. Dip the rims of 6 glasses in the orange liqueur and then in sugar to form a thinly sugared rim."
        },
        {
          "id": 2,
          "text": "Divide remaining orange liqueur and orange juice among the 6 prepared glasses. Top with champagne. Serve immediately."
        }
      ],
