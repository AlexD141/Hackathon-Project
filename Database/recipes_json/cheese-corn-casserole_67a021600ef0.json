  "recipes": [
    {
      "name": "Cheese Corn Casserole",
      "ingredients_raw": [
        "3 tablespoons butter",
        "1 cup sliced onion",
        "1 (8.5 ounce) package corn bread mix",
        "0.5 cup milk",
        "1 cup cream-style corn",
        "1 dash hot pepper sauce",
        "1 cup sour cream",
        "1 cup shredded sharp Cheddar cheese"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C). Spray one 10x10 inch pan with non-stick cooking spray."
        },
        {
          "id": 2,
          "text": "ina medium skillet, saute onions in butter over medium heat until soft; set aside."
        },
        {
          "id": 3,
          "text": "In a medium sized bowl, combine corn muffin mix, milk, corn and hot sauce."
        },
        {
          "id": 4,
          "text": "Pour cornbread into baking dish and layer with onions, followed by sour cream and cheese."
        },
        {
          "id": 5,
          "text": "Bake for 25 to 30 minutes, cover for last 15 minutes."
        }
      ],
