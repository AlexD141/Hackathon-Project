  "recipes": [
    {
      "name": "Kid&#39;s Favorite Passover Pizza",
      "ingredients_raw": [
        "0.25 cup spaghetti sauce",
        "2 matzo crackers",
        "1 pinch garlic salt",
        "1 pinch dried oregano",
        "0.75 cup shredded mozzarella cheese",
        "1 tomato, sliced",
        "0.25 cup sliced black olives"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Spread spaghetti sauce onto matzo crackers; sprinkle with garlic salt and oregano. Top with cheese, tomato slices, and olives; place pizzas on a baking sheet."
        },
        {
          "id": 3,
          "text": "Bake in the preheated oven until cheese is melted, about 5 minutes."
        }
      ],
