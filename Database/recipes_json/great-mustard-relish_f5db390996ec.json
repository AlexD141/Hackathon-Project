      "name": "Great Mustard Relish",
      "ingredients_raw": [
        "0.5 cup dill pickle slices",
        "0.5 cup onion, chopped",
        "1 tablespoon prepared yellow mustard"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Add pickles to the bowl of a food processor; pulse into ¼-inch pieces. Transfer minced pickles to a bowl."
        },
        {
          "id": 2,
          "text": "Add onions to the bowl of the food processor; pulse into ¼-inch pieces. Transfer minced onions to bowl with pickles."
        },
        {
          "id": 3,
          "text": "Stir mustard into pickles and onions until well blended."
        }
      ],
