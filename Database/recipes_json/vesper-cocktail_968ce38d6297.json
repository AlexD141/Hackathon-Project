    {
      "name": "Vesper Cocktail",
      "ingredients_raw": [
        "1 cup ice",
        "3 fluid ounces gin",
        "1 fluid ounce vodka",
        "0.5 fluid ounce Lillet blanc",
        "1 orange twist"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Fill a cocktail mixing glass with ice; add gin, vodka, and Lillet. Stir until well chilled and properly diluted, about 20 to 30 seconds. Strain into a chilled cocktail glass and garnish with an orange twist for a hint of bright citrus flavor."
        }
      ],
