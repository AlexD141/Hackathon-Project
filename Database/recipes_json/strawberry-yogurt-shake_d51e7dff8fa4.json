      "name": "Strawberry-Yogurt Shake",
      "ingredients_raw": [
        "3 cups ice cubes",
        "2 bananas, peeled and sliced",
        "1 (16 ounce) package fresh strawberries, hulled",
        "1 (16 ounce) container plain low-fat yogurt"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine ½ ice cubes, bananas, strawberries, and yogurt in a blender; blend on high until smooth. Add remaining ½ ice; blend until smooth. Serve immediately."
        }
      ],
