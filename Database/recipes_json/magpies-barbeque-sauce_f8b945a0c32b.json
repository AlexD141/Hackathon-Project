  "recipes": [
    {
      "name": "Magpie&#39;s Barbeque Sauce",
      "ingredients_raw": [
        "1 tablespoon bacon drippings",
        "0.33333334326744 cup minced onion",
        "2 cloves garlic, minced",
        "1 tablespoon minced fresh ginger",
        "1.5 cups ketchup",
        "0.25 cup Worcestershire sauce",
        "0.25 cup soy sauce",
        "1 cup brown sugar, firmly packed",
        "1 cup balsamic vinegar",
        "0.25 cup fresh lemon juice",
        "1 teaspoon bottled chipotle chile sauce",
        "2 tablespoons ground mustard",
        "0.5 teaspoon crushed dried chile pepper",
        "1 teaspoon fresh-ground black pepper",
        "0.125 teaspoon kosher salt",
        "0.5 teaspoon ground cumin",
        "1 teaspoon ground coriander",
        "0.5 teaspoon Spanish paprika"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Heat the bacon drippings in a saucepan over medium heat. Cook the onion in the bacon drippings until soft, about 7 minutes. Stir in the garlic and ginger. Cook and stir another 30 seconds. Reduce heat to low."
        },
        {
          "id": 2,
          "text": "Stir together the ketchup, Worcestershire sauce, soy sauce, brown sugar, balsamic vinegar, lemon juice, chipotle sauce, mustard, ground chile pepper, pepper, salt, cumin, coriander, and paprika in a bowl. Stir sauce into the onion mixture, and simmer for 20 minutes, stirring frequently."
        }
      ],
