      "name": "Irish Black Russian",
      "ingredients_raw": [
        "1 (1.5 fluid ounce) jigger coffee flavored liqueur",
        "2 (1.5 fluid ounce) jiggers vodka",
        "1 (12 fluid ounce) can or bottle Irish stout beer",
        "1 (12 fluid ounce) can or bottle cola-flavored carbonated beverage"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Half-fill a highball glass with ice cubes. Measure in the coffee liqueur and vodka. Pour cola to within 1/2 inch of the top. finish with enough Irish stout to form a &#39;head&#39; on the top. Stir and serve."
        }
      ],
