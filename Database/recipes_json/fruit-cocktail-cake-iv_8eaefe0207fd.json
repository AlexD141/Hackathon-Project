  "recipes": [
    {
      "name": "Fruit Cocktail Cake IV",
      "ingredients_raw": [
        "1 cup all-purpose flour",
        "1 cup white sugar",
        "0.5 teaspoon salt",
        "1 teaspoon baking soda",
        "1 egg",
        "1 (15.25 ounce) can fruit cocktail with syrup",
        "0.5 cup chopped pecans",
        "0.75 cup brown sugar"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 9x13 inch pan."
        },
        {
          "id": 2,
          "text": "In a large bowl mix together flour, sugar, salt and baking soda. Pour in egg and fruit cocktail with syrup. Mix well and pour into prepared pan. Sprinkle with pecans and brown sugar."
        },
        {
          "id": 3,
          "text": "Bake in the preheated oven for 50 to 60 minutes, or until a toothpick inserted into the center of the cake comes out clean. Allow to cool."
        }
      ],
