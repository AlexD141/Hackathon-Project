  "recipes": [
    {
      "name": "3-Cheese Enchiladas",
      "ingredients_raw": [
        "3 cups salsa, divided",
        "1 (8 ounce) package cream cheese, softened",
        "4 stalks green onions, chopped, divided",
        "2.5 cups Cheddar cheese, divided",
        "2.5 cups shredded Monterey Jack cheese, divided",
        "12 (8 inch) flour tortillas"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Combine 2 cups salsa, cream cheese, and ½ green onions in a bowl."
        },
        {
          "id": 3,
          "text": "Stir in 2 cups Cheddar cheese and 2 cups Monterey Jack cheese to combine."
        },
        {
          "id": 4,
          "text": "Spoon a scant ½ cup cheese filling in a line across middle of each tortilla. Roll tortillas around filling."
        },
        {
          "id": 5,
          "text": "Place enchiladas, seam-sides down, in a 9x13-inch baking dish."
        },
        {
          "id": 6,
          "text": "Spread remaining 1 cup salsa over top of enchiladas."
        },
        {
          "id": 7,
          "text": "Combine remaining ½ cup each Cheddar and Monterey Jack in a bowl; sprinkle over enchiladas, then scatter remaining green onions over top. Cover the dish with aluminum foil."
        },
        {
          "id": 8,
          "text": "Bake in the preheated oven until enchiladas are warmed through and cheese is melted and bubbly, about 20 minutes."
        }
      ],
