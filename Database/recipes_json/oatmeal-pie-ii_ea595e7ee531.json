      "name": "Oatmeal Pie II",
      "ingredients_raw": [
        "1 recipe pastry for a 9 inch single crust pie",
        "0.33333334326744 cup butter, melted",
        "0.66666668653488 cup white sugar",
        "0.5 teaspoon salt",
        "3 eggs",
        "1 cup corn syrup",
        "1 cup quick cooking oats"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Beat together the eggs, sugar, salt, butter, and syrup together. Stir in oats."
        },
        {
          "id": 2,
          "text": "Pour into the unbaked pastry shell and bake in a preheated 350 degrees F (175 degrees C) oven until set, about 45 minutes to 1 hour. Let cool before cutting."
        }
      ],
