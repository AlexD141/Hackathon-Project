  "recipes": [
    {
      "name": "PHILADELPHIA® 7-Layer Mexican Dip",
      "ingredients_raw": [
        "1 (8 ounce) package PHILADELPHIA Cream Cheese, softened",
        "1 tablespoon TACO BELL® HOME ORIGINALS® Taco Seasoning Mix",
        "1 cup guacamole",
        "1 cup TACO BELL® HOME ORIGINALS® Thick 'N Chunky Salsa",
        "1 cup shredded lettuce",
        "1 cup KRAFT Shredded Cheddar Cheese",
        "0.5 cup chopped green onions",
        "2 tablespoons sliced pitted ripe olives"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Mix cream cheese and seasoning mix until blended; spread onto serving plate or bottom of pie plate."
        },
        {
          "id": 2,
          "text": "Top with remaining ingredients."
        },
        {
          "id": 3,
          "text": "Refrigerate several hours or until chilled."
        }
      ],
