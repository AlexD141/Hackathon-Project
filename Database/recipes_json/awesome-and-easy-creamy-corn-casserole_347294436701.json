  "recipes": [
    {
      "name": "Awesome and Easy Creamy Corn Casserole",
      "ingredients_raw": [
        "1 (15 ounce) can whole kernel corn, drained",
        "1 (14.75 ounce) can creamed corn",
        "1 (8.5 ounce) package dry cornbread mix",
        "1 cup sour cream",
        "0.5 cup butter, melted",
        "2 eggs, beaten"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x9-inch baking dish."
        },
        {
          "id": 2,
          "text": "Stir whole and creamed corn, cornbread mix, sour cream, melted butter, and eggs together in a medium bowl until well combined."
        },
        {
          "id": 3,
          "text": "Spoon mixture into the prepared dish."
        },
        {
          "id": 4,
          "text": "Bake in the preheated oven until the top is golden brown and the center is just set, about 45 minutes."
        },
        {
          "id": 5,
          "text": "Serve and enjoy!"
        }
      ],
