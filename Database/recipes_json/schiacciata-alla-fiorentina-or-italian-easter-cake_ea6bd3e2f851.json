  "recipes": [
    {
      "name": "Schiacciata alla Fiorentina or Italian Easter Cake",
      "ingredients_raw": [
        "2 cups all-purpose flour",
        "1 cup white sugar",
        "7 tablespoons warm milk",
        "0.25 cup olive oil",
        "1 orange, juice and zest",
        "2 eggs",
        "1.5 tablespoons baking powder",
        "1 teaspoon vanilla extract",
        "0.5 teaspoon ground nutmeg"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 360 degrees F (180 degrees C)."
        },
        {
          "id": 2,
          "text": "Grease a 9x13-inch baking dish with butter."
        },
        {
          "id": 3,
          "text": "Mix flour, sugar, milk, olive oil, orange juice, orange zest, eggs, baking powder, vanilla extract, and nutmeg in a large bowl until batter is well combined."
        },
        {
          "id": 4,
          "text": "Pour batter into the prepared baking dish."
        },
        {
          "id": 5,
          "text": "Bake in the preheated oven until a toothpick inserted into the center of the cake comes out clean, about 30 minutes. Let cool before serving."
        }
      ],
