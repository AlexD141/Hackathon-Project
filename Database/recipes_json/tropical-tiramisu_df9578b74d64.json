  "recipes": [
    {
      "name": "Tropical Tiramisu",
      "ingredients_raw": [
        "1 (8 ounce) package cream cheese",
        "0.25 cup honey",
        "2 tablespoons pineapple juice concentrate, thawed",
        "3 cups leftover bunny cake, cubed",
        "0.5 cup mango nectar",
        "0.5 teaspoon rum flavored extract",
        "0.25 cup chopped crystallized ginger",
        "0.25 cup chopped macadamia nuts",
        "0.5 cup sliced fresh mango, garnish"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a medium bowl, beat together the cream cheese, honey, and pineapple juice concentrate until light and fluffy; set aside. In a small bowl, combine the mango nectar and rum extract; set aside."
        },
        {
          "id": 2,
          "text": "Place half of the cake cubes in a 1 1/2 quart glass bowl. Drizzle half of the mango/rum mixture over the cake, then spread half of the cream cheese mixture over the cake. Sprinkle on half of the ginger and nuts. Repeat layers."
        },
        {
          "id": 3,
          "text": "Cover with plastic wrap and refrigerate for 2 hours or overnight. Garnish each serving with fresh mango slices and pineapple."
        }
      ],
