  "recipes": [
    {
      "name": "Gee-Gee&#39;s Chicken Salad with Cantaloupe",
      "ingredients_raw": [
        "0.5 cup mayonnaise",
        "0.25 cup sour cream",
        "1.5 teaspoons lemon zest",
        "1 tablespoon fresh lemon juice",
        "1.5 teaspoons white sugar",
        "0.5 teaspoon ground ginger",
        "0.25 teaspoon salt",
        "2 cups cubed cooked chicken",
        "1.5 cups fresh blueberries",
        "1 cup sliced celery",
        "1 cup seedless green grapes, halved",
        "0.5 cup sliced almonds",
        "3 cantaloupes, halved and seeded"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Whisk mayonnaise, sour cream, lemon zest, lemon juice, sugar, ginger, and salt together in a large bowl."
        },
        {
          "id": 2,
          "text": "Fold chicken, blueberries, celery, grapes, and almonds into dressing until well combined. Cover the bowl and refrigerate for 1 hour."
        },
        {
          "id": 3,
          "text": "Spoon salad into cantaloupe halves."
        }
      ],
