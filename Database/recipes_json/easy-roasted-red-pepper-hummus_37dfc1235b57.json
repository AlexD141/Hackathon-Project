  "recipes": [
    {
      "name": "Easy Roasted Red Pepper Hummus",
      "ingredients_raw": [
        "1 (15 ounce) can chickpeas, drained",
        "0.33300000429153 cup tahini",
        "0.33300000429153 cup lemon juice",
        "2 cloves garlic, minced",
        "0.5 cup roasted red peppers",
        "0.25 teaspoon dried basil",
        "salt and pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine chickpeas, tahini, lemon juice, and garlic in the bowl of a food processor; pulse until blended. Add roasted peppers and basil; process until the peppers are finely chopped. Season with salt and pepper."
        },
        {
          "id": 2,
          "text": "Transfer hummus to a small bowl, cover, and chill until ready to serve."
        }
      ],
