  "recipes": [
    {
      "name": "Kohlrabi Slaw",
      "ingredients_raw": [
        "2 cups chopped cabbage",
        "4 kohlrabi bulbs, peeled and grated",
        "2 stalks celery, sliced thin",
        "2 carrots, sliced thin",
        "2 tablespoons minced fresh onion",
        "0.33333334326744 cup white sugar",
        "0.5 teaspoon salt",
        "0.125 teaspoon ground black pepper",
        "0.125 teaspoon celery seed",
        "0.5 cup mayonnaise",
        "4.5 teaspoons apple cider vinegar"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Toss cabbage, kohlrabi, celery, carrot, and onion together in a large bowl."
        },
        {
          "id": 2,
          "text": "Whisk sugar, salt, pepper, celery seed, mayonnaise, and vinegar together in a separate bowl until smooth; pour over the cabbage mixture and stir to coat evenly."
        }
      ],
