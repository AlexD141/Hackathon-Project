  "recipes": [
    {
      "name": "Quick-but-Yummy Oyster Stew",
      "ingredients_raw": [
        "2 (12 ounce) cans evaporated milk",
        "4 cups water",
        "1 cup butter",
        "salt and ground black pepper to taste",
        "2 (8 ounce) cans oysters, drained"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Stir the evaporated milk and water together in a large pot over medium-low heat; bring to a gentle boil."
        },
        {
          "id": 2,
          "text": "Stir butter into the liquid. Season with salt and black pepper. Cook, stirring occasionally, until the butter melts completely, 5 to 7 minutes."
        },
        {
          "id": 3,
          "text": "Stir the oysters into the liquid; continue cooking at a simmer until the edges of the oysters begin to curl, about 15 minutes."
        }
      ],
