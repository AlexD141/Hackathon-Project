  "recipes": [
    {
      "name": "Baked Potato Salad with Dill",
      "ingredients_raw": [
        "4 baking potatoes",
        "4 ounces fresh bean sprouts",
        "0.25 cup coarsely chopped walnuts",
        "4 celery, thinly sliced",
        "4 radishes, sliced",
        "3 tablespoons chopped fresh dill weed",
        "2 tablespoons chopped fresh parsley",
        "0.33333334326744 cup mayonnaise",
        "2 tablespoons lemon juice",
        "4 teaspoons Dijon-style prepared mustard",
        "0.25 teaspoon curry powder"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat over to 400 degrees F (200 degrees C). Pierce the potatoes with a fork, and bake in the preheated over for about an hour, or until tender. Remove from oven, let cool, and then chill until cold."
        },
        {
          "id": 2,
          "text": "Peel and cube the potatoes, and then add to a large bowl along with the bean sprouts, walnuts, celery, radishes, dill weed and parsley."
        },
        {
          "id": 3,
          "text": "Whisk together the mayonnaise, lemon juice, mustard and curry powder."
        },
        {
          "id": 4,
          "text": "Pour dressing over potato mixture; toss to coat. Cover and refrigerate until ready to serve."
        }
      ],
