  "recipes": [
    {
      "name": "Home-Made Coffee Liqueur",
      "ingredients_raw": [
        "5 cups water",
        "3 cups white sugar",
        "0.25 cup instant coffee granules",
        "1 (750 milliliter) bottle rum (dark or light)",
        "2 teaspoons vanilla extract"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Stir the water, sugar, and instant coffee together in a saucepan over high heat until the sugar dissolves and the mixture boils. Remove from the heat, and cool 30 to 45 minutes. Stir in the rum and vanilla. Using a funnel, pour into 3 clean wine bottles. Seal, and store in a dark, cool place at least 2 weeks before drinking."
        }
      ],
