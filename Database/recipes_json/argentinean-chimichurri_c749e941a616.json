  "recipes": [
    {
      "name": "Argentinean Chimichurri",
      "ingredients_raw": [
        "0.5 cup olive oil",
        "2 tablespoons fresh lemon juice",
        "1 teaspoon minced garlic",
        "0.33333334326744 cup minced shallot",
        "0.33333334326744 cup minced fresh parsley",
        "1 teaspoon chopped fresh basil",
        "1 teaspoon chopped fresh thyme",
        "1 teaspoon chopped fresh oregano",
        "Salt and ground black pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Stir olive oil and lemon juice together with garlic, shallot, parsley, basil, thyme, and oregano; season to taste with salt and pepper. Allow to stand for 2 hours at room temperature before serving; store remaining chimichurri in refrigerator."
        }
      ],
      "warnings": [],
