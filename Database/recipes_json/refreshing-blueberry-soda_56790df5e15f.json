  "recipes": [
    {
      "name": "Refreshing Blueberry Soda",
      "ingredients_raw": [
        "1 cup water",
        "1 cup white sugar",
        "2 cups fresh basil",
        "2 cups blueberries",
        "0.5 cup water",
        "2 tablespoons lemon juice",
        "4 cups carbonated sparkling water"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Bring 1 cup water to a boil in a saucepan. Stir the sugar and basil into the water and return to a boil; cook at a boil for 10 minutes and immediately remove from heat. Chill in refrigerator until slightly cooled, about 10 minutes."
        },
        {
          "id": 2,
          "text": "Blend the blueberries, 1/2 cup water, and the lemon juice in a blender until smooth; pour into a pitcher. Remove the basil leaves from the simple-syrup mixture; discard the basil. Stir the syrup into the blueberry mixture. Add the carbonated water to the mixture and stir gently."
        }
      ],
