  "recipes": [
    {
      "name": "Virgin Strawberry Daiquiri",
      "ingredients_raw": [
        "0.75 cup chilled lemon-lime soda",
        "0.25 cup white sugar",
        "2 large strawberries, hulled",
        "1 tablespoon lemon juice",
        "4 cubes ice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather the ingredients."
        },
        {
          "id": 2,
          "text": "Combine lemon-lime soda, sugar, strawberries, and lemon juice in a blender; add ice and blend until smooth."
        },
        {
          "id": 3,
          "text": "Pour into a fancy glass to serve."
        }
      ],
