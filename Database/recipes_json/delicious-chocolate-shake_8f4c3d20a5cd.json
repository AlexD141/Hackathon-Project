  "recipes": [
    {
      "name": "Delicious Chocolate Shake",
      "ingredients_raw": [
        "2 scoops chocolate ice cream",
        "2 tablespoons powdered chocolate drink mix",
        "1 cup milk"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine ice cream, drink mix powder, and milk in a blender. Blend until smooth."
        },
        {
          "id": 2,
          "text": "Pour into glasses and serve."
        }
      ],
