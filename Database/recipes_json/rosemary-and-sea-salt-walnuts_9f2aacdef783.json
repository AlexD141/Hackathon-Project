  "recipes": [
    {
      "name": "Rosemary and Sea Salt Walnuts",
      "ingredients_raw": [
        "2 tablespoons butter",
        "2 tablespoons finely chopped fresh rosemary",
        "1 teaspoon smoked black pepper",
        "0.75 teaspoon sea salt",
        "2 cups walnuts"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 300 degrees F. Melt butter in a small saucepan; stir in rosemary, pepper and salt. Add walnuts and stir well with a rubber scraper until mixture evenly coats walnuts."
        },
        {
          "id": 2,
          "text": "Transfer to a baking sheet and cook for 30 minutes, stirring every 10 minutes. Let cool completely before storing in an airtight container."
        }
      ],
