      "name": "Easy Lemonade",
      "ingredients_raw": [
        "0.75 cup fresh lemon juice",
        "2 quarts water",
        "0.5 cup white sugar"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a large pan, combine water and sugar. Heat until the sugar just melts. Remove from heat and pour in lemon juice. Mix well and chill in refrigerator before serving. Garnish with lemon, lime or orange slices."
        }
