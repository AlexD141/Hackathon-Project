  "recipes": [
    {
      "name": "Irish Coffee Cocktail",
      "ingredients_raw": [
        "4 teaspoons white sugar",
        "1.5 fluid ounces whiskey",
        "6 fluid ounces hot coffee",
        "0.25 cup whipped cream"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place 1 tablespoon sugar on a plate or in a shallow bowl. Lightly wet rim of an Irish coffee glass with a moistened paper towel; dip rim in sugar to coat."
        },
        {
          "id": 2,
          "text": "Pour Irish whisky into the prepared glass; fill with coffee to within ½ inch of top. Stir in 1 teaspoon sugar; top with whipped cream."
        }
      ],
