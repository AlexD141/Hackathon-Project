  "recipes": [
    {
      "name": "Doggie Birthday Cake",
      "ingredients_raw": [
        "1 egg",
        "0.33333334326744 cup honey",
        "0.25 cup peanut butter",
        "0.25 cup cooking oil",
        "1 teaspoon vanilla extract",
        "1 cup shredded carrots",
        "1 cup whole wheat or white flour",
        "1 teaspoon baking soda"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a 6-cup ring mold or fluted tube pan."
        },
        {
          "id": 2,
          "text": "Combine egg, honey, peanut butter, oil, and vanilla in a large bowl; blend well."
        },
        {
          "id": 3,
          "text": "Stir in carrots until well-combined."
        },
        {
          "id": 4,
          "text": "Sift together flour and baking soda and fold into carrot mixture."
        },
        {
          "id": 5,
          "text": "Spoon cake batter into the prepared pan."
        },
        {
          "id": 6,
          "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, about 40 minutes."
        },
        {
          "id": 7,
          "text": "Let cake cool in the pan for 10 minutes, then turn out onto a wire rack to cool completely."
        }
      ],
