  "recipes": [
    {
      "name": "Grilled Oyster Mushrooms",
      "ingredients_raw": [
        "16 ounces oyster mushroom caps",
        "0.125 pound grated Parmesan cheese"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Prepare the grill for medium heat."
        },
        {
          "id": 2,
          "text": "Oil grate. Place mushroom caps on the grill. Mushrooms cooked over the grill will cook very fast and become dried out, so move them around the fire for better heat control — don&#39;t let them burn! You can let them blacken a little bit on the edges for extra flavor. As edges begin to toast, add a sprinkle of Parmesan cheese to each mushroom, and let it melt. Serve and eat immediately!"
        }
      ],
