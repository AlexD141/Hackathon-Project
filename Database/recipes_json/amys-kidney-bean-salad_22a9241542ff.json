  "recipes": [
    {
      "name": "Amy&#39;s Kidney Bean Salad",
      "ingredients_raw": [
        "1 cup mayonnaise",
        "2 tablespoons milk",
        "2 tablespoons vinegar",
        "1 tablespoon white sugar",
        "salt and ground black pepper to taste",
        "4 (8 ounce) cans dark red kidney beans, drained and rinsed",
        "6 hard-boiled eggs, chopped",
        "1 green bell pepper, chopped",
        "1 small red onion, chopped"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Whisk mayonnaise, milk, vinegar, sugar, salt, and black pepper together in a medium-large bowl until well combined."
        },
        {
          "id": 2,
          "text": "Stir kidney beans, hard-boiled eggs, green bell pepper, and red onion into the mayonnaise mixture. Eat immediately or refrigerate before serving."
        }
      ],
