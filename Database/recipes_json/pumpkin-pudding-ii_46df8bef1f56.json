  "recipes": [
    {
      "name": "Pumpkin Pudding II",
      "ingredients_raw": [
        "0.66666698455811 cup white sugar",
        "3 eggs, beaten",
        "1 (12 fluid ounce) can evaporated milk",
        "1 (29 ounce) can canned pumpkin puree",
        "1 teaspoon ground cinnamon",
        "0.5 teaspoon salt",
        "0.25 teaspoon ground cloves",
        "0.25 teaspoon pumpkin pie spice",
        "0.5 (18.25 ounce) package spice cake mix",
        "0.25 cup margarine, melted",
        "0.5 cup chopped walnuts"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C). Grease one 9x13 inch baking dish."
        },
        {
          "id": 2,
          "text": "Blend together the sugar, eggs, evaporated milk, pumpkin, cinnamon, salt, clove and pie spice. Pour into baking dish."
        },
        {
          "id": 3,
          "text": "Spread dry cake mix over pumpkin mixture. Sprinkle with cinnamon, margarine and chopped nuts."
        },
        {
          "id": 4,
          "text": "Bake for 60 minutes or until knife inserted comes out clean. Serve with whipped cream if desired."
        }
      ],
