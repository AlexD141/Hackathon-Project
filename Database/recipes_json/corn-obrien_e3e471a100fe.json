  "recipes": [
    {
      "name": "Corn O&#39;Brien",
      "ingredients_raw": [
        "2 slices bacon, cut into 1/2 inch pieces",
        "0.25 cup minced white onion",
        "2 tablespoons green bell pepper, chopped",
        "2 cups whole kernel corn, drained",
        "1 tablespoon chopped pimento peppers",
        "salt and pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place bacon in a large, deep skillet; cook and stir over medium heat until evenly browned, about 10 minutes. Drain bacon on a paper towel-lined plate, leaving grease in the skillet."
        },
        {
          "id": 2,
          "text": "Stir onion and bell pepper into the skillet; cook until onion has softened and turned translucent, about 5 minutes. Add corn, pimento peppers, and reserved bacon. Cook and stir until heated through, 3 to 5 minutes. Season with salt and pepper."
        }
      ],
