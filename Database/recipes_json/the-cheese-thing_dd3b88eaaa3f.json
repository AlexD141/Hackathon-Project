  "recipes": [
    {
      "name": "The Cheese Thing",
      "ingredients_raw": [
        "1 (16 ounce) package penne pasta",
        "0.25 cup low fat margarine",
        "2.5 cups shredded reduced fat Colby cheese",
        "1 (28 ounce) can diced tomatoes with green chile peppers",
        "1 tablespoon white sugar",
        "0.5 teaspoon salt"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients. Preheat the oven to 400 degrees F (205 degrees C)."
        },
        {
          "id": 2,
          "text": "Cook pasta according to package directions. Drain."
        },
        {
          "id": 3,
          "text": "Stir together pasta, margarine, cheese, diced tomatoes, sugar, and salt. Place in a 9x13-inch pan."
        },
        {
          "id": 4,
          "text": "Bake in the preheated oven for 40 to 60 minutes, until hot and bubbly and the pasta on top is lightly browned. Cover loosely with aluminum foil if the top begins to brown too quickly."
        }
      ],
