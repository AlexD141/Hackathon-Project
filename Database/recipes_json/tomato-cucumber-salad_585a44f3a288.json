  "recipes": [
    {
      "name": "Tomato Cucumber Salad",
      "ingredients_raw": [
        "2 tomatoes, chopped",
        "1 cucumber, peeled and diced",
        "1 onion, chopped",
        "1 tablespoon lemon juice",
        "salt to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Combine tomatoes, cucumber, and onion in a salad bowl. Sprinkle with lemon juice and season with salt and black pepper; toss until well combined."
        },
        {
          "id": 3,
          "text": "Cover and chill salad in the refrigerator until ready to serve."
        }
      ],
