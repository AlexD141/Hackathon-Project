  "recipes": [
    {
      "name": "Raisin Pie II",
      "ingredients_raw": [
        "1.5 cups raisins",
        "1.5 cups boiling water",
        "1 tablespoon all-purpose flour",
        "0.5 cup white sugar",
        "1 tablespoon lemon juice",
        "1 tablespoon lemon zest",
        "0.5 cup finely chopped walnuts",
        "1 recipe pastry for a 9 inch double crust pie"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 425 degrees F ( 220 degrees C)."
        },
        {
          "id": 2,
          "text": "Wash raisins carefully. Cook in boiling water until tender. Mix flour and sugar, and add to cooked raisins. Stir until mixtures thickens. Remove from heat, and add lemon juice, lemon rind, and nuts. Cool slightly."
        },
        {
          "id": 3,
          "text": "Roll out dough, and fit to a 9 inch pie pan. Spoon filling into the shell. Cover with top crust, crimp the edges, and cut a couple slashes in the top."
        },
        {
          "id": 4,
          "text": "Bake for 40 to 45 minutes, or until crust is golden brown."
        }
      ],
