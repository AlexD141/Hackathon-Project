  "recipes": [
    {
      "name": "Sweet Potato Butternut Squash Pie",
      "ingredients_raw": [
        "3 cups mashed sweet potatoes",
        "2 cups cooked butternut squash",
        "4 eggs",
        "0.5 cup condensed milk",
        "1 teaspoon cinnamon",
        "0.5 teaspoon ground nutmeg",
        "0.5 teaspoon allspice",
        "1 unbaked 9-inch pie crust",
        "1 (10 ounce) package mini marshmallows"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Mash sweet potatoes and butternut squash together in a bowl; stir in eggs, milk, cinnamon, nutmeg, and allspice. Pour sweet potato-squash mixture into pie crust."
        },
        {
          "id": 3,
          "text": "Bake in the preheated oven for 30 minutes; arrange marshmallows on top of pie. Continue baking until a knife inserted into center comes out clean, about 30 minutes more."
        }
      ],
