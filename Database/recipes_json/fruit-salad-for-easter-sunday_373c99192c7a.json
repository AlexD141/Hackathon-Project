      "name": "Easter Fruit Salad",
      "ingredients_raw": [
        "1 cup chopped fresh strawberries",
        "1 cup fresh blueberries",
        "1 cup red grapes",
        "1 Fuji apple, cored and chopped",
        "1 Granny Smith apple, chopped",
        "2 kiwi fruit, peeled and chopped",
        "1 (15 ounce) can crushed pineapple",
        "2 cups lemon yogurt"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather the ingredients."
        },
        {
          "id": 2,
          "text": "Combine strawberries, blueberries, grapes, apples, and kiwi in a salad bowl."
        },
        {
          "id": 3,
          "text": "Add drained pineapple, then yogurt. Mix until thoroughly combined."
        }
