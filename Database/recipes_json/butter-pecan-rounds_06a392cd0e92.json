  "recipes": [
    {
      "name": "Butter Pecan Rounds",
      "ingredients_raw": [
        "2 tablespoons butter",
        "1.5 cups chopped pecans",
        "1.5 tablespoons white sugar",
        "0.5 cup unsalted butter",
        "0.5 cup white sugar",
        "0.5 cup packed light brown sugar",
        "1 egg",
        "1 teaspoon vanilla extract",
        "1.6666699647903 cups all-purpose flour",
        "0.5 teaspoon baking soda",
        "0.5 teaspoon salt"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 375 degrees F (190 degrees C). Line baking sheets with parchment paper."
        },
        {
          "id": 2,
          "text": "In a skillet over medium heat toast the pecans with 2 tablespoons of the butter, cooking for about 5 minutes. Sprinkle 1 1/2 tablespoons of the white sugar over the top."
        },
        {
          "id": 3,
          "text": "Cream 1/2 cup of the butter with the white and brown sugar. Beat in the egg and vanilla. Mix in the flour, baking soda and salt. Stir in the pecan mixture."
        },
        {
          "id": 4,
          "text": "Drop tablespoonfuls of dough onto the prepared baking sheets. Bake at 375 degrees F (190 degrees C) for 10 to 12 minutes until golden brown. Let cool and devour."
        }
      ],
