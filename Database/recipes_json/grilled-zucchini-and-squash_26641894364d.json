  "recipes": [
    {
      "name": "Grilled Zucchini and Squash",
      "ingredients_raw": [
        "2 zucchini, halved lengthwise and cut in 1/4 inch slices",
        "1 summer squash, thinly sliced",
        "0.75 cup butter",
        "1 tablespoon salt",
        "2 tablespoons ground black pepper",
        "2 tablespoons garlic powder"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather the ingredients. Preheat an outdoor grill for medium-high heat."
        },
        {
          "id": 2,
          "text": "Place zucchini and squash on a large sheet of aluminum foil; dot with butter. Season with salt, pepper, and garlic powder. Seal vegetables in the foil packet."
        },
        {
          "id": 3,
          "text": "Place the foil packet on the preheated grill until vegetables are tender, about 20 minutes."
        }
      ],
