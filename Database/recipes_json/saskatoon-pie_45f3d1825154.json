  "recipes": [
    {
      "name": "Saskatoon Pie",
      "ingredients_raw": [
        "0.75 cup white sugar",
        "3 tablespoons all-purpose flour",
        "4 cups fresh serviceberries",
        "0.25 cup water",
        "2 tablespoons lemon juice",
        "1 (14.1 ounce) package double-crust pie pastry, thawed",
        "1 tablespoon unsalted butter, cut into pieces"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather the ingredients."
        },
        {
          "id": 2,
          "text": "Preheat the oven to 425 degrees F (220 degrees C). Combine sugar and flour in a bowl."
        },
        {
          "id": 3,
          "text": "Simmer berries and water in a large saucepan for 10 minutes. Stir in lemon juice, then stir in sugar mixture."
        },
        {
          "id": 4,
          "text": "Press one pie pastry into the bottom of a 9-inch pie pan. Pour berry mixture into the pan and dot with butter."
        },
        {
          "id": 5,
          "text": "Place second pie pastry over top; seal and flute the edges."
        },
        {
          "id": 6,
          "text": "Bake in the preheated oven for 15 minutes. Reduce the oven temperature to 350 degrees F (175 degrees C) and bake until crust is golden brown, 35 to 45 minutes more."
        }
      ],
