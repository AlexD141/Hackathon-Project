  "recipes": [
    {
      "name": "Huckleberry Cake",
      "ingredients_raw": [
        "1 cup all-purpose flour",
        "1 cup whole wheat flour",
        "1 teaspoon baking soda",
        "0.5 teaspoon sea salt",
        "1.5 cups brown sugar",
        "1 cup buttermilk",
        "0.5 cup butter, melted",
        "1 egg, lightly beaten",
        "1 teaspoon vanilla extract",
        "1.5 cups huckleberries",
        "0.5 cup sliced almonds for garnish",
        "1.5 cups whipped cream for garnish",
        "0.5 cup brown sugar",
        "0.25 cup white sugar",
        "0.25 cup rolled oats",
        "1 teaspoon ground cinnamon",
        "1 tablespoon butter, melted"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan."
        },
        {
          "id": 2,
          "text": "Combine all-purpose flour, whole wheat flour, baking soda, and salt in a medium bowl."
        },
        {
          "id": 3,
          "text": "Combine 1 ½ cups brown sugar, buttermilk, ½ cup melted butter, egg, and vanilla in a large bowl; stir in flour mixture until combined. Gently fold in huckleberries. Pour batter into the prepared pan. Set aside."
        },
        {
          "id": 4,
          "text": "Combine ½ cup brown sugar, white sugar, oats, and cinnamon; stir in 1 tablespoon melted butter. Sprinkle oat-cinnamon topping evenly over cake batter."
        },
        {
          "id": 5,
          "text": "Bake in the preheated oven until a toothpick inserted into cake comes out clean, 45 to 50 minutes. Cool completely. Garnished with whipped cream and sliced almonds."
        }
      ],
