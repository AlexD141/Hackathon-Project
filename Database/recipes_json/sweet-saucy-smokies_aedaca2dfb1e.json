  "recipes": [
    {
      "name": "Sweet Saucy Smokies",
      "ingredients_raw": [
        "1 (20 ounce) can pineapple chunks, drained with juice reserved",
        "0.33333334326744 cup reserved pineapple juice",
        "1 (8 ounce) jar grape jelly",
        "1 (6 ounce) can tomato paste",
        "0.5 cup packed brown sugar",
        "0.5 cup vinegar",
        "2 tablespoons cornstarch",
        "2 teaspoons Worcestershire sauce",
        "1 teaspoon hot pepper sauce",
        "1 teaspoon liquid smoke flavoring",
        "0.5 teaspoon salt",
        "2 (14 ounce) packages little smoked sausages"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place the pineapple chunks, pineapple juice, grape jelly, tomato paste, brown sugar, vinegar, cornstarch, Worcestershire sauce, hot pepper sauce, liquid smoke flavoring, and salt into a saucepan over medium heat. Stirring constantly, bring the sauce to a simmer, and cook until the grape jelly melts, about 5 minutes."
        },
        {
          "id": 2,
          "text": "Stir in the smoked sausages, and turn the heat to low; cook the sausages in the sauce below a simmer until the sauce is thickened and the flavors have blended, about 30 minutes."
        }
      ],
