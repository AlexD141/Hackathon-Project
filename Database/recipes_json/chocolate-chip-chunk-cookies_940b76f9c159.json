  "recipes": [
    {
      "name": "Chocolate Chip Chunk Cookies",
      "ingredients_raw": [
        "2 cups all-purpose flour",
        "1 teaspoon baking soda",
        "0.5 teaspoon salt",
        "1 cup shortening",
        "0.5 cup white sugar",
        "0.75 cup packed brown sugar",
        "1 egg",
        "2.5 teaspoons vanilla extract",
        "1.3333333730698 cups semisweet chocolate chips",
        "1 cup chopped walnuts"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine flour, baking soda, and salt. Set aside."
        },
        {
          "id": 2,
          "text": "In a large bowl , cream the vegetable shortening and the two sugars. Beat in the egg and vanilla. Gradually blend in the dry ingredients."
        },
        {
          "id": 3,
          "text": "Fold in the chocolate chips and the nuts. Cover and chill for 2 to 3 hours."
        },
        {
          "id": 4,
          "text": "Preheat oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 5,
          "text": "Drop cookie by teaspoonfuls onto shiny lightly greased cookie sheets. Bake 10-12 minutes and transfer to wire racks to cool. Take out of oven when lightly colored - they will darken after being taken off cookie sheet."
        }
      ],
