  "recipes": [
    {
      "name": "Mashed Sweet Potato Bake",
      "ingredients_raw": [
        "3.5 cups mashed sweet potatoes",
        "0.25 cup milk",
        "0.25 cup orange juice",
        "2 eggs, beaten",
        "1 teaspoon vanilla extract",
        "0.5 cup white sugar",
        "0.5 teaspoon salt",
        "3 tablespoons butter, softened",
        "0.5 teaspoon ground nutmeg",
        "0.5 teaspoon ground cinnamon",
        "0.25 cup butter, softened",
        "0.75 cup packed light brown sugar",
        "0.5 cup all-purpose flour",
        "0.75 cup chopped pecans"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C). Grease one 2 quart casserole dish."
        },
        {
          "id": 2,
          "text": "In a large bowl, blend together the sweet potatoes, milk, orange juice, eggs, vanilla, sugar, salt, butter, nutmeg and cinnamon. Pour into prepared casserole dish."
        },
        {
          "id": 3,
          "text": "Mix together the 1/4 cup butter, brown sugar, flour and pecans; sprinkle over sweet potato mixture."
        },
        {
          "id": 4,
          "text": "Bake at 350 degrees F (175 degrees C) for 45 minutes."
        }
      ],
