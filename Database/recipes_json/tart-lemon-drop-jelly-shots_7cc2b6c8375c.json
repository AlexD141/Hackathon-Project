  "recipes": [
    {
      "name": "Tart Lemon Drop Jelly Shots",
      "ingredients_raw": [
        "4 cups water",
        "8 large lemons, cut into 8 wedges each",
        "3.5 cups white sugar",
        "8 (.25 ounce) packages unflavored gelatin",
        "4 cups lemon vodka",
        "1 tablespoon turbinado sugar"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Heat water, lemon wedges, and white sugar in a large saucepan over medium heat. Simmer until sugar is dissolved, mashing lemons often to release juice and oils."
        },
        {
          "id": 2,
          "text": "Cook and stir lemon mixture for 5 minutes more, then remove from heat and allow to cool slightly. Strain lemon pieces from saucepan."
        },
        {
          "id": 3,
          "text": "Sprinkle gelatin into saucepan."
        },
        {
          "id": 4,
          "text": "Heat syrup and gelatin mixture over low heat until gelatin dissolves, 5 to 10 minutes."
        },
        {
          "id": 5,
          "text": "Remove from heat and allow to cool for 15 minutes. Pour lemon vodka into gelatin mixture and stir well."
        },
        {
          "id": 6,
          "text": "Pour mixture into a 9x13-inch baking pan; refrigerate until set, at least 6 hours."
        },
        {
          "id": 7,
          "text": "Run a sharp knife under hot water; cut gelatin into cubes with knife and sprinkle cubes with turbinado sugar before serving."
        }
      ],
      "warnings": [],
