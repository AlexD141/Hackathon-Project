  "recipes": [
    {
      "name": "Easy White Sangria",
      "ingredients_raw": [
        "1 (750 milliliter) bottle white wine",
        "0.5 cup cubed watermelon",
        "0.5 cup cubed honeydew",
        "0.5 cup sliced strawberries",
        "0.5 cup fresh raspberries",
        "6 splashes ginger ale, or to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine white wine, watermelon, honeydew, strawberries, and raspberries in a large pitcher. Chill in the refrigerator to allow flavors to blend, at least 1 hour."
        },
        {
          "id": 2,
          "text": "Pour chilled wine and fruit into goblets; top each with a splash of ginger ale."
        }
      ],
