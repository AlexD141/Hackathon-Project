  "recipes": [
    {
      "name": "My Own Mincemeat Pie Filling",
      "ingredients_raw": [
        "1 pound ground beef",
        "4 apples - peeled, cored and chopped",
        "1 cup brown sugar",
        "1 cup brandy",
        "0.75 cup raisins, chopped",
        "0.5 cup ground suet (white beef fat)",
        "0.5 cup walnuts, chopped",
        "0.5 cup chopped dried mixed fruit",
        "0.5 cup candied mixed fruit peel, chopped",
        "1 lemon, juiced",
        "1 teaspoon salt",
        "1 teaspoon ground nutmeg",
        "0.5 teaspoon ground cinnamon",
        "0.5 teaspoon ground allspice",
        "0.5 teaspoon ground cloves"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Cook and stir ground beef in a skillet over medium heat until well-browned, about 10 minutes, breaking it up into small crumbles as it cooks. Drain excess fat."
        },
        {
          "id": 2,
          "text": "Combine beef, apples, brown sugar, brandy, raisins, suet, walnuts, dried mixed fruit, mixed fruit peel, lemon juice, salt, nutmeg, cinnamon, allspice, and cloves in a large cast-iron or other heavy skillet over medium heat. Stir until thoroughly combined and sugar has dissolved; bring to a boil. Reduce heat to a simmer; cook until flavors have blended and filling is thickened, about 1 hour. Stir occasionally."
        },
        {
          "id": 3,
          "text": "Use mincemeat pie filling as desired."
        }
      ],
      "warnings": [],
