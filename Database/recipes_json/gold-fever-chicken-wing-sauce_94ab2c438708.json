  "recipes": [
    {
      "name": "Gold Fever Chicken Wing Sauce",
      "ingredients_raw": [
        "0.5 cup honey mustard",
        "0.25 cup cayenne pepper hot sauce",
        "3 tablespoons unsalted butter",
        "1 pinch salt",
        "1 pinch ground black pepper"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine honey mustard, hot sauce, butter, salt, and black pepper in a saucepan over medium heat; stir until butter melted. Simmer until sauce begins to thicken, about 5 minutes. Use in your favorite chicken wings recipe and serve while hot."
        }
      ],
