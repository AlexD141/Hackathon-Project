            "author": {
              "@type": "Person",
              "name": "Ty Frappier"
            },
            "reviewBody": "I used catlemans brand bbq sauce that was Carolina style. And Franks red hot. Tasted awesome. As far as I'm concerned. Similar to the 99 restaurant.",
            "datePublished": "2015-09-17T15:48:31.377Z"
