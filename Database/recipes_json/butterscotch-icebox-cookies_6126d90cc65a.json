  "recipes": [
    {
      "name": "Butterscotch Icebox Cookies",
      "ingredients_raw": [
        "1 cup butter",
        "2 cups packed dark brown sugar",
        "2 eggs",
        "3.5 cups all-purpose flour",
        "0.5 teaspoon salt",
        "1 teaspoon baking soda",
        "1 teaspoon vanilla extract",
        "1 cup chopped pecans"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Cream butter, add sugar and cream well. Beat in eggs, then add sifted dry ingredients, vanilla and nuts."
        },
        {
          "id": 2,
          "text": "Shape into rolls, wrap in wax paper and freeze or put in refrigerator until firm."
        },
        {
          "id": 3,
          "text": "Slice and place about an inch apart on greased cookie sheet. Bake about 12 minutes at 400 degrees F (200 degrees C)."
        },
        {
          "id": 4,
          "text": "When done, remove from pan at once with a spatula. Store in a covered container and they will remain crisp."
        }
      ],
