    {
      "name": "Best Caprese Skewers",
      "ingredients_raw": [
        "20 grape tomatoes",
        "10 ounces mozzarella cheese, cubed",
        "2 tablespoons extra virgin olive oil",
        "2 tablespoons fresh basil leaves, chopped",
        "1 pinch salt",
        "1 pinch ground black pepper",
        "20 toothpicks"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Toss tomatoes, mozzarella, olive oil, basil, salt, and pepper together in a bowl until well coated."
        },
        {
          "id": 3,
          "text": "Skewer one tomato and one piece of mozzarella on each toothpick."
        }
      ],
