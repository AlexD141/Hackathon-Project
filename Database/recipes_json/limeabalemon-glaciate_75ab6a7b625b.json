  "recipes": [
    {
      "name": "Limeabalemon Glaciate",
      "ingredients_raw": [
        "1.5 cups crushed ice",
        "1 ripe banana",
        "0.5 lime, juiced",
        "0.5 lemon, juiced",
        "1 tablespoon shredded coconut, as garnish",
        "2 pitted cherries, as garnish"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Blend the ice and banana together in a blender set to Low until mixed, adding the lime juice and lemon juice as it blends to keep the ice from freezing to the side of the blender. Serve in a tall glass and garnish with coconut or a cherry."
        }
      ],
