      "name": "Alabama Slammer Cocktail",
      "ingredients_raw": [
        "1 fluid ounce amaretto liqueur",
        "1 fluid ounce Tennessee whiskey (such as Jack Daniels ®)",
        "0.5 fluid ounce sloe gin",
        "1 tablespoon lemon juice",
        "1 cup ice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine amaretto, whiskey, sloe gin, and lemon juice in a cocktail shaker. Add ice and stir until chilled. Strain into a chilled cordial glass."
        }
      ],
