      "ingredients_raw": [
        "2 avocados - peeled, pitted and diced",
        "1 fresh peach - peeled, pitted and diced",
        "0.5 cup diced sweet onion",
        "2 tablespoons fresh lime juice",
        "salt and ground black pepper to taste"
      ],
      "steps": [
        {
