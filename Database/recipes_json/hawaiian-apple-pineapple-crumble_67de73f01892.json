  "recipes": [
    {
      "name": "Hawaiian Apple-Pineapple Crumble",
      "ingredients_raw": [
        "2 cups thinly sliced apples",
        "1 tablespoon lemon juice",
        "1 cup crushed pineapple, drained",
        "2 cups cranberry sauce",
        "1 cup quick cooking oats",
        "0.75 cup packed brown sugar",
        "0.5 cup all-purpose flour",
        "0.5 teaspoon ground cinnamon",
        "salt to taste",
        "0.125 cup butter"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Toss apple slices with lemon juice. Place in a 10 x 6 x 1 1/2 inch baking dish. Spoon pineapple evenly over apples, then cover with cranberry sauce."
        },
        {
          "id": 2,
          "text": "Mix oats, brown sugar, flour, cinnamon, and salt. Cut in butter or margarine till crumbly. Sprinkle over fruit."
        },
        {
          "id": 3,
          "text": "Bake at 350 degrees F (175 degrees C) for 30 minutes, or till apples are tender. Serve warm."
        }
      ],
      "warnings": [],
