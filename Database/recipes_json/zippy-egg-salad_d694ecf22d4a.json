  "recipes": [
    {
      "name": "Zippy Egg Salad",
      "ingredients_raw": [
        "0.25 cup mayonnaise",
        "2 tablespoons grated Parmesan cheese",
        "1 tablespoon light soy sauce",
        "0.25 lime, juiced",
        "1 teaspoon crushed red pepper",
        "salt and ground black pepper to taste",
        "4 hard-cooked eggs, chopped",
        "1 stalk celery, finely sliced"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Whisk mayonnaise, Parmesan cheese, soy sauce, lime juice, red pepper, salt, and black pepper in a bowl."
        },
        {
          "id": 2,
          "text": "Stir eggs and celery into the mayonnaise mixture until well coated."
        },
        {
          "id": 3,
          "text": "Cover bowl with plastic wrap and refrigerate until chilled before serving."
        }
      ],
