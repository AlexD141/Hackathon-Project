  "recipes": [
    {
      "name": "Smoked Asparagus",
      "ingredients_raw": [
        "2 tablespoons butter",
        "4 cloves garlic, sliced thin",
        "2 tablespoons lemon juice",
        "salt to taste",
        "0.25 teaspoon ground black pepper",
        "1 onion, thinly sliced",
        "1.5 pounds asparagus, trimmed"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place the charcoal into the bottom pan of the smoker. Light the coals and wait for the temperature of the smoker to come to 240 degrees F (115 degrees C)."
        },
        {
          "id": 2,
          "text": "Melt the butter in a small saucepan, stir in the garlic and cook over low heat until just tender. Remove from the heat and mix in the lemon juice, salt, and black pepper."
        },
        {
          "id": 3,
          "text": "Arrange the onions in the bottom of a large cast iron skillet or heat-resistant glass container. Spread asparagus spears over the onions. Drizzle the butter and garlic mixture over the asparagus. Place the uncovered skillet or baking dish on the top grate of the preheated smoker."
        },
        {
          "id": 4,
          "text": "Close the smoker and cook the asparagus until tender, about 1 hour."
        }
      ],
