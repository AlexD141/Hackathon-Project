  "recipes": [
    {
      "name": "Petticoat Tails",
      "ingredients_raw": [
        "1 cup butter, softened",
        "1 cup sifted confectioners' sugar",
        "1 teaspoon vanilla extract",
        "2.5 cups sifted all-purpose flour",
        "0.25 teaspoon salt"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Beat butter, confectioners&#39; sugar, and vanilla together in a bowl with an electric mixer until light and fluffy. Stir in flour and salt; press and mold dough into a long smooth roll about 2 inches in diameter. Wrap in plastic wrap; chill 3 to 5 hours to overnight."
        },
        {
          "id": 2,
          "text": "Preheat the oven to 400 degrees F (205 degrees C)."
        },
        {
          "id": 3,
          "text": "Slice dough into 1/8- to 1/16-inch-thick slices; place on ungreased baking sheets."
        },
        {
          "id": 4,
          "text": "Bake in the preheated oven until lightly browned, 8 to 10 minutes."
        }
      ],
