  "recipes": [
    {
      "name": "Party Cheese Ball",
      "ingredients_raw": [
        "2 (8 ounce) packages PHILADELPHIA Cream Cheese, softened",
        "2 (8 ounce) packages KRAFT Shredded Sharp Cheddar Cheese",
        "1 tablespoon finely chopped onion",
        "1 tablespoon chopped red bell pepper",
        "2 teaspoons Worcestershire sauce",
        "1 teaspoon lemon juice",
        "1 dash ground red pepper",
        "1 dash salt",
        "1 cup chopped PLANTERS Pecans"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Beat cream cheese and Cheddar cheese in a bowl with an electric mixer on medium speed until well blended. Mix in onion, bell pepper, Worcestershire sauce, lemon juice, cayenne pepper, and salt. Cover and refrigerate for 3 hours or overnight."
        },
        {
          "id": 2,
          "text": "Remove from the refrigerator and shape into a ball. Roll in pecans and place onto a serving plate."
        }
      ],
