  "recipes": [
    {
      "name": "Best Ever Layered Mexican Dip",
      "ingredients_raw": [
        "1 (9 ounce) can bean dip",
        "1 (6 ounce) container guacamole",
        "12 ounces sour cream",
        "1 (1 ounce) package taco seasoning mix",
        "1 (8 ounce) package shredded Cheddar cheese",
        "1 tomato, chopped",
        "1 jalapeno pepper, seeded and diced"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Spread bean dip in a glass dish or on a large serving platter; top with a layer of guacamole. Allow the layers to thicken in the refrigerator for approximately 20 minutes."
        },
        {
          "id": 3,
          "text": "Meanwhile, mix sour cream and taco seasoning in a bowl until evenly combined."
        },
        {
          "id": 4,
          "text": "When the chilled mixture is sufficiently thickened, spread a layer of sour cream mixture over guacamole; top with grated cheese. Garnish with tomatoes and jalapeños. Enjoy with your favorite chips!"
        }
      ],
