  "recipes": [
    {
      "name": "Sour Cream Raisin Pie I",
      "ingredients_raw": [
        "1 (9 inch) pie crust, baked",
        "0.75 cup white sugar",
        "2 tablespoons cornstarch",
        "0.25 teaspoon salt",
        "2 eggs",
        "2 cups sour cream",
        "1 cup raisins",
        "2 tablespoons lemon juice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a large saucepan, combine sugar, cornstarch, and salt. Beat eggs, and add with 1 1/2 cups sour cream, raisins, and lemon juice to the saucepan. Cook over low heat, stirring constantly, until thickened. Pour custard into pie shell. Cool."
        },
        {
          "id": 2,
          "text": "Spread remaining 1/2 cup sour cream over cooled filling. Refrigerate several hours, until thoroughly chilled."
        }
      ],
