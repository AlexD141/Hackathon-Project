  "recipes": [
    {
      "name": "Texatini",
      "ingredients_raw": [
        "1 tablespoon coarse salt",
        "1 (1.5 fluid ounce) jigger tequila",
        "1 (1.5 fluid ounce) jigger orange liqueur (Cointreau, Triple Sec or Grand Marnier)",
        "0.5 cup sweet and sour mix",
        "1 fluid ounce orange juice",
        "1 cup crushed ice",
        "1 jalapeno-stuffed green olive"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Slightly moisten rim of a large martini glass, and dip in course salt to rim the glass."
        },
        {
          "id": 2,
          "text": "Combine tequila, orange liqueur, sweet and sour mix, orange juice, and ice in a shaker. Shake vigorously, and strain into martini glass. Garnish with jalapeno-stuffed green olives."
        }
      ],
