  "recipes": [
    {
      "name": "Italian Wedding Cake Martini",
      "ingredients_raw": [
        "2 fluid ounces vanilla vodka",
        "1 fluid ounce cranberry juice",
        "1 fluid ounce pineapple juice",
        "0.5 fluid ounce amaretto (almond flavored liqueur)",
        "0.5 fluid ounce white creme de cacao"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Pour the vodka, cranberry juice, pineapple juice, amaretto, and creme de cacao into a cocktail shaker over ice. Cover, and shake until the outside of the shaker has frosted. Strain into a chilled martini glass to serve."
        }
      ],
