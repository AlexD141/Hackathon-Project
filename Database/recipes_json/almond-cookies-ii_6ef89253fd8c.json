  "recipes": [
    {
      "name": "Almond Cookies II",
      "ingredients_raw": [
        "0.5 cup butter",
        "0.5 cup packed brown sugar",
        "1 teaspoon almond extract",
        "1 egg",
        "0.5 cup white rice flour",
        "2 cups crisp rice cereal",
        "2 tablespoons chopped almonds"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Cream butter or margarine and sugar together until light and fluffy. Add almond extract and egg. Beat well. Stir in flour, crispy rice and almonds."
        },
        {
          "id": 3,
          "text": "Shape into balls one inch in diameter and place on ungreased baking sheets. Press with a floured fork to flatten slightly. Bake for 12 to 15 minutes until lightly browned."
        }
      ],
