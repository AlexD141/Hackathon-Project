  "recipes": [
    {
      "name": "Tofu Mayo",
      "ingredients_raw": [
        "1 (10.5 ounce) package firm silken tofu",
        "1.5 teaspoons distilled white vinegar",
        "1 teaspoon salt",
        "0.5 teaspoon dry mustard",
        "1 teaspoon white sugar"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a blender combine tofu, vinegar, salt, mustard and sugar. Blend until smooth. Keep refrigerated."
        }
      ],
