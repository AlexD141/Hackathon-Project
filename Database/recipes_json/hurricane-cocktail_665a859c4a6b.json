  "recipes": [
    {
      "name": "Hurricane Cocktail",
      "ingredients_raw": [
        "1 fluid ounce dark rum",
        "1 fluid ounce light rum",
        "2 tablespoons lime juice",
        "1 tablespoon passion fruit flavored syrup",
        "1 cup ice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine dark rum, light rum, lime juice, and passion fruit syrup in a cocktail shaker. Add ice; cover and shake until the outside of the shaker has frosted. Strain into a chilled glass."
        }
      ],
