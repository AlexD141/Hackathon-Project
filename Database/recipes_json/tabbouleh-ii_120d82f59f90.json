  "recipes": [
    {
      "name": "Tabbouleh",
      "ingredients_raw": [
        "0.25 cup bulgur",
        "0.5 cup boiling water",
        "5 tomatoes, diced",
        "1 onion, finely diced",
        "1 cup chopped parsley",
        "0.25 cup chopped fresh mint leaves",
        "1 lemon, juiced",
        "2 teaspoons olive oil",
        "salt to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Place bulgur in a small mixing bowl. Add boiling water, mix, and cover with a clean towel. Let stand for 1 hour. Drain any excess water."
        },
        {
          "id": 3,
          "text": "Combine tomatoes, onion, parsley, mint, lemon juice, olive oil, and salt. Add bulgur; mix well and serve."
        }
      ],
