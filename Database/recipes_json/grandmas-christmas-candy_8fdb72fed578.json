  "recipes": [
    {
      "name": "Grandma&#39;s Christmas Candy",
      "ingredients_raw": [
        "2 cups semisweet chocolate chips",
        "0.5 cup butter",
        "2 cups crunchy peanut butter"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Line a 9 X13 inch pan with foil. Set aside."
        },
        {
          "id": 2,
          "text": "In the top pot of a double boiler set, slowly melt chocolate pieces and butter until smooth. Add peanut butter and stir until well mixed."
        },
        {
          "id": 3,
          "text": "Pour chocolate mixture into pan; cover and chill in refrigerator until hardened. Cut into small squares and serve."
        }
      ],
