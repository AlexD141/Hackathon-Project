  "recipes": [
    {
      "name": "Gyoza Sauce",
      "ingredients_raw": [
        "0.5 cup rice vinegar",
        "0.5 cup low-sodium soy sauce",
        "0.33333334326744 cup thinly sliced green onions",
        "1 garlic clove, minced",
        "1 teaspoon sesame oil",
        "0.5 teaspoon crushed red pepper flakes",
        "0.5 teaspoon minced fresh ginger root"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Whisk together rice vinegar, soy sauce, green onions, garlic, sesame oil, red pepper flakes, and ginger in a bowl."
        },
        {
          "id": 3,
          "text": "Let sit for 15 minutes before serving."
        },
        {
          "id": 4,
          "text": "Store covered in the refrigerator for up to 1 week. Enjoy!"
        }
      ],
