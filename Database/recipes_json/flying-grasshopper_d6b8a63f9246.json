      "name": "Flying Grasshopper",
      "ingredients_raw": [
        "2 fluid ounces chocolate liqueur",
        "2 fluid ounces creme de menthe",
        "1 fluid ounce vanilla vodka",
        "1 fluid ounce vodka",
        "0.5 cup half-and-half cream",
        "1 teaspoon chocolate syrup"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Pour the chocolate liqueur, creme de menthe, vanilla vodka, regular vodka, and half-and-half cream into a cocktail shaker over ice. Cover, and shake until the outside of the shaker has frosted. Strain into chilled martini glasses rimmed with chocolate syrup to serve."
        }
