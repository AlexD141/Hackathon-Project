  "recipes": [
    {
      "name": "Betty&#39;s Pork Roast",
      "ingredients_raw": [
        "3 pounds bone-in pork roast",
        "2 cloves garlic",
        "salt and pepper to taste",
        "0.25 teaspoon Cajun seasoning",
        "1 (28 ounce) bottle ketchup",
        "16 ounces prepared mustard"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Stuff roast with garlic, salt, pepper and Cajun seasoning. In a large pot of boiling water, boil roast until meat is slightly pink. Remove from water."
        },
        {
          "id": 3,
          "text": "Lay roast in a 9x13 inch baking dish lined with aluminum foil. Cover in ketchup and mustard. Then cover with more foil and bake in the preheated oven for 1 1/2 to 2 hours or until internal temperature has reached 145 degrees F (63 degrees C)."
        }
      ],
