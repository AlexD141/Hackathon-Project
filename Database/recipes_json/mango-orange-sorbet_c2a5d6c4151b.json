  "recipes": [
    {
      "name": "Mango Orange Sorbet",
      "ingredients_raw": [
        "4 cups chilled cubed mango",
        "0.5 cup cold water",
        "0.25 cup orange juice",
        "0.5 cup white sugar"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Blend the mango, water, and orange juice in a blender on medium-low speed until smooth. Add the sugar and blend until incorporated."
        },
        {
          "id": 2,
          "text": "Pour into an ice cream maker and freeze according to the manufacturer&#39;s instructions."
        }
      ],
