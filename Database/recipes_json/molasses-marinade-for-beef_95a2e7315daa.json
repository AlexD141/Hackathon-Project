    {
      "name": "Molasses Marinade for Beef",
      "ingredients_raw": [
        "0.5 cup molasses",
        "0.5 cup brown sugar",
        "1 cup ketchup",
        "1 tablespoon lemon juice",
        "1 tablespoon dried oregano",
        "1 tablespoon garlic powder",
        "0.5 teaspoon onion powder",
        "3 rings onion"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine the molasses, brown sugar, ketchup, lemon juice, oregano, garlic powder, onion powder, and onion in a bowl; stir to combine. Pour marinade over meat and allow to sit in the refrigerator overnight before cooking."
        }
      ],
