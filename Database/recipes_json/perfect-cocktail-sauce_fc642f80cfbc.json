  "recipes": [
    {
      "name": "Perfect Cocktail Sauce",
      "ingredients_raw": [
        "0.5 cup ketchup (such as Heinz®)",
        "1 cup tomato-based chili sauce (such as Heinz®)",
        "0.25 cup prepared horseradish",
        "0.33333334326744 cup light brown sugar",
        "2 tablespoons lemon juice",
        "0.5 teaspoon hot pepper sauce (such as Frank's RedHot®)",
        "0.25 teaspoon garlic salt",
        "0.25 teaspoon onion powder"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Whisk ketchup, chili sauce, horseradish, brown sugar, lemon juice, hot sauce, garlic salt, and onion powder together in a bowl until the sugar has dissolved."
        },
        {
          "id": 2,
          "text": "Cover and refrigerate at least 1 hour before serving."
        }
      ],
