      "name": "Kielbasa for the Big Game",
      "ingredients_raw": [
        "4 pounds kielbasa (Polish) sausage (such as Hillshire Farm®), cut into 1/2 inch pieces",
        "1 (18 ounce) jar grape jelly",
        "2 (18 ounce) bottles barbeque sauce"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place kielbasa into a slow cooker. Add grape jelly and barbeque sauce."
        },
        {
          "id": 2,
          "text": "Cook on Medium until hot, about 2 hours."
        }
      ],
