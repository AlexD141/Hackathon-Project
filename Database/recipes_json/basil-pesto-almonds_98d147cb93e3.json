  "recipes": [
    {
      "name": "Basil-Pesto Almonds",
      "ingredients_raw": [
        "2 egg whites",
        "0.25 cup packed whole basil leaves",
        "2 cups whole natural almonds",
        "0.25 cup freshly grated Parmesan cheese",
        "1 teaspoon salt",
        "0.5 teaspoon garlic powder"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 225 degrees F (107 degrees C). Line a baking sheet with parchment paper; set aside."
        },
        {
          "id": 2,
          "text": "Place egg whites and basil in a blender; blend on low speed until smooth. Transfer basil mixture to a bowl; add almonds and toss to coat. Drain in a colander."
        },
        {
          "id": 3,
          "text": "Combine Parmesan cheese, salt, and garlic powder in a bowl; add drained almonds and toss to coat. Spread almonds in a single layer on the prepared baking sheet."
        },
        {
          "id": 4,
          "text": "Bake in the preheated oven for 1 hour, stirring every 15 minutes. Cool completely. Store in an airtight container."
        }
      ],
