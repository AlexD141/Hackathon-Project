  "recipes": [
    {
      "name": "Peppermint Lemonade",
      "ingredients_raw": [
        "1 (12 ounce) can frozen lemonade concentrate, thawed",
        "1 fresh lemon",
        "1.25 cups white sugar",
        "0.5 cup fresh mint leaves"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Pour the lemonade concentrate into a large pitcher or cooler with a spout. Stir in enough water to make 1 gallon. Grate the zest from the lemon and add to the pitcher, then squeeze the lemon juice from the lemon into the pitcher. In a small bowl, crush the mint leaves into the sugar using a muddler or a wooden spoon. Stir into the lemonade. Cover and chill for several hours, then strain to remove the leaves and zest before serving. Serve over ice and garnish with a sprig of mint."
        }
      ],
