  "recipes": [
    {
      "name": "Passover Banana Coffee Cake",
      "ingredients_raw": [
        "1.25 cups matzo cake meal",
        "1 teaspoon cream of tartar",
        "0.5 teaspoon baking soda",
        "0.25 teaspoon salt",
        "0.25 cup butter, softened",
        "1 cup white sugar",
        "1 banana, mashed",
        "1 egg",
        "0.5 cup milk",
        "0.33333334326744 cup brown sugar",
        "2 tablespoons ground cinnamon"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8-inch square baking pan."
        },
        {
          "id": 2,
          "text": "Sift together matzo cake meal, cream of tartar, baking soda, and salt in a medium bowl. Set aside."
        },
        {
          "id": 3,
          "text": "Beat butter in a large bowl with an electric mixer until creamy. Add white sugar gradually, beating until mixture is fluffy. Beat in mashed banana and egg until incorporated. Add matzo meal mixture in 3 batches, alternating with milk, beating batter briefly after each addition."
        },
        {
          "id": 4,
          "text": "Spread batter in the prepared baking pan. Sprinkle brown sugar and cinnamon on top."
        },
        {
          "id": 5,
          "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 30 minutes."
        }
      ],
      "warnings": [],
