  "recipes": [
    {
      "name": "Filipino Beef Steak",
      "ingredients_raw": [
        "4 pounds New York strip steak, sliced thin",
        "1 lemon, juiced",
        "3 tablespoons soy sauce",
        "1 teaspoon white sugar",
        "salt and pepper to taste",
        "1 tablespoon cornstarch",
        "0.25 cup vegetable oil",
        "3 tablespoons olive oil",
        "1 onion, chopped",
        "2 cloves garlic, chopped"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place sliced beef in a large bowl. Whisk together lemon juice, soy sauce, sugar, salt, and pepper in a small bowl; pour over beef and toss to coat. Stir in cornstarch. Cover and refrigerate for 1 hour to overnight."
        },
        {
          "id": 2,
          "text": "Heat vegetable oil in a large skillet over medium heat."
        },
        {
          "id": 3,
          "text": "Remove beef slices from marinade, shaking to remove any excess liquid. Discard marinade."
        },
        {
          "id": 4,
          "text": "Working in batches, fry beef slices in hot oil until they start to firm and are reddish-pink and juicy in the center, 2 to 4 minutes per side. Transfer beef slices to a serving platter."
        },
        {
          "id": 5,
          "text": "Heat olive oil in a small skillet over medium heat. Cook and stir onion and garlic in hot oil until onion is golden brown, 5 to 7 minutes; spoon over beef slices."
        }
      ],
