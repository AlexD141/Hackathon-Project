  "recipes": [
    {
      "name": "Favorite Green Bean Casserole",
      "ingredients_raw": [
        "2 (16 ounce) packages frozen cut green beans",
        "1 cup water",
        "1 (10.5 ounce) can condensed cream of mushroom soup",
        "0.5 cup milk",
        "1 (4 ounce) jar diced pimento peppers, drained",
        "0.125 teaspoon ground black pepper",
        "1 (2.8 ounce) can French-fried onions"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Place green beans and water in a medium saucepan over medium heat; bring to a boil and simmer until tender, about 5 minutes. Drain."
        },
        {
          "id": 3,
          "text": "Mix condensed soup, milk, pimentos, and black pepper together in an 8x8-inch baking dish. Stir in green beans and sprinkle French-fried onions on top."
        },
        {
          "id": 4,
          "text": "Bake in the preheated oven, uncovered, until hot and bubbly in the center, about 30 to 40 minutes."
        }
      ],
