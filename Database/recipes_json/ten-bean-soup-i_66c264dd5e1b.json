  "recipes": [
    {
      "name": "10-Bean Soup",
      "ingredients_raw": [
        "1 (16 ounce) package dry mixed beans",
        "4 slices bacon",
        "0.5 onion, chopped",
        "2 cloves garlic, minced",
        "3 stalks celery, chopped",
        "salt to taste",
        "ground black pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Soak beans in water overnight."
        },
        {
          "id": 2,
          "text": "Fry bacon in a medium skillet over medium heat until partially cooked, then add onion, garlic, and celery. Cook until onion is tender, 3 to 4 minutes. Remove from heat."
        },
        {
          "id": 3,
          "text": "Place drained beans in a large pot. Add water to cover beans. Add bacon mixture to the pot."
        },
        {
          "id": 4,
          "text": "Cook at a low boil until beans are tender, about 1 1/2 hours. Season with salt and pepper."
        }
      ],
