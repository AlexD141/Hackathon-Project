{
  "source_url": "https://www.allrecipes.com/recipe/140020/moist-passover-bagel/",
  "extracted_at": "2026-10-18T01:56:22.316655+00:00",
  "recipes": [
    {
      "name": "Moist Passover Bagel",
      "ingredients_raw": [
        "cooking spray",
        "1.3333333730698 cups water",
        "0.66666668653488 cup peanut oil",
        "1 teaspoon salt",
        "1 teaspoon white sugar",
        "2 cups matzo meal",
        "6 eggs"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a baking sheet with cooking spray."
        },
        {
          "id": 2,
          "text": "Combine water, oil, salt, and sugar in a large saucepan and bring to a boil. Remove from heat. Stir in matzo meal until well combined; allow to cool for at least 5 minutes. Add eggs, 2 at a time, stirring to incorporate into dough after each addition."
        },
        {
          "id": 3,
          "text": "Form 2 tablespoons dough into a ball using wet hands. Transfer to the prepared baking sheet. Repeat with remaining dough. Poke a hole into the middle of each ball."
        },
        {
          "id": 4,
          "text": "Bake in the preheated oven until lightly brown, 50 to 60 minutes."
        }
      ],
