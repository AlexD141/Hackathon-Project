  "recipes": [
    {
      "name": "Slow Cooker Baked Potatoes",
      "ingredients_raw": [
        "4 baking potatoes, well scrubbed",
        "1 tablespoon extra virgin olive oil",
        "kosher salt to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Prick potatoes with a fork several times, then rub with olive oil and season with salt."
        },
        {
          "id": 3,
          "text": "Wrap tightly in foil and place into the slow cooker."
        },
        {
          "id": 4,
          "text": "Cook until tender, on Low for 7 1/2 hours or on High for 4 1/2 to 5 hours."
        },
        {
          "id": 5,
          "text": "Serve with your choice of toppings and enjoy!"
        }
      ],
