  "recipes": [
    {
      "name": "Pressure Cooker Sweet Potatoes",
      "ingredients_raw": [
        "2 large sweet potatoes",
        "0.25 teaspoon salt, or to taste",
        "0.5 cup dark brown sugar",
        "0.5 teaspoon ground cinnamon",
        "0.25 teaspoon ground nutmeg",
        "1 cup orange juice",
        "2 tablespoons butter, cut into pieces"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Cut sweet potatoes in half, lengthwise, then into 1/4-inch slices; place into a pressure cooker steamer basket. Sprinkle with salt."
        },
        {
          "id": 2,
          "text": "Combine brown sugar, cinnamon, and nutmeg in a small bowl."
        },
        {
          "id": 3,
          "text": "Add orange juice to the cooker (see Editor&#39;s Note, below). Place the trivet and steamer basket with sweet potatoes into the pot. Sprinkle with brown sugar mixture; dot with butter pieces."
        },
        {
          "id": 4,
          "text": "Lock the lid into place and bring the cooker up to full pressure (15 pounds per square inch) over high heat according to manufacturer&#39;s instructions. Once pressure reached, reduce heat to low; cook 7 minutes"
        },
        {
          "id": 5,
          "text": "Quickly release pressure according to manufacturer&#39;s instructions. Reserve cooking liquid."
        },
        {
          "id": 6,
          "text": "Remove steamer basket from cooker; carefully place sweet potatoes in a serving dish. Return cooker to stovetop; bring cooking liquid to a boil over high heat. Reduce the heat to medium; simmer, stirring frequently, until cooking liquid reduced, syrupy, and coats the back of a spoon, 5 to 7 minutes."
        },
        {
          "id": 7,
          "text": "Pour syrup over sweet potatoes; serve."
        }
      ],
