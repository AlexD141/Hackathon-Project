  "recipes": [
    {
      "name": "Plum Glaze for Pork",
      "ingredients_raw": [
        "1 tablespoon cooking oil",
        "3 cloves garlic, minced",
        "0.25 cup finely chopped green onions",
        "1 (12 ounce) jar plum jam",
        "0.5 cup chile sauce",
        "0.25 cup white grape juice",
        "1 tablespoon fresh lime juice",
        "0.5 teaspoon ground allspice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Heat the oil in a saucepan over medium heat. Add the garlic and green onions; cook and stir until green onions are wilted, about 3 minutes. Stir in the plum jam, chili sauce, grape juice, lime juice, and allspice. Bring mixture to a boil; reduce heat to medium-low, and simmer until sauce thickens, about 30 minutes."
        }
      ],
