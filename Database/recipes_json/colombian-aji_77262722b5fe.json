  "recipes": [
    {
      "name": "Colombian Ají",
      "ingredients_raw": [
        "10 jalapeno peppers, seeded",
        "1.5 cups chopped green onions",
        "1 cup chopped cilantro",
        "0.25 cup water",
        "0.25 cup white vinegar",
        "0.25 cup fresh lemon juice",
        "2 teaspoons salt"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine jalapeños, green onions, cilantro, water, vinegar, lemon juice, and salt in a blender; process until smooth. Store in the refrigerator until ready to serve."
        }
      ],
