      "name": "Best Fruit Dip",
      "ingredients_raw": [
        "1 (8 ounce) package cream cheese, softened",
        "1 (7 ounce) jar marshmallow creme"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather cream cheese and marshmallow creme."
        },
        {
          "id": 2,
          "text": "Place cream cheese and creme in a medium bowl"
        },
        {
          "id": 3,
          "text": "Blend cream cheese and creme with an electric mixer until smooth and well combined."
        },
        {
          "id": 4,
          "text": "Serve with fruit and enjoy!"
        }
