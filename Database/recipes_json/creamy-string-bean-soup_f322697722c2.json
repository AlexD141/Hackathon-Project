  "recipes": [
    {
      "name": "Creamy String Bean Soup",
      "ingredients_raw": [
        "1 (15 ounce) can cut green beans",
        "4 potatoes, diced",
        "2 tablespoons distilled white vinegar",
        "1 clove garlic",
        "1 cup sour cream",
        "salt and pepper to taste",
        "2 tablespoons all-purpose flour",
        "0.25 cup water",
        "1 yellow onion, chopped"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Cook potatoes in salted water. When half done, add beans, vinegar, pepper and garlic (spear on toothpick for easy finding). Add onion. Simmer until potatoes are done. Remove garlic glove."
        },
        {
          "id": 2,
          "text": "Combine the flour and 1/4 cup water and make a smooth paste. Thicken soup with the flour paste."
        },
        {
          "id": 3,
          "text": "Remove from heat. Slowly stir in sour cream. Do not cook any further. Stir in cooked and diced Mettwurst or other German sausage just before serving."
        }
      ],
