  "recipes": [
    {
      "name": "Rhubarb-Peach Crisp",
      "ingredients_raw": [
        "5 cups chopped rhubarb",
        "1 cup chopped peach",
        "1.5 cups white sugar, or to taste",
        "0.25 cup all-purpose flour",
        "1 cup brown sugar",
        "1 cup quick oats",
        "1.5 cups all-purpose flour",
        "0.75 cup butter"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a 9x13-inch baking dish."
        },
        {
          "id": 2,
          "text": "Mix rhubarb, peach, white sugar, and 1/4 cup flour together in a large bowl until evenly combined; pour into the prepared baking dish and spread into an even layer."
        },
        {
          "id": 3,
          "text": "Stir brown sugar, quick oats, and 1 ½ cups flour together in a separate bowl. Cut butter into flour mixture with a knife or pastry blender until mixture resembles coarse crumbs; sprinkle evenly over rhubarb and peach mixture."
        },
        {
          "id": 4,
          "text": "Bake in the preheated oven until golden brown on top, about 45 minutes."
        }
      ],
