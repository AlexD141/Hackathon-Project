  "recipes": [
    {
      "name": "Peanut Butter Pie II",
      "ingredients_raw": [
        "1 cup crunchy peanut butter",
        "1 teaspoon vanilla extract",
        "0.25 teaspoon salt",
        "2 tablespoons unsalted butter, melted",
        "3 eggs",
        "1 cup dark corn syrup",
        "0.5 cup white sugar",
        "1 cup heavy whipping cream",
        "2 tablespoons dark brown sugar"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Beat peanut butter, vanilla, salt, and melted butter in a medium size bowl until well blended."
        },
        {
          "id": 2,
          "text": "In a large bowl, beat together eggs, corn syrup, and sugar. Stir in the peanut butter mixture until thoroughly combined."
        },
        {
          "id": 3,
          "text": "Pour filling into unbaked Basic Flaky Pie Crust and bake 10 minutes at 450 degrees F (230 degrees C). Reduce the heat to 325 degrees F (165 degrees C), and continue to bake an additional 35 minutes. Cool."
        },
        {
          "id": 4,
          "text": "To Make Caramel Cream: Whip together the cream and the dark brown sugar until stiff peaks form. Chill. Serve with pie."
        }
      ],
