  "recipes": [
    {
      "name": "Lemon Mint Iced Tea",
      "ingredients_raw": [
        "1 quart water",
        "0.75 cup white sugar",
        "6 regular-size tea bags",
        "1 peppermint tea bag",
        "0.25 cup frozen lemonade concentrate",
        "ice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Boil water in a large saucepan over high heat. Off heat, stir in sugar until dissolved. Add black tea bags and peppermint tea bag; steep for 30 minutes. Remove and discard tea bags; stir in lemonade. Serve in ice-filled glasses."
        }
      ],
