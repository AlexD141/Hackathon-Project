  "recipes": [
    {
      "name": "Lettuce, Avocado and Sunflower Seed Salad",
      "ingredients_raw": [
        "0.5 cup olive oil",
        "1.5 tablespoons red wine vinegar",
        "1.5 tablespoons balsamic vinegar",
        "1 clove garlic, minced",
        "1 tablespoon mayonnaise",
        "2 heads Bibb lettuce - rinsed, dried and torn",
        "0.33333331346512 cup sunflower seeds",
        "2 avocados - peeled, pitted and sliced"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Whisk together the olive oil, red wine vinegar, balsamic vinegar, garlic and mayonnaise. Season with salt and pepper to taste."
        },
        {
          "id": 2,
          "text": "In a salad bowl, combine the lettuce and sunflower seeds. Toss with enough dressing to coat. Top with sliced avocado and serve."
        }
      ],
