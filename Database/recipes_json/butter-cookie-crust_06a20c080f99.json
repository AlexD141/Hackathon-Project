  "recipes": [
    {
      "name": "Butter Cookie Crust",
      "ingredients_raw": [
        "1.5 cups finely crumbled vanilla wafers",
        "0.25 cup white sugar",
        "6 tablespoons butter, melted",
        "0.5 teaspoon ground cinnamon"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 375 degrees F (190 degrees C)."
        },
        {
          "id": 2,
          "text": "In a medium bowl combine the cookie crumbs, sugar, butter or margarine and cinnamon; mix until well blended. Press into a 9 inch pie plate."
        },
        {
          "id": 3,
          "text": "Bake in the preheated oven for 7 minutes. Cool."
        }
      ],
