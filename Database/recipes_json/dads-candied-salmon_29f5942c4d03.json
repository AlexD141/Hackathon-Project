  "recipes": [
    {
      "name": "Dad&#39;s Candied Salmon",
      "ingredients_raw": [
        "1 (2 pound) whole salmon fillet",
        "3 tablespoons dry mustard",
        "0.5 cup brown sugar",
        "0.5 lemon"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat an oven to 425 degrees F (220 degrees C)."
        },
        {
          "id": 2,
          "text": "Place the salmon onto a baking sheet lined with aluminum foil with the skin side down. Rub the mustard into the flesh of the salmon and then spread the brown sugar evenly over the fish. Squeeze the lemon over the salmon. Bring the edges of the foil together and seal into a packet."
        },
        {
          "id": 3,
          "text": "Bake in the preheated oven until the fish flakes easily with a fork, 25 to 30 minutes."
        }
      ],
