    {
      "name": "Zucchini and Eggs",
      "ingredients_raw": [
        "2 teaspoons olive oil",
        "1 small zucchini, sliced",
        "1 egg, beaten",
        "salt and pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Heat a small skillet over medium heat. Pour in oil and saute zucchini until tender. Spread out zucchini in an even layer, and pour beaten egg evenly over top. Cook until egg is firm. Season with salt and pepper to taste."
        }
