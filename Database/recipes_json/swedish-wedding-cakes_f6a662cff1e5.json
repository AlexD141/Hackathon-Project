  "recipes": [
    {
      "name": "Swedish Wedding Cakes",
      "ingredients_raw": [
        "0.25 cup margarine",
        "0.66666668653488 cup white sugar",
        "1 egg, beaten",
        "1 (8 ounce) package dates, pitted and finely chopped",
        "1 teaspoon vanilla extract",
        "2 cups crispy rice cereal",
        "0.75 cup walnuts, finely chopped",
        "1 cup sweetened flaked coconut"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine the margarine, sugar, egg, and dates in a saucepan. Cook over medium heat until thick, about 7 to 10 minutes. Remove from heat; stir in vanilla."
        },
        {
          "id": 2,
          "text": "Combine the crispy rice cereal and the walnuts in a large bowl. Stir in the date mixture; mix well."
        },
        {
          "id": 3,
          "text": "Working quickly, form the cereal and date mixture into 1 inch balls. Roll balls in coconut. Store in an airtight container in a cool place. Do not refrigerate."
        }
      ],
