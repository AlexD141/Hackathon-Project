      "name": "Best Rib Sauce",
      "ingredients_raw": [
        "0.5 teaspoon hot pepper sauce",
        "0.25 cup fresh lime juice",
        "1 cup brewed coffee",
        "4 teaspoons brown sugar",
        "1 (1.5 fluid ounce) jigger bourbon",
        "1 cup honey",
        "2 teaspoons Worcestershire sauce",
        "0.5 cup tomato paste",
        "0.5 cup tomato sauce"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a medium saucepan over medium low heat, combine the hot pepper sauce, lime juice, coffee, sugar, whiskey, honey, Worcestershire sauce, tomato paste and tomato sauce. Mix together well and allow to simmer for 30 minutes."
        }
      ],
