  "recipes": [
    {
      "name": "Kellie&#39;s Come-Back-For-More Ham",
      "ingredients_raw": [
        "1 (8 pound) spiral cut bone-in cured ham",
        "1.5 cups ketchup, or as needed",
        "1 cup packed brown sugar"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Place the ham in a baking dish or roasting pan with the flattest side down. Cover with ketchup then use your hands to pack brown sugar into the ketchup. Cover the ham loosely with aluminum foil."
        },
        {
          "id": 3,
          "text": "Bake in the preheated oven until heated through and sugar has caramelized, about 1 hour."
        }
      ],
