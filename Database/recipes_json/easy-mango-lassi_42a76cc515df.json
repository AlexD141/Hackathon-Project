  "recipes": [
    {
      "name": "Easy Mango Lassi",
      "ingredients_raw": [
        "2 cups plain whole milk yogurt",
        "1 cup milk",
        "3 mangoes - peeled, seeded, and chopped",
        "4 teaspoons white sugar, or to taste",
        "0.125 teaspoon ground cardamom"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place the yogurt, milk, mangoes, white sugar, and cardamom into the jar of a blender and blend until smooth, about 2 minutes. Chill in the refrigerator for 1 hour or until cold, and serve sprinkled with a little ground cardamom."
        }
      ],
