    {
      "name": "Unsweetened Iced Tea ",
      "ingredients_raw": [
        "8 tea bags",
        "0.5 cup hot water",
        "7.5 cups cold water"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Put tea bags in a 2-quart pitcher. Add hot water. Let sit at least 15 minutes. Add cold water and remove tea bags."
        },
        {
          "id": 2,
          "text": "Refrigerate the tea and serve over ice."
        }
