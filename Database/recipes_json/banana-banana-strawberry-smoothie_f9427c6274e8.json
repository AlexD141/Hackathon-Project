      "name": "Banana Banana Strawberry Smoothie",
      "ingredients_raw": [
        "1 banana, broken into chunks",
        "1 teaspoon banana extract",
        "0.75 cup milk",
        "1 (8 ounce) container strawberry yogurt",
        "2 teaspoons white sugar"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place banana, banana extract, milk, yogurt, and sugar into a blender. Blend until smooth and serve."
