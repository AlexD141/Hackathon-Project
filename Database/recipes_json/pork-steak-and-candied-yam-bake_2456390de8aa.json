{
  "source_url": "https://www.allrecipes.com/recipe/220308/pork-steak-and-candied-yam-bake/",
  "extracted_at": "2026-10-18T03:09:51.253121+00:00",
  "recipes": [
    {
      "name": "Pork Steak and Candied Yam Bake",
      "ingredients_raw": [
        "cooking spray",
        "6 (1/2 inch thick) boneless pork chops",
        "salt and ground black pepper to taste",
        "2 tablespoons vegetable oil",
        "6 tablespoons brown sugar, not packed",
        "0.66666668653488 cup butter",
        "1 cup apricot preserves",
        "0.75 teaspoon ground cinnamon",
        "0.75 teaspoon ground nutmeg",
        "0.25 teaspoon ground ginger",
        "1.5 teaspoons vanilla extract",
        "0.25 cup chopped pecans",
        "2 (15 ounce) cans cut yams, drained (reserve liquid)"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 375 degrees F (190 degrees C)."
        },
        {
          "id": 2,
          "text": "Line a 9x13-inch baking dish with aluminum foil and spray with cooking spray."
        },
        {
          "id": 3,
          "text": "Season pork chops with salt and black pepper."
        },
        {
          "id": 4,
          "text": "Heat vegetable oil in a large skillet over medium heat. Cook pork chops until browned on both sides, 7 to 10 minutes. Drain pork chops on a paper towel-lined plate."
        },
        {
          "id": 5,
          "text": "Heat brown sugar, butter, apricot preserves, cinnamon, nutmeg, ginger, vanilla extract, and pecans in a saucepan over medium-low heat until sugar has dissolved and sauce is thickened, about 5 minutes. Season with salt and pepper. If sauce because too thick, stir in reserved yam liquid."
        },
        {
          "id": 6,
          "text": "Stir in yams until well coated."
        },
        {
          "id": 7,
          "text": "Transfer pork chops to the prepared baking dish."
        },
        {
          "id": 8,
          "text": "Spoon yam mixture on top of the pork chops."
        },
        {
          "id": 9,
          "text": "Bake in the preheated oven until pork chops no longer pink in the center, 30 to 45 minutes. Allow pork chops to rest for 10 minutes before serving."
        }
      ],
      "warnings": [],
