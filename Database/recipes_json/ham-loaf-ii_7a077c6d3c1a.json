  "recipes": [
    {
      "name": "Ham Loaf II",
      "ingredients_raw": [
        "1 pound ground smoked ham",
        "0.75 pound ground pork",
        "2 eggs",
        "1 cup dry bread crumbs",
        "0.25 cup brown sugar",
        "1 tablespoon prepared mustard",
        "1 teaspoon soy sauce"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Mix ham, ground pork, eggs, and bread crumbs in a bowl. Mix in enough bread crumbs to make it all stick together. Put in a loaf pan and bake for about 1 hour to 1 1/2 hours. Glaze the last 15 minutes of baking."
        },
        {
          "id": 3,
          "text": "To make glaze: Mix brown sugar, mustard and soy sauce together in a bowl."
        }
      ],
