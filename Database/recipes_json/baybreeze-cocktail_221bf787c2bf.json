        "2 fluid ounces cranberry juice",
        "2 fluid ounces pineapple juice",
        "1.5 fluid ounces vodka",
        "1 lime wedge for garnish"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
