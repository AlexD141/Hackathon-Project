            "author": {
              "@type": "Person",
              "name": "Mark Davies"
            },
            "reviewBody": "We like to add turkey kielbasa. We cut in to discs and brown in olive oil, then add to the mixture and bake the entire casserole (put Italian breadcrumbs on top). Delicious!",
            "datePublished": "2010-12-13T12:57:30.473Z"
