  "recipes": [
    {
      "name": "Lazy Pierogi",
      "ingredients_raw": [
        "3 pounds sauerkraut",
        "1 onion, chopped",
        "1 pound uncooked rotini pasta",
        "1 pound fresh mushrooms, chopped",
        "0.5 pound butter",
        "2 (10.75 ounce) cans condensed cream of mushroom soup"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place the sauerkraut and onion in a large skillet over medium-low heat with enough water to cover. Simmer 1 hour, or until most of the water has cooked off."
        },
        {
          "id": 2,
          "text": "Bring a large pot of lightly salted water to a boil. Add rotini and cook for 8 to 10 minutes or until al dente; drain."
        },
        {
          "id": 3,
          "text": "In a medium skillet over medium heat, saute the mushrooms in 2 tablespoons of the butter for about 5 minutes."
        },
        {
          "id": 4,
          "text": "Stir the remaining butter, cooked pasta, and cream of mushroom soup into the sauerkraut mixture. Cook and stir 15 minutes, or until heated through."
        }
      ],
