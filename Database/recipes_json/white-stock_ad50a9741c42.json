  "recipes": [
    {
      "name": "White Stock",
      "ingredients_raw": [
        "3 pounds chicken",
        "1 veal knuckle",
        "2 stalks celery",
        "1 yellow onion",
        "1 turnip",
        "1 carrots",
        "2 teaspoons salt",
        "4 quarts water"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Cut veal from bone."
        },
        {
          "id": 2,
          "text": "Combine water, veal meat, veal bone, chicken, vegetables, and salt in a stock pot. Bring to a boil. Reduce heat, cover, and simmer for 5 hours."
        },
        {
          "id": 3,
          "text": "Strain stock, and let cool. Discard vegetables and bones, use veal and chicken as desired."
        }
      ],
