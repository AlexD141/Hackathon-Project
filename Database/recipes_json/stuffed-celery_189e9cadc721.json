  "recipes": [
    {
      "name": "Stuffed Celery",
      "ingredients_raw": [
        "1 (8 ounce) package cream cheese, softened",
        "2 tablespoons sour cream",
        "0.25 cup chopped walnuts",
        "20 green olives with pimento, chopped",
        "1 bunch celery, cut into bite-size pieces"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "In a medium bowl, mix together the cream cheese and sour cream. Stir in the walnuts and chopped olives."
        },
        {
          "id": 3,
          "text": "Spread filling onto the celery pieces."
        },
        {
          "id": 4,
          "text": "Serve and enjoy!"
        }
      ],
