  "recipes": [
    {
      "name": "Lime-Garlic Chicken and Spinach Salad",
      "ingredients_raw": [
        "4 skinless, boneless chicken breast halves - cut into thin strips",
        "0.5 onion, chopped",
        "2 tablespoons minced garlic",
        "1 teaspoon fresh ground black pepper",
        "1 pinch salt",
        "1 teaspoon flour",
        "0.25 cup fresh lime juice, or to taste",
        "4.5 cups baby spinach leaves"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place chicken, onions, garlic, salt, pepper, and flour in a resealable bag. Stir in the lime juice. Allow to sit for a few minutes to marinate."
        },
        {
          "id": 2,
          "text": "Spray a non-stick frying pan with olive oil cooking spray and place over medium heat. Pour in the entire contents of the bag and cook until the onion has softened (there is no need to brown). Add additional lime juice to taste. Serve over spinach."
        }
      ],
