  "recipes": [
    {
      "name": "Stuffed Lobster for Two",
      "ingredients_raw": [
        "1 (1 1/2) pound fresh lobster",
        "1 cup soft bread crumbs",
        "0.5 cup butter, softened",
        "1 teaspoon salt",
        "0.5 teaspoon ground black pepper",
        "1 teaspoon dried tarragon",
        "2 teaspoons vegetable oil"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Bring a large pot of water to a rapid boil. Add the lobster and cook for 8 minutes. Remove from the water and set aside to cool slightly."
        },
        {
          "id": 2,
          "text": "Preheat the oven to 450 degrees F (220 degrees C). When the lobster is cool enough, split it in half lengthwise using a large chef&#39;s knife. Remove the dark strip if present. Remove the tomalley to a bowl and mix with the bread crumbs, butter, salt, pepper and tarragon. Stuff this mixture on top of the lobster meat still in the shell and place lobster halves in a baking dish. Drizzle oil over the top."
        },
        {
          "id": 3,
          "text": "Bake in the preheated oven until the stuffing is browned, about 20 minutes."
        }
      ],
