  "recipes": [
    {
      "name": "No-Bake Haystacks",
      "ingredients_raw": [
        "3 cups quick cooking oats",
        "1 cup flaked coconut",
        "1 cup roasted peanuts, chopped",
        "1 cup raisins",
        "2 cups white sugar",
        "0.5 cup milk",
        "0.25 cup butter",
        "0.25 cup unsweetened cocoa powder",
        "1 teaspoon vanilla"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Mix the oats, coconut, peanuts, and raisins together in a large bowl."
        },
        {
          "id": 2,
          "text": "Stir the sugar, milk, butter, and cocoa powder together in a saucepan and bring to a boil; boil for 1 minute and immediately remove from heat. Stir the vanilla into the cocoa mixture; pour over the oat mixture and stir to coat. Scoop heaping tablespoonfuls of the mixture and drop into haystack-like piles onto waxed paper; allow to cool completely before serving."
        }
      ],
