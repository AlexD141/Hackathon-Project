  "recipes": [
    {
      "name": "Meat Marinade",
      "ingredients_raw": [
        "0.5 cup olive oil",
        "0.25 cup soy sauce",
        "0.25 cup Worcestershire sauce",
        "3 tablespoons prepared mustard",
        "0.66670000553131 cup lemon juice",
        "salt and pepper to taste",
        "garlic powder to taste",
        "1 dash onion powder"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Use a flat container large enough to hold meat in a single layer. Combine oil, soy sauce, Worcestershire sauce, mustard and lemon juice. Season with garlic powder, onion powder, salt and pepper. Place meat in the marinade and turn to coat both sides."
        },
        {
          "id": 2,
          "text": "Cover and refrigerate for at least 2 hours, shaking or turning meat occasionally."
        }
      ],
