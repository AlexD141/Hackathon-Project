  "recipes": [
    {
      "name": "Mexican Pecan Cookies",
      "ingredients_raw": [
        "4 cups all-purpose flour",
        "2 cups very soft butter",
        "3.5 cups chopped pecans",
        "0.25 cup confectioners' sugar",
        "1 cup confectioners' sugar for rolling"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 375 degrees F (190 degrees C)."
        },
        {
          "id": 2,
          "text": "Mash together the flour, butter, pecans, and 1/4 cup of confectioners&#39; sugar in a bowl until the mixture is thoroughly combined and forms a soft dough. Pinch off about 2 teaspoons of dough per cookie, and roll into 3/4-inch balls. Place the balls on ungreased cookie sheets."
        },
        {
          "id": 3,
          "text": "Bake in the preheated oven until the bottoms of the cookies are lightly golden brown but the tops are still pale, 8 to 12 minutes."
        },
        {
          "id": 4,
          "text": "Let the cookies cool completely, then roll in remaining confectioners&#39; sugar."
        }
      ],
