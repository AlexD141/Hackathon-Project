      "name": "Brandy Smash Cocktail",
      "ingredients_raw": [
        "1 teaspoon white sugar",
        "4 fresh mint leaves",
        "1.5 cups ice cubes",
        "1.5 fluid ounces brandy",
        "0.25 ounce Benedictine® liqueur",
        "1 sprig mint, for garnish"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place sugar, mint, and a splash of water into a glass. Muddle gently, and then add ice to the glass. Pour in brandy and Benedictine, and stir. Add fresh mint for garnish."
        }
