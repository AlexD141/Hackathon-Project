  "recipes": [
    {
      "name": "Pan Fried Halibut",
      "ingredients_raw": [
        "1 egg",
        "1 cup all-purpose flour",
        "2 tablespoons dried herbes de Provence",
        "1 teaspoon seafood seasoning (such as Old Bay®)",
        "1 teaspoon salt",
        "ground black pepper",
        "1 pound skinless, boneless halibut fillets",
        "2 tablespoons olive oil"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Beat egg in a small bowl. Combine flour, herbes de Provence, seafood seasoning, salt, and black pepper in a separate small bowl. Cut halibut into 4 equal pieces."
        },
        {
          "id": 2,
          "text": "Heat olive oil in a large skillet over medium-low heat."
        },
        {
          "id": 3,
          "text": "Meanwhile, dip each piece halibut into beaten egg; lift up so excess egg drips back into the bowl. Dredge in flour mixture until all sides evenly coated; tap off excess."
        },
        {
          "id": 4,
          "text": "Immediately place coated halibut into the skillet; cook until lightly browned, about 5 minutes. Flip; cook until opaque and fish flakes easily with a fork, about 2 minutes more."
        }
      ],
