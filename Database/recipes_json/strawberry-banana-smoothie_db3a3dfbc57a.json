    {
      "name": "Strawberry Banana Smoothie",
      "ingredients_raw": [
        "1.5 cups vanilla yogurt",
        "2 bananas, cut up",
        "0.5 cup frozen strawberries",
        "2 tablespoons wheat germ",
        "1 tablespoon honey"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine yogurt, bananas, strawberries, wheat germ, and honey in a blender; blend until smooth, about 1 minute."
        }
      ],
