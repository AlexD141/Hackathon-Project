  "recipes": [
    {
      "name": "Rum Raisin Brownies",
      "ingredients_raw": [
        "0.5 cup raisins",
        "3 tablespoons rum",
        "0.66666668653488 cup whipping cream",
        "1 cup semi-sweet chocolate chips",
        "0.66666668653488 cup all-purpose flour",
        "0.5 cup light brown sugar",
        "2 tablespoons cocoa powder",
        "0.25 teaspoon baking powder",
        "0.33333334326744 teaspoon ground cinnamon",
        "2 eggs",
        "0.75 cup chopped toasted pecans"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat an oven to 325 degrees F (165 degrees C). Line an 8-inch square baking pan with parchment paper."
        },
        {
          "id": 2,
          "text": "Combine the raisins and rum in a small bowl; set aside to soak."
        },
        {
          "id": 3,
          "text": "Heat the whipping cream in a small pot over medium-low heat until hot, but do not allow to boil. Remove from heat and stir the chocolate chips into the hot cream until completely melted. Set aside to cool."
        },
        {
          "id": 4,
          "text": "Sift the flour, brown sugar, cocoa powder, baking powder, and cinnamon together into a bowl. Beat the eggs into the flour mixture individually; mix gently. Stir the chocolate mixture into the flour mixture until incorporated. Fold the raisins, any remaining rum, and the pecans into the batter; spread into the prepared baking pan."
        },
        {
          "id": 5,
          "text": "Bake in the preheated oven until the top is dry and the edges have started to pull away from the sides of the pan, about 30 minutes."
        }
      ],
