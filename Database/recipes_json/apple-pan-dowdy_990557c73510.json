  "recipes": [
    {
      "name": "Apple Pan Dowdy",
      "ingredients_raw": [
        "4 cups peeled and sliced apples",
        "0.25 cup all-purpose flour",
        "1 cup brown sugar",
        "1 cup water",
        "2 tablespoons vinegar",
        "1 tablespoon butter",
        "1 teaspoon vanilla extract",
        "2 teaspoons baking powder",
        "2.5 tablespoons shortening",
        "0.75 cup milk"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a 9-inch square baking dish. Layer apples evenly into the baking dish."
        },
        {
          "id": 2,
          "text": "Mix 1/4 cup flour and sugar together in a medium saucepan. Add water and vinegar; stir until mixture is well blended and sugar dissolves. Bring to a simmer over low heat; stir constantly until mixture thickens, about 3 minutes. Remove from heat and let cool, about 10 minutes. Stir in butter and vanilla extract. Pour mixture over apples in the pan."
        },
        {
          "id": 3,
          "text": "Mix remaining 1 cup flour and baking powder together in a bowl until smooth; cut shortening until mixture forms pea-size crumbs. Stir in milk; spread batter over apples."
        },
        {
          "id": 4,
          "text": "Bake in the preheated oven until golden brown, and apples are tender, about 35 minutes."
        }
      ],
