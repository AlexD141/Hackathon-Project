  "recipes": [
    {
      "name": "Roasted Tomatoes ",
      "ingredients_raw": [
        "4 cups grape tomatoes",
        "4 cloves garlic, sliced",
        "2 tablespoons olive oil",
        "salt and pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather the ingredients. Preheat the oven to 450 degrees F (230 degrees C). Place a piece of aluminum foil over a baking sheet."
        },
        {
          "id": 2,
          "text": "Place the tomatoes and garlic into a mixing bowl. Drizzle with olive oil, and toss until evenly coated. Season to taste with salt and pepper, then spread evenly onto the prepared baking sheet."
        },
        {
          "id": 3,
          "text": "Bake tomatoes in the preheated oven until the skins pop and start to brown, 15 to 20 minutes."
        }
      ],
