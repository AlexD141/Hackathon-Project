  "recipes": [
    {
      "name": "Easy Bok Choy",
      "ingredients_raw": [
        "1 tablespoon vegetable oil",
        "2 cloves garlic, crushed and chopped",
        "8 heads baby bok choy, trimmed and cut into bite-size pieces",
        "salt to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Heat oil in a large skillet or wok over medium heat; add garlic and cook until fragrant, 1 to 2 minutes."
        },
        {
          "id": 2,
          "text": "Add bok choy; cook and stir until leafy green parts turn bright green and stalks become slightly translucent, 5 to 8 minutes. Sprinkle with salt and serve."
        }
      ],
