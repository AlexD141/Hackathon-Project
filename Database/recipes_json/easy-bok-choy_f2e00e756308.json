            },
            "author": {
              "@type": "Person",
              "name": "lechelle"
            },
            "reviewBody": "I enjoyed this simple but flavorful recipe. I did however add 2 tablespoons of chicken broth while cooking. My husband loved it!",
            "datePublished": "2025-05-07T07:45:45.613Z"
          },
          {
            "@type": "Review",
            "reviewRating": {
