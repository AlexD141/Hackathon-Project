  "recipes": [
    {
      "name": "Healthier Grilled Salmon I",
      "ingredients_raw": [
        "1.5 pounds salmon fillets",
        "2 teaspoons lemon juice",
        "1 teaspoon lemon zest",
        "1 clove garlic, minced",
        "2 tablespoons extra-virgin olive oil",
        "2 tablespoons soy sauce",
        "0.33333334326744 cup brown sugar",
        "1 pinch salt to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Stir together lemon juice, lemon zest, soy sauce, brown sugar, garlic and olive oil in a 9x13-inch glass baking dish until sugar is dissolved, about 2 minutes. Place fish flesh side down in mixture and refrigerate for 30 minutes."
        },
        {
          "id": 2,
          "text": "Preheat an outdoor grill for medium-high heat and lightly oil grate."
        },
        {
          "id": 3,
          "text": "Place salmon on preheated grill and discard marinade."
        },
        {
          "id": 4,
          "text": "Cook salmon until fish flakes easily with a fork, 6 to 8 minutes."
        }
      ],
