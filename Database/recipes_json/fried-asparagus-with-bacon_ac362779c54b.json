  "recipes": [
    {
      "name": "Fried Asparagus with Bacon",
      "ingredients_raw": [
        "3 slices bacon, chopped",
        "1.5 teaspoons butter",
        "1 pound fresh asparagus, trimmed",
        "1 medium shallot, thinly sliced",
        "salt and ground black pepper to taste",
        "1 tablespoon grated Parmesan cheese"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Cook and stir bacon in a skillet over medium heat until crisp, about 5 minutes. Drain grease."
        },
        {
          "id": 3,
          "text": "Add butter to the skillet and let melt. Stir in asparagus and shallot, then season with salt and pepper. Cover and cook, stirring occasionally, until asparagus is tender, about 5 minutes."
        },
        {
          "id": 4,
          "text": "Transfer asparagus mixture to a platter. Sprinkle with Parmesan cheese."
        }
      ],
