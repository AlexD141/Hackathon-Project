  "recipes": [
    {
      "name": "No Bake Cookies V",
      "ingredients_raw": [
        "2 cups white sugar",
        "0.25 cup unsweetened cocoa powder",
        "0.5 cup milk",
        "0.5 cup margarine",
        "1 teaspoon vanilla extract",
        "1 pinch salt",
        "0.5 cup chunky peanut butter",
        "3 cups quick cooking oats"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a saucepan over medium heat, combine the sugar, cocoa, milk and margarine. Bring to a boil, stirring occasionally. Boil for 1 minute, then remove from heat and stir in the vanilla, salt, peanut butter and oats."
        },
        {
          "id": 2,
          "text": "Drop by rounded spoonfuls onto waxed paper. Allow cookies to cool for at least 1 hour. Store in an airtight container."
        }
      ],
