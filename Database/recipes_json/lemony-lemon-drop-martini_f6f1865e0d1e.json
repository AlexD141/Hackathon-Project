  "recipes": [
    {
      "name": "Lemony Lemon Drop Martini",
      "ingredients_raw": [
        "1 tablespoon white sugar",
        "1 cup ice cubes",
        "3 lemons, peel grated and juiced",
        "2 large mint leaves",
        "2 (1.5 fluid ounce) jiggers vodka",
        "2 tablespoons simple syrup"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Moisten the rim of a martini glass with lemon juice or water, then dip in sugar. Set aside."
        },
        {
          "id": 2,
          "text": "Fill a cocktail shaker with ice. Add lemon peel, lemon juice, mint leaves, vodka and simple syrup. Shake until well chilled, then pour into prepared martini glass."
        }
      ],
