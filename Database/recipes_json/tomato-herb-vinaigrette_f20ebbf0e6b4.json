  "recipes": [
    {
      "name": "Tomato-Herb Vinaigrette",
      "ingredients_raw": [
        "0.25 cup red wine vinegar",
        "2 tablespoons Burgundy wine",
        "0.5 teaspoon salt",
        "0.5 teaspoon white sugar",
        "0.5 teaspoon black pepper",
        "1 cup olive oil",
        "2 teaspoons minced garlic",
        "1 tablespoon chopped fresh thyme",
        "1 tablespoon chopped fresh marjoram",
        "1 tablespoon chopped fresh basil",
        "1 tablespoon chopped fresh tarragon",
        "3 shallots, minced",
        "1 cup diced tomatoes"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Pour vinegar and wine into a glass bowl. Whisk in salt, sugar, and pepper until the sugar has dissolved. Slowly pour the olive oil into the bowl while whisking rapidly to blend together. Stir in garlic, thyme, marjoram, basil, and tarragon; fold in shallots and tomatoes. Store in the refrigerator until serving."
        }
      ],
