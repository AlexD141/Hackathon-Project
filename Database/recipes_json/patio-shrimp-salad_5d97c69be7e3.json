  "recipes": [
    {
      "name": "Patio Shrimp Salad",
      "ingredients_raw": [
        "3.5 cups cooked white rice",
        "0.25 cup chopped dill pickles",
        "0.25 cup chopped black olives",
        "1 tablespoon chopped onion",
        "0.5 teaspoon salt",
        "1 teaspoon minced green bell pepper",
        "0.5 cup raisins",
        "1.5 cups tomato juice",
        "2 cups cooked salad shrimp",
        "0.75 cup mayonnaise"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place rice in a medium-size mixing bowl. Mix pickles, olives, onion, salt, green pepper, raisins and tomato juice into the rice. Stir well and let mixture stand 5 minutes."
        },
        {
          "id": 2,
          "text": "Mix shrimp and mayonnaise into the mixture, toss lightly and serve."
        }
      ],
