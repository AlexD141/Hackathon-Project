  "recipes": [
    {
      "name": "Kaiserschmarren",
      "ingredients_raw": [
        "4 eggs, separated",
        "1 cup all-purpose flour",
        "0.66666668653488 cup raisins",
        "0.5 cup milk",
        "0.5 cup white sugar",
        "1 pinch salt",
        "1 tablespoon butter",
        "2 tablespoons confectioners' sugar",
        "2 cups applesauce"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Beat egg whites in a clean bowl until soft peaks form. Lift your beater or whisk straight up; the egg whites will form soft mounds rather than a sharp peak."
        },
        {
          "id": 2,
          "text": "Beat egg yolks in a separate bowl until smooth. Mix in flour, raisins, milk, sugar, and salt until just moistened. Fold in egg whites."
        },
        {
          "id": 3,
          "text": "Melt butter in a large skillet over medium heat. Pour batter into the skillet and cook until golden brown; flip and cook until set on the other side, about 1 minute. Tear the kaiserschmarren into pieces using two forks and continue cooking until golden brown and cooked through, about 2 minutes."
        },
        {
          "id": 4,
          "text": "Sprinkle with confectioners&#39; sugar and serve with applesauce."
        }
      ],
