  "recipes": [
    {
      "name": "Sweet Persimmon Fireside Cookies",
      "ingredients_raw": [
        "2 cups all-purpose flour",
        "0.5 cup cake flour",
        "1 teaspoon ground cinnamon",
        "1 teaspoon ground ginger",
        "0.5 teaspoon baking soda",
        "0.25 teaspoon salt",
        "0.5 cup unsalted butter",
        "1 cup white sugar",
        "1 tablespoon lemon zest",
        "2 ripe persimmons, pureed",
        "1 egg",
        "0.25 cup confectioners' sugar"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 375 degrees F (190 degrees C). Grease one 9x13 inch baking pan."
        },
        {
          "id": 2,
          "text": "Sift together all-purpose flour, cake flour, cinnamon, ginger, baking soda and salt."
        },
        {
          "id": 3,
          "text": "In a medium bowl, cream butter, sugar, and lemon rind until fluffy and smooth. Blend in egg and persimmon pulp and mix until well combined."
        },
        {
          "id": 4,
          "text": "Gradually stir in the flour mixture and mix until well blended."
        },
        {
          "id": 5,
          "text": "Pour the batter into the prepared pan and spread evenly."
        },
        {
          "id": 6,
          "text": "Bake for 25 minutes in the preheated oven, until golden brown. Remove from the oven and let cool. When the bars are completely cool, sift confectioners&#39; sugar over the top and cut into bars."
        }
      ],
