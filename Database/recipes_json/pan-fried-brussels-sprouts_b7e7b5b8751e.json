            "author": {
              "@type": "Person",
              "name": "Ben"
            },
            "reviewBody": "Start with the onions, then add the garlic or the garlic will burn.",
            "datePublished": "2026-01-21T17:45:12.156Z"
          },
          {
            "@type": "Review",
            "reviewRating": {
              "@type": "Rating",
