  "recipes": [
    {
      "name": "Meringue Teasers",
      "ingredients_raw": [
        "2 egg whites",
        "0.66666668653488 cup super fine sugar",
        "1 teaspoon vanilla extract",
        "1 pinch salt",
        "1 cup semisweet chocolate chips",
        "1 cup chopped walnuts"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (180 degrees C). Cover cookie sheets with foil."
        },
        {
          "id": 2,
          "text": "Beat egg whites in small bowl until foamy. Gradually beat in sugar until meringue forms stiff peaks. Add food coloring, if using. Add vanilla and salt. Stir in chocolate chips and nuts."
        },
        {
          "id": 3,
          "text": "Drop meringue by teaspoonfuls onto prepared cookie sheets. Place in preheated oven. Turn oven off. Do not open door for at least 6 hours or overnight."
        }
      ],
