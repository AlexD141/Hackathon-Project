  "recipes": [
    {
      "name": "Asparagus with Lime and Ginger",
      "ingredients_raw": [
        "1.5 pounds fresh asparagus, trimmed",
        "2 tablespoons fresh lime juice",
        "1 teaspoon grated lime zest",
        "1 tablespoon chopped fresh cilantro",
        "1.5 teaspoons minced fresh ginger root",
        "0.5 teaspoon white sugar",
        "6 tablespoons vegetable oil",
        "salt and ground black pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Pour about 1 inch of water into the bottom half of a steamer pan set, and place over medium heat. Place the asparagus in the top half of the steamer pan set; steam until tender, 4 to 5 minutes. Remove the asparagus and arrange on a serving platter."
        },
        {
          "id": 2,
          "text": "Whisk the lime juice, lime zest, cilantro, ginger, and sugar together in a bowl; stream the vegetable oil into the mixture while whisking. Season with salt and pepper. Drizzle over the asparagus."
        }
      ],
