  "recipes": [
    {
      "name": "Pistachio Salad",
      "ingredients_raw": [
        "1 (20 ounce) can crushed pineapple, drained",
        "1 (3 ounce) package instant pistachio pudding mix",
        "1 (8 ounce) container frozen whipped topping, thawed",
        "0.5 (10.5 ounce) package miniature marshmallows"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather the ingredients."
        },
        {
          "id": 2,
          "text": "Combine pineapple and dry pistachio pudding mix in a large bowl. Fold in thawed whipped topping and marshmallows until well mixed."
        },
        {
          "id": 3,
          "text": "Refrigerate until chilled and serve."
        }
      ],
