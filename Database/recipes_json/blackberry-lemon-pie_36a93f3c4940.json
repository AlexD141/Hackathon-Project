  "recipes": [
    {
      "name": "Blackberry-Lemon Pie",
      "ingredients_raw": [
        "1 recipe pastry for a 9 inch double crust pie",
        "0.75 cup brown sugar",
        "1 tablespoon lemon zest",
        "4 cups fresh blackberries, rinsed and drained",
        "1 cup white sugar",
        "0.5 cup all-purpose flour",
        "1 tablespoon lemon zest",
        "1 tablespoon butter"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Place bottom crust into a 9 inch pie pan. In a medium bowl, crumble remaining pie crust into a bowl with the brown sugar and 1 tablespoon lemon zest. Mix with hands until dough becomes pea-size crumbs. Set aside."
        },
        {
          "id": 3,
          "text": "In a large bowl, combine blackberries, white sugar, flour and 1 tablespoon lemon zest. Fill bottom pie crust with blackberry mixture. Sprinkle crumb topping over mixture and dot with butter."
        },
        {
          "id": 4,
          "text": "Bake pie in preheated oven for 45 minutes to 1 hour, or until crust is browned and berries are bubbling. Let stand before serving."
        }
      ],
