  "recipes": [
    {
      "name": "Watermelon Mango Ice Pops",
      "ingredients_raw": [
        "2 cups cubed seeded watermelon",
        "1 cup mango chunks",
        "0.5 cup raspberries",
        "1 tablespoon lemon juice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place watermelon, mango, raspberries, and lemon juice in a blender; blend until smooth. Pour watermelon mixture into ice pop molds; insert handles or sticks."
        },
        {
          "id": 2,
          "text": "Freeze until firm, at least 4 hours."
        }
      ],
