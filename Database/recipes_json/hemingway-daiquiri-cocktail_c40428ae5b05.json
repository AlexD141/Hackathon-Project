  "recipes": [
    {
      "name": "Hemingway Daiquiri Cocktail",
      "ingredients_raw": [
        "1 cup ice",
        "2 fluid ounces rum",
        "0.75 fluid ounce lime juice",
        "0.5 fluid ounce maraschino liqueur",
        "0.5 fluid ounce grapefruit juice",
        "1 lime wheel"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Fill a cocktail shaker with ice; add rum, lime juice, Maraschino liqueur, and grapefruit juice. Cover and shake until chilled and the outside of the shaker has frosted. Strain into a chilled cocktail glass and garnish with a lime wheel."
        }
      ],
