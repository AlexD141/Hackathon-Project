  "recipes": [
    {
      "name": "Carrot Citrus Salad",
      "ingredients_raw": [
        "0.5 cup water",
        "2 tablespoons cider vinegar",
        "0.125 teaspoon sea salt",
        "2 carrots, shaved into strips using a vegetable peeler",
        "0.5 jicama, peeled and cut into thin matchsticks",
        "1 orange, peeled and thinly sliced",
        "1 sprig fresh cilantro, or to taste",
        "cracked black pepper to taste",
        "2 leaves escarole, torn"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Stir water, vinegar, and sea salt together in a bowl to dissolve the salt; add shaved carrots and submerge in the liquid. Marinate in refrigerator for 2 hours; drain."
        },
        {
          "id": 2,
          "text": "Layer carrots, jicama, orange slices, and cilantro on a plate; season with cracked black pepper and garnish with escarole to serve."
        }
      ],
