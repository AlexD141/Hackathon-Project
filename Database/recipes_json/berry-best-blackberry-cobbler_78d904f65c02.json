  "recipes": [
    {
      "name": "Berry Best Blackberry Cobbler",
      "ingredients_raw": [
        "6 cups fresh blackberries",
        "2 cups all-purpose flour",
        "1 cup white sugar",
        "1 cup milk",
        "1 cup heavy cream",
        "0.5 cup unsalted butter, melted",
        "1 tablespoon baking powder",
        "1 teaspoon salt",
        "1 teaspoon white sugar",
        "0.25 teaspoon ground nutmeg"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Spread blackberries into an ungreased 9x13-inch baking dish; set aside. Combine flour, 1 cup sugar, milk, heavy cream, melted butter, baking powder, and salt in a bowl; spoon on top blackberries. Sprinkle batter with 1 teaspoon sugar and nutmeg."
        },
        {
          "id": 3,
          "text": "Bake in the preheated oven until top is browned, fruit is bubbling, and a fork inserted into center of batter comes out clean, about 1 hour. Cool before serving."
        }
      ],
