  "recipes": [
    {
      "name": "Mel&#39;s Blender Pie",
      "ingredients_raw": [
        "4 eggs",
        "0.5 cup all-purpose flour",
        "2 cups milk",
        "0.75 cup white sugar",
        "1 cup sweetened flaked coconut",
        "1 teaspoon vanilla extract",
        "0.25 teaspoon ground cinnamon, for dusting"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat an oven to 350 degrees F (175 degrees C). Grease and flour a 9-inch pie pan."
        },
        {
          "id": 2,
          "text": "Place the eggs, flour, milk, sugar, coconut, and vanilla extract into a blender. Blend on high speed until the coconut has been finely chopped. Pour this mixture into the prepared pie pan; sprinkle with cinnamon."
        },
        {
          "id": 3,
          "text": "Bake in the preheated oven until a knife inserted into the center comes out clean, about 45 minutes. Cool on a wire rack to room temperature; refrigerate until cold before serving."
        }
      ],
