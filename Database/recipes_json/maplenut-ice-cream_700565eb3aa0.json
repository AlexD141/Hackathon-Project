      "name": "Maplenut Ice Cream",
      "ingredients_raw": [
        "3 quarts milk",
        "1 (14 ounce) can sweetened condensed milk",
        "3 eggs, beaten",
        "2 cups white sugar",
        "1 teaspoon vanilla extract",
        "1 teaspoon maple flavored extract",
        "1 cup wheat and barley nugget cereal (e.g. Grape-Nuts™)"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine milk, condensed milk, eggs, sugar, vanilla, maple extract and cereal in the freezer canister of an ice cream maker. Freeze according to manufacturer&#39;s directions."
        }
      ],
