  "recipes": [
    {
      "name": "Zucchini Pie with Crumb Topping",
      "ingredients_raw": [
        "1 (9 inch) unbaked pie crust",
        "1 cup peeled, cubed zucchini",
        "1 cup white sugar",
        "0.5 cup butter, melted",
        "2 eggs",
        "2 tablespoons all-purpose flour",
        "0.5 teaspoon vanilla extract",
        "0.5 cup all-purpose flour",
        "0.5 cup brown sugar",
        "3 tablespoons butter"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Place crust in a 9-inch pie plate; place pie plate on a baking sheet."
        },
        {
          "id": 3,
          "text": "Place zucchini in the bowl of a food processor; pulse until puréed. Transfer to a large bowl; whisk in white sugar, ½ cup melted butter, eggs, 2 tablespoons flour, and vanilla extract. Pour filling into pie crust."
        },
        {
          "id": 4,
          "text": "Combine ½ cup flour, brown sugar, and 3 tablespoons butter in a bowl until it resembles coarse crumbs; sprinkle evenly over pie filling."
        },
        {
          "id": 5,
          "text": "Bake in the preheated oven until filling is set and topping is lightly browned, about 45 minutes. Cool before serving, at least 30 minutes."
        }
      ],
