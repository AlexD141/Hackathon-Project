  "recipes": [
    {
      "name": "Marshmallow and Fruit Salad",
      "ingredients_raw": [
        "1 (3 ounce) package lemon pudding mix",
        "1 (15.5 ounce) can mandarin oranges, drained with liquid reserved",
        "3 cups miniature marshmallows",
        "3 bananas, sliced",
        "1 cup sliced strawberries",
        "1 kiwis, peeled and sliced",
        "0.5 cup chopped pecans"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Stir pudding mix and reserved liquid from mandarin oranges together in a large bowl until smooth."
        },
        {
          "id": 2,
          "text": "Stir marshmallows, banana slices, strawberry slices, kiwi slices, and pecans into the pudding mix."
        },
        {
          "id": 3,
          "text": "Chill 30 minutes before serving."
        }
      ],
