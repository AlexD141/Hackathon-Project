  "recipes": [
    {
      "name": "Red Pepper and Tomato Soup",
      "ingredients_raw": [
        "2 (10 ounce) cans condensed tomato soup",
        "1.5 cups water",
        "1 cup tomato juice (such as Mott's®)",
        "0.33333334326744 cup minced chives",
        "0.25 teaspoon garlic, minced",
        "0.25 pinch cayenne pepper",
        "1 teaspoon dried rosemary",
        "1 teaspoon dried thyme",
        "1 teaspoon dried oregano",
        "0.5 teaspoon dried basil",
        "1 teaspoon paprika",
        "0.5 cup diced tomatoes",
        "0.5 cup diced red bell pepper"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine the tomato soup and the water in a large sauce pot; simmer, stirring occasionally, for 5 minutes. Add the tomato juice, chives, garlic, cayenne, rosemary, thyme, oregano, basil, and paprika to the pot. Simmer soup for 25 minutes, stirring occasionally."
        },
        {
          "id": 2,
          "text": "Stir in the diced tomatoes and red peppers. Simmer until peppers are soft, about 10 minutes."
        }
      ],
