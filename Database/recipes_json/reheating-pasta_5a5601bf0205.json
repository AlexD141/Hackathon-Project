            "author": {
              "@type": "Person",
              "name": "cannvan"
            },
            "reviewBody": "This is a GREAT idea, especially for \"cooking for one or two\" or different shifts. Excellent tip. THANKYOU!",
            "datePublished": "2010-02-17T20:12:55.853Z"
          },
          {
            "@type": "Review",
            "reviewRating": {
              "@type": "Rating",
