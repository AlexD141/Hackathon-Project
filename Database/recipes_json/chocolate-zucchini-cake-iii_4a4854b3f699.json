  "recipes": [
    {
      "name": "Chocolate Zucchini Cake",
      "ingredients_raw": [
        "2 cups all-purpose flour",
        "2 cups white sugar",
        "0.75 cup unsweetened cocoa powder",
        "2 teaspoons baking soda",
        "1 teaspoon baking powder",
        "1 teaspoon ground cinnamon",
        "0.5 teaspoon salt",
        "1.5 cups vegetable oil",
        "4 eggs",
        "3 cups grated zucchini",
        "0.75 cup chopped walnuts"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch baking pan."
        },
        {
          "id": 3,
          "text": "Mix flour, sugar, cocoa, baking soda, baking powder, cinnamon, and salt together in a medium bowl."
        },
        {
          "id": 4,
          "text": "Add oil and eggs; mix well until just combined."
        },
        {
          "id": 5,
          "text": "Fold in shredded zucchini and walnuts until just combined."
        },
        {
          "id": 6,
          "text": "Pour cake batter into the prepared pan."
        },
        {
          "id": 7,
          "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 50 to 60 minutes."
        },
        {
          "id": 8,
          "text": "Cool cake completely before frosting with your favorite frosting."
        }
      ],
