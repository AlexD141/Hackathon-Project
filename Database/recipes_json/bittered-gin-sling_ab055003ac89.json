      "name": "Bittered Gin Sling",
      "ingredients_raw": [
        "ice",
        "1.5 (1.5 fluid ounce) jiggers gin",
        "0.75 ounce sweet vermouth",
        "0.5 ounce lemon juice",
        "0.5 ounce simple syrup",
        "2 dashes bitters (such as Angostura®)",
        "2 ounces club soda, or as needed",
        "1 (2 inch) piece lemon peel for garnish"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Put ice in a cocktail shaker. Pour in gin, vermouth, lemon juice, simple syrup, bitters. Shake well. Add ice to a highball glass. Strain cocktail into highball glass, top off with club soda, and garnish with lemon peel."
        }
