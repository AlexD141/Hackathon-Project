  "recipes": [
    {
      "name": "Southwest Baked Chili Dip",
      "ingredients_raw": [
        "8 ounces shredded Cheddar cheese",
        "1 cup mayonnaise",
        "1 (2 ounce) can chopped black olives",
        "1 (4 ounce) can diced jalapeno peppers",
        "0.25 teaspoon garlic powder",
        "1 dash hot pepper sauce",
        "1 tomato, chopped",
        "0.5 cup chopped green onions"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "In a large mixing bowl, combine Cheddar cheese, mayonnaise, half of the olives, jalapeno peppers, garlic and hot pepper sauce. Spread the mixture into a 9-inch pie pan."
        },
        {
          "id": 3,
          "text": "Bake for 20 minutes, or until heated through. Sprinkle over the dish the remaining olives, chopped tomatoes and green onions."
        }
      ],
