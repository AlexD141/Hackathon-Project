  "recipes": [
    {
      "name": "Herbed Brie in Puff Pastry",
      "ingredients_raw": [
        "1 (2.2 pound) wheel Brie cheese",
        "2 ounces thinly sliced salami, chopped",
        "1 clove garlic, minced",
        "1 teaspoon dried rosemary",
        "1 teaspoon dried thyme",
        "1 teaspoon dried marjoram",
        "0.75 teaspoon chopped fresh parsley",
        "1 sheet frozen puff pastry, thawed",
        "water",
        "1 egg, beaten"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Slice Brie in half crosswise, so you have 2 wheels."
        },
        {
          "id": 3,
          "text": "Mix together salami, garlic, rosemary, thyme, marjoram, and parsley in a medium bowl until well combined. Spread mixture on one of the cut sides and top with the other half of the Brie wheel."
        },
        {
          "id": 4,
          "text": "Place stuffed Brie in the center of puff pastry sheet. Fold puff pastry up and over Brie, pressing to secure pastry together using a little bit of water if necessary. Brush pastry with beaten egg."
        },
        {
          "id": 5,
          "text": "Bake in the preheated oven until golden brown, about 30 minutes. Remove from the oven and let stand for 15 minutes before serving."
        }
      ],
      "warnings": [],
