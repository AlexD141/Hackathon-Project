  "recipes": [
    {
      "name": "Uptown Red Beans and Rice",
      "ingredients_raw": [
        "2 tablespoons vegetable oil",
        "1 pound smoked turkey sausage, sliced",
        "3.25 cups water",
        "1 (8 ounce) package ZATARAIN'S® Red Beans and Rice Mix",
        "1 teaspoon Chopped green onions"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Heat oil in a medium saucepan over medium-high heat. Add sausage and cook until browned on both sides, 7 to 10 minutes."
        },
        {
          "id": 2,
          "text": "Stir in water and rice mix; bring to a boil. Reduce the heat to low, cover, and simmer, stirring occasionally, until rice is tender, 20 to 25 minutes."
        },
        {
          "id": 3,
          "text": "Remove from the heat and stir in green onions. Let stand 5 minutes before serving."
        }
      ],
