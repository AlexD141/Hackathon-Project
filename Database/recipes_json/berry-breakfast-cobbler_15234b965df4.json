  "recipes": [
    {
      "name": "Berry Breakfast Cobbler",
      "ingredients_raw": [
        "2.5 cups mixed frozen berries",
        "1 tablespoon brown sugar",
        "0.5 cinnamon stick, ground",
        "2 tablespoons flax seeds, ground",
        "0.25 cup unsweetened flaked coconut"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Stir the berries and brown sugar together in a microwave-safe bowl; heat on High until the berries are hot, about 2 minutes, stirring once about 1 minute into the heating process. Stir the ground cinnamon, ground flax seeds, and coconut into the heated berries and serve."
        }
      ],
