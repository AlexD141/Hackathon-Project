  "recipes": [
    {
      "name": "Blooming Onion",
      "ingredients_raw": [
        "0.5 cup mayonnaise",
        "2 tablespoons cream-style horseradish sauce",
        "2.25 teaspoons ketchup",
        "0.25 teaspoon paprika",
        "0.25 teaspoon salt",
        "1 pinch ground black pepper",
        "1 pinch cayenne pepper",
        "1 cup milk",
        "1 egg",
        "1 cup all-purpose flour",
        "1.5 teaspoons salt",
        "1.5 teaspoons cayenne pepper",
        "0.5 teaspoon ground black pepper",
        "0.5 teaspoon garlic powder",
        "0.25 teaspoon dried thyme",
        "0.25 teaspoon dried oregano",
        "0.125 teaspoon ground cumin",
        "1 large onion",
        "2 quarts vegetable oil for deep-frying"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Make dipping sauce: Combine mayonnaise, horseradish, ketchup, paprika, salt, black pepper, and cayenne pepper in a small bowl; refrigerate until needed."
        },
        {
          "id": 3,
          "text": "Prepare blooming onion: Beat milk and egg in a large bowl deep enough to dunk onion."
        },
        {
          "id": 4,
          "text": "Combine flour, salt, cayenne pepper, black pepper, garlic powder, thyme, oregano, and cumin in a separate bowl."
        },
        {
          "id": 5,
          "text": "Cut 3/4 to 1 inch off top and bottom of onion and remove skin. Remove the 1-inch diameter core from middle of onion."
        },
        {
          "id": 6,
          "text": "Use a large, sharp knife to slice down center of onion 3/4 of the way down; turn 90 degrees and slice again."
        },
        {
          "id": 7,
          "text": "Keep slicing each section in half until you have 16 sections. Be careful not to cut through bottom of onion."
        },
        {
          "id": 8,
          "text": "Spread petals apart, dip in milk mixture, then coat well with flour mixture."
        },
        {
          "id": 9,
          "text": "Separate petals again and sprinkle flour mixture between them."
        },
        {
          "id": 10,
          "text": "Dip into milk mixture and flour mixture again. Place battered onion in the refrigerator for at least 15 minutes while you preheat oil."
        },
        {
          "id": 11,
          "text": "Pour enough oil to cover onion into a deep fryer or deep pot. Heat oil to 350 degrees F (175 degrees C). Fry onion right-side-up in hot oil until golden brown, about 10 minutes."
        },
        {
          "id": 12,
          "text": "Drain on a rack or paper towels. Open center of onion wide enough to fit the bowl of dipping sauce and serve warm."
        }
      ],
