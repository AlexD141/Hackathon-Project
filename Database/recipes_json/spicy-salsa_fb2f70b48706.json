  "recipes": [
    {
      "name": "Spicy Salsa",
      "ingredients_raw": [
        "3 large ripe tomatoes, diced",
        "3 roma (plum) tomatoes, diced",
        "4 green onions, finely chopped",
        "4 fresh jalapeno peppers, finely diced",
        "1 stalk celery, finely diced",
        "4 tablespoons chopped fresh cilantro",
        "1 clove garlic, minced",
        "1 tablespoon fresh lime juice",
        "2 teaspoons ground black pepper",
        "salt to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a large bowl, combine the tomatoes, plum tomatoes, green onions, peppers, celery, cilantro, garlic, lime juice, pepper and salt to taste. Refrigerate for 45 minutes before serving."
        }
      ],
