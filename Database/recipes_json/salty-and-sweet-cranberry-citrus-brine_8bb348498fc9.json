  "recipes": [
    {
      "name": "Salty and Sweet Cranberry Citrus Brine",
      "ingredients_raw": [
        "1 gallon water",
        "1 (12 fluid ounce) can frozen orange juice concentrate",
        "1 (12 fluid ounce) can frozen cranberry juice concentrate",
        "1 cup kosher salt",
        "0.5 cup brown sugar",
        "1 medium lemon, cut into wedges",
        "1 medium orange, cut into wedges",
        "1 medium red onion, cut into wedges",
        "3 cloves garlic",
        "1 tablespoon dried thyme leaves",
        "1 tablespoon freshly ground black pepper",
        "1 (3 inch) cinnamon stick",
        "4 large bay leaves"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine water, orange and cranberry juice concentrates, kosher salt, brown sugar, lemon, orange, red onion, garlic, thyme, pepper, cinnamon stick, and bay leaves in a large stockpot. Stir until salt and brown sugar have dissolved."
        }
      ],
