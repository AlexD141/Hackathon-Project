  "recipes": [
    {
      "name": "Spinach and Tomato Rotini",
      "ingredients_raw": [
        "1 (9 ounce) box frozen creamed spinach, thawed",
        "0.5 pound uncooked rotini pasta",
        "2 cloves garlic, minced",
        "2 teaspoons olive oil",
        "2 plum tomatoes, diced"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Bring a pot of water to a rolling boil over high heat. Remove creamed spinach pouch from the box and place pouch in boiling water. Boil until heated through, 35 to 40 minutes, rotating serving times during heating."
        },
        {
          "id": 2,
          "text": "Meanwhile, fill a large pot with lightly salted water and bring to a rolling boil over high heat. Once the water is boiling, stir in the rotini, and return to a boil. Cook uncovered, stirring occasionally, until the pasta has cooked through, but is still firm to the bite, about 8 minutes. Drain well in a colander set in the sink."
        },
        {
          "id": 3,
          "text": "Combine garlic, olive oil, and tomatoes in a large bowl. Stir in the heated creamed spinach. Serve over rotini."
        }
      ],
