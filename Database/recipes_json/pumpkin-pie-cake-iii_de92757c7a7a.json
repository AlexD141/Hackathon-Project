  "recipes": [
    {
      "name": "Pumpkin Pie Cake III",
      "ingredients_raw": [
        "1 (16 ounce) can pumpkin",
        "1 (12 fluid ounce) can evaporated milk (such as Carnation ®)",
        "1 cup brown sugar",
        "3 eggs",
        "4 teaspoons pumpkin pie spice",
        "1 (18.25 ounce) package yellow cake mix",
        "0.5 cup chopped walnuts",
        "0.5 cup chopped pecans",
        "1 cup melted butter"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch cake pan."
        },
        {
          "id": 2,
          "text": "Whisk the pumpkin, evaporated milk, brown sugar, eggs, and pumpkin pie space together in a bowl. Pour into the prepared pan. Scatter the cake mix over the top of the pumpkin mixture; sprinkle the nuts over the cake mix. Drizzle the melted butter over the entire cake."
        },
        {
          "id": 3,
          "text": "Bake in the preheated oven until set in the center, about 50 minutes."
        }
      ],
