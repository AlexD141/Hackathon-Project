            },
            "author": {
              "@type": "Person",
              "name": "Paula"
            },
            "reviewBody": "This salad is absolutely delicious! I loved the sweet apple with the tangy dressing and the crunch factor of the celery, pecans, and apples. Next time I’ll dice the apples just to make the salad easier to eat.",
            "datePublished": "2023-01-27T00:44:36.701Z"
          },
          {
            "@type": "Review",
            "reviewRating": {
              "@type": "Rating",
