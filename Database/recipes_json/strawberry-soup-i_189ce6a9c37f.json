      "name": "Simple Strawberry Soup ",
      "ingredients_raw": [
        "2 pints strawberries",
        "2 cups plain yogurt",
        "0.5 cup orange juice",
        "0.5 cup white sugar",
        "0.5 cup water",
        "0.125 teaspoon ground cardamom"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine strawberries, yogurt, orange juice, sugar, water, and cardamom in a blender; purée until well mixed. Chill in the refrigerator before serving."
        }
