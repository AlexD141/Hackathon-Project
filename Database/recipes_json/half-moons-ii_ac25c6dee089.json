  "recipes": [
    {
      "name": "Half Moons II",
      "ingredients_raw": [
        "1 cup butter",
        "7.5 tablespoons ground walnuts",
        "4.5 tablespoons white sugar",
        "2.5 cups all-purpose flour",
        "1.5 teaspoons vanilla extract"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 325 degrees F (165 degrees C)."
        },
        {
          "id": 2,
          "text": "Mix the butter with the nuts and sugar until well combined. Add the flour and the vanilla and mix."
        },
        {
          "id": 3,
          "text": "Rolling about a tablespoon of dough in your hand, form a half moon or crescent shape."
        },
        {
          "id": 4,
          "text": "Bake cookies on ungreased cookie sheets at 325 degrees F (165 degrees C) for 15 minutes. Immediately remove from cookie sheets and roll in white sugar."
        }
      ],
