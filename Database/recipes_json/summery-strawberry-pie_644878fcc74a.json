  "recipes": [
    {
      "name": "Summery Strawberry Pie",
      "ingredients_raw": [
        "1 (9 inch) prepared graham cracker pie crust",
        "1 (8 ounce) package Neufchatel cheese, softened",
        "2 tablespoons white sugar",
        "2 tablespoons milk",
        "2 teaspoons pure vanilla extract",
        "1 pint fresh strawberries, hulled",
        "1 cup strawberry glaze"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Bake pie crust in the preheated oven until lightly browned, about 5 minutes. Cool completely."
        },
        {
          "id": 3,
          "text": "Beat Neufchâtel cheese, sugar, milk, and vanilla extract together in a bowl until smooth; spread into pie crust with a spatula."
        },
        {
          "id": 4,
          "text": "Arrange strawberries on top Neufchâtel mixture, cut-sides down, pushing slightly into filling; pour glaze over top."
        },
        {
          "id": 5,
          "text": "Refrigerate before serving, at least 1 hour."
        }
      ],
