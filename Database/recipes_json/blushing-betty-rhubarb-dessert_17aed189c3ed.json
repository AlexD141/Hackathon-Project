  "recipes": [
    {
      "name": "Blushing Betty (Rhubarb Dessert)",
      "ingredients_raw": [
        "4 pounds rhubarb, cut into 1-inch pieces",
        "2 cups white sugar",
        "1.3333333730698 cups raisins",
        "0.25 cup vegetable shortening",
        "0.66666668653488 cup white sugar",
        "2 eggs",
        "1 teaspoon vanilla extract",
        "2 cups all-purpose flour",
        "1 tablespoon baking powder",
        "0.5 teaspoon salt",
        "0.66666668653488 cup milk"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish."
        },
        {
          "id": 2,
          "text": "Mix rhubarb with 2 cups sugar in a large bowl and spread into the prepared baking dish; sprinkle rhubarb with raisins."
        },
        {
          "id": 3,
          "text": "Beat vegetable shortening with 2/3 cup sugar in a bowl; beat in eggs, one at a time, followed by vanilla extract. Whisk flour, baking powder, and salt together in another bowl. Gradually stir the flour mixture into the wet ingredients, alternating with milk, to form a smooth batter. Spread batter over fruit in baking dish."
        },
        {
          "id": 4,
          "text": "Bake in the preheated oven until rhubarb filling is bubbling and topping is set and golden brown, about 1 hour."
        }
      ],
