  "recipes": [
    {
      "name": "Canadian Style Chop Suey",
      "ingredients_raw": [
        "2 cups elbow macaroni",
        "1 onion, diced",
        "1 green bell pepper, diced",
        "1 pound ground Italian sausage",
        "1 (4.5 ounce) can mushrooms, drained",
        "1 (14 ounce) can stewed tomatoes"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain."
        },
        {
          "id": 2,
          "text": "In same pot, saute onion and bell pepper over medium heat until softened. Remove from pan."
        },
        {
          "id": 3,
          "text": "In same pot, cook sausage over medium heat until brown. Drain."
        },
        {
          "id": 4,
          "text": "Combine onion mixture, pasta, sausage, mushrooms and stewed tomatoes in same pot and heat through, 5 minutes. Serve."
        }
      ],
