  "recipes": [
    {
      "name": "Crantini",
      "ingredients_raw": [
        "ice",
        "3 fluid ounces cranberry juice",
        "1 fluid ounce vodka",
        "4 fluid ounces lemon-lime flavored carbonated beverage",
        "1 lemon wedge"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Fill a cocktail shaker with ice; pour in cranberry juice and vodka. Cover and shake until the outside of the shaker has frosted. Strain into a chilled glass."
        },
        {
          "id": 2,
          "text": "Stir in lemon-lime soda. Squeeze lemon wedge into the glass and stir again."
        }
      ],
      "warnings": [],
