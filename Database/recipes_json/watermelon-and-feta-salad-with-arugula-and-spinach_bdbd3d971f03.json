  "recipes": [
    {
      "name": "Spinach Watermelon Salad",
      "ingredients_raw": [
        "3 tablespoons extra-virgin olive oil",
        "2 teaspoons white balsamic vinegar",
        "0.5 teaspoon kosher salt",
        "2 cups arugula",
        "2 cups baby spinach leaves",
        "1 cup thinly sliced red onion",
        "1 cup grape tomatoes, halved",
        "0.5 cup crumbled feta cheese",
        "2 cups bite sized watermelon chunks"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Whisk olive oil, white balsamic vinegar, and salt together in a small bowl; set aside."
        },
        {
          "id": 2,
          "text": "Combine arugula, spinach, onions, and tomatoes in a large salad bowl. Drizzle vinaigrette over salad mixture; toss to coat. Add feta cheese and watermelon to serve."
        }
      ],
