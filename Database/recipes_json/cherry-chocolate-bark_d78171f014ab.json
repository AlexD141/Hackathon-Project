{
  "source_url": "https://www.allrecipes.com/recipe/184839/cherry-chocolate-bark/",
  "extracted_at": "2026-10-18T02:31:12.385613+00:00",
  "recipes": [
    {
      "name": "Cherry Chocolate Bark",
      "ingredients_raw": [
        "1 (12 ounce) bag semisweet chocolate chips",
        "12 cherry-flavored candy canes, crushed",
        "0.33333334326744 cup red confectioner's coating"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Line a 9x13 inch baking pan with aluminum foil."
        },
        {
          "id": 2,
          "text": "Melt the chocolate chips in a microwave-safe glass or ceramic bowl in 30-second intervals, stirring after each melting, until smooth, 1 to 3 minutes (depending on your microwave). Do not overheat or chocolate will scorch. Using a spatula, quickly spread the melted chocolate evenly in the prepared pan until the bottom of the pan is covered. Sprinkle the crushed candy evenly over the chocolate, and pat lightly with a clean spatula to help the candy settle into the chocolate."
        },
        {
          "id": 3,
          "text": "Melt the red confectioner&#39;s coating, if using, in a microwave-safe glass or ceramic bowl in 30-second intervals, stirring after each melting, until smooth, 1 to 3 minutes (depending on your microwave). Spoon the melted coating into a resealable plastic bag; snip off a very small corner of the bag, and use to drizzle coating over the bark."
        },
        {
          "id": 4,
          "text": "Place the pan in the refrigerator or freezer until hardened, about 30 minutes. Remove from pan; peel off foil. Break into small pieces to serve."
        }
      ],
