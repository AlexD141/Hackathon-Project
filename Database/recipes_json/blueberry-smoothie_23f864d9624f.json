  "recipes": [
    {
      "name": "Blueberry Smoothie",
      "ingredients_raw": [
        "1 cup blueberries (frozen or fresh)",
        "1 (8 ounce) container plain yogurt",
        "0.75 cup 2% reduced-fat milk",
        "2 tablespoons white sugar",
        "0.5 teaspoon vanilla extract",
        "0.125 teaspoon ground nutmeg"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Blend blueberries, yogurt, milk, sugar, vanilla, and nutmeg in a blender until frothy, scraping down the sides of the blender if needed."
        },
        {
          "id": 3,
          "text": "Divide between 2 glasses and serve immediately. Enjoy!"
        }
      ],
