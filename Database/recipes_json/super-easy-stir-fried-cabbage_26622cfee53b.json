  "recipes": [
    {
      "name": "Super Easy Cabbage Stir Fry",
      "ingredients_raw": [
        "1 tablespoon vegetable oil",
        "2 cloves garlic, minced",
        "1 pound shredded cabbage",
        "1 tablespoon soy sauce",
        "1 tablespoon Chinese cooking wine (Shaoxing wine)"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Heat oil in a wok or large skillet over medium heat. Stir in garlic and cook in hot oil until it starts to brown, 3 to 5 seconds."
        },
        {
          "id": 2,
          "text": "Stir in cabbage until coated in oil; cover the wok and cook for 1 minute."
        },
        {
          "id": 3,
          "text": "Pour in soy sauce; cook and stir for 1 minute more. Increase heat to high and stir in Chinese cooking wine. Cook and stir until cabbage is tender, about 2 minutes more."
        },
        {
          "id": 4,
          "text": "Serve hot and enjoy!"
        }
      ],
