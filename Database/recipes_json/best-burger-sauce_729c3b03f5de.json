  "recipes": [
    {
      "name": "Best Burger Sauce",
      "ingredients_raw": [
        "1 cup mayonnaise",
        "0.5 cup ketchup",
        "0.25 cup prepared yellow mustard",
        "2 teaspoons dried minced onion",
        "0.25 teaspoon dried minced garlic",
        "0.125 teaspoon white vinegar",
        "hot sauce to taste",
        "seasoned pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Whisk together mayonnaise, ketchup, mustard, onion, garlic, and vinegar in a bowl."
        },
        {
          "id": 3,
          "text": "Season with hot sauce and seasoned pepper."
        },
        {
          "id": 4,
          "text": "Cover and chill at least 1 hour before serving."
        },
        {
          "id": 5,
          "text": "Serve and enjoy!"
        }
      ],
