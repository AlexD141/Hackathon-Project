  "recipes": [
    {
      "name": "Elderflower Cordial Concentrate",
      "ingredients_raw": [
        "4.5 cups white sugar",
        "24 elderberry flower heads",
        "0.5 cup fresh lemon juice",
        "2 ounces citric acid powder",
        "1.5 quarts boiling water"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine sugar, elderflower heads, lemon juice, and citric acid in a large acid-proof container. Pour boiling water over top; steep for 24 hours, stirring occasionally."
        },
        {
          "id": 2,
          "text": "Strain liquid through muslin or cheesecloth into a large bowl; discard solids. Ladle liquid into bottles; refrigerate. Or pour liquid into freezer containers and freeze."
        }
      ],
