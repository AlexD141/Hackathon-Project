  "recipes": [
    {
      "name": "Sea Breeze Cocktail",
      "ingredients_raw": [
        "1.5 fluid ounces vodka",
        "4 fluid ounces cranberry juice",
        "1 fluid ounce grapefruit juice",
        "1.5 cups ice cubes",
        "1 lime wedge"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine vodka, cranberry juice, and grapefruit juice in a highball glass and stir to combine. Add ice."
        },
        {
          "id": 2,
          "text": "Garnish with a wedge of lime."
        }
      ],
