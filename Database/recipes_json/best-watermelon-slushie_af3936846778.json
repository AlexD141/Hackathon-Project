      "name": "Best Watermelon Slushie",
      "ingredients_raw": [
        "3 cups ice",
        "2 cups watermelon chunks",
        "0.5 cup cantaloupe chunks",
        "0.25 cup orange juice",
        "1 tablespoon honey",
        "4 sprigs mint, for garnish"
      ],
      "steps": [
