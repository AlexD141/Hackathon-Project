  "recipes": [
    {
      "name": "Tartar Sauce",
      "ingredients_raw": [
        "1 cup mayonnaise",
        "1 tablespoon sweet pickle relish",
        "1 tablespoon minced onion",
        "2 tablespoons lemon juice",
        "salt and pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Mix mayonnaise, relish, and onion together in a small bowl."
        },
        {
          "id": 3,
          "text": "Stir in lemon juice; season with salt and pepper."
        },
        {
          "id": 4,
          "text": "Cover and refrigerate for at least 1 hour before serving."
        },
        {
          "id": 5,
          "text": "Serve and enjoy!"
        }
      ],
