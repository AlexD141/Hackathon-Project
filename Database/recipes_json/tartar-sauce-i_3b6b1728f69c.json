            "author": {
              "@type": "Person",
              "name": "HandyStraw9735"
            },
            "reviewBody": "I added parsley to it! Really good flavor.",
            "datePublished": "2025-05-02T20:41:07.420Z"
          },
          {
            "@type": "Review",
            "reviewRating": {
              "@type": "Rating",
