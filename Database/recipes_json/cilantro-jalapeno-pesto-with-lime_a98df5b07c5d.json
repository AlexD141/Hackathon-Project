    {
      "name": "Cilantro Jalapeno Pesto with Lime",
      "ingredients_raw": [
        "1 bunch fresh cilantro",
        "2.5 tablespoons toasted pine nuts",
        "0.25 cup extra virgin olive oil",
        "5 cloves garlic",
        "1 tablespoon fresh lime juice",
        "0.5 fresh jalapeno pepper, seeded",
        "0.25 cup grated Parmesan cheese"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine the cilantro, pine nuts, olive oil, garlic, lime juice, jalapeno pepper, and Parmesan cheese in a blender; pulse until the mixture reaches a soft, paste-like consistency."
        }
      ],
