    {
      "name": "Honey Mustard Dressing",
      "ingredients_raw": [
        "0.25 cup mayonnaise",
        "1 tablespoon prepared mustard",
        "1 tablespoon honey",
        "0.5 tablespoon lemon juice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Whisk mayonnaise, mustard, honey, and lemon juice together in a small bowl until blended."
        },
        {
          "id": 3,
          "text": "Store covered in the refrigerator until ready to use."
        }
