  "recipes": [
    {
      "name": "Blubaugh&#39;s Blueberry Buckle Shortcake",
      "ingredients_raw": [
        "1.5 cups white sugar",
        "1 cup margarine",
        "4 eggs",
        "1 teaspoon vanilla extract",
        "2 cups all-purpose flour",
        "1 (16 ounce) can blueberry pie filling"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a baking sheet."
        },
        {
          "id": 2,
          "text": "Cream the sugar and margarine together in a mixing bowl. Stir in the eggs, one at a time, beating thoroughly after each. Stir in the vanilla and flour, and mix well. Spread the batter over the prepared baking sheet to form a rectangle. Use a knife to mark off 12 squares. Use a spoon to make a small well in each square. Place 1 tablespoon pie filling in each well."
        },
        {
          "id": 3,
          "text": "Bake in preheated oven until top is light brown, about 25 minutes. Cool on pan, and cut into 12 squares."
        }
      ],
