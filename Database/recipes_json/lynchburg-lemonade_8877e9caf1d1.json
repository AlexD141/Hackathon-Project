      "name": "Lynchburg Lemonade",
      "ingredients_raw": [
        "1 cup ice cubes",
        "1 (1.5 fluid ounce) jigger Tennessee whiskey",
        "1 (1.5 fluid ounce) jigger sweet and sour mix",
        "1 (1.5 fluid ounce) jigger triple sec (orange-flavored liqueur)",
        "0.75 cup chilled lemon-lime soda"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Fill a tall glass with ice cubes and pour in the whiskey, sweet and sour mix, triple sec and lemon-lime soda. Stir with a straw and enjoy!"
        }
      ],
