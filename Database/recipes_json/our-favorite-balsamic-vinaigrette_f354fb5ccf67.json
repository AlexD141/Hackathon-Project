  "recipes": [
    {
      "name": "Our Favorite Balsamic Vinaigrette",
      "ingredients_raw": [
        "0.5 cup olive oil",
        "0.25 cup balsamic vinegar",
        "1 shallot, minced",
        "1 clove garlic, minced",
        "1 teaspoon Dijon mustard",
        "1 teaspoon honey",
        "salt and ground black pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Combine olive oil, balsamic vinegar, shallot, garlic, Dijon mustard, honey, salt, and black pepper together in a glass jar with a tight-fitting lid."
        },
        {
          "id": 3,
          "text": "Replace the lid on the jar and shake vigorously until thoroughly combined."
        }
      ],
