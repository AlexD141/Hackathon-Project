  "recipes": [
    {
      "name": "Vanilla Wafer Cake III",
      "ingredients_raw": [
        "1 cup butter",
        "2 cups white sugar",
        "6 eggs",
        "0.5 cup milk",
        "1 (12 ounce) package vanilla wafers, crushed",
        "1 cup flaked coconut",
        "1 cup chopped walnuts"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 300 degrees F (150 degrees C). Grease and flour a 9-inch Bundt cake pan."
        },
        {
          "id": 2,
          "text": "In a medium bowl, cream together the butter and sugar. Beat in the eggs, one at a time. Next, stir in the milk. Finally, stir in the vanilla wafers, coconut and nuts. Pour into the prepared pan."
        },
        {
          "id": 3,
          "text": "Bake for 1 1/2 hours in the preheated oven. Allow cake to cool in the pan for at least 10 minutes before inverting onto a wire rack."
        }
      ],
