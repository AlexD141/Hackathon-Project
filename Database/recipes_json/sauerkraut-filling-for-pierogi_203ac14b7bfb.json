  "recipes": [
    {
      "name": "Sauerkraut Filling for Pierogi",
      "ingredients_raw": [
        "2 tablespoons vegetable oil",
        "1 cup chopped onion",
        "1 cup chopped mushrooms",
        "14 ounces sauerkraut - drained, rinsed and minced",
        "0.25 teaspoon salt",
        "0.25 teaspoon ground black pepper",
        "2 tablespoons sour cream"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a large skillet, heat oil over a medium flame. Add onions and mushrooms, and cook until tender but not brown. Stir in sauerkraut, 1/4 teaspoon salt, and 1/4 teaspoon black pepper. Cook for 6 to 10 minutes. Remove from heat, and stir in 2 tablespoons sour cream."
        }
      ],
