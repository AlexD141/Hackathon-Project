  "recipes": [
    {
      "name": "Uncle Jon&#39;s Watermelon Salsa",
      "ingredients_raw": [
        "8 cups cubed seeded watermelon",
        "1 cup white wine vinegar",
        "1 bunch fresh cilantro, chopped",
        "0.5 large white onion, chopped",
        "2 large jalapeno peppers - stemmed, seeded and minced",
        "2 cloves garlic, minced",
        "1 teaspoon salt"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine watermelon, vinegar, cilantro, onion, jalapeños, garlic, and salt in a large bowl until evenly mixed."
        },
        {
          "id": 2,
          "text": "Cover the bowl; refrigerate for the best flavor, 8 hours to overnight."
        }
      ],
