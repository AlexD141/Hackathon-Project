  "recipes": [
    {
      "name": "Judy’s Sauerkraut",
      "ingredients_raw": [
        "2 pounds sauerkraut, drained",
        "2 tablespoons bacon drippings",
        "2 onion, coarsely chopped",
        "1.25 cups beef broth",
        "3 whole cloves",
        "1 bay leaf",
        "4 juniper berries",
        "2 teaspoons caraway seeds",
        "salt to taste",
        "1 teaspoon white sugar, or to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place the sauerkraut, bacon drippings, and onion into a slow cooker. Pour in the beef broth, then season with cloves, bay leaf, juniper berries, caraway seed, salt, and sugar. Stir to combine."
        },
        {
          "id": 2,
          "text": "Cook on Low 8 hours."
        }
      ],
