          },
          {
            "@type": "Review",
            "reviewRating": {
              "@type": "Rating",
              "ratingValue": "5"
            },
            "author": {
              "@type": "Person",
              "name": "Marti Korpi"
            },
            "reviewBody": "These were popular for a long time. They are good as shots too. I used to know a bar owner who sold them for $10 for the whole jigger and you could serve several people for that amt! They call em red snappers because they snap you in the butt later if you have a few lol",
            "datePublished": "2011-08-08T07:11:27.057Z"
          },
          {
            "@type": "Review",
            "reviewRating": {
              "@type": "Rating",
