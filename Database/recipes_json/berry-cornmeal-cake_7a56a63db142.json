  "recipes": [
    {
      "name": "Berry Cornmeal Cake",
      "ingredients_raw": [
        "0.5 cup yellow cornmeal",
        "1.25 cups all-purpose flour",
        "0.5 cup white sugar",
        "2 teaspoons baking powder",
        "1 teaspoon salt",
        "4 eggs",
        "1 (14 ounce) can sweetened condensed milk",
        "0.66666668653488 cup milk",
        "0.33333334326744 cup canola oil",
        "1 teaspoon vanilla extract",
        "0.5 cup fresh blueberries",
        "0.5 cup fresh raspberries",
        "0.5 cup sliced fresh strawberries",
        "0.5 cup fresh blackberries"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease 9x9 inch baking dish."
        },
        {
          "id": 2,
          "text": "Stir the cornmeal, flour, sugar, baking powder, and salt together in a mixing bowl. Combine the eggs, condensed milk, milk, oil, and vanilla in a second mixing bowl. Add egg mixture to the cornmeal mixture all at once and beat until well blended, about 2 minutes. Spread berries over the bottom of prepared dish. Spoon batter evenly over the berries to completely cover."
        },
        {
          "id": 3,
          "text": "Bake in preheated oven until top is golden brown, about 45 minutes."
        }
      ],
