      "name": "Submarine Flavors",
      "ingredients_raw": [
        "1 cup extra virgin olive oil",
        "2 teaspoons Italian seasoning",
        "2 cloves garlic, halved",
        "salt and pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine all ingredients in a jar, and let sit for at least an hour to steep the flavors in the oil. Sprinkle generously on the lettuce in your sub or directly on the insides of the bun."
        }
