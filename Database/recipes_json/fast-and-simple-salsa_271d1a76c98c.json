      "name": "Fast and Simple Salsa",
      "ingredients_raw": [
        "6 large tomatoes, chopped",
        "1 medium onion, chopped",
        "0.75 cup green chile peppers, chopped",
        "1 teaspoon vinegar",
        "1 teaspoon salt"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine tomatoes, onion, and chile peppers in a strainer set over a bowl; drain briefly."
        },
        {
          "id": 2,
          "text": "Transfer tomato mixture to a clean bowl. Stir in vinegar and salt."
        }
      ],
