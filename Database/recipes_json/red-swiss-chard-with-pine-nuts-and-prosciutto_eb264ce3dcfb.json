  "recipes": [
    {
      "name": "Red Swiss Chard with Pine Nuts and Prosciutto",
      "ingredients_raw": [
        "2 teaspoons olive oil",
        "0.25 cup pine nuts",
        "2 cloves garlic, minced",
        "8 cups chopped red Swiss chard",
        "salt and ground black pepper to taste",
        "0.25 pound sliced prosciutto, chopped"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Heat olive oil in a large skillet over medium heat. Cook and stir the pine nuts in the hot oil until they turn a light golden brown, about 2 minutes; watch carefully, they burn easily. Stir in the garlic; cook until fragrant, about 1 more minute, stirring constantly."
        },
        {
          "id": 2,
          "text": "Mix in the Swiss chard; cook and stir until the chard has wilted, 3 to 5 minutes. Season with salt and black pepper. Lightly stir in the chopped prosciutto; cook and stir just until prosciutto is hot, then serve."
        }
      ],
