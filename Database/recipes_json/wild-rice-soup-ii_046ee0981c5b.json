  "recipes": [
    {
      "name": "Wild Rice Soup II",
      "ingredients_raw": [
        "0.5 cup dry lentils",
        "3 cups water",
        "1 (6 ounce) package uncooked wild rice",
        "1 (14.5 ounce) can vegetable broth",
        "1 (10 ounce) package frozen mixed vegetables",
        "1 cup milk",
        "1.5 cups shredded American cheese"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Rinse and sort lentils, discarding any debris or blemished lentils."
        },
        {
          "id": 2,
          "text": "Combine lentils and water in a medium saucepan. Bring to a boil; cover, reduce heat to low and simmer for 5 minutes. Let stand for 1 hour, covered. Drain and rinse lentils."
        },
        {
          "id": 3,
          "text": "Using a medium saucepan cook rice according to package directions."
        },
        {
          "id": 4,
          "text": "In a medium stock pot add lentils, cooked rice, vegetable broth, frozen mixed vegetables, milk and American cheese. Bring to a boil; reduce heat to low and simmer, uncovered for 20 minutes. Garnish as desired."
        }
      ],
