  "recipes": [
    {
      "name": "Healthier BBQ Pork for Sandwiches",
      "ingredients_raw": [
        "1 (14 ounce) can beef broth",
        "3 pounds boneless pork ribs",
        "1 cup shredded carrot",
        "4.5 fluid ounces barbeque sauce",
        "4.5 ounces mesquite sauce"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Pour beef broth into slow cooker and add pork ribs. Cook on High until meat shreds easily, about 4 hours. Remove meat and shred with two forks."
        },
        {
          "id": 2,
          "text": "Preheat oven to 350 degrees F (175 degrees C). Transfer shredded pork to a Dutch oven or skillet and stir in carrots, barbecue sauce, and mesquite sauce."
        },
        {
          "id": 3,
          "text": "Bake in preheated oven until heated through, about 30 minutes."
        }
      ],
