  "recipes": [
    {
      "name": "Mary&#39;s Deviled Eggs",
      "ingredients_raw": [
        "8 eggs",
        "0.5 teaspoon prepared mustard",
        "1 tablespoon creamy salad dressing (such as Miracle Whip®), or as needed",
        "salt and pepper to taste",
        "1 pinch paprika"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Place eggs in a saucepan and cover with water. Bring to a boil, cover and remove from heat; let eggs stand in hot water for 10 to 12 minutes. Remove eggs from hot water and cool in ice water."
        },
        {
          "id": 3,
          "text": "Peel eggs and cut in half lengthwise, remove and reserve yolks in a bowl."
        },
        {
          "id": 4,
          "text": "Add mustard, salad dressing, salt, and pepper to egg yolks; mix until smooth."
        },
        {
          "id": 5,
          "text": "Refill each egg half with the yolk mixture and sprinkle with paprika."
        }
      ],
