  "recipes": [
    {
      "name": "Easy Rum Raisin Ice Cream",
      "ingredients_raw": [
        "0.25 cup raisins",
        "0.25 cup dark rum",
        "1 quart vanilla ice cream",
        "0.125 teaspoon ground nutmeg"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place raisins in a small bowl, pour rum on top, cover with plastic wrap, and allow to steep overnight."
        },
        {
          "id": 2,
          "text": "The next day, remove ice cream from the freezer; let stand at room temperature until softened but not melting, about 15 minutes."
        },
        {
          "id": 3,
          "text": "Scoop ice cream into a large bowl. Stir in rum-soaked raisins, any extra rum in the bowl, and nutmeg until ice cream is well combined. The rum will soften the ice cream and make mixing easier."
        },
        {
          "id": 4,
          "text": "Pack flavored ice cream back into the carton; refreeze until needed, at least 30 minutes."
        }
      ],
