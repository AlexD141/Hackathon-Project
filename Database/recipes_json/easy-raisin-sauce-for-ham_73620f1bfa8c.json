            "author": {
              "@type": "Person",
              "name": "SandyGrape2578"
            },
            "reviewBody": "I added two teaspoons of yellow mustard and two teaspoons of apple cider vinegar. Cut the sweetness a little and added some interest. Very nice!",
            "datePublished": "2023-08-03T23:39:53.649Z"
          },
          {
            "@type": "Review",
            "reviewRating": {
              "@type": "Rating",
