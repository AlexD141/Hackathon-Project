  "recipes": [
    {
      "name": "Christy&#39;s Awesome Hot Ham and Cheese",
      "ingredients_raw": [
        "2 slices whole grain bread",
        "2 teaspoons butter",
        "2 slices Swiss cheese",
        "2 thin slices deli ham",
        "1 teaspoon mayonnaise",
        "1 teaspoon whole grain mustard"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Preheat a skillet over medium-high heat."
        },
        {
          "id": 3,
          "text": "Spread one side of each slice of bread with 1 teaspoon butter."
        },
        {
          "id": 4,
          "text": "Place one slice butter-side down in the hot skillet. Top with Swiss cheese and ham."
        },
        {
          "id": 5,
          "text": "Spread the unbuttered side of second slice of bread with mayonnaise and mustard; place it butter-side up on sandwich."
        },
        {
          "id": 6,
          "text": "Cook in the hot skillet until golden brown and cheese is melted, about 3 minutes per side."
        }
      ],
