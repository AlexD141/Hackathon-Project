    {
      "name": "Purple Monstrosity Fruit Smoothie",
      "ingredients_raw": [
        "2 frozen bananas, skins removed and cut in chunks",
        "0.5 cup frozen blueberries",
        "1 cup orange juice",
        "1 tablespoon honey",
        "1 teaspoon vanilla extract"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place bananas, blueberries and juice in a blender, puree. Use honey and/or vanilla to taste. Use more or less liquid depending on the thickness you want for your smoothie."
        }
      ],
