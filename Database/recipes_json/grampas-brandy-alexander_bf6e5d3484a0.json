  "recipes": [
    {
      "name": "Grampa&#39;s Brandy Alexander",
      "ingredients_raw": [
        "2 tablespoons brandy",
        "2 tablespoons creme de cacao",
        "2 tablespoons chocolate syrup",
        "1 cup chocolate ice cream, softened"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In blender, combine brandy, creme de cacao, and chocolate syrup. Blend at medium speed until well-mixed. Add the softened ice cream in large chunks. Blend at high speed until smooth. Serve immediately."
        }
      ],
