      "name": "Basil Strawberry Mango Smoothie",
      "ingredients_raw": [
        "1 cup frozen mango pieces",
        "1 cup water",
        "5 hulled strawberries",
        "4 leaves basil",
        "3 cubes ice",
        "0.25 cup white sugar, or to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place mango, water, strawberries, and basil in a blender; blend until smooth. Add ice and sugar; blend until smooth."
        }
