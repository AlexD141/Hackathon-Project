  "recipes": [
    {
      "name": "Spicy Habanero Dipping Sauce",
      "ingredients_raw": [
        "0.25 cup malt vinegar",
        "2 tablespoons soy sauce",
        "2 tablespoons water",
        "2 teaspoons white sugar",
        "3 cloves garlic, minced",
        "0.25 cup chopped fresh cilantro",
        "1 habanero pepper, chopped (use gloves)"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine the malt vinegar, soy sauce, water, and sugar together in a small saucepan over high heat; bring to a boil, and immediately remove from heat."
        },
        {
          "id": 2,
          "text": "Combine the garlic, cilantro, and habanero pepper together in a bowl; pour the malt vinegar mixture over the garlic mixture, and allow to steep for 5 minutes before serving."
        }
      ],
