  "recipes": [
    {
      "name": "Grandma Winnie&#39;s Turkey Stuffing",
      "ingredients_raw": [
        "0.25 pound butter",
        "1 cup chopped onion",
        "1.5 cups chopped celery",
        "9 cups soft bread cubes",
        "0.5 teaspoon poultry seasoning",
        "1 (4.5 ounce) can sliced mushrooms",
        "1 egg, beaten",
        "1 cup chicken stock"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 325 degrees F (165 degrees C). Butter one 2 quart casserole dish."
        },
        {
          "id": 2,
          "text": "In a saute pan, cook onion and celery in butter until soft."
        },
        {
          "id": 3,
          "text": "In a mixing bowl, combine onion and celery, bread cubes, poultry seasonings, mushrooms, egg and stock. Mix well and add to casserole dish. Bake for 1 hour."
        }
      ],
