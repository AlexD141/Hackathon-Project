  "recipes": [
    {
      "name": "Baked Pineapple Side Dish",
      "ingredients_raw": [
        "1 cup white sugar",
        "0.25 pound butter, softened",
        "4 eggs, beaten",
        "1 (20 ounce) can pineapple",
        "5 slices bread, crusts removed and broken into crumbs"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Beat sugar and butter together in a medium bowl; beat in eggs. Add pineapple and bread crumbs; transfer mixture to a 10-inch pie plate or baking dish."
        },
        {
          "id": 3,
          "text": "Bake in the preheated oven until brown, 45 to 60 minutes."
        }
      ],
