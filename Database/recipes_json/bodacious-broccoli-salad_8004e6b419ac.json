  "recipes": [
    {
      "name": "Bodacious Broccoli Salad",
      "ingredients_raw": [
        "8 slices bacon",
        "2 heads fresh broccoli, chopped",
        "1.5 cups sharp Cheddar cheese, shredded",
        "0.5 large red onion, chopped",
        "0.66666668653488 cup mayonnaise",
        "0.25 cup red wine vinegar",
        "0.125 cup white sugar",
        "2 teaspoons ground black pepper",
        "1 teaspoon salt",
        "1 teaspoon fresh lemon juice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Place bacon in a large, deep skillet. Cook over medium-high heat until crisp and evenly browned, 8 to 10 minutes. Transfer to a paper towel-lined plate and crumble when cool enough to handle."
        },
        {
          "id": 3,
          "text": "Combine crumbled bacon, broccoli, cheese, and onion in a large salad bowl."
        },
        {
          "id": 4,
          "text": "Whisk mayonnaise, red wine vinegar, sugar, pepper, salt, and lemon juice together in a small bowl until well combined."
        },
        {
          "id": 5,
          "text": "Pour dressing over salad and toss well until broccoli is coated."
        },
        {
          "id": 6,
          "text": "Cover and refrigerate until ready to serve."
        }
      ],
