  "recipes": [
    {
      "name": "Cheese and Pecan Pasta Salad",
      "ingredients_raw": [
        "1 pound spaghetti",
        "2 tablespoons olive oil",
        "2 cloves garlic, minced",
        "0.25 cup torn fresh basil leaves",
        "1 tablespoon chopped fresh oregano",
        "1 teaspoon salt",
        "1 teaspoon ground black pepper",
        "0.5 cup half-and-half cream",
        "0.5 cup olive oil",
        "1 green bell pepper, seeded and thinly sliced",
        "1 red bell pepper, seeded and thinly sliced",
        "0.5 cup chopped fresh parsley",
        "0.66666668653488 pound Jarlsberg cheese, cut into matchsticks",
        "0.5 cup toasted, chopped pecans",
        "0.25 pound grated Parmesan cheese"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Bring a large pot of lightly salted water to a boil. Add spaghetti and cook for 8 to 10 minutes or until al dente. Drain and toss with 2 tablespoons olive oil in a large bowl; set aside."
        },
        {
          "id": 2,
          "text": "Whisk together the garlic, basil, oregano, salt, pepper, half-and-half, an 1/2 cup olive oil in a bowl. Toss with the cooked spaghetti. Add the green bell pepper, red bell pepper, parsley, Jarlsberg, and pecans. Toss the salad again to mix, and sprinkle with Parmesan cheese to serve."
        }
      ],
