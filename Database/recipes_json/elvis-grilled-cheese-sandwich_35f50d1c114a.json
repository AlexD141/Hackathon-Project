  "recipes": [
    {
      "name": "Elvis&#39; Grilled Cheese Sandwich",
      "ingredients_raw": [
        "2 slices bacon",
        "1 tablespoon smooth peanut butter",
        "2 slices soft white bread",
        "1 slice American cheese",
        "1 tablespoon butter, softened"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place the bacon in a large, deep skillet, and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain the bacon slices on a paper towel-lined plate."
        },
        {
          "id": 2,
          "text": "Spread peanut butter on a slice of white bread, and cover with cheese slice and bacon. Top with the other piece of bread. Spread butter on both sides of the sandwich, and pan-fry in a skillet over medium heat until the bread is golden brown and the cheese has melted, 2 to 3 minutes per side. Serve hot."
        }
      ],
