  "recipes": [
    {
      "name": "Apple Raisin Cakes",
      "ingredients_raw": [
        "2 eggs, beaten",
        "1 cup applesauce",
        "1 teaspoon ground cinnamon",
        "2 teaspoons white sugar",
        "1 cup all-purpose flour",
        "0.5 cup whole wheat flour",
        "2 teaspoons baking powder",
        "2 teaspoons vanilla extract",
        "0.5 cup raisins"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a large mixing bowl, combine eggs, applesauce, cinnamon, sugar, flour, baking powder, vanilla, and raisins. Form small cakes out of the batter."
        },
        {
          "id": 2,
          "text": "Heat a nonstick griddle over medium heat, fry the cakes until both sides are browned, about 5 to 7 minutes."
        }
      ],
