            },
            "author": {
              "@type": "Person",
              "name": "DeeFrap"
            },
            "reviewBody": "Instead of whole wheat flour I used almond flour... they taste incredible!!!",
            "datePublished": "2016-08-23T00:41:02.233Z"
          },
          {
            "@type": "Review",
            "reviewRating": {
              "@type": "Rating",
