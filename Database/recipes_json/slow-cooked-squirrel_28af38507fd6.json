      "name": "Slow Cooked Squirrel",
      "ingredients_raw": [
        "2 squirrels - skinned, gutted, and cut into pieces",
        "4 large potatoes, quartered",
        "1 pound carrots, chopped",
        "1 green bell pepper, chopped",
        "4 onions, sliced",
        "2 cups water",
        "0.25 medium head cabbage",
        "1 teaspoon salt",
        "1 teaspoon ground black pepper"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a slow cooker, place the squirrel meat, potatoes, carrots, green bell pepper, onions, water, cabbage, salt and ground black pepper."
        },
        {
          "id": 2,
          "text": "Cover and cook on low setting for 8 hours."
        }
