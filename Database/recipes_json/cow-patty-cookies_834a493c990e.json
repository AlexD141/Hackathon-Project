  "recipes": [
    {
      "name": "Cow Patty Cookies",
      "ingredients_raw": [
        "2 cups white sugar",
        "5 tablespoons unsweetened cocoa powder",
        "0.5 cup unsalted butter",
        "0.5 cup crunchy peanut butter",
        "1 teaspoon vanilla extract",
        "3 cups quick cooking oats",
        "0.5 cup chopped walnuts",
        "0.5 cup milk"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Cover baking sheets with wax paper and set aside."
        },
        {
          "id": 2,
          "text": "Combine sugar and cocoa in a large saucepan. Stir in milk, butter and peanut butter. Cook and stir over medium heat until butter melts and mixture is combined, about 5-20 minutes. Remove from heat."
        },
        {
          "id": 3,
          "text": "Stir in the vanilla, oats and nuts, and mix thoroughly. Take a teaspoon and scoop out a spoonful of the mixture; drop the spoonful onto the waxed paper-covered baking sheet. Repeat with the rest of the mixture. Place in the refrigerator until the cookies are cooled and set. Store the cookies in an airtight container."
        }
      ],
