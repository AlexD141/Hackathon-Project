            "author": {
              "@type": "Person",
              "name": "Gary"
            },
            "reviewBody": "As a kid (half urban half year farmhand) we washed class with white vinegar and newspaper. We also kept five different vinegars fermenting year round. White, apple cider, white and red wine and rice.",
            "datePublished": "2025-10-05T13:16:39.624Z"
