  "recipes": [
    {
      "name": "Fusilli with Grape Tomatoes and Sausage",
      "ingredients_raw": [
        "1 (7.75 ounce) package DOLE® Extra Veggie™ with Grape Tomatoes",
        "1 clove garlic, minced",
        "2 links hot Italian sausage, cooked and chopped in bite-size pieces",
        "1 tablespoon olive oil",
        "1 cup dry fusilli pasta or rotini pasta, cooked according to package directions",
        "0.25 cup chicken broth",
        "1 pinch Salt and ground black pepper, to taste",
        "Grated Parmesan cheese"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Remove grape tomatoes from pouch and cut in half; set aside."
        },
        {
          "id": 2,
          "text": "Saute garlic and cooked sausage in olive oil in large skillet over medium-high heat 2 to 3 minutes or until garlic is softened. Add salad blend and tomatoes; saute 3 to 4 minutes longer or until salad blend starts to wilt."
        },
        {
          "id": 3,
          "text": "Add cooked pasta and broth; cook, stirring until heated through. Season with salt and pepper, to taste. Sprinkle with Parmesan cheese."
        }
      ],
