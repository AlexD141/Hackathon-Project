  "recipes": [
    {
      "name": "Shower Sherbet Punch",
      "ingredients_raw": [
        "0.5 gallon pineapple sherbet",
        "1 liter lemon-lime flavored carbonated beverage",
        "4 cups pineapple juice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Scoop sherbet into a large punch bowl."
        },
        {
          "id": 3,
          "text": "Pour soda and pineapple juice over sherbet. When adding soda, the punch will foam, so stir constantly so the foam can go down."
        },
        {
          "id": 4,
          "text": "Serve immediately."
        }
      ],
