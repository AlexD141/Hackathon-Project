  "recipes": [
    {
      "name": "Most Amazing Sangria Recipe Ever!",
      "ingredients_raw": [
        "4.5 cups red wine",
        "0.75 cup ginger ale",
        "0.5 cup orange juice",
        "2 fluid ounces brandy",
        "1 fluid ounce triple sec (orange-flavored liqueur)",
        "1 teaspoon white sugar",
        "1 pinch ground cinnamon",
        "2 cups crushed ice",
        "0.5 Granny Smith apple, diced"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Stir red wine, ginger ale, orange juice, brandy, triple sec, sugar, cinnamon, and apple together in a large pitcher."
        },
        {
          "id": 2,
          "text": "Divide crushed ice evenly into six large wine glasses."
        },
        {
          "id": 3,
          "text": "Pour red wine mixture into each wine glass, making sure that each serving has a few pieces of apple."
        }
      ],
