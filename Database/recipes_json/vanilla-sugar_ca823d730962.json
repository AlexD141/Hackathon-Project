  "recipes": [
    {
      "name": "Vanilla Sugar",
      "ingredients_raw": [
        "2 cups white sugar",
        "1 whole vanilla bean"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Pour the sugar into a clean, dry, airtight container. Split the vanilla bean lengthwise and open it. Use the tip of a knife to scrape out the seeds. Stir the vanilla seeds into the sugar, then bury the pod in the sugar. Seal the container and let stand at room temperature for at least 1 week to allow the vanilla flavor to develop."
        }
      ],
