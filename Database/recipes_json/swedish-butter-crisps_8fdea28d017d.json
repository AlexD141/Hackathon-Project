  "recipes": [
    {
      "name": "Swedish Butter Crisps",
      "ingredients_raw": [
        "1 cup butter",
        "0.75 cup white sugar",
        "1 egg yolk",
        "1 teaspoon vanilla extract",
        "2 cups all-purpose flour",
        "1 egg white, stiffly beaten",
        "0.25 cup brown sugar",
        "0.25 cup chopped pecans"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat an oven to 350 degrees F (175 degrees C). Grease a cookie sheet with cooking spray."
        },
        {
          "id": 2,
          "text": "Beat the butter and white sugar with an electric mixer in a bowl until smooth. Add the egg yolk and vanilla extract, then mix in the flour until just incorporated. Press the dough into the prepared cookie sheet, and spread with the beaten egg white. Sprinkle with brown sugar and pecans."
        },
        {
          "id": 3,
          "text": "Bake in the preheated oven until golden and set, about 30 minutes. Cool completely before cutting into squares."
        }
      ],
