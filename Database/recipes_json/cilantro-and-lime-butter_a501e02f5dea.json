  "recipes": [
    {
      "name": "Cilantro and Lime Butter",
      "ingredients_raw": [
        "1 cup unsalted butter",
        "0.25 cup chopped fresh cilantro",
        "1.5 tablespoons lime juice",
        "0.5 teaspoon crushed red pepper flakes",
        "salt to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a mixing bowl, cream butter. Mix in cilantro, lime juice, and red pepper flakes. Season with salt to taste. Cover, and chill for at least 1 hour."
        }
      ],
