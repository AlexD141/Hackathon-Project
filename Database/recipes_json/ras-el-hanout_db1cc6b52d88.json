      "name": "Ras el Hanout",
      "ingredients_raw": [
        "1 teaspoon salt",
        "1 teaspoon ground cumin",
        "1 teaspoon ground ginger",
        "1 teaspoon ground turmeric",
        "0.75 teaspoon ground cinnamon",
        "0.75 teaspoon freshly ground black pepper",
        "0.5 teaspoon ground white pepper",
        "0.5 teaspoon ground coriander seed",
        "0.5 teaspoon ground cayenne pepper",
        "0.5 teaspoon ground allspice",
        "0.5 teaspoon ground nutmeg",
        "0.25 teaspoon ground cloves"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Mix salt, cumin, ginger, turmeric, cinnamon, black pepper, white pepper, coriander, cayenne, allspice, nutmeg, and cloves in a small bowl until evenly blended. Store in an airtight container for up to 1 month."
        }
      ],
