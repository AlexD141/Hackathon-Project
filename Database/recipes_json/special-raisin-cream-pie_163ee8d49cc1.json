  "recipes": [
    {
      "name": "Special Raisin Cream Pie",
      "ingredients_raw": [
        "2 cups raisins",
        "1 cup white sugar",
        "0.5 teaspoon ground cinnamon",
        "0.25 teaspoon ground cloves",
        "1 cup sour cream",
        "2 eggs",
        "1 tablespoon butter",
        "1 (8 ounce) package cream cheese, softened",
        "0.5 cup confectioners' sugar",
        "4 cups frozen whipped topping, thawed",
        "1 (9 inch) pie shell, baked"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine raisins, white sugar, spices, sour cream, eggs, and butter or margarine in saucepan. Bring mixture to a boil, and reduce heat. Cook until thick, stirring constantly. Set aside to cool."
        },
        {
          "id": 2,
          "text": "Blend cream cheese and confectioners&#39; sugar together. Fold in 2 cups whipped topping."
        },
        {
          "id": 3,
          "text": "Spread half of cream cheese mixture on bottom of baked and cooled pie shell. Cover with cooled raisin mixture, and top with remaining cream cheese mixture. Spread additional whipped topping on top of pie. Refrigerate."
        }
      ],
