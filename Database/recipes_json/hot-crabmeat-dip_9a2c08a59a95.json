  "recipes": [
    {
      "name": "Hot Crabmeat Dip",
      "ingredients_raw": [
        "1 (8 ounce) package cream cheese, softened",
        "1 tablespoon milk",
        "2 tablespoons minced onion",
        "1 teaspoon prepared horseradish",
        "0.25 teaspoon salt",
        "1 pinch ground black pepper",
        "1 (6 ounce) can crabmeat, drained and flaked",
        "0.33300000429153 cup sliced almonds"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 300 degrees F (150 degrees C)."
        },
        {
          "id": 2,
          "text": "In a medium bowl, mix the cream cheese, milk, onion, horseradish, salt, pepper and crabmeat. Spread the mixture into a pie pan or shallow baking dish. Sprinkle almonds over the crabmeat mixture"
        },
        {
          "id": 3,
          "text": "Bake in the preheated oven 45 minutes, or until bubbly and lightly browned."
        }
      ],
