  "recipes": [
    {
      "name": "Quick and Easy Jambalaya",
      "ingredients_raw": [
        "1 tablespoon butter or margarine",
        "1 (14 ounce) package Hillshire Farm® Smoked Sausage",
        "1 onion, chopped",
        "1 red bell pepper, seeded, chopped",
        "1 green bell pepper, seeded, chopped",
        "2 cloves garlic, minced",
        "1 (28 ounce) can crushed tomatoes",
        "0.5 teaspoon hot pepper sauce",
        "0.5 teaspoon ground black pepper",
        "0.25 teaspoon crushed red pepper flakes",
        "1 pinch Salt to taste",
        "0.5 pound large raw shrimp, peeled, deveined",
        "6 cups hot cooked long grain white rice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Melt butter in a 5- to 6-quart pan over medium-high heat. Add sausage, onion, bell peppers, and garlic; cook, stirring occasionally, until vegetables are soft and sausage is lightly browned, about 5 minutes."
        },
        {
          "id": 2,
          "text": "Stir in tomatoes, hot pepper sauce, black pepper, red pepper flakes, and salt; bring to a boil. Add shrimp and cook until bright pink on the outside and the meat is opaque, about 3 minutes."
        },
        {
          "id": 3,
          "text": "Gently stir in hot rice and cook until heated through, 3 to 5 minutes."
        }
      ],
