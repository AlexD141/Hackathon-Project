  "recipes": [
    {
      "name": "Family Day Scones",
      "ingredients_raw": [
        "1.5 cups all-purpose flour",
        "1 cup whole wheat flour",
        "1 tablespoon baking powder",
        "0.5 teaspoon salt",
        "0.5 cup cold butter, cut into chunks",
        "0.33333334326744 cup brown sugar",
        "0.66666668653488 cup sour cream",
        "1 teaspoon vanilla extract",
        "0.25 cup half-and-half cream"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat an oven to 425 degrees F (220 degrees C). Lightly grease a baking sheet."
        },
        {
          "id": 2,
          "text": "Whisk together the all-purpose flour, whole wheat flour, baking powder, and salt. in a mixing bowl. Cut in the butter with a knife or pastry cutter until the mixture resembles coarse crumbs. Stir in the brown sugar."
        },
        {
          "id": 3,
          "text": "Whisk together the sour cream, light cream, and vanilla extract in a small bowl, then stir into the flour mixture until just moistened. Turn the dough out onto a lightly floured surface and knead briefly, for five or six turns. Pat or roll the dough out into a 1/2 inch thick round. Cut into 8 wedge-shaped pieces, and place onto the prepared baking sheet."
        },
        {
          "id": 4,
          "text": "Bake in the preheated oven until golden brown, 18 to 20 minutes."
        }
      ],
