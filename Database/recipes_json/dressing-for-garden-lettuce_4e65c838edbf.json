  "recipes": [
    {
      "name": "Dressing for Garden Lettuce",
      "ingredients_raw": [
        "1 (5 ounce) can evaporated milk",
        "0.25 cup cider vinegar",
        "4.5 teaspoons white sugar",
        "0.5 teaspoon salt",
        "0.125 teaspoon ground black pepper"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Whisk evaporated milk, vinegar, sugar, salt, and black pepper together in a bowl until sugar dissolves. Chill dressing until ready to use."
        }
      ],
