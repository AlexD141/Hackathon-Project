      "name": "Honey Syrup",
      "ingredients_raw": [
        "1.5 cups honey",
        "0.5 cup water",
        "0.25 cup fresh lemon juice",
        "0.5 teaspoon grated lemon zest"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine honey, water, lemon juice, and zest in a small saucepan. Cook over medium heat, stirring occasionally, until boiling. Continue to boil until mixture thickens and is reduced by a fourth."
        }
      ],
