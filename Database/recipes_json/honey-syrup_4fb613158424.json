            "author": {
              "@type": "Person",
              "name": "coconutheather"
            },
            "reviewBody": "Wonderful alternative to sugary store bought syrup. Love the citrus flavor! And..you don't need a whole lot to get the sweetness you vwant!",
            "datePublished": "2012-08-08T18:44:12.467Z"
          },
          {
            "@type": "Review",
            "reviewRating": {
