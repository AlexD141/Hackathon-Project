            "author": {
              "@type": "Person",
              "name": "Jennifer Lebow"
            },
            "reviewBody": "This was DELISH! Used this on Belgian waffles and it was awesome. Kids loved it. You need very little to get the flavor because it is strong.",
            "datePublished": "2013-05-26T09:23:54.780Z"
          },
          {
            "@type": "Review",
            "reviewRating": {
              "@type": "Rating",
