  "recipes": [
    {
      "name": "Tricia&#39;s Fantastic Fudge Pie",
      "ingredients_raw": [
        "1 cup white sugar",
        "0.5 cup butter, melted and slightly cooled",
        "2 large eggs, beaten",
        "1 teaspoon vanilla extract",
        "0.25 cup all-purpose flour",
        "0.25 cup unsweetened cocoa powder",
        "1 cup semi-sweet chocolate chips",
        "1 (9 inch) pie shell"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 325 degrees F (165 degrees C)."
        },
        {
          "id": 2,
          "text": "Stir sugar, melted butter, eggs, and vanilla together in a bowl."
        },
        {
          "id": 3,
          "text": "Mix flour and cocoa powder together in a separate bowl. Pour in wet ingredients and stir until thoroughly combined. Fold in chocolate chips. Pour batter into pie shell."
        },
        {
          "id": 4,
          "text": "Bake in the preheated oven for 30 to 40 minutes. Serve hot."
        }
      ],
