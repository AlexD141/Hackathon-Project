  "recipes": [
    {
      "name": "Ace&#39;s BBQ Sauce for Grilling",
      "ingredients_raw": [
        "1.5 cups distilled white vinegar",
        "0.75 cup prepared yellow mustard",
        "0.25 cup margarine",
        "2 teaspoons salt",
        "1 teaspoon ground black pepper",
        "2 teaspoons crushed red pepper flakes",
        "1 clove garlic, minced",
        "1 tablespoon white sugar"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Stir the vinegar, mustard, margarine, salt, black pepper, red pepper flakes, garlic, and sugar together in a saucepan over medium-high heat until the mixture comes to a boil. Reduce heat to medium-low and simmer until thickened, about 25 minutes."
        }
      ],
