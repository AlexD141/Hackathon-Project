      "name": "Light and Fluffy Peanut Butter Pie",
      "ingredients_raw": [
        "1 (9 inch) prepared graham cracker crust",
        "1 (16 ounce) jar reduced fat peanut butter",
        "1 cup confectioners' sugar",
        "1 (8 ounce) package cream cheese, softened"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a medium mixing bowl, combine peanut butter, confectioners&#39; sugar, and cream cheese. Whip until smooth and fluffy. Spoon mixture into graham cracker crust and chill 2 hours before serving."
        }
