  "recipes": [
    {
      "name": "Deep-Fried Oreos",
      "ingredients_raw": [
        "2 quarts vegetable oil for frying",
        "1 cup milk",
        "1 large egg",
        "2 teaspoons vegetable oil",
        "1 cup pancake mix",
        "1 (18 ounce) package cream-filled chocolate sandwich cookies (such as Oreo®)"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients. Heat oil in a deep fryer or large saucepan to 375 degrees F (190 degrees C)."
        },
        {
          "id": 2,
          "text": "Whisk milk, egg, and 2 teaspoons of vegetable oil in a large bowl until smooth."
        },
        {
          "id": 3,
          "text": "Stir in the pancake mix until no dry lumps remain."
        },
        {
          "id": 4,
          "text": "Dip cookies into batter, one at a time, and carefully place into hot oil."
        },
        {
          "id": 5,
          "text": "Fry in batches, 4 or 5 at a time, until cookies are golden brown, about 2 minutes."
        },
        {
          "id": 6,
          "text": "Drain on a paper towel-lined plate before serving. Enjoy!"
        }
      ],
