  "recipes": [
    {
      "name": "Easy Barbeque Beef Tenderloin Steak",
      "ingredients_raw": [
        "2 (2 inch thick) steaks beef tenderloin",
        "1 tablespoon olive oil",
        "2 cloves crushed garlic",
        "1 teaspoon meat tenderizer"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Rub meat with olive oil and crushed garlic. Sprinkle with tenderizer. Cover, and refrigerate for 30 minutes."
        },
        {
          "id": 2,
          "text": "Preheat grill for medium high heat."
        },
        {
          "id": 3,
          "text": "Brush grate with oil, and place steaks on the grill. Cook for 5 to 7 minutes per side, or until done."
        }
      ],
