  "recipes": [
    {
      "name": "Molasses Snowballs",
      "ingredients_raw": [
        "1 cup shortening",
        "0.25 cup molasses",
        "1 teaspoon vanilla extract",
        "2 cups all-purpose flour",
        "2 cups chopped walnuts",
        "0.5 cup confectioners' sugar"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 325 degrees F (165 degrees C)."
        },
        {
          "id": 2,
          "text": "In a medium bowl, cream the shortening, molasses and vanilla until smooth. Stir in the flour and walnuts. Roll dough into 1 inch balls and place them about 2 inches apart on an unprepared cookie sheet."
        },
        {
          "id": 3,
          "text": "Bake for 20 minutes in the preheated oven. Roll cookies in confectioners&#39; sugar when cool."
        }
      ],
