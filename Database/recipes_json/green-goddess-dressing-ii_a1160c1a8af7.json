            },
            "author": {
              "@type": "Person",
              "name": "Susieque"
            },
            "reviewBody": "I added an equal amount of lite mayo to thicken it up.",
            "datePublished": "2016-06-23T23:52:15.927Z"
          },
          {
            "@type": "Review",
            "reviewRating": {
