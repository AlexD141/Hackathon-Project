    {
      "name": "Nuoc Cham (Vietnamese Dipping Sauce)",
      "ingredients_raw": [
        "0.25 cup white sugar",
        "0.5 cup warm water",
        "0.25 cup fish sauce",
        "0.33333334326744 cup distilled white vinegar",
        "0.5 lemon, juiced",
        "3 cloves garlic, minced",
        "3 Thai chile peppers, chopped",
        "1 green onion, thinly sliced"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Stir the sugar and warm water together in a bowl until the sugar dissolves completely; add the fish sauce, vinegar, lemon juice, garlic, Thai chile peppers, and green onion to the mixture."
        }
      ],
