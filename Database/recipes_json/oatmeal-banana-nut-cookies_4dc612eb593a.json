  "recipes": [
    {
      "name": "Oatmeal Banana Nut Cookies",
      "ingredients_raw": [
        "1 cup butter",
        "1 cup white sugar",
        "1 cup packed brown sugar",
        "2 eggs",
        "1 teaspoon banana extract",
        "1.5 cups all-purpose flour",
        "1 teaspoon baking soda",
        "0.5 teaspoon salt",
        "3 cups rolled oats",
        "2 cups chopped pecans"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 375 degrees F (190 degrees C)."
        },
        {
          "id": 2,
          "text": "Cream butter or margarine with mixer. Blend in whole eggs, sugar, and extract. Add flour, baking soda, and salt. When the ingredients are thoroughly mixed, add oats and pecans. Mix on lower speed until consistent."
        },
        {
          "id": 3,
          "text": "Drop pieces of the dough using an ice cream scoop onto an ungreased cookie tray roughly 3 to 4 inches apart."
        },
        {
          "id": 4,
          "text": "Bake 8 to 10 minutes. Eight minutes would yield crispy cookies with a chewy, slightly doughy center. For harder, crispier cookies, bake longer. Cool on wire rack."
        }
      ],
