  "recipes": [
    {
      "name": "Fruit Pizza Trifles To Go",
      "ingredients_raw": [
        "4 (8 ounce) packages reduced-fat cream cheese, softened",
        "2 cups brown sugar",
        "4 teaspoons vanilla extract",
        "1 fresh pineapple - peeled, cored and chopped",
        "1 pound fresh strawberries, coarsely chopped",
        "1 pound seedless grapes, halved",
        "1 pint blueberries",
        "25 clear, plastic (10 ounce) cups",
        "12 sugar cookies, crushed",
        "2 kiwis, peeled and sliced"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine cream cheese, sugar, and vanilla extract in a bowl until smooth. Refrigerate until cold, about 30 minutes."
        },
        {
          "id": 2,
          "text": "Gently stir pineapple, strawberries, grapes, and blueberries together in a separate bowl."
        },
        {
          "id": 3,
          "text": "Place ½-inch layer cream cheese mixture in bottom of each plastic cup; top with ⅓ cup mixed fruit and 1 to 2 teaspoons cookie crumbs. Garnish each trifle with sliced kiwi. Refrigerate trifles until ready to serve."
        }
      ],
