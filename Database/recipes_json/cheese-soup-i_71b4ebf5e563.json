    {
      "name": "Easy Vegetable Cheese Soup ",
      "ingredients_raw": [
        "1 cup chopped celery",
        "0.5 cup chopped onion",
        "2 cups cubed potatoes",
        "1 (16 ounce) package frozen mixed vegetables",
        "4 cubes chicken bouillon",
        "2.5 cups water",
        "1 pound processed cheese food (eg. Velveeta), cubed",
        "2.5 cups milk",
        "2 tablespoons margarine"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a large pot boil the chopped celery, chopped onion, potatoes, mixed vegetables, bouillon cubes and water until all the vegetables are tender."
        },
        {
          "id": 2,
          "text": "Add the Velveeta® milk and butter or margarine. Heat until hot and serve."
        }
      ],
