  "recipes": [
    {
      "name": "Corn Dip",
      "ingredients_raw": [
        "3 (11 ounce) cans Mexican-style corn",
        "10 ounces shredded Cheddar cheese",
        "1 (8 ounce) container sour cream",
        "0.75 cup mayonnaise",
        "1 (4 ounce) can diced green chiles, drained",
        "5 green onions, chopped",
        "1 jalapeno pepper, chopped"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather the ingredients."
        },
        {
          "id": 2,
          "text": "Combine Mexican-style corn, Cheddar cheese, sour cream, mayonnaise, green chiles, green onions, and jalapeño in a medium bowl; mix well."
        },
        {
          "id": 3,
          "text": "Cover and refrigerate until chilled before serving, at least 1 hour."
        }
      ],
