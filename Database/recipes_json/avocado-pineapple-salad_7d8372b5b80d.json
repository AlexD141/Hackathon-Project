      "name": "Avocado Pineapple Salad",
      "ingredients_raw": [
        "1.5 cups cucumbers - peeled, seeded, and cubed",
        "0.5 cup chopped red onion",
        "2 tablespoons chopped serrano pepper",
        "2 tablespoons lime juice",
        "0.75 teaspoon salt",
        "2.5 cups pineapple, peeled and cut into 1/2-inch dice",
        "2 avocado - peeled, pitted and diced"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine cucumbers, onion, serrano pepper, lime juice, and salt in a large bowl. Add pineapple and avocado; gently toss to combine."
        }
