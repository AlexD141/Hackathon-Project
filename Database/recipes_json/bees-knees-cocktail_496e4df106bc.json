      "name": "Bee&#39;s Knees Cocktail",
      "ingredients_raw": [
        "2 fluid ounces gin",
        "0.5 fluid ounce lemon juice",
        "0.75 fluid ounce honey syrup",
        "1 cup ice cubes"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine gin, lemon juice, and honey syrup in a cocktail shaker. Add ice, cover and shake until chilled. Strain into a chilled coupe glass."
