    {
      "name": "Avocado Ranch Salad Dressing",
      "ingredients_raw": [
        "0.25 cup ripe avocado",
        "0.25 cup mayonnaise",
        "0.25 cup sour cream",
        "1 tablespoon buttermilk",
        "1.5 teaspoons distilled white vinegar",
        "0.125 teaspoon salt",
        "0.125 teaspoon dried parsley",
        "1 pinch dried dill weed",
        "0.125 teaspoon onion powder",
        "1 pinch garlic powder"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Mash avocado in a bowl, then stir in mayonnaise, sour cream, buttermilk, and vinegar. Sprinkle with salt, parsley, dill, onion powder, and garlic powder. Stir until well blended, chill until ready to serve."
        }
      ],
