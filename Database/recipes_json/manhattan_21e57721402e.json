  "recipes": [
    {
      "name": "Manhattan",
      "ingredients_raw": [
        "2 fluid ounces bourbon",
        "0.5 fluid ounce sweet vermouth",
        "1 maraschino cherry",
        "0.5 cup ice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place ice into a shaker."
        },
        {
          "id": 2,
          "text": "Pour bourbon and vermouth over ice; shake well."
        },
        {
          "id": 3,
          "text": "Pour into a cocktail glass and garnish with a cherry."
        }
      ],
