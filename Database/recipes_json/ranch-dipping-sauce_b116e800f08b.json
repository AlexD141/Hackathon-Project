      "name": "Ranch Dipping Sauce",
      "ingredients_raw": [
        "0.75 cup plain yogurt",
        "0.33300000429153 cup mayonnaise",
        "1 (1 ounce) package ranch dressing mix",
        "1 tablespoon chopped fresh parsley"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a medium-size mixing bowl, blend yogurt, mayonnaise, and ranch dressing mix. Mix well with a wire whisk. Cover and refrigerate overnight. Sprinkle with parsley before serving."
        }
