  "recipes": [
    {
      "name": "Date-Marshmallow Waldorf Salad",
      "ingredients_raw": [
        "2 cups peeled, diced tart apples",
        "1 tablespoon white sugar",
        "1 teaspoon lemon juice",
        "1 pinch salt",
        "0.5 cup chopped celery",
        "0.5 cup chopped pitted dates",
        "0.5 cup chopped walnuts",
        "0.25 cup mayonnaise",
        "0.5 cup heavy cream",
        "0.25 cup miniature marshmallows"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place the apples in a medium serving bowl and sprinkle with sugar, lemon juice and salt. Stir in the celery, dates and walnuts. In a separate bowl, whip the cream with an electric mixer until it can hold a peak. Mix in mayonnaise and gently fold into the apple mixture along with the marshmallows. Refrigerate for at least 1 hour before serving."
        }
      ],
