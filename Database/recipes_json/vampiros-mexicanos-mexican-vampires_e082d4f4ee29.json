      "name": "Vampiros Mexicanos (Mexican Vampires)",
      "ingredients_raw": [
        "ice cubes, or as needed",
        "3 ounces sangrita (Mexican-style bloody mary mix with orange and lime)",
        "1.5 fluid ounces silver tequila (100% agave)",
        "1.5 ounces citrus-flavored soda (such as Squirt®)",
        "0.5 lime, juiced",
        "1 pinch Mexican-style chili powder with lime (such as Tajin® fruit seasoning)"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Fill a highball glass with ice cubes."
        },
        {
          "id": 3,
          "text": "Pour in sangrita, tequila, citrus soda, lime juice, and chili-lime seasoning. Stir to mix well."
        }
      ],
