      "name": "Americano Cocktail",
      "ingredients_raw": [
        "2 cups ice",
        "1.5 fluid ounces bitter orange aperitif (such as Campari®)",
        "1.5 fluid ounces sweet vermouth",
        "3 ounces club soda, or as needed",
        "1 (1 inch) piece orange peel"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Add ice to a tall glass. Pour in Campari and vermouth. Stir and top with soda water. Squeeze a twist of orange peel over the drink and drop it in."
        }
      ],
