      "name": "Three Bean Salad with Corn",
      "ingredients_raw": [
        "1 (15 ounce) can kidney beans, drained",
        "1 (15 ounce) can wax beans, drained",
        "1 (15 ounce) can cut green beans, drained",
        "1 (15 ounce) can garbanzo beans, drained",
        "1 (15.25 ounce) can whole kernel corn, drained",
        "1 (4.5 ounce) can sliced mushrooms, drained",
        "1 onion, chopped",
        "1 green bell pepper, cubed",
        "0.5 cup cider vinegar",
        "0.5 cup white sugar",
        "0.25 cup vegetable oil",
        "0.5 teaspoon ground black pepper",
        "0.25 teaspoon salt",
        "0.25 teaspoon dried basil",
        "0.25 teaspoon dried oregano",
        "0.25 cup white sugar, or more to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Mix kidney beans, wax beans, green beans, garbanzo beans, corn, mushrooms, onion, green bell pepper, cider vinegar, 1/2 cup sugar, vegetable oil, black pepper, salt, basil, and oregano in a large bowl."
        },
        {
          "id": 2,
          "text": "Chill in refrigerator for 8 hours or overnight."
        },
        {
          "id": 3,
          "text": "Stir 1/4 cup sugar into the bean salad. Taste and add more if needed to balance vinegar flavor."
        }
      ],
