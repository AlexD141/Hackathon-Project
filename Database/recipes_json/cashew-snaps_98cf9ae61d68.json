            "reviewRating": {
              "@type": "Rating",
              "ratingValue": "5"
            },
            "author": {
              "@type": "Person",
              "name": "Kate"
            },
            "reviewBody": "Lovely, crispy texture and deep taste. In my oven 8-9 minutes was enough and it made 5 dozen.",
