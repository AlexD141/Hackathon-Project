  "recipes": [
    {
      "name": "Cashew Snaps",
      "ingredients_raw": [
        "0.5 cup butter",
        "1.25 cups packed brown sugar",
        "1 egg",
        "0.5 cup chopped cashews",
        "0.25 teaspoon baking soda",
        "0.125 teaspoon salt",
        "1.25 cups all-purpose flour"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease cookie sheet."
        },
        {
          "id": 2,
          "text": "In a large bowl, cream together the butter, brown sugar, and egg. Stir in the chopped cashews, baking soda, salt, and flour. Drop by half teaspoon two inches apart onto greased cookie sheet."
        },
        {
          "id": 3,
          "text": "Bake at 350 degrees F (175 degrees C) for 12 to 15 minutes."
        }
      ],
