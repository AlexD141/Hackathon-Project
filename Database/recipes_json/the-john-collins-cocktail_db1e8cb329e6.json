  "recipes": [
    {
      "name": "The John Collins Cocktail",
      "ingredients_raw": [
        "2 fluid ounces bourbon whiskey",
        "1 fluid ounce lemon juice",
        "1 teaspoon simple syrup",
        "2 cups ice, divided",
        "2 fluid ounces club soda",
        "1 orange slice",
        "1 lemon slice",
        "1 maraschino cherry"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine bourbon, lemon juice, and simple syrup in a cocktail shaker. Add 1 cup ice, cover, and shake until chilled. Strain into a Collins glass. Add 1 cup ice, fill with club soda, and stir."
        },
        {
          "id": 2,
          "text": "Garnish with orange and lemon slices and a maraschino cherry."
        }
      ],
