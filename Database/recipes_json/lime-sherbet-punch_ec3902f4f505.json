  "recipes": [
    {
      "name": "Lime Sherbet Punch",
      "ingredients_raw": [
        "2 quarts lime sherbet",
        "2 (2 liter) bottles ginger ale",
        "1 (46 fluid ounce) can pineapple juice",
        "1 (4 ounce) jar maraschino cherries, drained",
        "1 lemon, sliced",
        "1 lime, sliced"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Scoop lime sherbet into a punch bowl."
        },
        {
          "id": 3,
          "text": "Pour in ginger ale and pineapple juice."
        },
        {
          "id": 4,
          "text": "Stir well."
        },
        {
          "id": 5,
          "text": "Stir in maraschino cherries and float lemon and lime slices in the punch."
        }
      ],
