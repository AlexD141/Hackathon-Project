  "recipes": [
    {
      "name": "Apricot Oat Bread",
      "ingredients_raw": [
        "4.25 cups bread flour",
        "0.66666668653488 cup rolled oats",
        "1 tablespoon white sugar",
        "2 teaspoons active dry yeast",
        "1.5 teaspoons salt",
        "1 teaspoon ground cinnamon",
        "2 tablespoons butter, cut up",
        "1.6666666269302 cups orange juice",
        "0.5 cup diced dried apricots",
        "2 tablespoons honey, warmed"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place bread ingredients in the pan of the bread machine in the order recommended by the manufacturer; add the dried apricots just before the knead cycle ends."
        },
        {
          "id": 2,
          "text": "Remove the bread promptly from the machine when it&#39;s finished, and glaze with the warmed honey. Allow to cool completely before serving."
        }
      ],
