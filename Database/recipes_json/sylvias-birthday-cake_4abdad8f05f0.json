  "recipes": [
    {
      "name": "Sylvia&#39;s Birthday Cake",
      "ingredients_raw": [
        "3 cups high protein wheat flour",
        "0.5 cup white sugar",
        "2 teaspoons baking powder",
        "1 teaspoon baking soda",
        "0.5 teaspoon salt",
        "4 eggs",
        "0.5 teaspoon vanilla extract",
        "0.75 cup vegetable oil",
        "2 cups water"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 10 inch round cake pan."
        },
        {
          "id": 2,
          "text": "In a large bowl, combine flour, sugar, baking powder, soda and salt. Make a well in the center and add eggs, vanilla, oil and water. Mix until smooth. Pour batter into 10 inch round cake pan."
        },
        {
          "id": 3,
          "text": "Bake in preheated oven for 25 to 35 minutes, or until a toothpick inserted into cake comes out clean. Allow to cool before frosting."
        }
      ],
