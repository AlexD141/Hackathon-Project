  "recipes": [
    {
      "name": "Marinade for Steak II",
      "ingredients_raw": [
        "0.5 cup molasses",
        "0.5 cup ketchup",
        "1 tablespoon ground ginger",
        "1 teaspoon chopped fresh thyme",
        "1 tablespoon ground black pepper",
        "1 tablespoon distilled white vinegar",
        "1 dash hot pepper sauce, or to taste",
        "1 tablespoon garlic powder"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a medium bowl, mix molasses, ketchup, ground ginger, thyme, black pepper, distilled white vinegar, hot pepper sauce and garlic powder. Place desired meat in mixture. Marinate in the refrigerator 3 hours or longer before grilling."
        }
      ],
