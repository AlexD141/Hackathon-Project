  "recipes": [
    {
      "name": "Easy Lemony-Dilly Cucumber Salad",
      "ingredients_raw": [
        "1 lemon, zested and juiced",
        "2 tablespoons dried dill weed",
        "1 teaspoon white sugar",
        "0.25 cup mayonnaise",
        "2 large English cucumbers, peeled and diced"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Whisk lemon zest, lemon juice, dill, and sugar together in a bowl until sugar dissolved; stir in mayonnaise until smooth. Stir in cucumber. Let stand before serving, 10 minutes."
        }
      ],
