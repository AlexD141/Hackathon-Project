  "recipes": [
    {
      "name": "Dill Sauce",
      "ingredients_raw": [
        "0.5 cup sour cream",
        "1.5 tablespoons Dijon-style prepared mustard",
        "1 tablespoon lemon juice",
        "2 teaspoons chopped fresh dill"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Whisk together sour cream, mustard, lemon juice, and dill until well blended. Chill before serving."
        }
      ],
