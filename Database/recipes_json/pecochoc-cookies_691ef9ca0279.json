  "recipes": [
    {
      "name": "Pecochoc Cookies",
      "ingredients_raw": [
        "0.5 teaspoon baking soda",
        "0.5 teaspoon baking powder",
        "0.5 teaspoon salt",
        "1.75 cups all-purpose flour",
        "1.5 teaspoons instant coffee granules",
        "0.5 cup butter, softened",
        "1 cup packed brown sugar",
        "3 tablespoons white sugar",
        "2 eggs",
        "2 tablespoons milk",
        "2 teaspoons vanilla extract",
        "0.5 cup chopped pecans",
        "1.5 cups semisweet chocolate chips"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 375 degrees F (190 degrees C)."
        },
        {
          "id": 2,
          "text": "Combine baking soda, baking powder, salt, flour and instant coffee in a mixing bowl."
        },
        {
          "id": 3,
          "text": "Cream the butter with the brown and white sugar until fluffy. Beat in eggs, milk and vanilla extract. Gradually add flour mixture to the butter mixture and beat well. Stir in the chopped pecans and chocolate chips; mix well to blend. Drop cookies by tablespoon onto an ungreased cookie sheet."
        },
        {
          "id": 4,
          "text": "Bake for 15 minutes or until cookies are golden in color."
        }
      ],
