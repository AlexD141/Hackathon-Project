      "name": "Budget Jungle Juice for a Crowd",
      "ingredients_raw": [
        "2 gallons orange-flavored drink",
        "4 quarts pink lemonade",
        "4 quarts pineapple and orange juice blend",
        "4 (750 milliliter) bottles vodka",
        "2 (750 milliliter) bottles white rum",
        "2 (46 fluid ounce) cans fruit punch"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather the ingredients."
        },
        {
          "id": 2,
          "text": "Pour orange drink, pink lemonade, pineapple-orange juice blend, vodka, rum, and fruit punch into a large punch bowl or container; stir well."
        },
        {
          "id": 3,
          "text": "Serve and enjoy!"
        }
      ],
