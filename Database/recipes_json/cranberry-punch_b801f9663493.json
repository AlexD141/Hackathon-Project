      "name": "Cranberry Punch",
      "ingredients_raw": [
        "1.5 liters cranberry-apple juice",
        "1 liter ginger ale",
        "2 limes, thinly sliced",
        "6 sprigs fresh mint",
        "6 cups ice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Half-fill 6 tall glasses with ice. Fill to about three quarters with cranberry-apple juice. Pour ginger ale evenly into the glasses. Stir gently. Decorate with lime and mint sprigs."
        }
