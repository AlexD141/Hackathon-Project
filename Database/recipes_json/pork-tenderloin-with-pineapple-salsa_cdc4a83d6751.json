  "recipes": [
    {
      "name": "Pork Tenderloin with Pineapple Salsa",
      "ingredients_raw": [
        "2 (1 pound) pork tenderloins",
        "3 tablespoons brown sugar",
        "3 tablespoons Dijon mustard",
        "0.75 teaspoon minced fresh ginger root",
        "2 cups chopped fresh pineapple",
        "0.33333334326744 cup chopped red bell pepper",
        "1 small jalapeno pepper, seeded and chopped",
        "2 green onions, chopped",
        "1 tablespoon minced fresh cilantro",
        "1 tablespoon brown sugar"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 425 degrees F (220 degrees C). Line a shallow roasting pan with aluminum foil."
        },
        {
          "id": 2,
          "text": "Place pork in roasting pan. Combine 3 tablespoons brown sugar, mustard, and ginger in bowl; spread over pork."
        },
        {
          "id": 3,
          "text": "Bake in preheated oven until juices run clear and a meat thermometer reads 160 degrees F (71 degrees C), about 35 to 40 minutes. Let stand 10 minutes before slicing."
        },
        {
          "id": 4,
          "text": "Combine pineapple, peppers, green onions, cilantro, and 1 tablespoon brown sugar in a bowl. Serve with pork."
        }
      ],
