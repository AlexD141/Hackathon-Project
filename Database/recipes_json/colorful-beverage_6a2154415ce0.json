      "name": "Colorful Beverage",
      "ingredients_raw": [
        "1 (64 fluid ounce) bottle orange juice",
        "1 (64 fluid ounce) bottle cranberry juice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Pour the orange juice into ice cube trays and freeze them. Chill the cranberry juice in the refrigerator."
        },
        {
          "id": 2,
          "text": "When the orange juice cubes are frozen, Place them in a large pitcher and pour in the cranberry juice."
        }
