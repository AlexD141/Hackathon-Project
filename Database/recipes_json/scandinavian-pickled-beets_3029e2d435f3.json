  "recipes": [
    {
      "name": "Scandinavian Pickled Beets",
      "ingredients_raw": [
        "0.5 cup vinegar",
        "0.5 cup water",
        "0.5 cup sugar",
        "salt and pepper to taste",
        "1 (15 ounce) can sliced canned beets, drained"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine the vinegar, water, sugar, salt, and pepper in a saucepan; bring to a boil and cook until sugar dissolves."
        },
        {
          "id": 2,
          "text": "Arrange the beets in a glass or ceramic bowl; pour the hot vinegar mixture over the beets. Cover and refrigerate for 12 hours. Drain and serve."
        }
      ],
