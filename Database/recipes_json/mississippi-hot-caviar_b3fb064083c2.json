      "name": "Mississippi Hot Caviar",
      "ingredients_raw": [
        "3 (15 ounce) cans black-eyed peas",
        "1 cup diced green chili peppers",
        "0.75 cup diced onion",
        "0.75 cup diced jalapeno chile pepper",
        "0.25 cup diced pimento peppers, drained",
        "1.5 teaspoons minced garlic",
        "1 (16 ounce) bottle Italian-style salad dressing"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a mixing bowl, combine the black-eyed peas, green chili pepper, onion, jalapeno pepper, pimento, garlic and Italian-style dressing. Chill the mixture overnight."
        }
      ],
