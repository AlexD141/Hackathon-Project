  "recipes": [
    {
      "name": "Cauliflower and Egg Salad",
      "ingredients_raw": [
        "4 cups cauliflower, broken into small florets",
        "3 hard-boiled eggs, diced",
        "0.5 small carrot, peeled and shaved into strips using a vegetable peeler",
        "3 small green onions, chopped",
        "5 tablespoons sweet pickle relish",
        "5 tablespoons light mayonnaise",
        "1 tablespoon mustard",
        "salt and ground black pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Bring a large pot of lightly salted water to a boil. Cook cauliflower in boiling water until tender, about 10 minutes; drain."
        },
        {
          "id": 2,
          "text": "Mix together cauliflower, eggs, carrot, green onions, relish, mayonnaise, and mustard in a large bowl until well combined. Season with salt and black pepper."
        }
      ],
