      "name": "Derby BLT Dip",
      "ingredients_raw": [
        "1 cup sour cream",
        "1 cup creamy salad dressing (such as Miracle Whip®)",
        "1 cup shredded Cheddar cheese",
        "1 cup seeded and chopped Roma tomatoes",
        "1 (3 ounce) jar real bacon bits",
        "1 tablespoon chopped green onion"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine sour cream, creamy salad dressing, cheese, tomatoes, and bacon in a bowl; refrigerate. Top with green onion just before serving."
        }
      ],
