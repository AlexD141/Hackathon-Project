  "recipes": [
    {
      "name": "Quick Tartar Sauce",
      "ingredients_raw": [
        "1 cup mayonnaise",
        "2 teaspoons sweet pickle relish",
        "1 teaspoon prepared yellow mustard",
        "1 teaspoon lemon juice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Add mayonnaise, relish, mustard (if using), and lemon juice together in a bowl."
        },
        {
          "id": 3,
          "text": "Stir until thoroughly combined."
        },
        {
          "id": 4,
          "text": "Serve immediately or refrigerate the sauce until ready to serve."
        }
      ],
