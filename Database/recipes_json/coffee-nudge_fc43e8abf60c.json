  "recipes": [
    {
      "name": "Coffee Nudge",
      "ingredients_raw": [
        "8 fluid ounces coffee flavored liqueur",
        "8 fluid ounces brandy",
        "4 fluid ounces creme de cacao",
        "8 cups hot brewed coffee",
        "2 cups whipped cream, garnish",
        "2 tablespoons chocolate sprinkles"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Pour 1 ounce coffee liqueur, 1 ounce brandy, and 1/2 ounce crème de cacao into each of 8 mugs or glass coffee cups."
        },
        {
          "id": 2,
          "text": "Fill each mug with hot coffee. Garnish with a dollop of whipped cream and chocolate sprinkles; serve."
        }
      ],
