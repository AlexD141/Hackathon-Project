  "recipes": [
    {
      "name": "Melitzanosalata Agioritiki (Athenian Eggplant Salad)",
      "ingredients_raw": [
        "1 large eggplant, washed",
        "1 small onion, diced",
        "1 tomato, seeded and chopped",
        "0.5 cup crumbled feta cheese",
        "2 tablespoons chopped fresh parsley",
        "2 tablespoons extra-virgin olive oil",
        "2 tablespoons distilled white vinegar",
        "salt to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate."
        },
        {
          "id": 2,
          "text": "Pierce eggplant a few times with the tip of a paring knife or fork."
        },
        {
          "id": 3,
          "text": "Cook on the preheated grill, turning often, until skin is charred and eggplant is tender, about 15 minutes. Set aside until cool enough to handle. Remove and discard skin from eggplant; dice pulp."
        },
        {
          "id": 4,
          "text": "Combine eggplant pulp, onion, tomato, feta, parsley, olive oil, and vinegar in a bowl; mix well. Refrigerate for 1 hour. Season with salt before serving."
        }
      ],
