  "recipes": [
    {
      "name": "Easy Orange Glaze Duck",
      "ingredients_raw": [
        "1 (12 fluid ounce) can or bottle orange soda",
        "1 (6 ounce) can frozen orange juice concentrate, thawed",
        "0.5 (18 ounce) bottle honey barbecue sauce",
        "0.25 cup brown sugar",
        "0.33333334326744 cup bottled teriyaki sauce",
        "1 (5 pound) whole frozen duckling, thawed",
        "1 (4.5 ounce) can sliced mushrooms, drained"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Pour the orange soda, orange juice concentrate, barbecue sauce, brown sugar, and teriyaki sauce into a bowl, and stir to combine and dissolve the sugar."
        },
        {
          "id": 2,
          "text": "Preheat oven to 350 degrees F (175 degrees C). Remove any excess pieces of fat from inside the duckling, place the duck into a roasting pan, and prick the skin all over with a fork to allow the fat to drain off while roasting."
        },
        {
          "id": 3,
          "text": "Brush the duckling with the orange mixture. Place the mushrooms into the cavity of the duck, and spoon in some of the orange sauce."
        },
        {
          "id": 4,
          "text": "Roast the duck in the preheated oven, brushing it every 20 to 30 minutes with the orange sauce, until a meat thermometer inserted into a thick part of a thigh reads 165 degrees F (75 degrees C), about 2 1/2 hours."
        }
      ],
