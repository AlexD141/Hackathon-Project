    {
      "name": "Thai-Style Peanut Sauce with Honey",
      "ingredients_raw": [
        "0.25 cup honey",
        "0.25 cup smooth peanut butter",
        "1 tablespoon crunchy peanut butter",
        "3 tablespoons soy sauce",
        "2 tablespoons rice vinegar",
        "2 tablespoons extra-virgin olive oil",
        "1 tablespoon sesame oil",
        "2 teaspoons minced fresh garlic",
        "1 tablespoon minced fresh ginger root",
        "1 teaspoon crushed red pepper flakes"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Stir together the honey, peanut butters, soy sauce, rice vinegar, olive oil, sesame oil, garlic, ginger, and red pepper flakes in a small bowl."
        }
      ],
