  "recipes": [
    {
      "name": "Southern Fried Catfish",
      "ingredients_raw": [
        "0.5 cup buttermilk",
        "0.5 cup water",
        "salt and pepper, to taste",
        "1 pound catfish fillets, cut in strips",
        "1.5 cups fine cornmeal",
        "0.5 cup all-purpose flour",
        "1 teaspoon seafood seasoning, such as Old Bay™",
        "1 quart vegetable oil for deep frying",
        "1 quart vegetable oil for deep frying"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Mix buttermilk, water, salt, and pepper in a small bowl. Pour mixture into a flat pan large enough to hold fillets."
        },
        {
          "id": 3,
          "text": "Arrange fillets in a single layer in the pan, turning to coat each side. Set aside to marinate while you prepare the coating mix."
        },
        {
          "id": 4,
          "text": "Combine cornmeal, flour, and seafood seasoning in a 2-gallon resealable plastic bag."
        },
        {
          "id": 5,
          "text": "Add fillets to the bag, a few at a time, and tumble gently until evenly coated. Transfer breaded fillets to a plate."
        },
        {
          "id": 6,
          "text": "Heat oil in a deep fryer to 365 degrees F (185 degrees C). Working in batches to avoid overcrowding, fry fillets a few at a time in hot oil until crisp and golden brown, about 3 minutes. Make sure oil temperature is right before starting a new batch."
        },
        {
          "id": 7,
          "text": "Drain on paper towels."
        },
        {
          "id": 8,
          "text": "Serve hot with lemon wedges and enjoy!"
        }
      ],
