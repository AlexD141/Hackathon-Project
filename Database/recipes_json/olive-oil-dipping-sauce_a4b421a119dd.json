    {
      "name": "Olive Oil Dipping Sauce",
      "ingredients_raw": [
        "1 cup extra-virgin olive oil",
        "2 cloves garlic, minced",
        "0.25 teaspoon dried oregano",
        "1 pinch salt, or to taste",
        "1 pinch dried rosemary, or to taste",
        "1 pinch dried basil, or to taste",
        "ground black pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine the olive oil, garlic, oregano, salt, rosemary, basil, and pepper in a skillet over medium heat; cook until the garlic begins to sizzle, about 5 minutes. Remove immediately from heat."
        }
      ],
