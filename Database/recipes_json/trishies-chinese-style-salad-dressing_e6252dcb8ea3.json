      "name": "Trishie&#39;s Chinese-Style Salad Dressing",
      "ingredients_raw": [
        "0.5 cup red wine vinegar",
        "11 tablespoons extra-virgin olive oil",
        "1 tablespoon hoisin sauce",
        "1 tablespoon honey",
        "0.25 teaspoon minced garlic",
        "salt and ground black pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Whisk the red wine vinegar, olive oil, hoisin sauce, honey, garlic, salt, and pepper together in a bowl. Store in refrigerator. Shake well before use."
        }
