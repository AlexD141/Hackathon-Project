    {
      "name": "Gimlet Cocktail",
      "ingredients_raw": [
        "1.5 fluid ounces gin",
        "1 fluid ounce lime juice",
        "1 teaspoon simple syrup",
        "1 cup ice",
        "1 lime wheel"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine gin, lime juice, and simple syrup in a cocktail shaker. Add ice and shake until chilled. Strain into a chilled cocktail glass."
        },
        {
          "id": 2,
          "text": "Garnish with a lime wheel."
        }
      ],
