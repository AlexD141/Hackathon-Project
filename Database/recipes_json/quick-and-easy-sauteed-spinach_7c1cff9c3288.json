  "recipes": [
    {
      "name": "Quick and Easy Sautéed Spinach",
      "ingredients_raw": [
        "1 tablespoon extra-virgin olive oil",
        "1 (10 ounce) bag spinach leaves",
        "1.5 teaspoons garlic salt",
        "0.25 cup grated Parmesan cheese"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Heat olive oil in a large skillet over medium heat; add spinach leaves, cover, and cook for 3 minutes. Stir in garlic salt; cover and cook until leaves are wilted and bright green, 1 or 2 minutes more."
        },
        {
          "id": 3,
          "text": "Remove from heat and sprinkle with Parmesan cheese."
        }
      ],
