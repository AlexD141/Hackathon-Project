  "recipes": [
    {
      "name": "Easy Shredded Pork",
      "ingredients_raw": [
        "3 tablespoons paprika",
        "1 tablespoon garlic powder",
        "1 tablespoon brown sugar",
        "1 tablespoon dry mustard",
        "3 tablespoons kosher salt",
        "2 (7 pound) pork shoulder roasts",
        "4 (20 ounce) bottles barbeque sauce"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Mix paprika, garlic powder, brown sugar, dry mustard, and kosher salt together in a small bowl; spread evenly over the pork roasts. Refrigerate the seasoned roasts at least 3 hours."
        },
        {
          "id": 2,
          "text": "Preheat the oven to 300 degrees F (150 degrees C). Place pork roasts into a large roasting pan."
        },
        {
          "id": 3,
          "text": "Bake the roasts in the preheated oven until pork is tender and shreds easily with two forks, 4 to 6 hours."
        },
        {
          "id": 4,
          "text": "Shred the pork and place into a large pot over medium heat. Mix the meat with barbeque sauce. Bring the mixture to a simmer and cook until the flavors have blended, about 30 minutes."
        }
      ],
