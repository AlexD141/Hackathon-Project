  "recipes": [
    {
      "name": "Blueberry Granita",
      "ingredients_raw": [
        "2.5 cups blueberries",
        "0.5 cup white sugar",
        "0.75 cup water",
        "1 tablespoon fresh lemon juice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place blueberries and sugar in the bowl of a food processor; pulse until smooth. Strain mixture through a fine-mesh strainer, pressing with a wooden spoon to separate blueberry purée from seeds. Discard seeds."
        },
        {
          "id": 2,
          "text": "Stir blueberry purée, water, and lemon juice together in a shallow baking dish. Freeze, scraping and stirring granita with a fork every hour until evenly frozen and icy, about 4 hours."
        },
        {
          "id": 3,
          "text": "Scrape granita to fluff and lighten ice crystals; spoon into chilled glasses to serve."
        }
      ],
