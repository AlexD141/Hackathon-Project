  "recipes": [
    {
      "name": "Southwestern Summer Salad",
      "ingredients_raw": [
        "4 large tomatoes, sliced",
        "1 tablespoon lime juice",
        "2 tablespoons extra virgin olive oil",
        "0.25 teaspoon ground cumin",
        "0.25 teaspoon fennel seed",
        "1 dried red chile pepper",
        "2 tablespoons chopped fresh cilantro",
        "salt and pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Arrange tomato slices on a platter; sprinkle with lime juice."
        },
        {
          "id": 2,
          "text": "Warm oil in a small pan over moderate heat. Add cumin, fennel and chili pepper; cook for 30 seconds. Remove from heat, discard pod and cool."
        },
        {
          "id": 3,
          "text": "Spoon seasoned oil over tomatoes, sprinkle with cilantro, salt and pepper."
        }
      ],
