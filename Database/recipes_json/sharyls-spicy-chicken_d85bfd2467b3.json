  "recipes": [
    {
      "name": "Sharyl&#39;s Spicy Chicken",
      "ingredients_raw": [
        "1 teaspoon salt",
        "1 teaspoon black pepper",
        "1 teaspoon hot Hungarian paprika",
        "0.5 teaspoon ground cumin",
        "0.5 teaspoon ground cinnamon",
        "0.5 teaspoon brown sugar",
        "4 skinless, boneless chicken breast halves",
        "1 tablespoon vegetable oil",
        "0.5 cup orange juice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine the salt, pepper, hot paprika, cumin, cinnamon, and brown sugar in a small bowl. Sprinkle the spices on the chicken using all of the spice mixture."
        },
        {
          "id": 2,
          "text": "Heat oil in a large skillet over medium-high heat. Cook the chicken in the hot oil for 4 minutes. Turn the chicken, and lower heat to medium-low. Pour in the orange juice; simmer until chicken is cooked through, about 7 minutes. Serve the chicken with a bit of the pan sauce spooned over the each piece."
        }
      ],
