    {
      "name": "Italian Cream Soda",
      "ingredients_raw": [
        "8 fluid ounces carbonated water",
        "0.75 fluid ounce passion fruit flavored syrup",
        "0.75 fluid ounce watermelon flavored syrup",
        "1 fluid ounce half-and-half cream"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Fill a tall glass half full with ice. Fill to 2/3 with carbonated water. Pour in watermelon and passion fruit flavored syrups, then float the half-and-half cream on top. Stir when ready to drink."
        }
      ],
