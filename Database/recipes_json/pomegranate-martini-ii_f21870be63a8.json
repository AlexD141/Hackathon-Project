  "recipes": [
    {
      "name": "Pomegranate Martini II",
      "ingredients_raw": [
        "4 fluid ounces pomegranate juice",
        "2 fluid ounces cranberry juice cocktail",
        "2 fluid ounces raspberry vodka",
        "2 fluid ounces orange-flavored liqueur",
        "1 fluid ounce grenadine syrup",
        "1 cup crushed ice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine pomegranate juice, cranberry juice, raspberry vodka, orange-flavored liqueur, grenadine syrup, and crushed ice in a shaker. Shake vigorously to chill. Pour into martini glasses, and serve."
        }
      ],
