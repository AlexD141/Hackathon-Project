            "author": {
              "@type": "Person",
              "name": "Maryann Terpstra"
            },
            "reviewBody": "Very simple. Appreciated the addition of a bay leaf. I added chopped parsley and chopped toasted almonds. No leftovers to put away after dinner!",
            "datePublished": "2023-02-20T05:55:37.834Z"
          },
          {
            "@type": "Review",
            "reviewRating": {
              "@type": "Rating",
