  "recipes": [
    {
      "name": "Singapore Sling Cocktail",
      "ingredients_raw": [
        "2 cups ice, divided",
        "4 fluid ounces pineapple juice",
        "1.5 fluid ounces gin",
        "0.5 fluid ounce cherry-flavored brandy",
        "0.5 fluid ounce lime juice",
        "0.5 fluid ounce grenadine syrup",
        "0.25 fluid ounce triple sec",
        "0.25 fluid ounce Benedictine® liqueur",
        "1 slice fresh pineapple",
        "1 maraschino cherry"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Fill a Collins glass with 1 cup ice and place in the freezer."
        },
        {
          "id": 2,
          "text": "Combine pineapple juice, gin, cherry-flavored brandy, lime juice, grenadine, triple sec, and Bénédictine in a cocktail shaker. Add 1 cup ice, cover, and shake until chilled. Strain into the prepared Collins glass."
        },
        {
          "id": 3,
          "text": "Garnish with pineapple slice and cherry."
        }
      ],
