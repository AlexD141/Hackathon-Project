  "recipes": [
    {
      "name": "Shrimp Toast",
      "ingredients_raw": [
        "0.5 pound medium shrimp, peeled and deveined",
        "1 slice fresh ginger root, chopped",
        "1 clove garlic, chopped",
        "0.5 cup water chestnuts, drained and chopped",
        "1 teaspoon salt",
        "1 teaspoon ground black pepper",
        "2 tablespoons dry sherry",
        "1 egg white",
        "1 teaspoon baking soda",
        "3 slices white bread, crusts trimmed",
        "3 tablespoons sesame seeds",
        "3 cups oil for deep frying"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a medium skillet, heat the 3 cups of oil to 300 degrees F (150 degrees C)."
        },
        {
          "id": 2,
          "text": "In a food processor, combine the shrimp, ginger, garlic and water chestnuts; grind to a paste. Add salt, pepper, sherry, egg white and baking soda. Process until smooth."
        },
        {
          "id": 3,
          "text": "Cut each slice of trimmed bread into quarters, forming 4 triangles each. Divide the shrimp mixture over each piece of bread; sprinkle with sesame seeds."
        },
        {
          "id": 4,
          "text": "Deep fry shrimp toast until golden brown. Drain on paper towels."
        }
      ],
