  "recipes": [
    {
      "name": "Nutty Irishman",
      "ingredients_raw": [
        "2 cups hot, strong coffee",
        "2 fluid ounces Irish cream liqueur, divided",
        "2 fluid ounces hazelnut liqueur (such as Frangelico®), divided",
        "2 fluid ounces Irish whiskey, divided",
        "0.25 cup whipped cream",
        "2 pinches ground nutmeg"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Divide coffee between two mugs."
        },
        {
          "id": 2,
          "text": "Stir 1 ounce Irish cream liqueur, 1 ounce hazelnut liqueur, and 1 ounce Irish whiskey into each mug."
        },
        {
          "id": 3,
          "text": "Place a dollop of whipped cream in each mug. Sprinkle cream with nutmeg."
        }
      ],
