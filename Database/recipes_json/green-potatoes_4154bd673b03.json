    {
      "name": "Green Potatoes",
      "ingredients_raw": [
        "5 pounds potatoes, peeled and halved",
        "3 cloves garlic, crushed",
        "0.25 cup chopped parsley",
        "salt and pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a large pot combine potatoes, garlic, parsley, salt and pepper. Pour in enough water to just cover potatoes. Cover and cook on medium heat for 1 hour, stirring occasionally. Let stand 10 minutes."
        }
      ],
