  "recipes": [
    {
      "name": "Baked Hot Dog Sandwiches",
      "ingredients_raw": [
        "8 hot dogs, chopped",
        "0.66666668653488 cup shredded Cheddar cheese",
        "3 tablespoons pickle relish",
        "3 tablespoons ketchup",
        "2 teaspoons prepared mustard",
        "3 tablespoons chopped onion",
        "8 hot dog buns"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients. Preheat the oven to 325 degrees F (165 degrees C)."
        },
        {
          "id": 2,
          "text": "Stir hot dogs, Cheddar cheese, relish, ketchup, mustard, and onion together in a bowl."
        },
        {
          "id": 3,
          "text": "Spoon into hot dog buns. Wrap each sandwich in aluminum foil."
        },
        {
          "id": 4,
          "text": "Bake in the preheated oven until hot, about 20 minutes. Serve immediately."
        }
      ],
