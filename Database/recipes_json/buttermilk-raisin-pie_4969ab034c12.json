  "recipes": [
    {
      "name": "Buttermilk Raisin Pie",
      "ingredients_raw": [
        "1 recipe pastry for a 9 inch double crust pie",
        "1 egg, beaten",
        "1 cup raisins",
        "1 cup white sugar",
        "1 cup buttermilk",
        "1 pinch salt"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 450 degrees F (225 degrees C)."
        },
        {
          "id": 2,
          "text": "In a medium bowl, combine egg, raisins, sugar, buttermilk, and salt. Mix thoroughly. Pour mixture into pastry-lined 8 inch pie pan. Cover with second pastry circle. Seal edges and cut steam vents in top."
        },
        {
          "id": 3,
          "text": "Bake in preheated oven for 15 minutes. Reduce heat to 350 degrees F (175 degrees C) and bake an additional 35 to 40 minutes. Serve warm or cold."
        }
      ],
