  "recipes": [
    {
      "name": "Pineapple Rhubarb Pie",
      "ingredients_raw": [
        "1 (15 ounce) package refrigerated pie crusts",
        "1.3333333730698 cups white sugar",
        "0.33333334326744 cup all-purpose flour",
        "0.5 teaspoon grated orange zest",
        "0.125 teaspoon salt",
        "3 cups chopped rhubarb",
        "1 cup drained crushed pineapple",
        "2 tablespoons butter"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 425 degrees F (220 degrees C)."
        },
        {
          "id": 2,
          "text": "Press 1 crust into bottom and up sides of a 9-inch pie plate. Refrigerate remaining crust until needed."
        },
        {
          "id": 3,
          "text": "Stir sugar, flour, orange zest, and salt together in a large bowl until well combined. Combine rhubarb and pineapple in a medium bowl; stir into flour mixture until evenly blended."
        },
        {
          "id": 4,
          "text": "Pour rhubarb mixture into the prepared pie crust; dot with butter. Place remaining 1 crust on top; crimp the edges to seal in filling. Cut a few slits in top crust to vent steam."
        },
        {
          "id": 5,
          "text": "Bake in the preheated oven until crust is golden brown and rhubarb is tender when pierced with a fork, 45 to 50 minutes."
        }
      ],
