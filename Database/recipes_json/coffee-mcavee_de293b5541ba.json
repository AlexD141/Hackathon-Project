  "recipes": [
    {
      "name": "Coffee McAvee",
      "ingredients_raw": [
        "11 (1.5 fluid ounce) jiggers coffee flavored liqueur",
        "0.25 cup white sugar",
        "10 (1.5 fluid ounce) jiggers 151 proof rum",
        "5 cups vanilla ice cream",
        "5 cups hot, brewed coffee"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Pour 2 jiggers of coffee flavored liqueur into a saucer. Spread sugar out on a separate saucer. Dip each glass into the liqueur and then into the sugar to coat the rim."
        },
        {
          "id": 2,
          "text": "Pour 1 jigger of rum into each glass. Light the rum on fire using a long match and allow it to burn the sugar around the rim of the glass until it has turned to caramel, about 1 minute."
        },
        {
          "id": 3,
          "text": "Extinguish the fire in each glass with a 1/2 cup sized scoop of ice cream. Pour 1 jigger of coffee liqueur over the ice cream, and top off the glass with hot coffee."
        }
      ],
