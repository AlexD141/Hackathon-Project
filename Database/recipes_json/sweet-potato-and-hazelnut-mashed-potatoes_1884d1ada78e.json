  "recipes": [
    {
      "name": "Sweet Potato and Hazelnut Mashed Potatoes",
      "ingredients_raw": [
        "2 pounds sweet potatoes, peeled and cubed",
        "0.25 cup toasted, ground hazelnuts",
        "0.5 cup heavy cream",
        "0.25 cup sour cream",
        "0.25 cup apple cider",
        "salt and pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place the sweet potatoes into a large pot and cover with salted water. Bring to a boil over high heat, then reduce heat to medium-low, cover, and simmer until tender, about 20 minutes. Drain and allow to steam dry for a minute or two."
        },
        {
          "id": 2,
          "text": "Mash the potatoes until smooth, then stir in the hazelnuts, heavy cream, sour cream, and apple cider. Season to taste with salt and pepper."
        }
      ],
