  "recipes": [
    {
      "name": "Swiss Cheese Soup",
      "ingredients_raw": [
        "6 cups chicken stock",
        "10 cloves garlic, crushed",
        "4 tablespoons unsalted butter",
        "4 tablespoons all-purpose flour",
        "0.5 cup white wine",
        "2.5 cups shredded Swiss cheese"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place the stock in a large pot over high heat. Bring to a boil, stir in the garlic and reduce heat to low."
        },
        {
          "id": 2,
          "text": "In separate skillet over medium heat, combine the butter and flour and stir well for a few minutes. Add the garlic and stock mixture along with the wine, stirring constantly. Bring to a boil to thicken."
        },
        {
          "id": 3,
          "text": "Stir in the cheese and serve immediately. (Do NOT allow to boil once cheese has been added, and do not allow to sit long or the cheese will separate out.)"
        }
      ],
      "warnings": [],
