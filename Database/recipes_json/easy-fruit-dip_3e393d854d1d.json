  "recipes": [
    {
      "name": "Easy Fruit Dip",
      "ingredients_raw": [
        "16 ounces marshmallow creme",
        "1 (8 ounce) package cream cheese, softened",
        "1 tablespoon maraschino cherry juice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place marshmallow creme and cream cheese in a microwave-safe bowl. Place in microwave and cook on medium-high in 20 seconds increments until softened."
        },
        {
          "id": 2,
          "text": "Stir cherry juice into marshmallow-cream cheese mixture. Cover and refrigerate until chilled."
        }
      ],
