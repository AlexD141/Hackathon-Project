  "recipes": [
    {
      "name": "Fried Pumpkin",
      "ingredients_raw": [
        "1 small sugar pumpkin",
        "salt and pepper to taste",
        "0.5 cup all-purpose flour",
        "0.25 cup butter"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Cut pumpkin in half, remove seeds, pith and outer skin. Cut into 2x3 inch pieces."
        },
        {
          "id": 2,
          "text": "Place 1/2 of pumpkin (2 to 3 pounds) in large bowl and season with salt and pepper. Add flour and stir to evenly coat."
        },
        {
          "id": 3,
          "text": "Melt butter in a large deep skillet over medium heat. Add pumpkin and cook, turning often until golden brown and tender."
        }
      ],
