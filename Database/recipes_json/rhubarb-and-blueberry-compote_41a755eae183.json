  "recipes": [
    {
      "name": "Rhubarb and Blueberry Compote",
      "ingredients_raw": [
        "10 stalks rhubarb, peeled and chopped",
        "1 cup white sugar",
        "1 cup frozen blueberries",
        "1 teaspoon vanilla extract",
        "1 cinnamon stick",
        "water to cover"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine rhubarb, sugar, blueberries, vanilla extract, and cinnamon stick in a pot; add enough water to barely cover mixture. Simmer, stirring occasionally, until rhubarb is soft and broken down, 30 to 40 minutes. Discard cinnamon stick."
        },
        {
          "id": 2,
          "text": "Cool compote in the refrigerator until thickened, about 30 minutes."
        }
      ],
