  "recipes": [
    {
      "name": "Hot Wings",
      "ingredients_raw": [
        "4 pounds chicken wings",
        "1 teaspoon garlic powder",
        "0.5 teaspoon ground black pepper",
        "1 cup tomato-based hot pepper sauce",
        "2 tablespoons vinegar-based hot pepper sauce",
        "1 teaspoon garlic powder",
        "0.25 cup grated Parmesan cheese",
        "3 tablespoons butter, melted"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat an outdoor or indoor grill to a high heat. Lightly grease the grill."
        },
        {
          "id": 2,
          "text": "Season wings with garlic powder and ground black pepper. Cook wings on the preheated grill until they are very crispy. Turn the wings frequently as they will burn easily."
        },
        {
          "id": 3,
          "text": "While the wings are grilling, in a large bowl, combine both hot sauces with garlic powder, Parmesan cheese and melted butter."
        },
        {
          "id": 4,
          "text": "When the wings are finished cooking, place them in the large bowl of hot sauce mixture and stir until they are coated."
        }
      ],
