      "name": "Georgia Sunset",
      "ingredients_raw": [
        "1 cup ice cubes, or as needed",
        "1 (1.5 fluid ounce) jigger brandy",
        "1 (1.5 fluid ounce) jigger peach schnapps",
        "1 fluid ounce grenadine syrup",
        "0.25 cup chilled lemon-lime soda"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Fill a cocktail shaker with ice; add brandy, peach schnapps, and grenadine. Cover and shake until the outside of the shaker has frosted. Strain into a glass."
        }
      ],
