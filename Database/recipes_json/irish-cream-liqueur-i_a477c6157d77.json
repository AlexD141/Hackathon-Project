  "recipes": [
    {
      "name": "Irish Cream Liqueur I",
      "ingredients_raw": [
        "1 (14 ounce) can sweetened condensed milk",
        "0.25 cup liquid non-dairy creamer",
        "3 eggs",
        "1 drop vanilla extract",
        "1.5 tablespoons chocolate syrup",
        "1 cup whiskey"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Pour all ingredients into a blender and blend on high until mixed. Pour into a sealable container and store in the refrigerator. Serve in shot glasses."
        }
      ],
