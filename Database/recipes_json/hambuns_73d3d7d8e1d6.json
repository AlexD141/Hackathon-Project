  "recipes": [
    {
      "name": "Hambuns",
      "ingredients_raw": [
        "6 cups diced cooked ham",
        "1 (2 pound) loaf processed cheese, cubed",
        "4 hard-cooked eggs, chopped",
        "1 cup mayonnaise",
        "1 (2 ounce) can chopped black olives",
        "1 green onion, chopped",
        "salt and pepper to taste",
        "16 hamburger buns"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Combine ham, cheese, eggs, mayonnaise, olives, green onion, salt, and black pepper in a large bowl; spoon onto buns. Wrap each bun separately in a piece of aluminum foil; place wrapped buns on a cookie sheet."
        },
        {
          "id": 3,
          "text": "Bake in the preheated oven until heated through, 15 minutes."
        }
      ],
