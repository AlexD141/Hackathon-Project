  "source_url": "https://www.allrecipes.com/recipe/12119/raisin-pie-i/",
  "extracted_at": "2026-10-18T01:48:26.055708+00:00",
  "recipes": [
    {
      "name": "Raisin Pie I",
      "ingredients_raw": [
        "0.75 cup white sugar",
        "1 tablespoon cornstarch",
        "0.25 teaspoon salt",
        "1 teaspoon ground cinnamon",
        "0.5 teaspoon ground nutmeg",
        "0.25 teaspoon ground cloves",
        "1 cup sour cream",
        "1 tablespoon lemon juice",
        "1 cup raisins",
        "2 egg yolks, beaten",
        "0.5 cup chopped walnuts",
        "1 prepared 8 inch pastry shell, baked and cooled",
        "2 egg whites",
        "0.25 teaspoon cream of tartar",
        "0.25 cup white sugar"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine 3/4 cup white sugar, cornstarch, salt, cinnamon, nutmeg, and cloves in a saucepan. Stir in sour cream and lemon juice. Add the raisins. Bring to a boil over medium heat, stirring constantly. Cook and stir until thick. Remove from heat."
        },
        {
          "id": 2,
          "text": "Stir a small amount of the hot mixture into the egg yolks, and then return this to the hot mixture. Cook and stir for one minute. Cool filling to lukewarm, and then add the nuts. Pour into the cooled pie shell."
        },
        {
          "id": 3,
          "text": "Beat egg whites with cream of tartar to soft peaks. Gradually add 1/4 cup sugar; beat until stiff peaks form, and all the sugar is dissolved. Spread meringue on pie, carefully sealing to the edges."
        },
        {
          "id": 4,
          "text": "Bake at 350 degrees F (175 degrees C) for 12 to 15 minutes."
        }
      ],
      "warnings": [],
