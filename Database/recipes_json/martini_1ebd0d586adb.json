      "name": "Martini",
      "ingredients_raw": [
        "2.5 fluid ounces gin",
        "0.5 fluid ounce dry vermouth",
        "1 pitted green olive",
        "1 cup ice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Scoop ice into a shaker. Pour in gin and vermouth. Cover shaker, and gently shake to mix vermouth and gin. Pour drink, without ice, into a cocktail glass. Gently drop olive or lemon twist into the glass. Serve."
        }
