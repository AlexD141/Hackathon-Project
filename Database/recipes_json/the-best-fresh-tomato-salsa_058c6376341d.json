  "recipes": [
    {
      "name": "The Best Fresh Tomato Salsa",
      "ingredients_raw": [
        "3 cups chopped tomatoes",
        "1 cup onion, diced",
        "0.5 cup chopped green bell pepper",
        "0.25 cup minced fresh cilantro",
        "2 tablespoons fresh lime juice",
        "4 teaspoons chopped fresh jalapeno pepper (including seeds)",
        "0.5 teaspoon ground cumin",
        "0.5 teaspoon kosher salt",
        "0.5 teaspoon ground black pepper"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Stir tomatoes, onion, green bell pepper, cilantro, lime juice, jalapeño pepper, cumin, salt, and pepper together in a bowl until just combined."
        },
        {
          "id": 3,
          "text": "Serve and enjoy!"
        }
      ],
