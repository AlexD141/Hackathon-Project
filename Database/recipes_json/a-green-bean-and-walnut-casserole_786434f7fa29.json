  "recipes": [
    {
      "name": "A&#43; Green Bean and Walnut Casserole",
      "ingredients_raw": [
        "2 tablespoons vegetable oil spread",
        "4 ounces mushrooms, minced",
        "1 cup chopped onion",
        "3 tablespoons flour",
        "1.5 cups chicken stock",
        "0.5 cup fat-free half and half",
        "0.75 teaspoon salt",
        "1 teaspoon Freshly ground pepper to taste",
        "1.5 pounds fresh green beans, trimmed",
        "0.66666668653488 cup crushed whole grain seasoned croutons",
        "0.66666668653488 cup chopped walnuts",
        "2 tablespoons vegetable or soy spread, melted",
        "0.5 cup minced onion"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Melt spread in a medium saucepan over medium heat. Add mushrooms and onion; cook, stirring frequently, for 10 minutes. Stir in flour; cook and stir for 5 minutes more. Slowly add stock and bring mixture to a boil; reduce heat and simmer for 10 minutes. Stir in half &amp; half and season with salt and pepper; set aside."
        },
        {
          "id": 2,
          "text": "Preheat oven to 350 degrees F. Cook beans in boiling water for 5 minutes. Drain well then add to mushroom sauce; toss to coat with mixture. Transfer to an 11 x 7-inch baking dish."
        },
        {
          "id": 3,
          "text": "Stir together all topping ingredients until well blended and sprinkle around the edge of the beans."
        },
        {
          "id": 4,
          "text": "Bake for 20 minutes or until golden brown on top."
        }
      ],
      "warnings": [],
