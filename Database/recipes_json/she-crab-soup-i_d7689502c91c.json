  "recipes": [
    {
      "name": "She Crab Soup I",
      "ingredients_raw": [
        "1 onion, chopped",
        "1.5 tablespoons margarine",
        "2 teaspoons all-purpose flour",
        "1.5 teaspoons margarine",
        "1 quart whole milk",
        "1 pound crabmeat, flaked",
        "4 ounces crab roe",
        "0.125 teaspoon ground white pepper",
        "0.125 teaspoon ground mace",
        "2 cups milk",
        "0.5 cup dry sherry"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Using a saute pan melt 1 1/2 tablespoons butter, over low heat, and saute onions."
        },
        {
          "id": 2,
          "text": "Using a double broiler melt 1 1/2 tablespoons of butter. Add flour and stir until well blended."
        },
        {
          "id": 3,
          "text": "Combine sauteed onions and flour mixture into a large stock pot. Add 1 quart whole milk and stir constantly until soup is well blended."
        },
        {
          "id": 4,
          "text": "Add the crab meat and roe and stir well; add pepper and mace and cook slowly for 20 minutes. Add 1 pint of milk and stir."
        },
        {
          "id": 5,
          "text": "Remove from heat and add wine."
        },
        {
          "id": 6,
          "text": "Serve in soup bowls which have been heated and garnish with sour cream, parsley sprigs or a sprinkle of paprika."
        }
      ],
      "warnings": [],
