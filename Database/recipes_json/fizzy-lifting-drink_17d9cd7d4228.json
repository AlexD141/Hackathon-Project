  "recipes": [
    {
      "name": "Fizzy Lifting Drink",
      "ingredients_raw": [
        "3 fluid ounces bubblegum-flavored vodka",
        "1 fluid ounce sweet and sour mix",
        "0.5 fluid ounce vanilla vodka",
        "0.5 fluid ounce strawberry vodka",
        "1 dash maraschino cherry juice",
        "2 fluid ounces dry champagne"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Pour the bubble gum vodka, sweet and sour mix, vanilla vodka, strawberry vodka, and maraschino cherry juice into a cocktail shaker over ice. Cover, and shake until the outside of the shaker has frosted. Strain into two chilled glass, and top with champagne to serve."
        }
      ],
