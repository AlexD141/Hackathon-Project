  "recipes": [
    {
      "name": "Bonbons",
      "ingredients_raw": [
        "1 cup margarine, softened",
        "2 pounds confectioners' sugar, sifted",
        "1 (14 ounce) can sweetened condensed milk",
        "3 cups coconut",
        "1 cup finely chopped walnuts",
        "1 teaspoon vanilla extract",
        "1 (12 ounce) package semisweet chocolate chips",
        "2 tablespoons shortening"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Mix butter, confectioners&#39; sugar, condensed milk, coconut, chopped walnuts, and vanilla in a large bowl until well combined. Cover and chill in the refrigerator until mixture has thickened enough to roll into balls, about 2 hours."
        },
        {
          "id": 3,
          "text": "Roll bonbon mixture into 1-inch balls and place close together, but not touching, on cookie sheets. Freeze until hard."
        },
        {
          "id": 4,
          "text": "While bonbons are freezing, line a cookie sheet or flat surface with waxed paper. Combine chocolate chips and shortening in the top of a double boiler, over simmering water; stir until melted."
        },
        {
          "id": 5,
          "text": "Dip each bonbon in the melted chocolate using a toothpick or a fork."
        },
        {
          "id": 6,
          "text": "Place on waxed paper to dry."
        }
      ],
