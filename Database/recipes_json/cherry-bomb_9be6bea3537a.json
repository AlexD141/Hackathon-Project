  "recipes": [
    {
      "name": "Cherry Bomb",
      "ingredients_raw": [
        "1 liter lime soda",
        "4 fluid ounces rum",
        "4 fluid ounces grenadine syrup",
        "1 lime, juiced",
        "1 lime, sliced",
        "4 maraschino cherries"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Stir together lime soda, rum, grenadine, and lime juice in a mixing glass."
        },
        {
          "id": 3,
          "text": "Pour into 4 chilled glasses."
        },
        {
          "id": 4,
          "text": "Garnish with lime slices and cherries."
        }
      ],
