  "recipes": [
    {
      "name": "The Best Spinach Salad Ever",
      "ingredients_raw": [
        "1 cup slivered almonds",
        "1 cup mayonnaise",
        "0.5 cup milk",
        "0.25 cup white sugar",
        "1 (3 ounce) jar bacon bits",
        "0.5 cup grated Parmesan cheese",
        "1 (10 ounce) bag baby spinach leaves",
        "0.5 head cauliflower, chopped"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Spread nuts onto a baking sheet."
        },
        {
          "id": 3,
          "text": "Toast nuts in the preheated oven until golden brown and fragrant, 5 to 10 minutes. Watch as they bake because they burn quickly. Set nuts aside to cool to room temperature."
        },
        {
          "id": 4,
          "text": "Mix together mayonnaise, milk, and sugar in a large salad bowl. Stir in bacon bits and Parmesan cheese until dressing is well combined and creamy."
        },
        {
          "id": 5,
          "text": "Place spinach leaves, chopped cauliflower, and toasted almonds into the salad bowl; stir lightly to coat with dressing."
        }
      ],
