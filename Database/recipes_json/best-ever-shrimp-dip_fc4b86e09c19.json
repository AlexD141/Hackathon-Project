      "ingredients_raw": [
        "1 (8 ounce) package cream cheese, softened",
        "1 cup mayonnaise",
        "0.25 cup chopped onion",
        "0.25 cup chopped celery",
        "0.5 pound cooked and peeled shrimp"
      ],
