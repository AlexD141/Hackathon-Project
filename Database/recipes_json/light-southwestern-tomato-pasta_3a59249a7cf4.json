  "recipes": [
    {
      "name": "Light Southwestern Tomato Pasta",
      "ingredients_raw": [
        "1 pound pasta",
        "4 large tomatoes, cubed",
        "1 teaspoon chopped fresh cilantro",
        "1 pinch dried basil",
        "2 teaspoons white sugar",
        "0.5 teaspoon dried oregano",
        "0.33000001311302 cup olive oil",
        "salt and pepper to taste",
        "2 tablespoons grated Parmesan cheese"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain."
        },
        {
          "id": 2,
          "text": "In a large bowl, combine tomatoes, cilantro, basil, sugar and oregano; mix well, then add olive oil and season with salt and pepper to taste. Mix well."
        },
        {
          "id": 3,
          "text": "Combine sauce with pasta and toss to coat. Top with cheese and serve."
        }
      ],
