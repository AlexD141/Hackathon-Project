  "recipes": [
    {
      "name": "Southwest-Style Meatloaf",
      "ingredients_raw": [
        "1.5 pounds ground beef",
        "2 eggs",
        "0.5 cup chopped onion",
        "0.5 cup Italian bread crumbs",
        "0.5 cup salsa",
        "0.25 cup ketchup",
        "0.25 cup barbeque sauce",
        "1 teaspoon salt",
        "1 teaspoon ground black pepper",
        "0.5 teaspoon celery salt"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Mix ground beef, eggs, onion, bread crumbs, salsa, ketchup, barbecue sauce, salt, pepper, and celery salt together in a bowl; transfer to a loaf pan."
        },
        {
          "id": 3,
          "text": "Bake in the preheated oven until golden brown on top, about 1 hour."
        }
      ],
