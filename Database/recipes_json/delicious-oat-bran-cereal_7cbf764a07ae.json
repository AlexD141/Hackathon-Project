  "recipes": [
    {
      "name": "Delicious Oat Bran Cereal",
      "ingredients_raw": [
        "1 cup water",
        "0.25 teaspoon ground cinnamon",
        "5 dried pitted prunes, chopped",
        "1 teaspoon sugar substitute (such as Splenda)",
        "0.25 cup oat bran"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine water, cinnamon, prunes, and sugar substitute in a small saucepan over medium heat; bring to a boil. Stir in oat bran and boil for 2 minutes."
        }
      ],
