  "recipes": [
    {
      "name": "Fruit BBQ Marinade",
      "ingredients_raw": [
        "1 tablespoon olive oil",
        "1 small onion, chopped",
        "0.5 red bell pepper",
        "0.25 cup brown sugar",
        "1 teaspoon garlic",
        "1 tablespoon dry mustard",
        "0.5 cup cider vinegar",
        "4 cups pineapple juice",
        "1 (16 ounce) jar pineapple fruit preserves"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Brown onions, and red peppers in olive oil. Add brown sugar, garlic, mustard, and cider vinegar. Cook for one minute on high or until bubbly. Add pineapple juice."
        },
        {
          "id": 2,
          "text": "Marinade meat of choice overnight or up to 24 hours."
        },
        {
          "id": 3,
          "text": "Cook on barbecue and baste frequently with the marinade. Near the end of the cooking, add preserves to top and allow to brown slightly."
        }
      ],
