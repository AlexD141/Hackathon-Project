  "recipes": [
    {
      "name": "Praline Cookies",
      "ingredients_raw": [
        "0.5 cup butter",
        "0.66666668653488 cup packed brown sugar",
        "1 egg",
        "1 teaspoon vanilla extract",
        "0.5 teaspoon maple flavored extract",
        "0.5 teaspoon baking soda",
        "0.25 teaspoon salt",
        "2 cups all-purpose flour",
        "1 cup pecan halves"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a large bowl, cream together butter and brown sugar. Beat in egg, vanilla and maple flavoring. Beat in salt and flour until a smooth dough is formed. Shape dough into a log 12 inches long, wrap in wax paper, and refrigerate overnight."
        },
        {
          "id": 2,
          "text": "Preheat oven to 350 degrees F (180 degrees C). Line cookie sheet with parchment paper."
        },
        {
          "id": 3,
          "text": "Slice dough into 1/4 inch slices. Place slices on cookie sheet. Top each cookie with a pecan half. Bake for 10 minutes in preheated oven, or until golden brown."
        }
      ],
