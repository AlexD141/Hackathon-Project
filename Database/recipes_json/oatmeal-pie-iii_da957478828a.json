    {
      "name": "Oatmeal Pie III",
      "ingredients_raw": [
        "4 eggs",
        "1 cup flaked coconut",
        "1.5 cups dark corn syrup",
        "1.5 cups white sugar",
        "0.5 cup margarine, melted",
        "1.75 cups rolled oats",
        "1.75 cups evaporated milk",
        "2 9-inch pie crusts"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Mix eggs, corn syrup, and sugar. Add milk, melted margarine, coconut, and oatmeal. Pour into two 9-inch pie shells."
        },
        {
          "id": 3,
          "text": "Bake in preheated oven until filling is browned and set, about 40 minutes."
        }
      ],
