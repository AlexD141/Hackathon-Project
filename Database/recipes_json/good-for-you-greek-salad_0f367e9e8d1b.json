  "recipes": [
    {
      "name": "Easy Greek Salad",
      "ingredients_raw": [
        "3 large ripe tomatoes, chopped",
        "2 medium cucumbers, peeled and chopped",
        "1 small red onion, chopped",
        "0.25 cup olive oil",
        "4 teaspoons lemon juice",
        "1.5 teaspoons dried oregano",
        "salt and pepper to taste",
        "1 cup crumbled feta cheese",
        "6 black Greek olives, pitted and sliced"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Toss tomatoes, cucumbers, and red onion together in a shallow salad bowl."
        },
        {
          "id": 3,
          "text": "Drizzle oil and lemon juice over top, then sprinkle with oregano, salt, and pepper."
        },
        {
          "id": 4,
          "text": "Top with feta and olives. Enjoy!"
        }
      ],
