      "name": "Favorite Mexicorn Chip Dip",
      "ingredients_raw": [
        "2 (11 ounce) cans Mexican-style corn with red and green peppers, drained",
        "1 (10 ounce) can diced tomatoes with green chile peppers (such as RO*TEL®)",
        "1 cup mayonnaise",
        "1 cup shredded Cheddar cheese"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine the corn, tomatoes, mayonnaise, and Cheddar cheese in a bowl until well blended. Cover and refrigerate until chilled."
        }
      ],
