  "recipes": [
    {
      "name": "Butter Fried Parsnips",
      "ingredients_raw": [
        "6 parsnips, peeled and quartered lengthwise",
        "0.25 cup all-purpose flour for coating",
        "0.5 teaspoon seasoning salt",
        "0.5 cup butter, melted"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a large saucepan cover parsnips with water, cover and boil over medium-high heat until tender, about 10 minutes. Drain."
        },
        {
          "id": 2,
          "text": "In a plastic bag combine flour and seasoning salt. Dip parsnips in butter and place them in the bag. Shake bag to coat parsnips with the seasoned flour."
        },
        {
          "id": 3,
          "text": "Heat the butter in a large skillet over medium-high heat. When the butter starts to sizzle, add parsnips. Cook, turning occasionally, until all sides are golden brown."
        }
      ],
