  "recipes": [
    {
      "name": "Orange Juice Tzimmes",
      "ingredients_raw": [
        "8 large carrots",
        "1 cup prunes",
        "2 cups orange juice",
        "0.33333334326744 cup white sugar",
        "4 tablespoons butter, melted",
        "1 teaspoon grated lemon zest",
        "0.5 teaspoon grated fresh ginger root"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place carrot and prunes in a pot. Cover the vegetables with orange juice. Bring the mixture to a boil, let boil 10 minutes."
        },
        {
          "id": 2,
          "text": "Stir in sugar and butter. Simmer gently for 1 hour or until the liquid is almost absorbed."
        },
        {
          "id": 3,
          "text": "Sprinkle with lemon zest and ginger and let simmer another 5 minutes."
        }
      ],
