  "recipes": [
    {
      "name": "Easy Tofu Salad with Tuna and Watercress",
      "ingredients_raw": [
        "3 cups bean sprouts",
        "1 (12 ounce) package soft tofu, drained and cut into 1/2-inch cubes",
        "2 (5 ounce) cans tuna, drained",
        "1 bunch watercress, chopped",
        "2 tomatoes, cubed",
        "0.25 cup Japanese pickled radish",
        "0.5 cup chopped onion",
        "4 cloves garlic, thinly sliced",
        "0.25 cup sesame oil",
        "0.5 cup soy sauce"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Layer the bean sprouts, tofu, tuna, watercress, tomatoes, and Japanese pickled radish in a 9x13-inch baking dish. Set aside. Place the onion in a bowl."
        },
        {
          "id": 2,
          "text": "Heat the garlic in the sesame oil in a skillet over medium heat until garlic is browned and fragrant, about 5 minutes. Remove garlic slices, then pour the hot oil over the onion. Stir in the soy sauce and pour dressing over the salad."
        }
      ],
