  "recipes": [
    {
      "name": "Quick and Easy Creamed Bacon Spinach",
      "ingredients_raw": [
        "2.6666667461395 tablespoons butter",
        "1.5 large white onions, finely chopped",
        "6 slices bacon, cut into 1 inch pieces",
        "2 cloves garlic, minced",
        "0.5 cup all-purpose flour",
        "1.5 teaspoons salt",
        "0.25 teaspoon ground black pepper",
        "2.5 cups milk",
        "3 (10 ounce) packages frozen chopped spinach - thawed, drained, and squeezed dry",
        "0.5 cup half-and-half"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Heat butter in a large skillet over medium heat. Cook and stir onion, bacon, and garlic until bacon is crisp, 5 to 7 minutes."
        },
        {
          "id": 2,
          "text": "Whisk flour, salt, and black pepper into onion mixture until blended and the flour and drippings form a paste, 1 to 2 minutes."
        },
        {
          "id": 3,
          "text": "Slowly whisk milk into onion mixture. Bring to a boil, continuously whisking, until sauce is thick and creamy, 3 to 5 minutes."
        },
        {
          "id": 4,
          "text": "Stir spinach and half-and-half into sauce; cook until spinach is heated through, 4 to 6 minutes."
        }
      ],
