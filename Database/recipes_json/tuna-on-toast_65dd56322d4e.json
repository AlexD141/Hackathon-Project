            "author": {
              "@type": "Person",
              "name": "tpf2005"
            },
            "reviewBody": "If you're prepared to consume Tuna on Toast, this is a great way to do it. Its cheap and easy.",
            "datePublished": "2011-02-18T14:35:26.807Z"
