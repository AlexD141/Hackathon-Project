    {
      "name": "Tuna on Toast",
      "ingredients_raw": [
        "1 (10.75 ounce) can condensed cream of mushroom soup",
        "2 hard-cooked eggs, sliced",
        "1 (5 ounce) can tuna, drained",
        "6 slices whole wheat bread"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Make cream of mushroom soup according to the directions on the can."
        },
        {
          "id": 2,
          "text": "Stir in canned tuna and egg slices. Heat thoroughly. Meanwhile, toast bread slices."
        },
        {
          "id": 3,
          "text": "Spoon tuna mixture over slices of whole wheat toast. Serve."
        }
      ],
