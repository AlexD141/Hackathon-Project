      "name": "Warm Mexican Corn Dip",
      "ingredients_raw": [
        "2 (8 ounce) packages cream cheese, softened",
        "1 cup butter, softened",
        "2 (15.25 ounce) cans white corn, drained",
        "2 (14 ounce) cans diced tomatoes with green chile peppers"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine the cream cheese, butter, corn, and tomatoes with green chile peppers in a slow cooker. Set the slow cooker to Low. Cook until the cream cheese and butter melt completely, about 1 hour."
