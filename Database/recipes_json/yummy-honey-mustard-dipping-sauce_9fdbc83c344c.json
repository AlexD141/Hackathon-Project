  "recipes": [
    {
      "name": "Yummy Honey Mustard Dipping Sauce",
      "ingredients_raw": [
        "0.5 cup mayonnaise",
        "2 tablespoons honey",
        "2 tablespoons prepared yellow mustard",
        "1 tablespoon Dijon mustard",
        "0.5 tablespoon lemon juice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Mix mayonnaise, honey, mustards, and lemon juice together in a bowl."
        },
        {
          "id": 3,
          "text": "For best flavor, cover and chill in the refrigerator overnight."
        },
        {
          "id": 4,
          "text": "Serve and enjoy!"
        }
      ],
