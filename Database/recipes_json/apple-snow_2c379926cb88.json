  "recipes": [
    {
      "name": "Apple Snow",
      "ingredients_raw": [
        "6 large apples - peeled, cored and chopped",
        "3 tablespoons water",
        "1 cup white sugar",
        "0.5 teaspoon ground cinnamon",
        "0.25 teaspoon ground cloves",
        "0.5 teaspoon vanilla extract",
        "1 egg white"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a large saucepan or Dutch oven, combine apples and water and cook, covered, over low heat, until frothy, 15 to 30 minutes. Remove from heat and stir in sugar, cinnamon, cloves and vanilla. Let cool."
        },
        {
          "id": 2,
          "text": "In a medium bowl, whip the egg white until stiff peaks form. Fold into the cooled apple mixture. Serve."
        }
      ],
