  "recipes": [
    {
      "name": "Island Yam Bake",
      "ingredients_raw": [
        "2.5 pounds yams, peeled and cubed",
        "1 cup pineapple and orange juice blend",
        "2 tablespoons softened butter",
        "0.5 cup (packed) dark brown sugar",
        "0.5 cup chopped macadamia nuts"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place yams into a large pot and cover with salted water. Bring to a boil, then reduce heat to medium-low, cover, and simmer until tender, about 20 minutes. Drain and allow to steam dry for a minute or two."
        },
        {
          "id": 2,
          "text": "Preheat oven to 325 degrees F (165 degrees C)."
        },
        {
          "id": 3,
          "text": "Return yams to the cooking pot, and mash with juice until smooth. Pack mashed yams into a 3 quart casserole dish, dot with butter, then sprinkle with brown sugar and nuts. Loosely cover with aluminum foil."
        },
        {
          "id": 4,
          "text": "Bake in preheated oven until hot and bubbly, 35 to 40 minutes."
        }
      ],
