  "recipes": [
    {
      "name": "Candied Ginger Carrots",
      "ingredients_raw": [
        "1 (12 ounce) package baby carrots",
        "1 cup water",
        "3 tablespoons butter",
        "2 tablespoons brown sugar",
        "1.5 teaspoons ground ginger",
        "0.25 teaspoon salt"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Bring carrots and water to a boil in a saucepan. Reduce heat to low; simmer until carrots are tender, about 10 minutes. Drain carrots."
        },
        {
          "id": 2,
          "text": "Stir in butter until coated, then stir in brown sugar, ginger, and salt. Return to a boil; cook, stirring often, until carrots are glazed, 2 to 3 minutes."
        }
      ],
