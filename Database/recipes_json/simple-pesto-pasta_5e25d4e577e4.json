  "recipes": [
    {
      "name": "Simple Pesto Pasta",
      "ingredients_raw": [
        "0.5 (16 ounce) box dry fettuccine pasta",
        "0.25 cup butter, or to taste",
        "3 tablespoons minced garlic",
        "0.25 cup pesto"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Bring a pot of lightly salted water to a rolling boil; cook the fettuccini at a boil until cooked through yet firm to the bite, about 8 minutes; drain. Transfer the fettuccini to a bowl."
        },
        {
          "id": 2,
          "text": "Melt the butter in a saucepan over medium heat. Cook the garlic and pesto in the melted butter until warmed, 2 to 3 minutes; pour over the fettuccini and toss to coat."
        }
      ],
