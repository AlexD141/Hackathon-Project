  "recipes": [
    {
      "name": "Deer Ribs",
      "ingredients_raw": [
        "1 (12 fluid ounce) bottle dark beer",
        "1 cup apple cider vinegar",
        "3 chopped red bell peppers",
        "3 celery ribs, chopped",
        "3 carrots, chopped",
        "1 chopped onion",
        "1 head garlic, peeled",
        "6 pounds venison ribs",
        "2 tablespoons Cajun seasoning",
        "salt and pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 200 degrees F (95 degrees C)."
        },
        {
          "id": 2,
          "text": "Pour beer and vinegar into a large roasting pan. Add red bell peppers, celery, carrots, onion, and garlic."
        },
        {
          "id": 3,
          "text": "Rub venison ribs with Cajun seasoning, salt, and pepper. Place ribs over vegetables in the roasting pan. Cover with a tight-fitting lid or aluminum foil."
        },
        {
          "id": 4,
          "text": "Bake in the preheated oven until meat falls off the bone, about 18 hours."
        }
      ],
