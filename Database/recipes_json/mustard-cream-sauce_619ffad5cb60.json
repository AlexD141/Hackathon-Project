      "name": "Mustard Cream Sauce",
      "ingredients_raw": [
        "0.33000001311302 cup mayonnaise",
        "0.25 cup sour cream",
        "1 tablespoon prepared Dijon-style mustard",
        "1 tablespoon fresh lemon juice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a medium bowl, whisk together mayonnaise, sour cream, Dijon-style mustard and lemon juice. Adjust amount of mustard to taste. Cover and chill in the refrigerator until serving."
        }
