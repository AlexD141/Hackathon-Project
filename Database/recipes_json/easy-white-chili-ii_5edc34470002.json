  "recipes": [
    {
      "name": "Easy White Chili II",
      "ingredients_raw": [
        "4 skinless, boneless chicken breasts, cut into 1-inch pieces",
        "1 (4 ounce) can chopped green chilies, undrained",
        "0.5 (8 ounce) jar salsa",
        "2 cubes chicken bouillon",
        "1 (48 ounce) jar navy beans, rinsed and drained",
        "2 cups water"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine the chicken, green chilies, salsa, chicken bouillon, navy beans, and water in a slow cooker."
        },
        {
          "id": 2,
          "text": "Cook on High until the chicken falls apart, about 4 hours."
        },
        {
          "id": 3,
          "text": "Mash the chili with a potato masher to give a thicker texture, if desired."
        }
      ],
