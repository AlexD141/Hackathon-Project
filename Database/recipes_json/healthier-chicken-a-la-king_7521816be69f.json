      "name": "Healthier Chicken a la King",
      "ingredients_raw": [
        "3 tablespoons chopped onion",
        "2 tablespoons all-purpose flour",
        "1 teaspoon salt",
        "1 cup milk",
        "0.5 pound cooked, cubed chicken meat",
        "1 hard-boiled egg, sliced",
        "1.3332999944687 cups cooked spinach",
        "3 tablespoons chopped onions"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place onion in a medium saucepan over low heat and sprinkle with flour and salt. Stir together and add milk. Bring to a boil and cook until thickened."
        },
        {
          "id": 2,
          "text": "Mix in chicken, egg and spinach. Heat through and serve."
        }
