      "name": "Spinach Salad with Poppy Seed Dressing",
      "ingredients_raw": [
        "0.5 cup creamy salad dressing (e.g. Miracle Whip®)",
        "0.33333334326744 cup white vinegar",
        "0.33333334326744 cup white sugar",
        "1 teaspoon poppy seeds",
        "4 cups baby spinach",
        "4 cups mixed salad greens",
        "1 (10 ounce) can mandarin oranges, drained",
        "0.33333334326744 cup thinly sliced red onion",
        "0.5 cup slivered almonds"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Make poppy seed dressing: Whisk together creamy salad dressing, vinegar, sugar, and poppy seeds; set aside."
        },
        {
          "id": 2,
          "text": "Prepare the salad: Arrange spinach leaves, mixed salad greens, oranges, onion, then almonds onto individual salad plates."
        },
        {
          "id": 3,
          "text": "Drizzle with poppy seed dressing to serve."
        }
      ],
