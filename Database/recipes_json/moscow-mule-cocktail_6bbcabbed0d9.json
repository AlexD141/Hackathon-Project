      "name": "Moscow Mule Cocktail",
      "ingredients_raw": [
        "1.5 fluid ounces vodka",
        "0.5 fluid ounce lime juice",
        "ice cubes",
        "0.5 cup ginger beer",
        "1 lime wedge for garnish"
