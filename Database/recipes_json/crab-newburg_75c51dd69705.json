  "recipes": [
    {
      "name": "Crab Newburg",
      "ingredients_raw": [
        "0.33333334326744 cup butter",
        "1 pound fresh crabmeat",
        "1 pint sour cream, room temperature",
        "0.25 teaspoon ground black pepper",
        "2 tablespoons tomato paste",
        "2 tablespoons dry sherry",
        "2 tablespoons grated Parmesan cheese"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Melt butter in a skillet over medium heat. Add crab, stir and cook for 2 minutes. Mix in sour cream, tomato paste, dry sherry, parmesan, and black pepper. Cook, constantly stirring, until heated through. Do not boil."
        }
      ],
