  "recipes": [
    {
      "name": "Curried Egg Sandwiches",
      "ingredients_raw": [
        "0.5 cup mayonnaise",
        "1 teaspoon curry powder",
        "4 hard-cooked eggs, peeled and chopped",
        "salt and pepper to taste",
        "8 slices bread"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather the ingredients."
        },
        {
          "id": 2,
          "text": "Mix mayonnaise and curry powder together in a large bowl until well blended. Gently stir in eggs, then season with salt and pepper."
        },
        {
          "id": 3,
          "text": "Evenly divide egg mixture between 4 bread slices; top with remaining 4 slices."
        }
      ],
