    {
      "name": "Strawberrylicious Daiquiris",
      "ingredients_raw": [
        "1 (1 pound) strawberries, halved",
        "0.5 cup white sugar",
        "1 tablespoon lime juice",
        "0.33333334326744 cup unsweetened pineapple juice",
        "0.75 cup spiced rum",
        "ice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine strawberries and sugar in blender; blend until smooth. Pour in pineapple juice, lime juice, and rum. Pulse until combined. Serve over ice."
        }
      ],
