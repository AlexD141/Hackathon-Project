  "recipes": [
    {
      "name": "Marshmallow-Peanut Butter Fudge",
      "ingredients_raw": [
        "4.5 cups white sugar",
        "1 (7 ounce) jar marshmallow creme",
        "1.5 cups evaporated milk",
        "0.25 cup butter",
        "2 cups peanut butter chips"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Butter one 7x11 or 9x13 inch pan."
        },
        {
          "id": 2,
          "text": "In a 4 quart saucepan combine the sugar, marshmallow creme, evaporated milk and butter. Cook over medium heat, stirring constantly, until mixture comes to a rolling boil. Boil and stir for 5 minutes. (It will burn easily so watch it carefully.)"
        },
        {
          "id": 3,
          "text": "Remove from the heat and stir in the peanut butter chips. Beat until chips are melted. Spread mixture into pan and let cool then cut into teensy squares."
        },
        {
          "id": 4,
          "text": "Variation: After mixture boils 5 minutes, divide mixture in half and add 1 cup peanut butter chips to one half and 1/2 cup cocoa powder and 1/4 melted butter to the other half. Pour &#34;blonde&#34; mixture into pan. Top with cocoa mixture. Let cool before cutting into squares."
        }
      ],
