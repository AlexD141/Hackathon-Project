  "recipes": [
    {
      "name": "Bailey&#39;s Banana Colada",
      "ingredients_raw": [
        "2 bananas, broken into chunks",
        "6 fluid ounces banana liqueur",
        "6 fluid ounces Irish cream liqueur",
        "6 fluid ounces coconut cream",
        "6 cups crushed ice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a blender combine the bananas and banana liqueur; blend until smooth. Blend in the Irish cream and coconut cream (Note: Make sure the coconut cream is at room temperature, or you will not be able to pour it). Finally, add the ice and blend until smooth."
        }
      ],
