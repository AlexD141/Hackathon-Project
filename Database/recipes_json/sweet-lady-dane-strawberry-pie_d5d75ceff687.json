{
  "source_url": "https://www.allrecipes.com/recipe/220140/sweet-lady-dane-strawberry-pie/",
  "extracted_at": "2026-10-18T03:09:24.535278+00:00",
  "recipes": [
    {
      "name": "Sweet Lady Dane Strawberry Pie",
      "ingredients_raw": [
        "3 cups sliced fresh strawberries",
        "1 cup white sugar",
        "3 tablespoons cornstarch",
        "0.75 cup cold water",
        "1 cup half-and-half",
        "1 egg",
        "1 egg yolk",
        "0.75 cup white sugar",
        "0.33333334326744 cup all-purpose flour",
        "3 tablespoons butter",
        "2 teaspoons vanilla extract",
        "2 cups fresh strawberries, halved",
        "1 (9 inch) prepared graham cracker crust"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Mash 3 cups sliced strawberries with 1 cup sugar in a saucepan over medium heat. Bring strawberry mixture to a boil, stirring frequently."
        },
        {
          "id": 2,
          "text": "Mix cornstarch with water in a small bowl and pour into mashed strawberries; reduce heat to medium-low."
        },
        {
          "id": 3,
          "text": "Let strawberry mixture simmer, stirring constantly, until thickened, about 10 minutes. Set aside."
        },
        {
          "id": 4,
          "text": "Bring half-and-half to a boil in a saucepan; remove from heat."
        },
        {
          "id": 5,
          "text": "Beat egg and egg yolk with an electric mixer in a bowl until frothy; gradually mix in 3/4 cup of sugar, then beat until the egg mixture is thick, pale yellow, and forms a ribbon when beater is lifted out of the bowl, about 3 minutes."
        },
        {
          "id": 6,
          "text": "Mix in flour until smooth."
        },
        {
          "id": 7,
          "text": "Gradually pour hot half-and-half into the egg mixture in a steady stream, beating constantly."
        },
        {
          "id": 8,
          "text": "Return mixture to the saucepan and place over medium heat. Cook, stirring constantly with a wooden spoon, until the custard thickens and starts to boil. Reduce heat to medium-low; continue cooking, stirring constantly until flour is cooked, 2 to 3 more minutes."
        },
        {
          "id": 9,
          "text": "Remove custard from heat, and stir in butter and vanilla extract."
        },
        {
          "id": 10,
          "text": "Spread custard in an even layer over the bottom of graham cracker crust. Top the custard with the cooked strawberry mixture. Arrange fresh strawberries over the top."
        },
        {
          "id": 11,
          "text": "Chill at least 3 hours before serving."
        }
      ],
