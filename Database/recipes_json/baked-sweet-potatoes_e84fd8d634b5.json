  "recipes": [
    {
      "name": "Baked Sweet Potatoes",
      "ingredients_raw": [
        "2 tablespoons olive oil",
        "3 large sweet potatoes",
        "2 pinches dried oregano",
        "2 pinches salt",
        "2 pinches ground black pepper"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 350 degrees F (175 degrees C). Brush some oil on the bottom of a glass or nonstick baking dish."
        },
        {
          "id": 2,
          "text": "Peel sweet potatoes; cut into medium cubes."
        },
        {
          "id": 3,
          "text": "Transfer sweet potato cubes to the baking dish. Add remaining oil, sprinkle with oregano, salt, and pepper, and toss to coat."
        },
        {
          "id": 4,
          "text": "Bake in the preheated oven until sweet potato cubes are soft and fork-tender, 45 minutes to 1 hour."
        }
      ],
