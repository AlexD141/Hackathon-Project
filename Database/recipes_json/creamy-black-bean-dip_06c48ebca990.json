      "name": "Creamy Black Bean Dip",
      "ingredients_raw": [
        "1 (15.5 ounce) can black beans, rinsed and drained",
        "2.5 teaspoons balsamic vinegar",
        "1.5 tablespoons ketchup",
        "0.5 teaspoon apple cider vinegar",
        "0.5 teaspoon salt",
        "0.25 teaspoon onion powder",
        "0.25 teaspoon chili powder"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine the black beans, balsamic vinegar, ketchup, apple cider vinegar, salt, onion powder, and chili powder in a food processor; pulse until creamy. Serve at room temperature."
        }
      ],
