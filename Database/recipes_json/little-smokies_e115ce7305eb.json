  "recipes": [
    {
      "name": "Little Smokies",
      "ingredients_raw": [
        "1 (18 ounce) bottle barbeque sauce",
        "1 cup packed brown sugar",
        "0.5 cup ketchup",
        "0.33333334326744 cup chopped onion",
        "1 tablespoon Worcestershire sauce",
        "2 (16 ounce) packages little wieners"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Stir barbecue sauce, brown sugar, ketchup, onion, Worcestershire sauce, and cocktail sausages in the bowl of a slow cooker until evenly coated."
        },
        {
          "id": 2,
          "text": "Cover and cook on Low until heated through and sauce is thickened, about 2 hours. Keep warm on the Low or Warm setting for serving."
        },
        {
          "id": 3,
          "text": "Serve with toothpicks."
        }
      ],
