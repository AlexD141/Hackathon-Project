    {
      "name": "Espresso Martini",
      "ingredients_raw": [
        "1 cup crushed ice",
        "2 fluid ounces coffee-flavored liqueur",
        "1 fluid ounce vanilla flavored vodka",
        "1 fluid ounce cream or milk"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place ice into a cocktail shaker. Pour coffee liqueur, vodka, and cream over ice. Cover and shake until the outside of the shaker has frosted. Strain into 2 martini glasses."
        }
      ],
