            },
            "author": {
              "@type": "Person",
              "name": "Sara DeBovis"
            },
            "reviewBody": "Made it, but replaced the brown sugar with maple syrup.",
            "datePublished": "2025-04-18T23:54:56.497Z"
          },
          {
            "@type": "Review",
            "reviewRating": {
