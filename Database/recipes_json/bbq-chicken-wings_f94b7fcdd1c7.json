  "recipes": [
    {
      "name": "BBQ Chicken Wings",
      "ingredients_raw": [
        "0.5 cup teriyaki sauce",
        "1 cup oyster sauce",
        "0.25 cup soy sauce",
        "0.25 cup ketchup",
        "2 tablespoons garlic powder",
        "0.25 cup gin",
        "2 dashes liquid smoke flavoring",
        "0.5 cup white sugar",
        "1.5 pounds chicken wings, separated at joints, tips discarded",
        "0.25 cup honey"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a large bowl, mix the teriyaki sauce, oyster sauce, soy sauce, ketchup, garlic powder, gin, liquid smoke, and sugar. Place the chicken wings in the bowl, cover, and marinate in the refrigerator 8 hours or overnight."
        },
        {
          "id": 2,
          "text": "Preheat the grill for low heat."
        },
        {
          "id": 3,
          "text": "Lightly oil the grill grate. Arrange chicken on the grill, and discard the marinade. Grill the chicken wings on one side for 20 minutes, then turn and brush with honey. Continue grilling 25 minutes, or until juices run clear."
        }
      ],
