  "recipes": [
    {
      "name": "Manhattan Cocktail",
      "ingredients_raw": [
        "2 fluid ounces rye whiskey",
        "0.5 fluid ounce sweet vermouth",
        "1 dash Angostura bitters",
        "1 cup ice cubes",
        "1 maraschino cherry"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Combine whiskey, vermouth, and bitters in a cocktail mixing glass. Add ice and stir until chilled."
        },
        {
          "id": 3,
          "text": "Strain into a chilled cocktail glass and garnish with a maraschino cherry."
        },
        {
          "id": 4,
          "text": "Enjoy!"
        }
      ],
