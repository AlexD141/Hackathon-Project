  "recipes": [
    {
      "name": "Easy Oven Beef Stew",
      "ingredients_raw": [
        "3 pounds chuck roast",
        "1 packet dry onion soup mix",
        "1 (12 fluid ounce) can or bottle ginger ale",
        "1 (8 ounce) can mushrooms, drained"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 200 degrees F (95 degrees C)."
        },
        {
          "id": 2,
          "text": "Cut the roast into cubes, then place in a 10x15 inch roasting pan with soup mix, ginger ale and mushrooms; mix well."
        },
        {
          "id": 3,
          "text": "Bake in preheated oven for 4 hours."
        }
      ],
