  "recipes": [
    {
      "name": "Garlic-Cilantro Scrambled Eggs",
      "ingredients_raw": [
        "4 large eggs",
        "1 tablespoon sour cream",
        "0.25 cup milk",
        "1 clove garlic, minced",
        "0.25 cup chopped fresh cilantro",
        "salt and pepper to taste",
        "1 tablespoon butter",
        "1.5 teaspoons freshly grated Parmesan cheese"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Whisk together eggs, sour cream, milk, and garlic until smooth; add cilantro and season to taste with salt and pepper."
        },
        {
          "id": 2,
          "text": "Melt butter in a nonstick skillet over medium heat. Pour in egg mixture and cook to desired degree of doneness, stirring constantly. Sprinkle with Parmesan cheese to serve."
        }
      ],
