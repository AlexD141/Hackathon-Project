  "recipes": [
    {
      "name": "Thin Mint Cocoa",
      "ingredients_raw": [
        "0.5 cup white sugar",
        "0.25 cup hot cocoa mix",
        "1 dash salt",
        "0.33333334326744 cup hot water",
        "4 cups whole milk",
        "1 teaspoon vanilla extract",
        "1 teaspoon peppermint extract"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Mix the sugar, cocoa mix, and salt into the water in a saucepan until completely dissolved. Bring the mixture to a boil; cook and stir at a boil for 2 minutes. Stir the milk, vanilla extract, and peppermint extract through the mixture. Continue cooking until hot, but do not bring to a boil. Serve hot."
        }
      ],
