  "recipes": [
    {
      "name": "Sunflower Drop Cookies",
      "ingredients_raw": [
        "1.125 cups all-purpose flour",
        "1.125 cups whole wheat flour",
        "1 teaspoon salt",
        "1 teaspoon baking soda",
        "1 cup butter",
        "5 tablespoons brown sugar",
        "5 tablespoons white sugar",
        "2 eggs",
        "1 teaspoon vanilla extract",
        "1 cup sunflower seeds",
        "2 cups flaked coconut"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a large mixing bowl, cream together sugar and butter or margarine. Beat in eggs and vanilla."
        },
        {
          "id": 2,
          "text": "Stir in flour, salt and baking soda. Add coconut and sunflower seeds. Mix together well."
        },
        {
          "id": 3,
          "text": "Drop by spoonfuls onto greased cookie sheet. Bake at 350 degrees F (175 degrees C) for 8 to 10 minutes."
        }
      ],
