  "recipes": [
    {
      "name": "Sweet Potato Eggnog Casserole",
      "ingredients_raw": [
        "2 (15 ounce) cans sweet potatoes, mashed",
        "1 cup eggnog",
        "2 tablespoons butter, melted",
        "0.75 cup white sugar",
        "0.5 teaspoon salt",
        "0.5 teaspoon ground ginger",
        "0.25 teaspoon ground cloves",
        "2 tablespoons grated orange zest",
        "0.5 cup chopped pecans"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat an oven to 375 degrees F (190 degrees C)."
        },
        {
          "id": 2,
          "text": "Mix sweet potatoes, eggnog, butter, sugar, salt, ginger, clove, orange zest, and pecans in a large bowl. Pour into a 2-quart baking dish."
        },
        {
          "id": 3,
          "text": "Bake in the preheated oven until heated through and golden on top, about 40 minutes."
        }
      ],
