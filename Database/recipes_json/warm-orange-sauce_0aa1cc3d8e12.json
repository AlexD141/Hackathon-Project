  "recipes": [
    {
      "name": "Warm Orange Sauce",
      "ingredients_raw": [
        "0.75 cup freshly squeezed orange juice",
        "0.33333334326744 cup white sugar",
        "3 tablespoons butter",
        "1 pinch salt",
        "0.75 cup cold water",
        "2.5 tablespoons cornstarch",
        "2 tablespoons finely shredded orange peel",
        "2 fluid ounces triple sec"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Bring orange juice, sugar, butter, and salt to a simmer in a saucepan over medium heat."
        },
        {
          "id": 2,
          "text": "Whisk cold water and cornstarch in a small bowl; whisk cornstarch mixture into simmering sauce until thickened and no longer cloudy."
        },
        {
          "id": 3,
          "text": "Remove sauce from heat; stir in orange peel and triple sec. Serve warm."
        }
      ],
