  "recipes": [
    {
      "name": "Homemade Horseradish Sauce",
      "ingredients_raw": [
        "0.5 cup sour cream",
        "2 tablespoons extra-hot prepared horseradish",
        "2 teaspoons thinly sliced chives",
        "0.25 teaspoon lemon juice",
        "1 pinch cayenne pepper"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Stir together sour cream, horseradish, chives, lemon juice, and cayenne pepper in a small bowl until well combined. Cover and chill in the refrigerator for at least 2 hours before serving."
        }
      ],
