  "recipes": [
    {
      "name": "Brandy Butter (Hard Sauce)",
      "ingredients_raw": [
        "1.125 cups unsalted butter, softened",
        "2 cups sifted confectioners' sugar",
        "2 tablespoons orange zest",
        "2 tablespoons orange juice",
        "4 tablespoons brandy"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place butter, confectioners sugar, orange rind, orange juice, and brandy or cognac into food processor and mix until smooth. Pile sauce into serving bowl and refrigerate. Remove from fridge about one hour before serving."
        }
      ],
