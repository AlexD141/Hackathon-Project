  "recipes": [
    {
      "name": "Eggnog Latte",
      "ingredients_raw": [
        "0.33333334326744 cup 2% milk",
        "0.66666668653488 cup eggnog",
        "1 (1.5 fluid ounce) jigger brewed espresso",
        "1 pinch ground nutmeg"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Pour milk and eggnog into a steaming pitcher and heat to between 145 degrees F to 165 degrees F (65 to 70 degrees C) using the steaming wand."
        },
        {
          "id": 3,
          "text": "Brew a shot of espresso; pour into a mug. Pour steamed milk and eggnog into the mug, using a spoon to hold back the foam."
        },
        {
          "id": 4,
          "text": "Spoon foam over the top. Sprinkle nutmeg on top of foam."
        }
      ],
