            },
            "author": {
              "@type": "Person",
              "name": "funmom"
            },
            "reviewBody": "Been making these for years. Everyone raves about them! I do two versions: date stuffed with 1/4 pecan and for a more savory version with crunch, substitute a whole water chestnut for the stuffed date.... Delicious!",
            "datePublished": "2015-11-07T00:24:54.033Z"
          },
