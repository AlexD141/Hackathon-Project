  "recipes": [
    {
      "name": "Tasteful Tahini Salad Dressing",
      "ingredients_raw": [
        "0.5 cup tahini (sesame paste)",
        "0.5 cup olive oil",
        "0.5 cup water",
        "0.25 cup tamari (dark soy sauce)",
        "2 tablespoons red wine vinegar",
        "2 tablespoons lemon juice",
        "2 teaspoons minced fresh ginger root",
        "2 cloves garlic, pressed",
        "black pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Combine tahini, olive oil, water, tamari, red wine vinegar, lemon juice, ginger, garlic, and black pepper in a blender; blend until smooth."
        }
      ],
