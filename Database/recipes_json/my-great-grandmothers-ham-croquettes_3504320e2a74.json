  "recipes": [
    {
      "name": "My Great Grandmother’s Ham Croquettes",
      "ingredients_raw": [
        "0.5 pound diced ham",
        "1 egg",
        "1 tablespoon mayonnaise",
        "1 cup dry breadcrumbs, divided"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Mix ham, egg, mayonnaise, and 1/2 cup bread crumbs together in a large bowl until well combined; shape into 6 balls. Spread remaining 1/2 cup bread crumbs onto a plate. Roll balls in crumbs to coat; arrange in a baking dish."
        },
        {
          "id": 3,
          "text": "Bake croquettes in the preheated oven until golden brown, 20 to 25 minutes."
        }
      ],
