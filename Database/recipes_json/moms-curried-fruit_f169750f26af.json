  "recipes": [
    {
      "name": "Mom&#39;s Curried Fruit",
      "ingredients_raw": [
        "1 (16 ounce) can sliced pears, well drained",
        "1 (20 ounce) can pineapple chunks, drained",
        "1 (15 ounce) can apricot halves, drained",
        "2 (15 ounce) cans sliced peaches",
        "1 (4 ounce) jar maraschino cherries",
        "0.25 cup packed brown sugar",
        "0.25 cup white sugar",
        "3 teaspoons curry powder",
        "2 tablespoons butter"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 400 degrees F (205 degrees C)."
        },
        {
          "id": 2,
          "text": "Drain fruit and arrange it in an oven-proof casserole dish. Dot fruit with butter or margarine. Mix sugars and curry powder together, sprinkle over the top of fruit."
        },
        {
          "id": 3,
          "text": "Bake at 400 degrees F (205 degrees C) until slightly brown, about 15 to 20 minutes."
        }
      ],
