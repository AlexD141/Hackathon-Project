  "recipes": [
    {
      "name": "Sugar and Spice Bacon",
      "ingredients_raw": [
        "0.5 cup all-purpose flour",
        "0.5 cup brown sugar",
        "1 teaspoon coarsely ground black pepper",
        "1 pound thick cut bacon"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 400 degrees F (200 degrees C)."
        },
        {
          "id": 2,
          "text": "Place flour, sugar, and pepper into a resealable plastic bag and shake to mix. Shake bacon with flour mixture a few strips at a time to coat. Place coated bacon onto a baking sheet or broiler pan."
        },
        {
          "id": 3,
          "text": "Bake in preheated oven for 15 minutes or until bacon has cooked to desired doneness."
        }
      ],
