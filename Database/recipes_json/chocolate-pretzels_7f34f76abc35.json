  "recipes": [
    {
      "name": "Chocolate Pretzels",
      "ingredients_raw": [
        "24 circular pretzels",
        "24 milk chocolate candy kisses",
        "1 (1.69 ounce) package mini candy-coated chocolates"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather ingredients and preheat the oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Spread pretzels evenly onto baking sheets. Unwrap candy kisses and place one in the center of each pretzel."
        },
        {
          "id": 3,
          "text": "Bake in the preheated oven until kisses melt, 1 to 2 minutes. Remove from the oven, then gently press a candy-coated chocolate into the melted chocolate center of each pretzel."
        },
        {
          "id": 4,
          "text": "Chill in the refrigerator until set."
        }
      ],
