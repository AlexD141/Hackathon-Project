            "reviewRating": {
              "@type": "Rating",
              "ratingValue": "5"
            },
            "author": {
              "@type": "Person",
              "name": "Kathleen"
            },
            "reviewBody": "This was very tasty. I thought it had plenty of flavor. We enjoyed it with crackers, but I can see it being great on lots of things, even as a salad dressing if you thin it!",
            "datePublished": "2020-05-29T23:31:46.297Z"
