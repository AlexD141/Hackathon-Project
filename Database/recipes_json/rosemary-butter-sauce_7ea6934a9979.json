  "recipes": [
    {
      "name": "Rosemary-Butter Sauce",
      "ingredients_raw": [
        "0.25 cup butter",
        "3 tablespoons minced shallot",
        "0.5 cup dry white wine",
        "0.5 cup heavy cream",
        "0.5 cup chicken broth",
        "1 teaspoon lemon juice",
        "2 teaspoons chopped fresh rosemary",
        "salt to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Melt butter in a small saucepan over medium heat. Stir in shallot; cook until shallot has softened and turned translucent, about 3 minutes."
        },
        {
          "id": 2,
          "text": "Pour in wine, cream, chicken broth, and lemon juice. Simmer until the liquid has reduced by half, about 10 minutes. Stir in rosemary and season to taste with salt."
        }
      ],
