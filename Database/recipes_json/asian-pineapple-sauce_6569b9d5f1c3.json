  "recipes": [
    {
      "name": "Asian Pineapple Sauce",
      "ingredients_raw": [
        "0.75 cup pineapple juice",
        "2 tablespoons teriyaki sauce",
        "1 teaspoon soy sauce",
        "0.5 teaspoon lemon juice",
        "4 slices canned pineapple in juice, drained and chopped",
        "0.5 cup white sugar",
        "1.5 tablespoons garlic powder",
        "0.25 cup water"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine the pineapple juice, teriyaki sauce, soy sauce, lemon juice, pineapple, sugar, and garlic powder in a saucepan over medium heat; cook until the liquid has reduced to a syrup, about 5 minutes. Stir the water through the mixture; continue cooking until the mixture thickens again. Remove from heat and serve immediately."
        }
      ],
