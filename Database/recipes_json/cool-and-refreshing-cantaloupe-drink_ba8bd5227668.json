      "name": "Cool and Refreshing Cantaloupe Drink",
      "ingredients_raw": [
        "1 cantaloupe, halved and seeded",
        "0.5 cup white sugar, or more to taste",
        "6 cups cold water, or more as needed",
        "2 cups milk"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Shred cantaloupe with a fork; place in a large pitcher, including juice and pulp. Stir in sugar; mash large pieces cantaloupe. Stir in water and milk until pitcher is full. Serve cold."
        }
      ],
