  "recipes": [
    {
      "name": "Hot Dog Roll-Up",
      "ingredients_raw": [
        "4 all beef hot dogs",
        "4 slices processed American cheese",
        "4 (6 inch) Mission® Fajita Flour Tortillas"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Place hot dogs between 2 paper towels. Microwave on high for 20 seconds. Set aside."
        },
        {
          "id": 3,
          "text": "Lay 1 slice processed cheese in center of each tortilla. Place 1 hot dog on top of each cheese slice."
        },
        {
          "id": 4,
          "text": "Roll up each tortilla from one end to the other, enclosing cheese and hot dog."
        },
        {
          "id": 5,
          "text": "Place roll-ups on a microwave-safe plate. Microwave until cheese is fully melted and tortillas warmed, 10 to 12 seconds."
        }
      ],
