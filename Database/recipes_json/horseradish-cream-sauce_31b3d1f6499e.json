  "recipes": [
    {
      "name": "Horseradish Cream Sauce",
      "ingredients_raw": [
        "0.25 cup mayonnaise",
        "0.5 cup prepared horseradish",
        "2 tablespoons Dijon mustard",
        "0.75 cup heavy cream, whipped to soft peaks",
        "1 pinch white sugar, or to taste",
        "salt and black pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Stir the mayonnaise, horseradish, and Dijon mustard in a bowl until evenly combined. Fold in the whipped cream, then season to taste with sugar, salt, and pepper."
        }
      ],
