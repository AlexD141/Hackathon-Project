  "recipes": [
    {
      "name": "Baked Sweet Potato Balls",
      "ingredients_raw": [
        "1 (40 ounce) can sweet potatoes, drained",
        "0.25 cup butter",
        "salt to taste",
        "3 cups crushed cornflakes cereal",
        "0.75 cup real maple syrup",
        "10 large marshmallows"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Drain sweet potatoes and put into large mixing bowl. Mash the potatoes with butter or margarine. Salt to taste."
        },
        {
          "id": 2,
          "text": "Hand pat mixture into 3 inch diameter balls. Roll in crushed corn flakes and put into 9x12 inch greased baking dish. Pour maple syrup evenly over all balls."
        },
        {
          "id": 3,
          "text": "Bake at 325 degrees F (165 degrees C) for 40 minutes. The last fifteen minutes put a marshmallow over each ball."
        }
      ],
