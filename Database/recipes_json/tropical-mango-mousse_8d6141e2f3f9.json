    {
      "name": "Tropical Mango Mousse",
      "ingredients_raw": [
        "2 mangos - peeled, seeded, and cubed",
        "1 banana",
        "0.66666698455811 cup nonfat plain yogurt",
        "2 teaspoons honey",
        "6 cubes ice",
        "1 teaspoon vanilla extract"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a blender combine mangoes, bananas, yogurt, honey, ice cubes, and vanilla extract until smooth. Refrigerate for 3 hours. Pour into individual dishes and serve."
        }
      ],
