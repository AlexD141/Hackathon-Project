      "name": "JR&#39;s Salsa",
      "ingredients_raw": [
        "8 roma (plum) tomatoes, seeded and diced",
        "6 serrano chile peppers, diced",
        "2 jalapeno peppers, seeded and diced",
        "0.5 small white onion, diced",
        "3 cloves garlic, minced",
        "2 tablespoons chopped fresh cilantro",
        "0.25 teaspoon chili powder",
        "0.25 teaspoon grated lime zest",
        "1 lime, juiced",
        "coarse salt and ground black pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Toss tomatoes, serrano peppers, jalapeno peppers, white onion, garlic, cilantro, chili powder, lime zest, and lime juice in a bowl; season with salt and black pepper. Cover the bowl with plastic wrap and refrigerate 1 hour to overnight before serving."
        }
      ],
