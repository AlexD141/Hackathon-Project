  "recipes": [
    {
      "name": "Buñuelos",
      "ingredients_raw": [
        "4 large eggs",
        "0.25 cup white sugar",
        "1 teaspoon vegetable oil",
        "1.5 cups all-purpose flour, plus more for kneading",
        "1 teaspoon baking powder",
        "1 teaspoon salt",
        "1 cup white sugar",
        "1 teaspoon ground cinnamon",
        "1 cup vegetable oil for frying"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Beat eggs and 1/4 cup sugar in a large bowl until thick and lemon-colored; mix in 1 teaspoon vegetable oil."
        },
        {
          "id": 3,
          "text": "Combine 1 ½ cups of flour, baking powder, and salt; gradually add to egg mixture, mixing well until evenly combined."
        },
        {
          "id": 4,
          "text": "Turn dough out onto a floured board and knead thoroughly until dough is smooth."
        },
        {
          "id": 5,
          "text": "Shape dough into 16 even-sized balls. Flatten and roll each one into a very thin circle about 5 inches in diameter. Let stand uncovered on waxed paper for about 10 minutes."
        },
        {
          "id": 6,
          "text": "Meanwhile, combine 1 cup sugar and cinnamon in a small bowl until evenly mixed; set aside. Heat oil in a deep pan to 350 degrees F (175 degrees C)."
        },
        {
          "id": 7,
          "text": "Lower one circle of dough carefully into the hot oil; fry until golden, turning once, about 30 seconds on each side. Transfer to a paper towel-lined plate to drain; sprinkle with cinnamon-sugar mixture."
        },
        {
          "id": 8,
          "text": "Repeat with remaining dough. Serve or cool completely and store in airtight containers."
        }
      ],
      "warnings": [],
