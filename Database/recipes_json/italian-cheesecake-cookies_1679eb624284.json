  "recipes": [
    {
      "name": "Italian Cheesecake Cookies",
      "ingredients_raw": [
        "1 pound ricotta cheese",
        "2 (8 ounce) packages cream cheese, softened",
        "1.5 cups white sugar",
        "4 eggs",
        "1 teaspoon vanilla extract",
        "3 tablespoons cornstarch",
        "3 tablespoons all-purpose flour",
        "0.5 cup butter, melted and cooled",
        "0.5 pint sour cream",
        "0.5 lemon, juiced",
        "1 cup cherry pie filling"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Cream together the ricotta and cream cheese. Add sugar and continue beating until smooth. Add lemon juice, vanilla, flour, and cornstarch, beating well after each addition. Beat in eggs, one at a time. Gradually beat in melted butter. Blend in sour cream, continue beating all ingredients until well blended."
        },
        {
          "id": 2,
          "text": "Pour into ungreased 9 x 13 inch pan. Bake at 320 degrees F (160 degrees C) for 1 hr. Turn off oven and leave inside for 2 hours."
        },
        {
          "id": 3,
          "text": "Cut into squares. Top each with strawberry, blueberry, or cherry pie filling. Note: Bars can be frozen."
        }
      ],
