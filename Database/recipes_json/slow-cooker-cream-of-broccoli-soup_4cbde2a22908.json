  "recipes": [
    {
      "name": "Slow Cooker Cream of Broccoli Soup",
      "ingredients_raw": [
        "1 tablespoon vegetable oil",
        "1 small onion, chopped",
        "2 (10 ounce) packages frozen chopped broccoli, thawed",
        "2 (10.5 ounce) cans cream of celery soup",
        "1 (10.5 ounce) can condensed cream of mushroom soup",
        "21 ounces milk",
        "1 cup shredded American cheese"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Heat vegetable oil in a large pot over medium heat. Add onion; cook and stir until soft, 5 to 7 minutes. Drain as much liquid from the onion as possible; transfer onion into a slow cooker."
        },
        {
          "id": 2,
          "text": "Add broccoli, celery soup, and condensed soup to the slow cooker. Fill the condensed soup can twice with milk, and pour it into the slow cooker. Add American cheese, and stir to combine."
        },
        {
          "id": 3,
          "text": "Cover and cook on Low until broccoli is tender and flavors meld, 3 to 4 hours."
        }
      ],
