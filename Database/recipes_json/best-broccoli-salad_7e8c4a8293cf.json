  "recipes": [
    {
      "name": "Best Broccoli Salad",
      "ingredients_raw": [
        "1 large head fresh broccoli",
        "1 large head cauliflower",
        "2 apples - peeled, cored and chopped",
        "1 (11 ounce) can mandarin oranges, drained",
        "0.33333298563957 cup sunflower seeds",
        "1 (16 ounce) bottle Catalina salad dressing"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Cut broccoli and cauliflower into small to medium florets; combine with apples and oranges."
        },
        {
          "id": 2,
          "text": "Pour enough dressing over ingredients to coat; toss and sprinkle with sunflower seeds. Serve immediately or allow to chill and flavors to blend."
        }
      ],
