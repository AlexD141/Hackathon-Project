      "name": "Southern Sweet Ham Glaze",
      "ingredients_raw": [
        "1 cup packed brown sugar",
        "1 cup molasses",
        "0.75 cup spicy brown mustard",
        "0.25 cup bourbon",
        "1.5 teaspoons ground ginger",
        "1.5 teaspoons ground cinnamon",
        "0.5 teaspoon ground cloves",
        "0.25 teaspoon ground black pepper"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place brown sugar, molasses, mustard, bourbon, ginger, cinnamon, cloves, and black pepper in a mixing bowl and stir until sugar has dissolved."
        }
      ],
