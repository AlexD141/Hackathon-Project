  "recipes": [
    {
      "name": "Sandwich Filling",
      "ingredients_raw": [
        "0.5 pound lean ground beef",
        "8 ounces tomato sauce",
        "0.5 cup finely chopped onion",
        "0.5 cup chopped black olives",
        "0.25 cup chopped pimento peppers",
        "1 (8 ounce) can mushrooms, drained and chopped",
        "8 ounces extra-sharp Cheddar cheese, shredded",
        "1.5 teaspoons chili powder",
        "salt and ground black pepper to taste",
        "4 hamburger buns, split"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 400 degrees F (200 degrees C)."
        },
        {
          "id": 2,
          "text": "Cook and stir ground beef in a large skillet until well browned, about 10 minutes; drain fat. Place cooked beef in a large bowl. Stir in tomato sauce, onion, black olives, pimentos, mushrooms, Cheddar cheese, chili powder, salt, and black pepper."
        },
        {
          "id": 3,
          "text": "Spoon sandwich filling on hamburger bun bottoms, spreading to the edges. Filling should be approximately 1/2&#34; thick in the center of the sandwich."
        },
        {
          "id": 4,
          "text": "Bake in the preheated oven until the edges start to bubble, 5-10 minutes. Turn oven to Broil and continue to cook until heated through, about 3 minutes."
        }
      ],
