  "recipes": [
    {
      "name": "Halloumi Cheese Fingers",
      "ingredients_raw": [
        "0.5 tablespoon olive oil",
        "6 ounces halloumi cheese, cut into 1/2 inch thick sticks",
        "2 teaspoons fresh lemon juice",
        "0.25 teaspoon dried oregano",
        "black pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Heat olive oil in a skillet over medium heat. Add halloumi sticks and cook until the cheese turns light golden brown, 1 to 2 minutes."
        },
        {
          "id": 3,
          "text": "Sprinkle with lemon juice, oregano, and pepper to serve."
        }
      ],
