  "recipes": [
    {
      "name": "Malibu-Bailey&#39;s Colada",
      "ingredients_raw": [
        "0.5 cup Irish cream liqueur (such as Baileys®)",
        "0.5 cup coconut-flavored rum (such as Malibu®)",
        "0.5 cup pineapple juice",
        "0.5 cup cream of coconut",
        "6 ice cubes"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Mix the Irish cream liqueur, rum, pineapple juice, and cream of coconut together in a large pitcher. Pour 1/2 cup into a blender container. Add the ice cubes and blend to desired consistency. Pour the ice mixture into two glasses, dividing equally, and fill with the remaining rum mixture."
        }
      ],
