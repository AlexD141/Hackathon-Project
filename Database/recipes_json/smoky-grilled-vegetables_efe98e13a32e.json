  "recipes": [
    {
      "name": "Smoky Grilled Vegetables",
      "ingredients_raw": [
        "1 eggplant, sliced into 1/2 inch rounds",
        "2 red bell peppers, halved and seeded",
        "2 yellow bell peppers, halved and seeded",
        "2 zucchini, sliced",
        "2 large onions, peeled and sliced into 1/2-inch thick roun",
        "4 tablespoons vegetable oil",
        "1 cup teriyaki sauce"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Brush vegetables with oil to coat."
        },
        {
          "id": 2,
          "text": "Prepare smoker using manufacturer &#39;s instructions using either alder or apple chips. Place veggies in single layers on smoker racks. Smoke for about 30 minutes."
        },
        {
          "id": 3,
          "text": "Preheat grill for high heat."
        },
        {
          "id": 4,
          "text": "Brush grate with oil. Arrange vegetables on grill, with the peppers away from the center. Cook for 10 to 15 minutes, turning once. Baste with teriyaki sauce frequently. Vegetables will cook at different rates; remove tender pieces from the grill, and continue cooking until all are done."
        }
      ],
