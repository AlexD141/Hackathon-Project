  "recipes": [
    {
      "name": "Cornbread Pudding",
      "ingredients_raw": [
        "1 (15.25 ounce) can whole kernel corn",
        "1 (15 ounce) can cream-style corn",
        "1 (8 ounce) container sour cream",
        "1 (8.5 ounce) package dry corn muffin mix",
        "salt and pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13 inch casserole dish."
        },
        {
          "id": 2,
          "text": "In the greased casserole dish, combine kernel corn, cream style corn, sour cream, corn muffin mix and salt and pepper to taste."
        },
        {
          "id": 3,
          "text": "Bake in a preheated 350 degrees F (175 degrees C) oven for 90 minutes or until a toothpick comes out clean."
        }
      ],
