              "@type": "Person",
              "name": "stannius"
            },
            "reviewBody": "I'm from Massachusetts and we call this recipe a Fluffernutter. Now that I'm an adult I get to have one every single day if I want to. And I do!"
          },
          {
            "@type": "Review",
            "reviewRating": {
              "@type": "Rating",
