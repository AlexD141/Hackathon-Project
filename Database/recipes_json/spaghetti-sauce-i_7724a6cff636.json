  "recipes": [
    {
      "name": "Spaghetti Sauce I",
      "ingredients_raw": [
        "1 pound lean ground beef",
        "1 onion, chopped",
        "2 (15 ounce) cans tomato sauce",
        "0.25 cup white sugar",
        "0.25 cup butter",
        "2 teaspoons dried oregano",
        "0.25 tablespoon dried basil",
        "salt to taste",
        "ground black pepper to taste",
        "1 pinch garlic powder"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Saute the beef and onion. Drain."
        },
        {
          "id": 2,
          "text": "Stir in the tomato sauce, butter and sugar. Add the oregano, basil, salt, pepper and garlic powder to taste. Cook over low heat until hot."
        }
      ],
