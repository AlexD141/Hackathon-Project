  "recipes": [
    {
      "name": "Waldorf Salad",
      "ingredients_raw": [
        "0.5 cup mayonnaise",
        "1 tablespoon white sugar",
        "1 teaspoon lemon juice",
        "0.125 teaspoon salt",
        "3 apples -- peeled, cored, and chopped",
        "1 cup thinly sliced celery",
        "0.5 cup chopped walnuts",
        "0.5 cup raisins"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Whisk mayonnaise, sugar, lemon juice, and salt together in a serving bowl."
        },
        {
          "id": 3,
          "text": "Stir in apples, celery, walnuts, and raisins. Cover and chill in the refrigerator until ready to serve."
        },
        {
          "id": 4,
          "text": "Serve and enjoy!"
        }
      ],
