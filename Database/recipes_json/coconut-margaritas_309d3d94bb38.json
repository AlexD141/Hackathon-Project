  "recipes": [
    {
      "name": "Coconut Margaritas",
      "ingredients_raw": [
        "2 cups ice",
        "0.75 cup sweetened coconut cream",
        "4.5 fluid ounces tequila",
        "1.5 fluid ounces triple sec",
        "0.25 cup sweetened flaked coconut"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Fill a blender with ice; add the coconut cream, tequila, and triple sec; blend at high speed until smooth. Scatter the coconut onto a plate. Wet the rims of four glasses. Dip the glass rims in the coconut. Serve the margaritas in the prepared glasses."
        }
      ],
