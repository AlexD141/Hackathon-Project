  "recipes": [
    {
      "name": "Summer Couscous",
      "ingredients_raw": [
        "0.5 cup chicken broth",
        "0.5 cup couscous",
        "2 tablespoons olive oil",
        "8 cherry tomatoes, quartered",
        "2 green onions, chopped",
        "0.25 red onion, diced",
        "0.25 cup seeded, diced cucumber",
        "2 tablespoons chopped fresh parsley",
        "1 tablespoon lemon juice",
        "salt and ground black pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Bring broth to a near boil in a small saucepan over medium heat."
        },
        {
          "id": 2,
          "text": "Pour hot broth over couscous in a large bowl; stir in oil. Add tomatoes, green onions, red onion, cucumber, parsley, and lemon juice."
        },
        {
          "id": 3,
          "text": "Cover the bowl with plastic wrap; steam for 5 minutes. Uncover the bowl; fluff couscous and vegetables with a fork. Season with salt and black pepper."
        }
      ],
