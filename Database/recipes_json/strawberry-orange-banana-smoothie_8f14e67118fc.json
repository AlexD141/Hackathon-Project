            },
            "author": {
              "@type": "Person",
              "name": "Sarah Jo"
            },
            "reviewBody": "I used a frozen banana which eliminated the need for ice. This was delicious! NOTE: I'll use this recipe for a summer yogurt pop, just add a cup or so of greek yogurt. I bet that would be really tasty!",
            "datePublished": "2012-03-24T02:50:27.403Z"
          },
