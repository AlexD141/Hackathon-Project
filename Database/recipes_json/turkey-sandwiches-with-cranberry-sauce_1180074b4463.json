  "recipes": [
    {
      "name": "Turkey Cranberry Sandwich",
      "ingredients_raw": [
        "1 loaf French bread",
        "4 tablespoons margarine",
        "8 ounces sliced deli turkey meat",
        "8 slices provolone cheese",
        "8 slices precooked bacon",
        "4 tablespoons mayonnaise",
        "4 tablespoons jellied cranberry sauce",
        "8 slices fresh tomatoes",
        "4 lettuce leaves"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Set an oven rack about 6 inches from the heat source and preheat the oven&#39;s broiler."
        },
        {
          "id": 2,
          "text": "Cut loaf into 4 sandwich-sized pieces and slice each one open, leaving one long side attached. Spread butter on the cut sides and place them cut-side up on a baking sheet."
        },
        {
          "id": 3,
          "text": "Broil under the preheated broiler until toasted and lightly browned, 1 to 2 minutes."
        },
        {
          "id": 4,
          "text": "Top each bottom half with turkey, cheese, and bacon. Return to the broiler until the cheese just melts, about 1 minute."
        },
        {
          "id": 5,
          "text": "Spread mayonnaise on each top half and cranberry sauce on each bottom half. Add tomato slices and lettuce, then close sandwiches. Serve warm."
        }
      ],
