      "name": "Lemon Dressing",
      "ingredients_raw": [
        "0.25 cup olive oil",
        "0.25 cup white wine vinegar",
        "1 teaspoon prepared mustard",
        "1 teaspoon minced garlic",
        "1 teaspoon white sugar",
        "1 teaspoon grated lemon rind"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a glass jar, combine olive oil, vinegar, mustard, garlic, sugar, and lemon rind; shake well. Refrigerate until ready to serve."
        }
