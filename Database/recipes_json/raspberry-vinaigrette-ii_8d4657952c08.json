      "name": "Easy Raspberry Vinaigrette",
      "ingredients_raw": [
        "0.5 cup raspberry vinegar",
        "1 tablespoon fresh mint leaves, finely chopped",
        "1 teaspoon white sugar"
      ],
      "steps": [
        {
