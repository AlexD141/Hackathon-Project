  "recipes": [
    {
      "name": "Maverick Moose Chili",
      "ingredients_raw": [
        "1 pound ground moose",
        "2 (15 ounce) cans chili beans, undrained",
        "2 (14.5 ounce) cans pinto beans, rinsed and drained",
        "2 (14 ounce) cans kidney beans, rinsed and drained",
        "1 (28 ounce) can diced tomatoes with green chile peppers",
        "1 white onion, chopped",
        "1 green bell pepper, chopped",
        "2 (2.25 ounce) cans sliced black olives",
        "1 (1.25 ounce) package chili seasoning mix"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Brown ground moose in a large skillet over medium-high heat."
        },
        {
          "id": 2,
          "text": "Combine moose, chili beans, pinto beans, kidney beans, diced tomatoes, onion, bell pepper, and olives in a slow cooker; stir in chili seasoning. Cover slow cooker; cook on Low for 8 to 12 hours."
        }
      ],
