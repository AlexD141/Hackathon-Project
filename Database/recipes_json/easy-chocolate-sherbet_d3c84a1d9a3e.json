      "name": "Easy Chocolate Sherbet",
      "ingredients_raw": [
        "1 cup sugar",
        "0.75 cup unsweetened cocoa powder",
        "1.5 cups water",
        "2 tablespoons amaretto (almond flavored liqueur)"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a medium bowl, whisk together sugar, cocoa, water, and amaretto until smooth."
        },
        {
          "id": 2,
          "text": "Pour mixture into an ice cream freezer container, and follow the manufacturer&#39;s instructions to freeze."
        }
