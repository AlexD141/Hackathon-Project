      "name": "Stewed Tomatoes Spiced with Mustard",
      "ingredients_raw": [
        "12 roma (plum) tomatoes - peeled, quartered, and seeded",
        "0.25 onion, minced",
        "0.33333334326744 cup water",
        "0.5 teaspoon mustard seed",
        "0.33333334326744 teaspoon dry mustard powder",
        "1 large clove garlic, minced",
        "1 bay leaf",
        "0.125 teaspoon ground black pepper",
        "0.5 teaspoon soy sauce",
        "salt to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine tomatoes, onion, water, mustard seed, mustard powder, garlic, bay leaf, and black pepper in a large, heavy pot over medium heat; bring to a simmer and cook for 10 minutes. Stir soy sauce through the tomato mixture; continue cooking another 5 minutes. Season with salt. Remove bay leaf to serve."
        }
      ],
