  "recipes": [
    {
      "name": "Mai Tai Cocktail",
      "ingredients_raw": [
        "1 cup ice",
        "1 fluid ounce light rum",
        "1 fluid ounce gold rum",
        "0.5 fluid ounce orange Curacao liqueur",
        "0.5 fluid ounce orgeat syrup",
        "0.5 fluid ounce lime juice",
        "1 cup ice",
        "1 fluid ounce dark rum",
        "1 wedge fresh pineapple",
        "1 maraschino cherry"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Fill an old-fashioned glass with 1 cup crushed ice. Set aside in the freezer."
        },
        {
          "id": 2,
          "text": "Combine light rum, gold rum, orange Curacao, orgeat, and lime juice in a cocktail shaker. Add 1 cup ice, cover and shake until chilled. Strain into the chilled old-fashioned glass. Top with dark rum."
        },
        {
          "id": 3,
          "text": "Garnish with a wedge of pineapple and a maraschino cherry."
        }
      ],
