  "recipes": [
    {
      "name": "Durian Puree Cheesecake",
      "ingredients_raw": [
        "12 ounces cream cheese, room temperature",
        "7 fluid ounces sweetened condensed milk",
        "0.25 cup pureed fresh durian",
        "2 eggs",
        "0.5 cup sour cream",
        "1 teaspoon vanilla extract",
        "1 tablespoon durian or banana extract",
        "1 (9 inch) prepared graham cracker crust"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 325 degrees F (170 degrees C)."
        },
        {
          "id": 2,
          "text": "If not using canned or frozen durian purée, cut into husk of durian fruit and remove one segment of pulpy inner flesh. Place in a bowl and use a fork to mash flesh. Reserve 1/4 cup."
        },
        {
          "id": 3,
          "text": "Beat cream cheese until fluffy. Add condensed milk and continue beating until smooth. Beat in puréed durian, eggs, sour cream, vanilla extract, and durian or banana extract. Pour batter into prepared graham cracker crust."
        },
        {
          "id": 4,
          "text": "Bake 1 hour or until filling is set and edges are lightly browned. Serve warm or chill overnight in the refrigerator."
        }
      ],
