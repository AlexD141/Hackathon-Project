  "recipes": [
    {
      "name": "No-Bake Oreo Cheesecake",
      "ingredients_raw": [
        "1 (18 ounce) package OREO Cookies, divided",
        "0.25 cup unsalted butter, melted",
        "4 (8 ounce) packages PHILADELPHIA Cream Cheese, softened",
        "0.75 cup sugar",
        "1 teaspoon vanilla",
        "1 (8 ounce) tub COOL WHIP Whipped Topping, thawed"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "To make the crust: Set aside 15 cookies for the filling. Finely crush remaining cookies in a large bowl."
        },
        {
          "id": 3,
          "text": "Add melted butter and mix to combine."
        },
        {
          "id": 4,
          "text": "Press buttery crumbs firmly into the bottom of a 9x13-inch pan. Place in the refrigerator."
        },
        {
          "id": 5,
          "text": "To make the filling: Coarsely chop the reserved cookies."
        },
        {
          "id": 6,
          "text": "Beat cream cheese, sugar, and vanilla in large bowl with an electric mixer on medium speed until well blended."
        },
        {
          "id": 7,
          "text": "Gently stir in whipped topping and chopped cookies."
        },
        {
          "id": 8,
          "text": "Spread over crust. Cover and refrigerate until firm, about 4 hours. Cut into 20 squares."
        }
      ],
