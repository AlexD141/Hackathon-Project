  "recipes": [
    {
      "name": "Orange and Cinnamon Tequila Shot",
      "ingredients_raw": [
        "1 slice orange, seeds removed",
        "1 pinch ground cinnamon, or more to taste",
        "1 (1.5 fluid ounce) jigger tequila"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place orange slice between forefinger and thumb of left hand. Lick the skin just below thumb of left hand and sprinkle with a pinch of cinnamon. Place shot of tequila in right hand. Lick cinnamon, drink shot, and bite orange slice."
        }
      ],
