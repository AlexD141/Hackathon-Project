            "author": {
              "@type": "Person",
              "name": "Michael Lemke"
            },
            "reviewBody": "I loved this recipe. The only piddly thing I do different is I mix the cornstarch with the water first to avoid clumping.",
            "datePublished": "2024-07-19T18:53:42.691Z"
          },
          {
            "@type": "Review",
