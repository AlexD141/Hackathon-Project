  "recipes": [
    {
      "name": "Mellissa’s Grandma’s Blackberry Cobbler",
      "ingredients_raw": [
        "4 cups blackberries",
        "1.5 cups white sugar",
        "2 tablespoons cornstarch",
        "2 cups water",
        "2 cups all-purpose flour",
        "0.66666668653488 cup white sugar",
        "1 teaspoon baking powder",
        "1 teaspoon salt",
        "1 cup margarine",
        "0.66666668653488 cup milk"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 425 degrees F (220 degrees C). Grease a 9x13-inch baking dish."
        },
        {
          "id": 2,
          "text": "Place blackberries, 1 ½ cups sugar, and cornstarch in a large saucepan; add water. Bring to a boil over high heat, stirring constantly until thickened, about 5 minutes. Transfer to the prepared baking dish."
        },
        {
          "id": 3,
          "text": "Whisk flour, ⅔ cup sugar, baking powder, and salt together in a large bowl; cut in margarine with 2 knives or pastry blender until mixture is pea-sized. Stir in milk until a soft dough forms. Drop dough by spoonfuls on top blackberry mixture."
        },
        {
          "id": 4,
          "text": "Bake in the preheated oven until golden brown, 30 to 45 minutes."
        }
      ],
