    {
      "name": "Homemade Irish (Whiskey) Cream",
      "ingredients_raw": [
        "1.6666666269302 cups Irish whiskey",
        "1 cup heavy cream",
        "1 (14 ounce) can sweetened condensed milk",
        "2 tablespoons instant coffee granules",
        "1 teaspoon vanilla extract",
        "1 teaspoon almond extract"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Blend the Irish whiskey, heavy cream, sweetened condensed milk, instant coffee granules, vanilla extract, and almond extract in a blender on high until frothy, 20 to 30 seconds. Chill 24 hours before using."
        }
      ],
