  "recipes": [
    {
      "name": "Cranberry-Raspberry Dessert Sauce",
      "ingredients_raw": [
        "1 cup fresh orange juice",
        "1 cup white sugar",
        "1 (12 ounce) bag fresh cranberries",
        "2 cups fresh or frozen raspberries"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Stir the orange juice and sugar together in a pan over medium heat. Add the cranberries and bring to a boil. Cook and stir until the cranberries burst. Stir in the raspberries; reduce heat and simmer 10 to 15 minutes. Refrigerate or serve warm."
        }
      ],
