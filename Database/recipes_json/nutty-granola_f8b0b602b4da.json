  "recipes": [
    {
      "name": "Nutty Granola",
      "ingredients_raw": [
        "6 cups old-fashioned oats",
        "1 cup slivered almonds",
        "1 cup flaked coconut",
        "0.5 cup hulled green pumpkin seeds",
        "0.5 cup shelled sunflower seeds",
        "0.5 cup crushed pecans",
        "1 teaspoon salt",
        "0.5 cup butter",
        "0.66666668653488 cup honey",
        "1 teaspoon vanilla extract",
        "1 cup dried cranberries"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Stir oats, almonds, coconut, pumpkin seeds, sunflower seeds, pecans, and salt, together in a large bowl."
        },
        {
          "id": 3,
          "text": "Stir butter and honey together in a small saucepan over low heat until the butter is fully melted."
        },
        {
          "id": 4,
          "text": "Stir vanilla extract into the melted butter."
        },
        {
          "id": 5,
          "text": "Pour butter mixture over oats mixture; stir until evenly coated."
        },
        {
          "id": 6,
          "text": "Spread the mixture onto 2 large baking sheets into single, even layers."
        },
        {
          "id": 7,
          "text": "Bake in preheated oven 10 minutes. Remove from oven and gently turn the granola. Continue baking until golden brown, about 10 minutes more."
        },
        {
          "id": 8,
          "text": "Set granola aside to cool to room temperature; transfer to a large bowl."
        },
        {
          "id": 9,
          "text": "Gently fold cranberries into the granola."
        }
      ],
