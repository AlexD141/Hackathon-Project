  "recipes": [
    {
      "name": "Mummy&#39;s Tea Bread",
      "ingredients_raw": [
        "1.5 cups chopped pitted dates",
        "1.5 cups white sugar",
        "1 teaspoon salt",
        "2 tablespoons butter",
        "1.5 cups boiling water",
        "1 egg, lightly beaten",
        "2.75 cups all-purpose flour",
        "1 teaspoon baking soda",
        "1 teaspoon cream of tartar",
        "1.5 teaspoons vanilla extract",
        "1 cup chopped walnuts"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease and flour 9x5 inch loaf pan."
        },
        {
          "id": 2,
          "text": "Place the dates, sugar, salt, and butter into a bowl, and pour in the boiling water. Stir together and set aside to cool. Once cool, mix in the egg."
        },
        {
          "id": 3,
          "text": "Stir the flour, baking soda, and cream of tartar together in a bowl. Pour the raisin mixture over the flour mixture, and stir together until thoroughly combined. Mix in the vanilla extract and, if desired, walnuts. Pour batter into prepared loaf pan."
        },
        {
          "id": 4,
          "text": "Bake in preheated oven until knife inserted in center comes out clean, about 1 hour 15 minutes. Cool in pan 10 minutes before turning out onto a rack to cool completely. Wrap in aluminum foil and store in the refrigerator."
        }
      ],
