            "reviewRating": {
              "@type": "Rating",
              "ratingValue": "3"
            },
            "author": {
              "@type": "Person",
              "name": "Caroline C"
            },
            "reviewBody": "We thought this was just ok. The texture isn't great, and it just wasn't creamy enough. I'll stick to my regular guac recipe. Thanks anyway.",
            "datePublished": "2006-10-31T09:29:07.083Z"
          },
          {
            "@type": "Review",
