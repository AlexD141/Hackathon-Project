    {
      "name": "Raw Pasta Sauce",
      "ingredients_raw": [
        "2 tomatoes, chopped",
        "0.25 cup chopped green bell pepper",
        "0.25 cup chopped onion",
        "1.5 teaspoons lime juice",
        "1 clove garlic, minced",
        "0.125 teaspoon sea salt",
        "0.125 teaspoon dried oregano",
        "0.125 teaspoon dried rosemary"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Puree tomatoes, including seeds and juice, in a food processor or blender. Transfer to a lidded 2-cup container."
        },
        {
          "id": 2,
          "text": "Stir green bell pepper, onion, lime juice, garlic, sea salt, oregano, and rosemary into pureed tomatoes. Place lid on container and refrigerate at least 30 minutes."
        }
      ],
