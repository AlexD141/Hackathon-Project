  "recipes": [
    {
      "name": "Simple Garlic Shrimp",
      "ingredients_raw": [
        "1.5 tablespoons olive oil",
        "1 pound shrimp, peeled and deveined",
        "salt to taste",
        "6 cloves garlic, finely minced",
        "0.25 teaspoon red pepper flakes",
        "3 tablespoons lemon juice",
        "1 tablespoon caper brine",
        "2 tablespoons cold butter, cut into 4 equal pieces, divided",
        "0.33333334326744 cup chopped flat-leaf parsley, divided",
        "1 teaspoon water, or as needed"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Heat olive oil in a large, heavy-duty skillet over high heat until it just begins to smoke. Place shrimp in an even layer in the pan; cook, undisturbed, for 1 minute."
        },
        {
          "id": 2,
          "text": "Season shrimp with salt; cook, stirring, until shrimp begin to turn pink, about 1 minute."
        },
        {
          "id": 3,
          "text": "Add garlic and red pepper flakes; cook, stirring, for 1 minute."
        },
        {
          "id": 4,
          "text": "Stir in lemon juice, caper brine, 1 piece of butter, and 1/2 of the parsley; cook until butter melts, about 1 minute."
        },
        {
          "id": 5,
          "text": "Reduce heat to low and stir in remaining 3 pieces of butter. Cook, stirring, until butter melts, sauce thickens, and shrimp are pink and opaque, 2 to 3 minutes."
        },
        {
          "id": 6,
          "text": "Remove shrimp with a slotted spoon and transfer to a bowl; continue cooking butter sauce, adding water, 1 teaspoon at a time, if too thick, about 2 minutes."
        },
        {
          "id": 7,
          "text": "Season with salt to taste; serve shrimp topped with the pan sauce and remaining parsley."
        }
      ],
