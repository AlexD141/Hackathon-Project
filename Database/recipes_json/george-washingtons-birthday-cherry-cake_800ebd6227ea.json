  "recipes": [
    {
      "name": "George Washington&#39;s Birthday Cherry Cake",
      "ingredients_raw": [
        "1 teaspoon vegetable shortening",
        "2 cups all-purpose flour",
        "0.75 cup white sugar",
        "0.75 cup vegetable oil",
        "2 eggs",
        "2 teaspoons vanilla extract",
        "1 teaspoon baking soda",
        "1 teaspoon ground cinnamon",
        "1 dash salt",
        "1 (21 ounce) can cherry pie filling",
        "1 (6 ounce) package semisweet chocolate chips",
        "1 cup chopped walnuts",
        "2 teaspoons confectioners' sugar for dusting"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C). Thoroughly grease a 9-inch Bundt® pan with shortening, then dust with flour. Shake off any excess flour from the pan."
        },
        {
          "id": 2,
          "text": "In a bowl, mix together the flour, sugar, vegetable oil, eggs, vanilla extract, baking soda, cinnamon, and salt until thoroughly combined. Gently mix in the cherry pie filling, chocolate chips and nuts, and scrape the batter into the prepared pan."
        },
        {
          "id": 3,
          "text": "Bake in the preheated oven until a toothpick inserted into the center of the cake comes out with moist crumbs, about 1 hour. Allow to cool for 10 minutes, then invert pan and remove cake. Allow cake to finish cooling on a rack; sprinkle lightly with confectioners&#39; sugar."
        }
      ],
