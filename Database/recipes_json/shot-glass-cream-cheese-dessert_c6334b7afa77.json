  "recipes": [
    {
      "name": "Shot Glass Cream Cheese Dessert",
      "ingredients_raw": [
        "0.5 cup miniature chocolate chips",
        "2 (8 ounce) packages cream cheese",
        "0.75 cup white sugar",
        "1.5 cups chocolate chips",
        "12 milk chocolate candy kisses (such as Hershey's Kisses®)"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Line the bottom of 12 shot glasses with miniature chocolate chips."
        },
        {
          "id": 2,
          "text": "Whip cream cheese and sugar together in a bowl with an electric hand mixer on medium speed."
        },
        {
          "id": 3,
          "text": "Layer cream cheese into the shot glasses, alternating with layers of chocolate chips. Garnish with milk chocolate candy kisses."
        }
      ],
