  "recipes": [
    {
      "name": "Homemade Mozzarella Sticks",
      "ingredients_raw": [
        "2 large eggs",
        "2 cups milk",
        "1.5 cups Italian seasoned bread crumbs",
        "10 egg roll wrappers",
        "10 mozzarella string cheese sticks",
        "1 quart vegetable oil for frying"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Beat eggs in a mixing bowl. Whisk in milk, then set aside."
        },
        {
          "id": 2,
          "text": "Place bread crumbs into a resealable plastic bag; set aside."
        },
        {
          "id": 3,
          "text": "Separate and lay an egg roll wrapper onto a flat, clean work surface with one of the tips pointed towards you. Moisten the two far edges of the wrapper with water. Place a string cheese stick onto the corner nearest you, then roll it in 1/3 of the way. Fold over the right and left corners, then continue rolling to the end, pressing to seal. Repeat this step with remaining string cheese sticks and egg roll wrappers."
        },
        {
          "id": 4,
          "text": "Heat oil in a deep fryer or large saucepan to 375 degrees F (190 degrees C)."
        },
        {
          "id": 5,
          "text": "Dip mozzarella sticks into egg mixture, then toss in bread crumbs."
        },
        {
          "id": 6,
          "text": "Working in batches, fry breaded mozzarella sticks in hot oil until crisp and golden brown, 3 to 4 minutes."
        }
      ],
