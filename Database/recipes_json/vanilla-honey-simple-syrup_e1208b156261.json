  "recipes": [
    {
      "name": "Vanilla Honey Simple Syrup",
      "ingredients_raw": [
        "2 teaspoons milk",
        "2 teaspoons vanilla extract",
        "1 tablespoon honey",
        "2 teaspoons butter"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine milk and vanilla extract in a bowl."
        },
        {
          "id": 2,
          "text": "Heat honey and butter together in a microwave-safe bowl in the microwave for 30 seconds; stir into milk mixture."
        },
        {
          "id": 3,
          "text": "Allow to cool completely before use. Chill in the refrigerator if too hot."
        }
      ],
