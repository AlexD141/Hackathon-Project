    {
      "name": "Aranitas (Shredded Green Plantain Patties)",
      "ingredients_raw": [
        "3 cups canola oil for frying",
        "2 green plantains, peeled and shredded",
        "2 teaspoons garlic salt"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Heat canola oil in a deep-fryer or large saucepan to 375 degrees F (190 degrees C). Gather about 2 tablespoons of shredded plantains and shape into patties."
        },
        {
          "id": 2,
          "text": "Fry the patties in the preheated oil until golden and crispy, about 10 minutes. Drain on paper towels and season with garlic salt."
        }
