  "recipes": [
    {
      "name": "Traditional Shoofly Pie",
      "ingredients_raw": [
        "2 (9 inch) unbaked pie crusts",
        "1 teaspoon baking soda",
        "1 cup warm water",
        "1 cup molasses",
        "2 cups all-purpose flour",
        "0.5 cup white sugar",
        "0.5 teaspoon baking soda",
        "0.25 cup butter"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place pie crusts in 9 inch pie pans. Chill the crusts approximately 1 hour before use."
        },
        {
          "id": 2,
          "text": "Preheat oven to 425 degrees F (220 degrees C)."
        },
        {
          "id": 3,
          "text": "In a medium bowl, stir together the baking soda and warm water. Mix in the molasses and stir until foamy. Transfer the mixture to the pie crusts."
        },
        {
          "id": 4,
          "text": "In a medium bowl, mix together flour, sugar and baking soda. Use a pastry blender to cut the butter into the flour mixture until very fine crumbs have formed. Sprinkle the crumbs over the molasses mixture in the pie crusts."
        },
        {
          "id": 5,
          "text": "Bake in the preheated oven 10 minutes. Reduce heat to 350 degrees F (175 degrees C), and continue baking 35 minutes, or until crust is lightly browned and the filling has set."
        }
      ],
      "warnings": [],
