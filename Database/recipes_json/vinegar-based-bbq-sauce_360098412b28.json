  "recipes": [
    {
      "name": "Vinegar-Based BBQ Sauce",
      "ingredients_raw": [
        "1 cup cider vinegar",
        "1 tablespoon brown sugar",
        "1 tablespoon kosher salt",
        "1 teaspoon crushed red pepper flakes",
        "0.5 teaspoon cayenne pepper"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Stir together vinegar, brown sugar, kosher salt, red pepper flakes, and cayenne pepper in a small bowl until combined. Allow to sit at room temperature until flavors meld, 4 to 8 hours."
        }
      ],
