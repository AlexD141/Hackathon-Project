  "recipes": [
    {
      "name": "Chicken Matzo Ball Soup",
      "ingredients_raw": [
        "2 eggs, lightly beaten",
        "2 tablespoons melted butter or margarine",
        "0.5 cup matzo meal",
        "1 tablespoon water",
        "1 teaspoon chopped fresh flat-leaf parsley",
        "0.5 teaspoon salt",
        "1 dash white pepper",
        "6 cups chicken broth",
        "1 medium carrot, cut into 2 inch julienne strips"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine eggs and melted butter in a small bowl; stir in matzo meal, water, parsley, salt, and white pepper until a soft dough forms. Cover the bowl; refrigerate at least 30 minutes."
        },
        {
          "id": 2,
          "text": "Bring chicken broth and carrots to a boil in a large pot; reduce heat to a simmer."
        },
        {
          "id": 3,
          "text": "Meanwhile, shape matzo dough into 12 balls. (For easier shaping, dip hands in cold water from time to time.) Drop matzo balls into simmering broth; cover the pot and cook 30 to 40 minutes."
        }
      ],
