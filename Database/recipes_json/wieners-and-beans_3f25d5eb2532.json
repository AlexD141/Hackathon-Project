  "recipes": [
    {
      "name": "Wieners and Beans",
      "ingredients_raw": [
        "8 beef frankfurters",
        "4 tablespoons barbeque sauce",
        "2 teaspoons dry mustard",
        "2 (16 ounce) cans baked beans with pork"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a saucepan filled with water, boil the frankfurters for about 5 minutes."
        },
        {
          "id": 2,
          "text": "In another saucepan, combine barbeque sauce, dry mustard and baked beans. Stir and heat."
        },
        {
          "id": 3,
          "text": "When the frankfurters are cooked, combine them with the sauce mixture for about 10 to 15 minutes or until heated through."
        }
      ],
