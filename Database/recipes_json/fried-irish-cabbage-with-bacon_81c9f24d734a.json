  "recipes": [
    {
      "name": "Irish Fried Cabbage with Bacon",
      "ingredients_raw": [
        "1 (12 ounce) package bacon",
        "0.25 cup bacon drippings",
        "1 small head cabbage, cored and finely chopped",
        "ground black pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Cook bacon in a deep skillet over medium heat until crisp, 5 to 7 minutes. Remove bacon from skillet and drain on a paper towel-lined plate. Reserve 1/4 cup drippings in skillet."
        },
        {
          "id": 2,
          "text": "Add cabbage to hot bacon drippings; cook and stir over medium heat until cabbage wilts, 5 to 7 minutes."
        },
        {
          "id": 3,
          "text": "Crumble bacon over cabbage. Stir and simmer until bacon is warmed, 2 to 3 minutes. Season with black pepper."
        }
      ],
