            "author": {
              "@type": "Person",
              "name": "T C"
            },
            "reviewBody": "Easy and delicious! My family loves this recipe and I love that they get so much calcium from it. It does set very firm, but we like pudding like that (much better than not setting and being loose).",
            "datePublished": "2018-01-04T14:13:59.207Z"
          }
