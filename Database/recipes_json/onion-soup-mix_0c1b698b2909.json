            },
            "author": {
              "@type": "Person",
              "name": "SLJ6"
            },
            "reviewBody": "I used no sodium boullion packets instead of the cubes. Made onion dip with low fat sour cream. Very nice....made the day before serving so the onions had a chance to re-hydrate. Thanks!",
            "datePublished": "2013-03-03T10:37:29.413Z"
