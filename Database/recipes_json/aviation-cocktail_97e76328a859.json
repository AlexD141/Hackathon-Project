    {
      "name": "Aviation Cocktail",
      "ingredients_raw": [
        "2 fluid ounces gin",
        "1 tablespoon maraschino liqueur",
        "0.25 fluid ounce lemon juice",
        "1 cup ice",
        "maraschino cherry for garnish"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine gin, maraschino liqueur, and lemon juice in a cocktail shaker. Add ice, cover and shake until chilled. Strain into a chilled cocktail glass."
        },
        {
          "id": 2,
          "text": "Garnish with maraschino cherry."
        }
      ],
