  "recipes": [
    {
      "name": "Unstuffed Cabbage",
      "ingredients_raw": [
        "5 cups shredded cabbage",
        "1 (12 ounce) package vegetarian burger crumbles",
        "2 (14.5 ounce) cans Italian-style stewed tomatoes",
        "0.5 tablespoon lemon juice",
        "1 tablespoon brown sugar",
        "0.5 cup chopped fresh dill",
        "0.5 teaspoon ground allspice",
        "freshly ground black pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Heat a large skillet over a medium heat. Stir in cabbage and let it cook 4 minutes; or until wilted and lightly browned."
        },
        {
          "id": 2,
          "text": "Stir vegetarian burger crumbles, tomatoes, lemon juice, brown sugar, dill, allspice, and pepper into the mixture. Bring the mixture to a boil, cover and reduce the heat to low. Let the mixture simmer 5 minutes before serving."
        }
      ],
