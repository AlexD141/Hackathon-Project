    {
      "name": "Grown-Up Orange Juice",
      "ingredients_raw": [
        "1 cup orange juice",
        "1 (1.5 fluid ounce) jigger rum",
        "1 egg",
        "6 ice cubes",
        "2 orange slices for garnish",
        "2 maraschino cherries for garnish"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Pour the orange juice and rum into a blender. Mix in the egg and pulse until smooth. Add the ice cubes and blend. Divide the mixture between two tall glasses and garnish each drink with orange slices and maraschino cherries."
        }
      ],
