  "recipes": [
    {
      "name": "Ginger-Cinnamon Cranberry Sauce",
      "ingredients_raw": [
        "1 cup water",
        "1 cup white sugar",
        "2 cups fresh cranberries",
        "1 (1 inch) piece fresh ginger, peeled",
        "1 cinnamon stick"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Bring water and sugar to a boil in a pot over medium heat; boil for 5 minutes stirring occasionally. Add the cranberries, ginger, and cinnamon stick; return the mixture to a boil and cook until the cranberries start popping, about 5 minutes. Transfer the sauce to a shallow container; chill in refrigerator until cold, about 3 hours."
        }
      ],
