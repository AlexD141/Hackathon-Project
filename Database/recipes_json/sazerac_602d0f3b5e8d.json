            },
            "author": {
              "@type": "Person",
              "name": "Martha Harrington Duran"
            },
            "reviewBody": "Sazerac should not have ice in the glass. You should chill or freeze the glass for about 30 minutes and then strain the liquid from your cocktail shaker and drink straight. The chilled glass and the shaking with the ice will make the drink cold.",
            "datePublished": "2009-02-23T15:16:44.627Z"
