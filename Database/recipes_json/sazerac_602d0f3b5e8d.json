  "recipes": [
    {
      "name": "Sazerac",
      "ingredients_raw": [
        "0.25 teaspoon anise flavored liqueur",
        "0.5 teaspoon white sugar",
        "1 teaspoon water",
        "2 dashes Peychaud bitters",
        "ice cubes",
        "0.25 cup rye whiskey",
        "1 lemon twist, for garnish"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place a cocktail glass in the freezer for 15 to 20 minutes before making the cocktail."
        },
        {
          "id": 2,
          "text": "Pour anise-flavored liqueur into the frosted glass and turn to coat the sides. Dump excess liqueur in the sink (or drink it!)."
        },
        {
          "id": 3,
          "text": "Add sugar, water, and bitters to the glass, stirring to dissolve. Add ice cubes and rye whiskey. Stir and garnish with a twist of lemon."
        }
      ],
