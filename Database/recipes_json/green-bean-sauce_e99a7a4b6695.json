        "1 cup mayonnaise",
        "0.5 teaspoon prepared horseradish",
        "0.5 teaspoon lemon juice",
        "0.25 teaspoon salt",
        "0.125 teaspoon ground black pepper",
        "1 pinch garlic powder",
        "1 pinch dried parsley, or to taste",
        "1 dash Worcestershire sauce, or to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Mix the eggs, mayonnaise, horseradish, lemon juice, salt, black pepper, garlic powder, parsley, and Worcestershire sauce in a bowl until well blended."
        }
      ],
