  "recipes": [
    {
      "name": "Tomato Bread III",
      "ingredients_raw": [
        "2.5 cups all-purpose flour",
        "1 teaspoon baking powder",
        "1 teaspoon salt",
        "2 teaspoons Italian seasoning",
        "1 teaspoon dried thyme",
        "0.75 teaspoon white sugar",
        "0.5 cup shredded Cheddar cheese",
        "4 tablespoons grated Parmesan cheese",
        "3 tablespoons milk",
        "2 eggs, beaten",
        "0.25 cup vegetable oil",
        "2 teaspoons minced garlic",
        "1 (14.5 ounce) can stewed tomatoes, drained",
        "0.33333298563957 cup sliced black olives"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease an 8x4 inch loaf pan."
        },
        {
          "id": 2,
          "text": "In a large bowl, stir together flour, baking powder, salt, Italian seasoning, thyme, sugar, Cheddar and Parmesan cheeses. In a separate bowl, mix together 1/2 cup reserved tomato juice, milk, eggs, oil and garlic. Combine liquid and dry mixtures. Fold in chopped tomatoes and olives. Pour batter into prepared pan."
        },
        {
          "id": 3,
          "text": "Bake in preheated oven for 60 minutes or until toothpick inserted into center of the loaf comes out clean."
        }
      ],
