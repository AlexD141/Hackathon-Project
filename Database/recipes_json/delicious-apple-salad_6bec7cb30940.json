    {
      "name": "Delicious Apple Salad",
      "ingredients_raw": [
        "10 Granny Smith apples - peeled, cored and chopped",
        "2 (8 ounce) cans pineapple chunks",
        "2 cups raisins",
        "1 cup chopped pecans",
        "20 ounces sour cream",
        "1 teaspoon granulated sugar"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine the apples, undrained pineapple, raisins, pecans and sour cream. Mix well and add sugar to taste. Serve chilled."
        }
      ],
