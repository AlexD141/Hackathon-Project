  "recipes": [
    {
      "name": "Tangy Banana Salad",
      "ingredients_raw": [
        "1 cup plain yogurt",
        "1 teaspoon mustard powder",
        "1 pinch salt",
        "3 bananas, sliced",
        "1 teaspoon minced fresh cilantro",
        "1 pinch chili powder"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Mix together the yogurt, mustard powder, and salt in a serving bowl. Add the banana slices and stir gently until bananas are evenly coated with yogurt mixture."
        },
        {
          "id": 2,
          "text": "Garnish with chopped cilantro and chili powder. Serve immediately."
        }
      ],
