  "recipes": [
    {
      "name": "Chocolate Almond Bread Pudding",
      "ingredients_raw": [
        "3 tablespoons butter, melted",
        "12 slices day-old bread, cut into 1-inch cubes",
        "0.5 cup dark chocolate chips, or to taste",
        "0.25 cup sliced almonds, or to taste",
        "8 eggs, beaten",
        "3 cups milk",
        "1.5 cups white sugar",
        "2 teaspoons ground cinnamon",
        "2 teaspoons vanilla extract",
        "2 teaspoons almond extract",
        "1 teaspoon ground nutmeg"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Pour melted butter over bread cubes in a 9x13-inch baking dish; toss to coat. Stir chocolate chips and almonds into bread mixture."
        },
        {
          "id": 3,
          "text": "Whisk eggs, milk, sugar, cinnamon, vanilla extract, almond extract, and nutmeg in a bowl; pour over bread mixture, lightly pressing bread with a spatula until egg mixture is absorbed."
        },
        {
          "id": 4,
          "text": "Bake in the preheated oven until the top of the bread pudding springs back when lightly pressed, about 45 minutes."
        }
      ],
