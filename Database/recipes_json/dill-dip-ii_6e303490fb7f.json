      "name": "Dill Dip II",
      "ingredients_raw": [
        "1 cup sour cream",
        "1 cup mayonnaise",
        "1 teaspoon monosodium glutamate (MSG)",
        "1 teaspoon seasoning salt",
        "1 teaspoon dried parsley",
        "1.25 teaspoons dried dill weed"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a medium bowl, combine sour cream, mayonnaise, monosodium glutamate, seasoning salt, parsley and dill. Cover and refrigerate overnight."
        }
