      "name": "Arugula Caprese Salad",
      "ingredients_raw": [
        "1 (5 ounce) package baby arugula",
        "1 cup halved grape tomatoes",
        "1 cup small fresh mozzarella balls",
        "0.5 cup garlic seasoned croutons",
        "1 tablespoon basil paste",
        "0.25 cup balsamic vinaigrette salad dressing",
        "1 pinch salt and ground black pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Toss arugula, tomatoes, mozzarella cheese balls, and croutons in a large bowl."
        },
        {
          "id": 2,
          "text": "Whisk basil paste into the balsamic salad dressing; pour on salad and toss to combine. Season salad with salt and black pepper, if desired."
        }
      ],
