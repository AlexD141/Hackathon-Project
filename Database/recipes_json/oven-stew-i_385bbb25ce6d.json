  "recipes": [
    {
      "name": "Oven Stew I",
      "ingredients_raw": [
        "2 pounds cubed beef stew meat",
        "1 onion, chopped",
        "8 carrots, chopped",
        "5 potatoes, chopped",
        "0.75 cup tomato sauce",
        "0.33329999446869 cup water",
        "3 tablespoons tapioca",
        "1 teaspoon white sugar",
        "salt and pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a large stock pot combine meat, onion, carrots and potatoes."
        },
        {
          "id": 2,
          "text": "Mix together tomato sauce, water, tapioca, sugar and season with salt and pepper. Pour over meat and vegetables and cover. Bake at 250 degrees F (120 degrees C) for 5 hours."
        }
      ],
