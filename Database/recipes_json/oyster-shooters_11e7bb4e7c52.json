  "recipes": [
    {
      "name": "Oyster Shooters",
      "ingredients_raw": [
        "9 fluid ounces tomato juice",
        "1 teaspoon prepared horseradish",
        "2 teaspoons freshly ground black pepper",
        "12 (1.5 fluid ounce) jiggers vodka",
        "12 shucked oysters",
        "1 lemon - cut into wedges, for garnish"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Mix tomato juice, horseradish, and pepper in a large bowl until well combined."
        },
        {
          "id": 2,
          "text": "Pour 1/2 shot of tomato juice mixture into 12 small glasses. Add a shot of vodka to each glass. Place 1 raw oyster in each glass and garnish with a lemon wedge."
        }
      ],
