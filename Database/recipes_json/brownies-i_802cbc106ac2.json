  "recipes": [
    {
      "name": "Brownies I",
      "ingredients_raw": [
        "6 (1 ounce) squares unsweetened chocolate",
        "0.66666698455811 cup butter",
        "2 cups white sugar",
        "4 eggs",
        "1.25 cups all-purpose flour",
        "1 teaspoon salt",
        "1 teaspoon baking powder",
        "0.5 cup chopped walnuts"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9 x 13 inch pan."
        },
        {
          "id": 2,
          "text": "Melt the chocolate and butter in the top of a double-boiler, stirring sporadically. When melted and combined, add the sugar and eggs, and stir until combined. Sift the flour, salt, and baking powder into the pan; stir until combined. Stir in the nuts (or raisins, or M&amp;M candies, or toffee bits, etc.)."
        },
        {
          "id": 3,
          "text": "Spread the batter in the pan, smoothing it into the corners. Bake for about 35 minutes, but don&#39;t let it over-bake. Cool before cutting."
        }
      ],
