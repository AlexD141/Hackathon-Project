  "recipes": [
    {
      "name": "Hot Buttered Rum Batter",
      "ingredients_raw": [
        "2 cups butter",
        "2 cups white sugar",
        "2 cups brown sugar",
        "1 teaspoon vanilla extract",
        "1 quart vanilla ice cream, softened"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a microwave-safe bowl, combine butter, sugar, brown sugar and vanilla. Microwave until smooth. Mix in the ice cream. Place in a sealable container and freeze."
        },
        {
          "id": 2,
          "text": "When ready to use, spoon 1 1/2 tablespoons of the base into a mug. Pour in 1 shot of dark rum and 1 cup of hot water for each serving."
        }
      ],
