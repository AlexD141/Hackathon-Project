  "recipes": [
    {
      "name": "Marian&#39;s Delicious Strawberry Sauce",
      "ingredients_raw": [
        "3.5 cups fresh strawberries",
        "lemon, juiced",
        "1 cup white sugar",
        "1 tablespoon cornstarch",
        "0.25 teaspoon salt"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Mash the strawberries with a potato masher in a pot. Stir the lemon juice, sugar, cornstarch, and salt into the mashed strawberries. Place the pot over medium heat. Stirring constantly, bring the mixture to a boil; remove immediately from the heat and allow to cool to room temperature."
        }
      ],
