    {
      "name": "Grilled Yams",
      "ingredients_raw": [
        "olive oil-flavored cooking spray",
        "1 large yam, peeled and cut into 1/2 inch thick slices",
        "salt to taste",
        "1 tablespoon butter"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the grill to high heat and lightly oil the grate."
        },
        {
          "id": 2,
          "text": "Coat yam slices with cooking spray and season with salt."
        },
        {
          "id": 3,
          "text": "Arrange yam slices on the grate crosswise, so they don&#39;t fall through. Cook until tender and glazed, 10 to 12 minutes per side. Serve with butter."
        }
      ],
