  "recipes": [
    {
      "name": "Fudge Quickies",
      "ingredients_raw": [
        "2 cups white sugar",
        "2 cups packed brown sugar",
        "1 cup butter",
        "1 cup milk",
        "2 cups semisweet chocolate chips",
        "4 cups quick cooking oats",
        "1 cup chopped walnuts",
        "1 cup flaked coconut"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place oats, nuts, coconut, and chocolate chips in a large bowl."
        },
        {
          "id": 2,
          "text": "Place sugars, butter or margarine, and milk in a saucepan. Bring to a boil, and continue to boil for 2 minutes. Pour hot mixture over oat mixture. Mix well. Drop from a teaspoon onto wax paper. Allow to set up."
        }
      ],
