  "recipes": [
    {
      "name": "Maryellen&#39;s Baked Onions",
      "ingredients_raw": [
        "6 sweet onions",
        "0.25 cup balsamic vinegar",
        "0.25 cup honey",
        "0.18250000476837 teaspoon fresh chopped tarragon"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Peel onions and make two cross cuts on the top of the onion. Place in a clay cooker or casserole dish."
        },
        {
          "id": 3,
          "text": "Mix together the Balsamic vinegar, honey and tarragon. Pour over onions and marinate for 1 hour."
        },
        {
          "id": 4,
          "text": "Bake for 30 to 40 minutes or until onions are tender."
        }
      ],
      "warnings": [],
