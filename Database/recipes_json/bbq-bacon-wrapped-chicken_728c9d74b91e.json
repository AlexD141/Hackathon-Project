  "recipes": [
    {
      "name": "BBQ Bacon-Wrapped Chicken",
      "ingredients_raw": [
        "8 slices bacon",
        "4 boneless chicken breasts, skin on",
        "0.5 teaspoon salt",
        "0.5 teaspoon pepper",
        "0.75 cup Heinz Tomato Ketchup",
        "0.33333334326744 cup maple syrup",
        "2 tablespoons grainy Dijon mustard",
        "2 tablespoons lemon juice",
        "1 clove garlic, minced",
        "Lemon wedges",
        "Chopped fresh chives"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Cook bacon until just opaque. Blot on paper towels. Sprinkle chicken evenly with salt and pepper. Wrap each chicken breast in bacon, securing strips in place with toothpicks. Set aside."
        },
        {
          "id": 2,
          "text": "Preheat the grill to medium-high."
        },
        {
          "id": 3,
          "text": "Blend ketchup with maple syrup, mustard, lemon juice, and garlic. Brush half the sauce all over chicken."
        },
        {
          "id": 4,
          "text": "Place chicken on the grill and turn heat down to medium. Grill, turning and basting twice with remaining sauce until bacon is almost crisp or until chicken is cooked through, about 15 minutes."
        },
        {
          "id": 5,
          "text": "Squeeze lemon wedges over chicken and sprinkle with chives. Remove toothpicks before serving."
        }
      ],
