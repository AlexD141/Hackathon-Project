  "recipes": [
    {
      "name": "Cracker Cookie Brittle",
      "ingredients_raw": [
        "1.5 (8 ounce) packages thin round wheat crackers (such as Dare Breton®) Original Crackers)",
        "1 cup butter",
        "1 cup brown sugar",
        "1 cup chocolate chips",
        "0.5 cup chopped walnuts"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with heavy-duty aluminum foil."
        },
        {
          "id": 2,
          "text": "Place crackers on the foil-lined baking sheet in a single layer so they overlap like shingles. Add butter and sugar to a saucepan over medium heat. Bring to a boil and continue to cook until sugar dissolves, about 3 minutes. Pour butter-sugar mixture evenly over crackers."
        },
        {
          "id": 3,
          "text": "Bake in the preheated oven for 15 minutes; remove from oven, and sprinkle with chocolate chips."
        },
        {
          "id": 4,
          "text": "Let stand until chips have melted, about 2 minutes. Spread chocolate over crackers with a spreader or kitchen knife. Sprinkle with nuts."
        },
        {
          "id": 5,
          "text": "Allow to cool completely, about 1 hour. Break into chunks, and store in an airtight, sealed container."
        }
      ],
