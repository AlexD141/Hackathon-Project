  "recipes": [
    {
      "name": "Kicked-Up Potato Pancakes",
      "ingredients_raw": [
        "2 large potatoes, peeled and shredded",
        "0.75 cup shredded deli smoked ham",
        "3 eggs",
        "0.75 cup shredded mozzarella cheese",
        "1 teaspoon onion powder",
        "1 teaspoon garlic powder",
        "salt and ground black pepper to taste",
        "olive oil for frying",
        "1 green onion, chopped",
        "0.5 cup grated Parmesan cheese"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine potatoes, ham, eggs, mozzarella cheese, onion powder, garlic powder, salt, and black pepper in a bowl."
        },
        {
          "id": 2,
          "text": "Heat a large skillet over medium-low heat. Pour enough olive oil to cover bottom of pan."
        },
        {
          "id": 3,
          "text": "Scoop up about 1/2 cup of potato mixture per pancake and form into a patty. Repeat, making 8 patties in all."
        },
        {
          "id": 4,
          "text": "Place 4 pancakes at time in hot olive oil. Cook until browned, about 4 minutes on each side. Transfer to paper towel-lined plate."
        },
        {
          "id": 5,
          "text": "Sprinkle with green onion and Parmesan cheese."
        }
      ],
