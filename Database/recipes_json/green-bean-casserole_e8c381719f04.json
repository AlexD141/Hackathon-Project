  "recipes": [
    {
      "name": "Pearl&#39;s Green Bean Casserole",
      "ingredients_raw": [
        "1 (14.5 ounce) can French style green beans, drained",
        "1 (10.75 ounce) can condensed cream of mushroom soup",
        "1 (6 ounce) can French-fried onions"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Combine green beans and soup in a small casserole dish."
        },
        {
          "id": 3,
          "text": "Bake in the preheated oven for 10 to 15 minutes. Remove from the oven and top with onions. Bake for another 10 minutes."
        }
      ],
