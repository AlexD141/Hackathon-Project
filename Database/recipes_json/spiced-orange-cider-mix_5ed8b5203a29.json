  "recipes": [
    {
      "name": "Spiced Orange Cider Mix",
      "ingredients_raw": [
        "1 cup white sugar",
        "1 cup orange flavored drink mix (such as Tang®)",
        "0.5 cup instant tea powder",
        "0.5 teaspoon ground cinnamon",
        "0.5 teaspoon ground cloves"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine sugar, orange flavored drink mix, tea powder, cinnamon, and cloves in a large bowl. Store in a sealed container."
        },
        {
          "id": 2,
          "text": "To serve, mix 2 to 3 tablespoons of the mixture with a cup of hot water."
        }
      ],
