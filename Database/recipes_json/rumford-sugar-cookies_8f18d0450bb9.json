  "recipes": [
    {
      "name": "Rumford Sugar Cookies",
      "ingredients_raw": [
        "2 cups white sugar",
        "1 cup shortening",
        "3 eggs",
        "2 tablespoons water",
        "3 teaspoons baking powder",
        "1 teaspoon ground nutmeg",
        "0.5 teaspoon ground cloves",
        "3 cups all-purpose flour"
      ],
      "steps": [
        {
          "id": 1,
          "text": "(Directions as written:) Cream fat and sugar, beat in whipped eggs, add baking powder and 1 cup flour, then water and spices; add remaining flour gradually, working in more flour until dough is stiff enough to roll."
        },
        {
          "id": 2,
          "text": "Sprinkle flour over pastry board. Make a ball of dough, lay it on the board. Rub rolling pin with flour and roll out dough into a sheet 1/4 inch thick. Cut in round cakes, sift granulated sugar over each, and bake quickly 400 - 450 F. (200 - 230 C)."
        }
      ],
