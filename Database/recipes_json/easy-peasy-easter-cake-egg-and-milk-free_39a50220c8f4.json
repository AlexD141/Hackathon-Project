  "recipes": [
    {
      "name": "Easy Peasy Easter Cake (Egg and Milk Free!)",
      "ingredients_raw": [
        "1.5 cups cake flour",
        "1 cup white sugar",
        "3 tablespoons unsweetened cocoa powder",
        "0.75 teaspoon baking powder",
        "0.75 teaspoon baking soda",
        "0.5 teaspoon salt",
        "1 cup water",
        "5 tablespoons vegetable oil",
        "1 tablespoon vinegar",
        "1 teaspoon vanilla extract"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Grease and flour an 9x9-inch cake pan."
        },
        {
          "id": 3,
          "text": "Whisk together cake flour, sugar, cocoa powder, baking powder, baking soda, and salt in a large bowl. Make a well in the middle of the dry ingredients"
        },
        {
          "id": 4,
          "text": "Whisk water, vegetable oil, vinegar, and vanilla extract in a separate bowl until thoroughly combined; pour the wet ingredients into the well in flour mixture."
        },
        {
          "id": 5,
          "text": "Stir until batter is smooth. Pour into prepared cake pan."
        },
        {
          "id": 6,
          "text": "Bake in preheated oven until cake springs back when lightly touched and a toothpick inserted into the center comes out clean, about 45 minutes."
        },
        {
          "id": 7,
          "text": "Cool in pan on wire rack for 15 minutes before removing cake to finish cooling on rack."
        }
      ],
      "warnings": [],
