  "recipes": [
    {
      "name": "Pittsburgh Football Party Cilantro Salsa",
      "ingredients_raw": [
        "1 bunch cilantro, chopped",
        "3 large fresh tomatoes, diced",
        "1 red onion, diced",
        "2 jalapeno peppers, seeded and chopped",
        "2 tomatillos, diced",
        "2 tablespoons lime juice",
        "1 teaspoon hot chili sauce (such as Sriracha)",
        "1 teaspoon freshly ground cumin seed",
        "salt, to taste",
        "corn tortilla chips"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Mix together the cilantro, tomatoes, red onion, jalapeno, tomatillos, lime juice, hot chili sauce and cumin seed in a large bowl. Season with salt to taste."
        },
        {
          "id": 2,
          "text": "Cover and refrigerate overnight before serving to blend flavors. Serve with tortilla chips."
        }
      ],
