  "recipes": [
    {
      "name": "Quick Pasta Sauce",
      "ingredients_raw": [
        "2 tablespoons olive oil",
        "3 cloves garlic, minced",
        "1 (28 ounce) can crushed tomatoes",
        "1 teaspoon dried basil",
        "salt and pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather the ingredients."
        },
        {
          "id": 2,
          "text": "Heat oil in a large skillet over low heat; add garlic and sauté until tender, about 2 minutes."
        },
        {
          "id": 3,
          "text": "Stir in crushed tomatoes, basil, salt, and pepper. Simmer, stirring occasionally, until slightly thickened, 15 to 20 minutes. Serve immediately."
        }
      ],
