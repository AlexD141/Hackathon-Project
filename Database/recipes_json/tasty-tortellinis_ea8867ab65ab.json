  "recipes": [
    {
      "name": "Tasty Tortellinis",
      "ingredients_raw": [
        "20 ounces cheese tortellini",
        "0.33333298563957 cup red wine vinegar",
        "0.75 cup olive oil",
        "1.5 tablespoons prepared Dijon-style mustard",
        "2 cloves garlic, minced",
        "2 tablespoons chopped fresh basil",
        "2 tablespoons chopped fresh parsley",
        "4 green onions, thinly sliced",
        "salt to taste",
        "ground black pepper to taste",
        "1 cup black olives",
        "6 tablespoons grated Parmesan cheese"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Cook tortellini according to package directions--al dente."
        },
        {
          "id": 2,
          "text": "While tortellini is cooking, prepare marinade. Combine vinegar, mustard, garlic, basil, chopped parsley, onions, and salt and pepper to taste."
        },
        {
          "id": 3,
          "text": "Drain tortellini and rinse in cold water. Pour marinade over tortellini, add olives (and optional ingredients, see above) and refrigerate. When ready to serve, add Parmesan and some fresh parsley for garnish, if desired. Serve with toothpicks."
        }
      ],
