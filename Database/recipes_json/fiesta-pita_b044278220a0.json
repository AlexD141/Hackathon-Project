  "recipes": [
    {
      "name": "Fiesta Pita",
      "ingredients_raw": [
        "1 (6 inch) whole wheat pita bread",
        "0.5 cup vegetarian refried beans",
        "0.25 avocado - peeled, pitted and diced",
        "2 tablespoons fresh salsa, or to taste",
        "2 tablespoons crumbled feta cheese, divided",
        "2 teaspoons chopped fresh cilantro, or to taste",
        "hot sauce to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Warm pita in a toaster oven until fragrant, 1 to 2 minutes; cut in half and open up each half."
        },
        {
          "id": 2,
          "text": "Heat beans in a small saucepan over medium heat until hot; stir in avocado. Divide bean mixture in half; fill each half pita with bean mixture and top with salsa, feta cheese, cilantro, and hot sauce."
        }
      ],
