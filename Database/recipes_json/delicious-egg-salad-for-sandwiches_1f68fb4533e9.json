  "recipes": [
    {
      "name": "Delicious Egg Salad",
      "ingredients_raw": [
        "8 eggs",
        "0.5 cup mayonnaise",
        "0.25 cup chopped green onion",
        "1 teaspoon prepared yellow mustard",
        "0.25 teaspoon paprika",
        "salt and pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Place eggs in a saucepan and cover with cold water. Bring water to a boil and immediately remove from heat. Cover and let eggs stand in hot water for 10 to 12 minutes."
        },
        {
          "id": 3,
          "text": "Remove eggs from hot water; cool, peel, and chop."
        },
        {
          "id": 4,
          "text": "Place chopped eggs in a bowl; stir in mayonnaise, green onion, and mustard. Season with paprika, salt, and pepper."
        },
        {
          "id": 5,
          "text": "Stir and serve on your favorite bread, crackers, or salad greens."
        }
      ],
