  "recipes": [
    {
      "name": "Brown Rice and Corn Cakes",
      "ingredients_raw": [
        "2 (15.25 ounce) cans whole kernel sweet corn, drained",
        "2 cups cooked brown rice, cooled",
        "0.5 cup skim milk",
        "2 eggs, beaten",
        "2 tablespoons chopped fresh chives",
        "0.66666668653488 cup whole wheat flour",
        "2 teaspoons baking powder",
        "0.125 teaspoon ground nutmeg",
        "salt and ground black pepper to taste",
        "1 tablespoon olive oil, or as needed"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine corn, rice, milk, eggs, and chives in a large bowl."
        },
        {
          "id": 2,
          "text": "Mix flour, baking powder, nutmeg, salt, and black pepper together in a separate bowl."
        },
        {
          "id": 3,
          "text": "Stir flour mixture into corn mixture until well combined."
        },
        {
          "id": 4,
          "text": "Heat olive oil on a griddle or a large skillet over medium heat."
        },
        {
          "id": 5,
          "text": "Scoop 1/4-cup portions of corn mixture onto heated griddle. Cook until golden brown, 3 to 4 minutes per side."
        }
      ],
