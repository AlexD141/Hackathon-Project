  "recipes": [
    {
      "name": "Lemon Gin Slush",
      "ingredients_raw": [
        "7 cups water",
        "2 pints lemon gin",
        "1 (12 fluid ounce) can frozen lemonade concentrate",
        "1 (12 fluid ounce) can frozen orange juice concentrate",
        "1 cup cold tea",
        "0.5 cup white sugar",
        "2 liters lemon-lime flavored carbonated beverage"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine water, gin, frozen lemonade, frozen orange juice, tea, and sugar in a medium bowl. Cover the bowl; freeze until ready to use."
        },
        {
          "id": 2,
          "text": "Combine frozen mixture with carbonated beverage; serve."
        }
      ],
