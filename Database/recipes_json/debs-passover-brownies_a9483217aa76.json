  "source_url": "https://www.allrecipes.com/recipe/213691/debs-passover-brownies/",
  "extracted_at": "2026-10-18T02:51:31.047045+00:00",
  "recipes": [
    {
      "name": "Deb&#39;s Passover Brownies",
      "ingredients_raw": [
        "1 cup butter",
        "4 (1 ounce) squares unsweetened baking chocolate",
        "4 eggs",
        "2 egg whites",
        "2 cups white sugar",
        "0.25 cup strong brewed coffee",
        "2 teaspoons kosher for Passover vanilla flavoring",
        "1 cup potato starch",
        "2 tablespoons potato starch",
        "0.25 cup matzo cake meal",
        "2 tablespoons matzo cake meal",
        "0.25 cup unsweetened cocoa powder",
        "0.5 teaspoon salt",
        "6 ounces semisweet chocolate chips"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease two 8x8-inch baking pans."
        },
        {
          "id": 2,
          "text": "Place butter and chocolate in the top of a double boiler over simmering water. Stir frequently, scraping down the sides with a rubber spatula to avoid scorching, until butter and chocolate are melted; mix well."
        },
        {
          "id": 3,
          "text": "Meanwhile, beat eggs and egg whites together in a large bowl with an electric mixer on high speed until very fluffy, about 5 minutes. Gently stir butter-chocolate mixture, sugar, coffee, and vanilla flavoring into egg mixture; beat well to combine."
        },
        {
          "id": 4,
          "text": "Combine potato starch, matzo cake meal, cocoa powder, and salt in a medium bowl; beat into chocolate-egg mixture until fluffy and thoroughly combined. Gently fold in chocolate chips until incorporated. Divide batter between the prepared baking pans."
        },
        {
          "id": 5,
          "text": "Bake in the preheated oven until a toothpick inserted into centers shows moist crumbs, 25 to 30 minutes."
        }
      ],
      "warnings": [],
