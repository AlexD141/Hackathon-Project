      "name": "Raspberry Blackberry Smoothie",
      "ingredients_raw": [
        "1 small banana",
        "0.5 cup blackberries",
        "1 cup fresh raspberries",
        "1 (6 ounce) container vanilla yogurt",
        "1 tablespoon honey",
        "4 ice cubes"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place banana, blackberries, raspberries, yogurt, honey, and ice cubes into a blender. Blend until smooth."
