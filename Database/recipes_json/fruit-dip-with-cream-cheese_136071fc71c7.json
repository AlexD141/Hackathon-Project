      "name": "Fruit Dip with Cream Cheese",
      "ingredients_raw": [
        "1 (8 ounce) package cream cheese",
        "1 (7 ounce) jar marshmallow creme",
        "0.75 cup confectioners' sugar",
        "0.125 teaspoon lemon juice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Blend cream cheese, marshmallow creme, sugar, and lemon juice in a large bowl with an electric mixer until smooth."
        }
