  "recipes": [
    {
      "name": "Kale Orange Banana Smoothie",
      "ingredients_raw": [
        "1 orange, peeled",
        "0.5 cup water",
        "1 leaf kale, torn into several pieces",
        "2 ripe bananas, peeled"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Blend orange in a blender until mostly juice."
        },
        {
          "id": 2,
          "text": "Add water and kale; blend again on High speed until kale is liquefied."
        },
        {
          "id": 3,
          "text": "Break bananas into chunks and add to the blender. Start blending at a lower speed until banana is incorporated. Increase speed to blend the mixture into a pudding-like texture."
        }
      ],
