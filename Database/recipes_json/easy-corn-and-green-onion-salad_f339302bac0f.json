      "name": "Easy Corn and Green Onion Salad",
      "ingredients_raw": [
        "1 (16 ounce) package frozen corn kernels, thawed",
        "1 green onion, chopped",
        "1.5 tablespoons white wine vinegar",
        "1 tablespoon olive oil",
        "1 teaspoon fresh lemon juice",
        "1.5 teaspoons dried tarragon leaves",
        "salt and ground black pepper to taste",
        "1 pinch seafood seasoning (such as Old Bay®), or to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Stir the corn, onion, vinegar, olive oil, lemon juice, tarragon, salt, and pepper together in a bowl. Season with seafood seasoning as desired."
        }
      ],
