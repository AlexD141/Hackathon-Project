  "recipes": [
    {
      "name": "Hawaiian Nut Cookies",
      "ingredients_raw": [
        "0.33333334326744 cup butter",
        "0.5 cup packed brown sugar",
        "0.25 cup white sugar",
        "1 egg",
        "1 teaspoon almond flavoring",
        "1.75 cups all-purpose flour",
        "0.5 teaspoon baking powder",
        "0.5 teaspoon baking soda",
        "0.25 teaspoon salt",
        "1 (8 ounce) can pineapple tidbits, drained",
        "1 tablespoon coconut flakes"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat an oven to 400 degrees F (200 degrees C)."
        },
        {
          "id": 2,
          "text": "Beat the butter, brown sugar, and white sugar with an electric mixer in a large bowl until smooth."
        },
        {
          "id": 3,
          "text": "Blend the egg and the almond flavoring into the creamed butter and sugar."
        },
        {
          "id": 4,
          "text": "Sift together the flour, baking powder, baking soda, and salt into a bowl."
        },
        {
          "id": 5,
          "text": "Blend the flour mixture into the butter mixture."
        },
        {
          "id": 6,
          "text": "Fold the pineapple tidbits and coconut flakes into the dough."
        },
        {
          "id": 7,
          "text": "Drop teaspoonfuls of the dough 2 inches apart onto greased baking sheets."
        },
        {
          "id": 8,
          "text": "Bake in preheated oven until golden brown, 10 to 12 minutes."
        }
      ],
