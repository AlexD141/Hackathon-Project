  "recipes": [
    {
      "name": "Anika&#39;s Cheesy Green Bean Casserole",
      "ingredients_raw": [
        "3 (15 ounce) cans French cut green beans, drained",
        "1 (10.75 ounce) can condensed cream of mushroom soup",
        "salt and pepper to taste",
        "1 (5 ounce) jar bacon cheese spread",
        "1 (6 ounce) can Cheddar-flavored French fried onions (such as French's®)"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Mix the green beans and mushroom soup in a large bowl. Spoon into 9x13 inch baking dish; season with salt and pepper. Dollop the cheese spread on top of the beans in heaping tablespoons."
        },
        {
          "id": 3,
          "text": "Bake in preheated oven for 30 minutes. Remove from oven; scatter fried onions over casserole. Bake until onions are golden brown, about 5 additional minutes."
        }
      ],
