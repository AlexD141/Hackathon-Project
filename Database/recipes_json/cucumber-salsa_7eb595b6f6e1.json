  "recipes": [
    {
      "name": "Cucumber Salsa",
      "ingredients_raw": [
        "2 cucumbers - peeled, seeded and chopped",
        "1 cup sour cream",
        "1 cup plain yogurt",
        "0.25 cup chopped fresh parsley",
        "0.25 cup chopped fresh cilantro",
        "1 teaspoon ground cumin",
        "0.5 teaspoon salt"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a medium bowl, combine the cucumber, sour cream, yogurt, parsley, cilantro, cumin and salt. Mix well. Cover and refrigerate for 2 hours before serving."
        }
      ],
