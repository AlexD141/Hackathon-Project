    {
      "name": "Erin&#39;s Pico de Gallo",
      "ingredients_raw": [
        "3 pounds diced roma tomatoes",
        "1.5 pounds diced red onion",
        "3 jalapeno pepper, seeded and minced",
        "1 cup minced fresh cilantro",
        "0.5 cup sweetened lime juice",
        "1 tablespoon taco seasoning mix"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place the tomatoes, onion, jalapeno peppers, cilantro, and lime juice into a large mixing bowl. Sprinkle with taco seasoning and stir gently until evenly mixed. Cover and refrigerate at least 1 hour to allow the flavors to blend before serving."
        }
      ],
