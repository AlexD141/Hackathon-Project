  "recipes": [
    {
      "name": "Sauerkraut Onion Bread",
      "ingredients_raw": [
        "2.25 cups bread flour",
        "1 cup milk",
        "0.75 teaspoon salt",
        "0.25 teaspoon onion salt",
        "2 tablespoons margarine",
        "0.5 cup sauerkraut - drained, rinsed and finely chopped",
        "1 tablespoon finely chopped onion",
        "0.5 cup whole wheat flour",
        "0.75 cup rye flour",
        "1.5 tablespoons white sugar",
        "0.5 tablespoon caraway seed",
        "1.75 teaspoons active dry yeast"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Add the ingredients to the bread pan in the order listed. Place the bread pan into the machine and close the lid. Select the basic setting and press start."
        }
      ],
