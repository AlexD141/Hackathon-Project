  "recipes": [
    {
      "name": "Broiler Icing",
      "ingredients_raw": [
        "1 cup brown sugar",
        "0.25 cup butter, melted",
        "0.25 cup cream",
        "1 cup flaked coconut",
        "0.5 cup chopped walnuts"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a medium bowl, combine brown sugar, butter, and cream. Mix in coconut and chopped nuts."
        },
        {
          "id": 2,
          "text": "Spread icing over cooled cake. Place cake under broiler for 2 minutes or until bubbly."
        }
      ],
