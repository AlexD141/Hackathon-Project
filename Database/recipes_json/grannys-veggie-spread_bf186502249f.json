      "name": "Granny&#39;s Veggie Spread",
      "ingredients_raw": [
        "1 (.25 ounce) envelope unflavored gelatin",
        "2 tablespoons cold water",
        "1 (16 ounce) jar mayonnaise",
        "1 cucumber, peeled and finely chopped",
        "1 onion, finely chopped",
        "1 green bell pepper, seeded and finely chopped",
        "1 tomato - peeled, seeded and finely chopped",
        "1 carrot, finely chopped"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Sprinkle gelatin over cold water in a bowl; let stand until softened, about 1 minute. Stir in mayonnaise until smooth. Stir in cucumber, onion, bell pepper, tomato, and carrot. Cover the bowl; chill in the refrigerator before serving, 1 hour."
        }
