    {
      "name": "Berry Bloody Smoothie",
      "ingredients_raw": [
        "1.25 cups frozen strawberries",
        "2 tablespoons frozen raspberries, or to taste",
        "0.5 cup orange juice, divided"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place frozen strawberries and raspberries into a blender, and pulse several times to break up the berries. Pour in half the orange juice with the blender running, and allow to blend until smooth and thick, about 30 seconds. If smoothie is too thick, blend in remaining orange juice. Serve immediately."
        }
      ],
