  "recipes": [
    {
      "name": "Rayna&#39;s Peanut Butter Jammies",
      "ingredients_raw": [
        "8 slices bread",
        "0.5 cup peanut butter",
        "0.25 cup any flavor fruit jam",
        "1 egg, beaten",
        "0.5 cup milk",
        "2 teaspoons white sugar",
        "1 pinch salt",
        "2 tablespoons butter"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Spread four slices of bread with peanut butter and jam. Cover with remaining four slices of bread. Beat together egg, milk, sugar and salt."
        },
        {
          "id": 2,
          "text": "In a large skillet or frying pan, melt butter over medium heat."
        },
        {
          "id": 3,
          "text": "Dip each sandwich into the egg mixture to coat it well and allow the excess to drip off. Place sandwiches in pan and cook until golden on both sides. Serve warm."
        }
      ],
