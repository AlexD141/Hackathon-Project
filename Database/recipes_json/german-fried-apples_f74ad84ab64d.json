  "recipes": [
    {
      "name": "German Fried Apples",
      "ingredients_raw": [
        "2 tablespoons butter",
        "1 red onion, chopped",
        "4 tart apples, cored and chopped",
        "salt to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Heat butter in a skillet over medium heat until melted and foam subsides. Add onion and cook until translucent, about 5 minutes. Add apples, and cook until onion starts to brown and apples are tender, about 10 more minutes. Sprinkle with salt to taste."
        }
      ],
