  "recipes": [
    {
      "name": "Pumpkin Pie Martini",
      "ingredients_raw": [
        "1 graham cracker, crushed",
        "1 tablespoon honey",
        "0.33333334326744 cup milk",
        "2 tablespoons pumpkin puree",
        "0.75 (1.5 fluid ounce) jigger vanilla flavored vodka",
        "0.5 (1.5 fluid ounce) jigger creme de cacao",
        "1 pinch pumpkin pie spice",
        "1 cup crushed ice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place graham cracker crumbs in a shallow dish. Coat rim of martini glass with honey, and dip into graham cracker crumbs to coat."
        },
        {
          "id": 2,
          "text": "Combine milk and pumpkin puree in a cocktail shaker, and shake to combine. Pour in vodka and creme de cacao, and add ice. Shake well, and then strain into prepared martini glass. Garnish with a sprinkle of pumpkin pie spice."
        }
      ],
