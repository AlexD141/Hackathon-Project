  "recipes": [
    {
      "name": "Tequila Sunrise Cocktail",
      "ingredients_raw": [
        "2.5 cups ice, divided",
        "4 fluid ounces orange juice",
        "2 fluid ounces tequila",
        "0.75 fluid ounce grenadine syrup"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather the ingredients."
        },
        {
          "id": 2,
          "text": "Fill a highball glass with 1 1/2 cups ice and set aside."
        },
        {
          "id": 3,
          "text": "Combine orange juice and tequila in a cocktail shaker; add remaining 1 cup ice. Cover and shake until the outside of the shaker has frosted."
        },
        {
          "id": 4,
          "text": "Strain into the prepared highball glass."
        },
        {
          "id": 5,
          "text": "Slowly pour in grenadine and let settle."
        },
        {
          "id": 6,
          "text": "Garnish and stir before drinking."
        }
      ],
      "warnings": [],
