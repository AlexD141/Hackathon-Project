    {
      "name": "Orange Glorious I",
      "ingredients_raw": [
        "1 cup milk",
        "1 cup ice water",
        "1 (6 ounce) can frozen orange juice concentrate",
        "12 cubes ice",
        "0.25 teaspoon vanilla extract",
        "0.125 cup white sugar"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a blender combine milk, water, orange juice concentrate, ice cubes, vanilla and sugar. Blend until smooth. Pour into three 12 oz glasses and enjoy with a straw."
        }
      ],
