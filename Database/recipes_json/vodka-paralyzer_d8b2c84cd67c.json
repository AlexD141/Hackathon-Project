  "recipes": [
    {
      "name": "Vodka Paralyzer",
      "ingredients_raw": [
        "1 cup ice cubes",
        "4 fluid ounces cola",
        "1 fluid ounce coffee flavored liqueur",
        "1 (1.5 fluid ounce) jigger vodka",
        "2 fluid ounces milk",
        "1 maraschino cherry"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Fill a highball glass with ice."
        },
        {
          "id": 2,
          "text": "Pour in cola, coffee liqueur, and vodka in the order listed; add milk and stir briefly. Top with a maraschino cherry."
        }
      ],
