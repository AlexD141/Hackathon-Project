  "recipes": [
    {
      "name": "Potato, Leek, and Pea Soup",
      "ingredients_raw": [
        "1 tablespoon butter",
        "3 leeks (white and pale green parts only), thinly sliced",
        "5 pounds potato, peeled and thinly sliced",
        "2 quarts chicken broth",
        "3 cups frozen peas",
        "1 pinch dried tarragon",
        "3 cups milk",
        "salt and ground black pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Melt butter in a large pot over medium-high heat. Cook and stir leeks in the melted butter until tender, 5 to 7 minutes."
        },
        {
          "id": 2,
          "text": "Stir potatoes and chicken broth into the leeks and bring to a boil; reduce heat to medium-low, cover the pot, and simmer until potatoes are tender, about 12 minutes."
        },
        {
          "id": 3,
          "text": "Stir peas and tarragon into the soup; simmer until peas are tender, about 5 minutes."
        },
        {
          "id": 4,
          "text": "Pour the soup into a blender, filling the pitcher no more than half full."
        },
        {
          "id": 5,
          "text": "Hold down the lid of the blender with a towel and carefully start the blender, using a few quick pulses to get the soup moving before leaving it on to puree. Puree in batches until smooth and pour into a clean pot. Alternately, you can use a stick blender and puree the soup in the pot."
        },
        {
          "id": 6,
          "text": "Pour milk into the pureed soup and bring to a simmer over medium heat until heated through. Season with salt and black pepper."
        }
      ],
