  "recipes": [
    {
      "name": "BLT",
      "ingredients_raw": [
        "4 slices bacon",
        "2 leaves lettuce",
        "2 slices tomato",
        "2 slices bread, toasted",
        "1 tablespoon mayonnaise"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Cook bacon in a large, deep skillet over medium-high heat until evenly browned, about 10 minutes. Drain bacon on a paper towel-lined plate."
        },
        {
          "id": 3,
          "text": "Arrange cooked bacon, lettuce, and tomato slices on one slice of bread. Spread mayonnaise on the other slice of bread."
        },
        {
          "id": 4,
          "text": "Close to make a sandwich."
        }
      ],
