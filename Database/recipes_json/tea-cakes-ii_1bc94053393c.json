  "recipes": [
    {
      "name": "Tea Cakes II",
      "ingredients_raw": [
        "4 eggs",
        "1 cup butter flavored shortening",
        "2 cups white sugar",
        "2 teaspoons baking powder",
        "6 cups all-purpose flour"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Cream together eggs, butter, sugar and baking powder. Stir in the flour. Dough will be stiff."
        },
        {
          "id": 2,
          "text": "Shape in walnut sized balls and flatten with the bottom of a glass."
        },
        {
          "id": 3,
          "text": "Place on an ungreased cookie sheet and bake at 350 degrees F (175 degrees C) for 8 minutes. If you brown them, you&#39;ve overbaked them. These may also be rolled out and cut with cookie cutters."
        }
      ],
