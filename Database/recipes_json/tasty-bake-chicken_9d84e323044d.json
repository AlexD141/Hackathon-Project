  "recipes": [
    {
      "name": "Tasty Bake Chicken",
      "ingredients_raw": [
        "4 chicken breast halves, bone in",
        "1 (.7 ounce) package dry Italian-style salad dressing mix",
        "2 tablespoons cold water",
        "2 tablespoons olive oil"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 400 degrees F (200 degrees C)."
        },
        {
          "id": 2,
          "text": "Empty contents of salad dressing mix package into a small bowl. Add water and mix well, then stir in olive oil and mix again. Note: DO NOT add vinegar as per package instructions."
        },
        {
          "id": 3,
          "text": "Place chicken breasts &#39;wrong side up&#39; in a lightly greased 9x13 inch baking dish. Put 1/2 teaspoon of the dressing mixture on each breast and spread over the surface."
        },
        {
          "id": 4,
          "text": "Bake at 400 degrees F (200 degrees C) for 15 to 25 minutes, depending on the size of the breasts. Turn breasts over and spoon remaining mixture on to the topside. Bake for another 15 to 20 minutes, or until tops are golden brown and chicken is cooked through (juices run clear)."
        }
      ],
