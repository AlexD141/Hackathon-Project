  "recipes": [
    {
      "name": "Oven SPAM Sandwiches",
      "ingredients_raw": [
        "1 (12 ounce) can fully cooked luncheon meat (such as SPAM®), cubed",
        "0.75 (1 pound) loaf processed cheese food (such as Velveeta®), cubed",
        "0.5 cup creamy salad dressing (such as Miracle Whip®)",
        "2 tablespoons sweet pickle relish",
        "8 hamburger buns, split"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 350°F (175°C)."
        },
        {
          "id": 2,
          "text": "Combine luncheon meat, cheese, salad dressing, and relish in a bowl; mic to combine. Divide evenly amongst hamburger buns. Wrap each sandwich in aluminum foil; place onto a baking sheet."
        },
        {
          "id": 3,
          "text": "Bake in the preheated oven until the filling is hot and buns are toasted, 10 to 15 minutes."
        }
      ],
