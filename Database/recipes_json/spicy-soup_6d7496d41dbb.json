  "recipes": [
    {
      "name": "Spicy Soup",
      "ingredients_raw": [
        "1 teaspoon unsalted butter",
        "0.25 cup chopped celery",
        "2 cloves garlic, chopped",
        "1 tablespoon all-purpose flour",
        "3.5 cups chicken broth",
        "1.5 cups chopped broccoli",
        "1.5 cups cauliflower, chopped",
        "2 tablespoons peanut butter",
        "0.25 teaspoon salt",
        "0.25 teaspoon crushed red pepper flakes",
        "2 green onions, chopped",
        "0.25 cup heavy cream"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Melt butter in a saucepan over medium heat; cook and stir celery and garlic until garlic is fragrant, about 5 minutes."
        },
        {
          "id": 2,
          "text": "Stir in flour to make a roux; cook for 1 minute."
        },
        {
          "id": 3,
          "text": "Stir in chicken broth, broccoli, cauliflower, peanut butter, salt, and red pepper flakes. Simmer for 15-20 minutes."
        },
        {
          "id": 4,
          "text": "Mix in green onions and heavy cream just before serving."
        }
      ],
