  "recipes": [
    {
      "name": "Orange Cream Milkshake",
      "ingredients_raw": [
        "0.5 cup milk",
        "4 scoops vanilla ice cream",
        "3 tablespoons frozen orange juice concentrate, thawed"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a blender combine milk, ice cream and orange juice concentrate. Blend until smooth. Pour into glasses, garnish with an orange slice and serve."
        }
      ],
