  "recipes": [
    {
      "name": "Barbecued Pork Chops",
      "ingredients_raw": [
        "8 lean pork chops",
        "0.5 cup ketchup",
        "1 teaspoon salt",
        "1 teaspoon celery seed",
        "0.5 teaspoon ground nutmeg",
        "0.33300000429153 cup distilled white vinegar",
        "1 cup water",
        "1 bay leaf"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 325 degrees F (165 degrees C)."
        },
        {
          "id": 2,
          "text": "In a skillet, heat a small amount of oil and brown both sides of the pork chops."
        },
        {
          "id": 3,
          "text": "In a bowl combine ketchup, salt, celery seed, nutmeg, vinegar, water, and bay leaf; Pour over chops."
        },
        {
          "id": 4,
          "text": "Bake in oven for 90 minutes. Turn chops once during baking."
        }
      ],
