  "recipes": [
    {
      "name": "Sugar-Free Mojito Punch",
      "ingredients_raw": [
        "0.5 cup lime juice",
        "0.5 cup fresh mint leaves",
        "0.25 cup granular sucralose sweetener (such as Splenda®)",
        "4.25 cups diet lemon-lime soda",
        "4 cups crushed ice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Stir lime juice, mint leaves, and sweetener together in a pitcher; gently crush and bruise mint leaves with a wooden spoon."
        },
        {
          "id": 2,
          "text": "Pour diet lemon-lime soda into juice mixture and stir until sweetener has dissolved."
        },
        {
          "id": 3,
          "text": "Mix in crushed ice to serve."
        }
      ],
