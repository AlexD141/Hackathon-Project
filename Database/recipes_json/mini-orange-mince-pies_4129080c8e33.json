  "recipes": [
    {
      "name": "Traditional Mince Pies",
      "ingredients_raw": [
        "1.75 cups all-purpose flour",
        "0.25 cup confectioners' sugar",
        "2 teaspoons ground cinnamon",
        "0.66666668653488 cup butter, softened",
        "2 tablespoons grated orange zest",
        "0.25 cup ice water",
        "0.75 cup prepared mincemeat pie filling",
        "1 egg, beaten"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 400 degrees F (200 degrees C)."
        },
        {
          "id": 2,
          "text": "Sift flour, 1/4 cup confectioners&#39; sugar, and cinnamon together in a large bowl. Use a pastry cutter or two forks to mix in butter until mixture resembles fine crumbs. Stir in orange zest. Sprinkle with ice water and gather dough into a ball. Roll out on a lightly floured surface to 1/4 inch thick. Cut out approximately 18 (3-inch) diameter circles, and 18 (2-inch) circles, re-rolling dough as needed."
        },
        {
          "id": 3,
          "text": "Line muffin cups or mini tart tins using the 3-inch pastry circles. Fill each pastry cup with about 1 tablespoon of mincemeat filling. Top with 2-inch pastry circles, sealing edges firmly together or crimping lightly with a fork to prevent the filling from leaking as they cook. Brush the top of each pie with egg."
        },
        {
          "id": 4,
          "text": "Bake mince pies in preheated oven until tops are golden brown, 15 to 20 minutes. Cool slightly on wire racks. Dust with remaining 1/4 cup confectioners&#39; sugar just before serving."
        }
      ],
