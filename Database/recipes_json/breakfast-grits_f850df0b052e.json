            "author": {
              "@type": "Person",
              "name": "rhonda"
            },
            "reviewBody": "I made this as a breakfast side. I didn't add salt and I used 3 cups of chicken broth instead of water. It was delicious!!!",
            "datePublished": "2019-09-08T18:59:33.500Z"
          },
