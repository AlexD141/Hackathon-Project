  "recipes": [
    {
      "name": "Very Personal Bolognese Sauce",
      "ingredients_raw": [
        "0.75 pound lean ground beef",
        "1 yellow onion, chopped",
        "3 tablespoons tomato paste",
        "1 teaspoon harissa",
        "1 tablespoon Worcestershire sauce",
        "1 (15 ounce) can tomato sauce",
        "1 teaspoon pressed garlic",
        "1 tablespoon mascarpone cheese",
        "1 pinch dried basil"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Crumble the ground beef into a large skillet over medium-high heat. Add onion and cook, stirring to break up large chunks, until no longer pink. Drain off excess grease. Mix in the tomato paste, harissa and Worcestershire sauce until blended. Stir in the tomato sauce and garlic; reduce heat to low and simmer for 15 minutes."
        },
        {
          "id": 2,
          "text": "Stir in the mascarpone cheese, and simmer for another 15 minutes. Remove from the heat, and season with dried basil."
        }
      ],
