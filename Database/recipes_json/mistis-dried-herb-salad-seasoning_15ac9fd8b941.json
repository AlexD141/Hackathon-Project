    {
      "name": "Misti&#39;s Dried Herb Salad Seasoning",
      "ingredients_raw": [
        "0.5 cup grated Parmesan cheese",
        "1 tablespoon dried parsley flakes",
        "2 teaspoons dried basil",
        "2 teaspoons dried chives",
        "2 teaspoons dried marjoram",
        "2 teaspoons paprika",
        "2 teaspoons onion powder",
        "2 teaspoons garlic powder",
        "2 teaspoons salt",
        "0.5 teaspoon freshly ground black pepper"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine Parmesan cheese, parsley flakes, basil, chives, marjoram, paprika, onion powder, garlic powder, salt, and pepper in a small bowl; stir to blend evenly. Store in an airtight container."
        }
      ],
