  "recipes": [
    {
      "name": "Mango-Mint Lassi with Indian Sweet Spices",
      "ingredients_raw": [
        "2 cups plain yogurt",
        "1 large mango - peeled, seeded, and diced",
        "3 tablespoons brown sugar",
        "2 tablespoons chopped fresh mint",
        "1 tablespoon lime juice",
        "1 teaspoon freshly ground star anise",
        "1 teaspoon freshly ground cardamom"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Add yogurt, mango, brown sugar, chopped mint, lime juice, star anise, and cardamom to a blender; blend on high until smooth."
        },
        {
          "id": 2,
          "text": "Pour into glasses; garnish with mint sprigs."
        }
      ],
