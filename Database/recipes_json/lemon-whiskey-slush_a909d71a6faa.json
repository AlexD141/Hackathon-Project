  "recipes": [
    {
      "name": "Lemon Whiskey Slush",
      "ingredients_raw": [
        "0.5 cup Irish whiskey",
        "0.5 cup fresh lemon juice",
        "3 tablespoons white sugar",
        "4 cups ice cubes"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine Irish whiskey, lemon juice, and sugar in a blender; add ice cubes. Cover; blend until slushy, 15 to 30 seconds."
        },
        {
          "id": 2,
          "text": "Pour slush into glasses."
        }
      ],
