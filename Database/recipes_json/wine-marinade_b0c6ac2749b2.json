    {
      "name": "Wine Marinade",
      "ingredients_raw": [
        "0.5 cup soy sauce",
        "0.25 cup red wine",
        "3 tablespoons white sugar",
        "1 teaspoon minced garlic",
        "1 teaspoon ground ginger",
        "1 teaspoon molasses"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Mix together soy sauce, wine, sugar, garlic, ginger and molasses. Pour over meat and refrigerate."
        }
      ],
