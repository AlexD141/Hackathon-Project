  "recipes": [
    {
      "name": "Deep Dish Persimmon Pie",
      "ingredients_raw": [
        "0.25 cup light brown sugar, packed",
        "1 tablespoon ground cinnamon",
        "1 tablespoon cornstarch",
        "0.125 teaspoon sea salt",
        "6 cups Fuyu persimmons, peeled and thinly sliced",
        "10 graham crackers, crushed",
        "0.25 cup butter, melted"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat an oven to 375 degrees F (190 degrees C)."
        },
        {
          "id": 2,
          "text": "Combine brown sugar, cinnamon, cornstarch, and sea salt in a small bowl. Spread half of the persimmons into an 8-inch deep pie plate. Sprinkle with half of the the sugar mixture. Repeat with the remaining persimmons and sugar mixture. Set aside. Mix graham cracker crumbs and melted butter until evenly combined. Spread crust evenly over persimmons."
        },
        {
          "id": 3,
          "text": "Bake until crust is golden brown and persimmons are tender, about 45 minutes. Serve warm."
        }
      ],
