  "recipes": [
    {
      "name": "Smoked Salmon Pizza",
      "ingredients_raw": [
        "1 (12 inch) pre-baked pizza crust",
        "1 tablespoon olive oil",
        "1 cup smoked salmon, cut into 1/2 inch pieces",
        "0.5 (6 ounce) jar marinated artichoke hearts, drained and quartered",
        "2 tablespoons chopped sun-dried tomatoes",
        "2 cups shredded mozzarella cheese"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 400 degrees F (200 degrees C)."
        },
        {
          "id": 2,
          "text": "Spread olive oil over pizza crust, then sprinkle with smoked salmon, artichokes, and sun-dried tomatoes. Sprinkle mozzarella cheese evenly over pizza."
        },
        {
          "id": 3,
          "text": "Bake in the preheated oven until cheese is melted and bubbly, 10 to 15 minutes."
        }
      ],
