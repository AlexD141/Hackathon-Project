  "recipes": [
    {
      "name": "Summer Pasta Salad I",
      "ingredients_raw": [
        "1 (16 ounce) package penne pasta",
        "1 cup distilled white vinegar",
        "0.5 cup white sugar",
        "1 (16 ounce) bottle Catalina salad dressing",
        "1 cup Italian-style salad dressing",
        "1 cucumber, chopped",
        "2 (2 ounce) cans sliced black olives",
        "1 tomato, chopped",
        "0.5 cup chopped onion",
        "1 cup chopped baby carrots",
        "1 green bell pepper, chopped",
        "0.5 teaspoon celery salt",
        "salt and pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain."
        },
        {
          "id": 2,
          "text": "In a small saucepan, bring vinegar and sugar to a boil. Boil for one minute."
        },
        {
          "id": 3,
          "text": "In large bowl, combine vinegar mixture, Catalina dressing and Italian dressing. Mix well. Add pasta, cucumber, olives, tomato, onion, carrots, and bell pepper; toss. Season with celery salt, salt and pepper. Refrigerate until serving."
        }
      ],
