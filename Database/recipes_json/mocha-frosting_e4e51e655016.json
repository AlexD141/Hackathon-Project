  "recipes": [
    {
      "name": "Mocha Frosting",
      "ingredients_raw": [
        "2 tablespoons warm milk",
        "0.5 teaspoon instant coffee powder",
        "1 (16 ounce) package confectioners' sugar",
        "6 tablespoons butter, melted",
        "0.25 cup unsweetened cocoa powder",
        "1.5 teaspoons vanilla extract"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Stir warm milk and coffee powder in large bowl until the coffee dissolves completely."
        },
        {
          "id": 2,
          "text": "Whisk confectioners&#39; sugar, melted butter, cocoa powder, and vanilla extract into the milk mixture until no clumps remain and you have a smooth frosting."
        }
      ],
