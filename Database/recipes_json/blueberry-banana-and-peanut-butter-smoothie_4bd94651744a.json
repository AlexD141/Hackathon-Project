  "recipes": [
    {
      "name": "Blueberry, Banana, and Peanut Butter Smoothie",
      "ingredients_raw": [
        "1 tablespoon flaxseed meal",
        "1 banana",
        "1 cup milk",
        "0.5 cup frozen blueberries",
        "0.5 cup plain yogurt",
        "1 tablespoon peanut butter",
        "1 teaspoon honey"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Put flaxseed meal into a blender to grind and further break down."
        },
        {
          "id": 2,
          "text": "Place banana, milk, blueberries, yogurt, peanut butter, and honey into the blender. Cover and purée until smooth."
        },
        {
          "id": 3,
          "text": "Pour into glasses to serve."
        }
      ],
