  "recipes": [
    {
      "name": "Cranberry Oatmeal Drops",
      "ingredients_raw": [
        "1 cup all-purpose flour",
        "1 teaspoon baking powder",
        "0.5 teaspoon ground cinnamon",
        "0.25 teaspoon ground nutmeg",
        "0.5 cup butter, softened",
        "0.75 cup packed brown sugar",
        "1 egg",
        "0.25 cup milk",
        "1 teaspoon orange zest",
        "1.5 cups quick cooking oats",
        "0.75 cup chopped cranberries",
        "0.25 cup chopped walnuts",
        "1 cup confectioners' sugar",
        "0.5 teaspoon orange zest",
        "0.25 teaspoon vanilla extract",
        "2 tablespoons orange juice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 375 degrees F (190 degrees C). Grease cookie sheets."
        },
        {
          "id": 2,
          "text": "Sift together the flour, baking powder, cinnamon and nutmeg, set aside. In a medium bowl, cream the butter and sugar. Stir in the egg, milk and orange zest. Add dry ingredients, mix until well blended. Then stir in the quick oats, cranberries and nuts."
        },
        {
          "id": 3,
          "text": "Drop dough by tablespoons onto the prepared cookie sheets about 2 inches apart. Bake for 10 to 12 minutes in the preheated oven, cookies should be lightly browned. Remove to cool on wire racks."
        },
        {
          "id": 4,
          "text": "In a small bowl, stir together the confectioners&#39; sugar, orange zest and vanilla. Stir in the orange juice 1 tablespoon at a time until desired consistency is reached. Drizzle onto cooled cookies."
        }
      ],
