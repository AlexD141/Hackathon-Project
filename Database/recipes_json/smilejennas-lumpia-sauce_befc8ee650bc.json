  "recipes": [
    {
      "name": "Smilejenna’s Lumpia Sauce",
      "ingredients_raw": [
        "1 cup water",
        "1 cup brown sugar",
        "1.5 tablespoons cornstarch",
        "2 tablespoons minced garlic, or to taste",
        "0.25 teaspoon red pepper flakes"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine water, brown sugar, and cornstarch in a small saucepan. Bring to a simmer over medium-high heat; stir until sugar dissolves and sauce thickens."
        },
        {
          "id": 2,
          "text": "Remove the saucepan from the heat; stir in garlic and red pepper flakes."
        }
      ],
