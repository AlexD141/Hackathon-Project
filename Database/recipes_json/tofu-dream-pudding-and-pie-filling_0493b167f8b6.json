    {
      "name": "Tofu Dream Pudding and Pie Filling",
      "ingredients_raw": [
        "1 (12 ounce) package extra firm tofu, drained and cubed",
        "0.25 cup brown sugar",
        "0.5 cup walnuts",
        "0.25 cup pure maple syrup",
        "1 tablespoon lemon juice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place tofu, brown sugar, walnuts, maple syrup, and lemon juice in a food processor. Process until smooth. Cover and chill to thicken for pie filling, or serve immediately as pudding."
        }
      ],
