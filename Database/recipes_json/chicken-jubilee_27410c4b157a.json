  "recipes": [
    {
      "name": "Chicken Jubilee",
      "ingredients_raw": [
        "8 skinless, boneless chicken breast halves",
        "0.25 cup melted butter",
        "1 (16.5 ounce) can pitted Bing cherries, drained, juice reserved",
        "0.5 cup brown sugar",
        "1 (12 fluid ounce) can or bottle chile sauce",
        "0.5 cup water",
        "1 tablespoon Worcestershire sauce",
        "1 onion, thinly sliced",
        "0.5 cup raisins",
        "salt and pepper to taste",
        "1 cup brandy"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to Broil."
        },
        {
          "id": 2,
          "text": "Lightly brush chicken breasts with melted butter and broil for 2 to 3 minutes each side, or until just lightly browned."
        },
        {
          "id": 3,
          "text": "Preheat oven to 325 degrees F (165 degrees C)."
        },
        {
          "id": 4,
          "text": "Place browned chicken in a 9x13 inch baking dish. In large bowl combine the reserved cherry liquid, sugar, chile sauce, water, Worcestershire sauce, onion, raisins and salt and pepper to taste. Mix all together and pour mixture over chicken."
        },
        {
          "id": 5,
          "text": "Cover dish and bake at 325 degrees F (165 degrees C) for 1 hour."
        },
        {
          "id": 6,
          "text": "Remove cover, add cherries and brandy to chicken and bake uncovered for another 15 minutes."
        }
      ],
