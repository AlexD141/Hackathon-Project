    {
      "name": "Deb&#39;s Mac Salad",
      "ingredients_raw": [
        "2 cups macaroni",
        "1 small onion, chopped",
        "1 green bell pepper, chopped",
        "1 carrot, grated",
        "0.25 cup mayonnaise",
        "0.25 cup Ranch-style salad dressing"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain. Rinse with cold water and place in large bowl."
        },
        {
          "id": 2,
          "text": "Add onion, pepper and carrot to bowl with pasta. Toss with mayonnaise and ranch-style dressing. Adjust mayonnaise and dressing to taste. Serve."
        }
      ],
