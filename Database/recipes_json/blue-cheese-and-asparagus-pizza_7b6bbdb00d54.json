  "recipes": [
    {
      "name": "Blue Cheese and Asparagus Pizza",
      "ingredients_raw": [
        "1 bunch asparagus, trimmed and snapped into pieces",
        "1 teaspoon olive oil, or as needed",
        "salt and black pepper to taste",
        "0.5 cup pizza sauce",
        "1 (14 ounce) prebaked pizza crust (such as Boboli®)",
        "0.75 cup crumbled blue cheese"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat an oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Place asparagus on a baking sheet; drizzle with olive oil and sprinkle with salt and pepper."
        },
        {
          "id": 3,
          "text": "Bake the asparagus in the preheated oven for 10 minutes."
        },
        {
          "id": 4,
          "text": "While asparagus is baking, spread the pizza sauce over the pizza crust. Distribute asparagus pieces and crumbles of blue cheese evenly over the pizza."
        },
        {
          "id": 5,
          "text": "Return pizza to center rack of preheated oven; bake until the cheese is melted and bubbling, 8 to 10 more minutes."
        }
      ],
