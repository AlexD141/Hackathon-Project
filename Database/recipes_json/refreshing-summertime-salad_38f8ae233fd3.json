  "recipes": [
    {
      "name": "Refreshing Summertime Salad",
      "ingredients_raw": [
        "4 cups mixed baby greens",
        "0.5 cup diced mango",
        "0.5 cup cubed seeded watermelon",
        "0.25 cup crumbled feta cheese",
        "2 tablespoons minced red onion",
        "1 tablespoon chopped fresh mint",
        "1 tablespoon white balsamic vinegar",
        "1 tablespoon olive oil",
        "1 tablespoon frozen mango juice concentrate, thawed"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine baby greens, mango, watermelon, feta cheese, red onion, and mint in a large bowl."
        },
        {
          "id": 2,
          "text": "Whisk vinegar, olive oil, and mango juice concentrate together in a small bowl until well combined; drizzle over salad and toss gently until evenly coated."
        }
      ],
