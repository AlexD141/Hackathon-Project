    {
      "name": "Bananerberry Smoothie",
      "ingredients_raw": [
        "1 cup fresh strawberries",
        "1 banana, sliced",
        "1 cup fresh peaches",
        "1 cup apples",
        "1.5 cups vanilla ice cream",
        "1.5 cups ice cubes",
        "0.5 cup milk"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a blender combine strawberries, banana, peaches, apples, and ice cream. Blend until smooth. Add ice, pour in milk and blend again until smooth. Serve immediately."
        }
      ],
