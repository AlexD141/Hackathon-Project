    {
      "name": "Tropical Delite Smoothie",
      "ingredients_raw": [
        "1 cup coconut milk",
        "1 (15.25 ounce) can mango slices with juice",
        "0.5 cup orange juice",
        "0.25 cup white sugar",
        "1 cup shaved ice",
        "0.25 cup whipped cream, divided",
        "1 tablespoon shaved milk chocolate, divided"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place coconut milk, mango slices with their juice, orange juice, and sugar into a blender, and blend until smooth; add the shaved ice, and blend again. Pour into 4 glasses, and top each serving with a dollop of whipped cream and a sprinkling of shaved milk chocolate."
        }
      ],
