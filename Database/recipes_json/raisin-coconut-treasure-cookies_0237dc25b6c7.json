  "recipes": [
    {
      "name": "Raisin Coconut Treasure Cookies",
      "ingredients_raw": [
        "1.5 cups finely ground graham cracker crumbs",
        "0.5 cup all-purpose flour",
        "2 teaspoons baking powder",
        "1 (14 ounce) can sweetened condensed milk",
        "0.5 cup butter, softened",
        "1.5 cups raisins",
        "1.3333300352097 cups flaked coconut",
        "1 cup chopped walnuts"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 375 degrees F (190 degrees C)."
        },
        {
          "id": 2,
          "text": "Mix graham cracker crumbs, flour and baking powder. Beat sweetened condensed milk and margarine until smooth. Add crumb mixture. Mix well. Stir in raisins, coconut and walnuts."
        },
        {
          "id": 3,
          "text": "Drop by tablespoons onto lightly greased cookie sheets. Bake 9-10 minutes or until lightly browned. Cool 2-3 minutes. Remove from cookie sheets. Store loosely covered at room temperature."
        }
      ],
