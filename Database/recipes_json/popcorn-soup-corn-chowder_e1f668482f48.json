  "recipes": [
    {
      "name": "Popcorn Soup (Corn Chowder)",
      "ingredients_raw": [
        "1 onion, chopped",
        "0.5 cup butter",
        "1 tablespoon dried parsley",
        "0.25 cup all-purpose flour",
        "2 quarts half-and-half cream",
        "2 (15.25 ounce) cans whole kernel corn",
        "salt and ground black pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Sauté onion in butter with parsley flakes until onion is tender, about 8 minutes."
        },
        {
          "id": 2,
          "text": "Stir flour into onion mixture (mixture will be lumpy). Slowly stir in half-and-half until smooth and creamy. Add corn and cook until slightly thickened, about 5 minutes."
        },
        {
          "id": 3,
          "text": "Season with salt and pepper. Ladle soup into bowls and garnish with popped corn."
        }
      ],
