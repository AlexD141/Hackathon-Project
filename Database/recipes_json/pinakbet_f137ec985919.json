            "author": {
              "@type": "Person",
              "name": "P'lar Kinzel"
            },
            "reviewBody": "I used a 12 can of v-8 tomato juice &amp; cooked this in the slow cooker for about 4hrs. The seasonings from the v-8 made this really tasty...",
            "datePublished": "2018-10-12T08:18:31.687Z"
          },
