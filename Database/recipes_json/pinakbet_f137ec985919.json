  "recipes": [
    {
      "name": "Pinakbet",
      "ingredients_raw": [
        "3 tablespoons olive oil",
        "1 onion, chopped",
        "2 cloves garlic, minced",
        "0.5 pound pork loin, chopped",
        "0.5 pound peeled and deveined prawns",
        "salt and pepper to taste",
        "1 tomato, chopped",
        "0.25 pound zucchini, seeded and cut into bite-size pieces",
        "0.25 pound fresh okra, ends trimmed",
        "0.25 pound fresh green beans, trimmed",
        "0.25 pound eggplant, cut into bite-size pieces",
        "1 small bitter melon, cut into bite-size pieces"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Heat oil in a large pot over medium heat; stir in onion and garlic and cook until tender, about 5 minutes."
        },
        {
          "id": 2,
          "text": "Add pork; cook and stir until browned, 5 to 7 minutes."
        },
        {
          "id": 3,
          "text": "Add prawns; cook and stir until they turn pink, about 5 minutes."
        },
        {
          "id": 4,
          "text": "Stir in tomato; season with salt and pepper, cover and simmer for 5 minutes."
        },
        {
          "id": 5,
          "text": "Stir in zucchini, okra, green beans, eggplant, and bitter melon; cover and cook until the vegetables are tender, about 10 minutes."
        }
      ],
