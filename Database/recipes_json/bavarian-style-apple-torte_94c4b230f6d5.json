  "recipes": [
    {
      "name": "Bavarian-Style Apple Torte",
      "ingredients_raw": [
        "0.75 cup butter or margarine, softened",
        "0.5 teaspoon vanilla extract",
        "1.5 cups all-purpose flour",
        "0.5 cup white sugar",
        "2 (8 ounce) packages cream cheese, softened",
        "0.25 cup white sugar",
        "2 eggs",
        "0.75 teaspoon vanilla extract",
        "3 cups apples - peeled, cored and sliced thinly",
        "1 teaspoon ground cinnamon",
        "0.5 cup white sugar"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Mix together the butter, 1/2 teaspoon vanilla extract, all-purpose flour, and 1/2 cup of sugar in a bowl. Press the mixture into the bottom of an ungreased 9-inch springform pan."
        },
        {
          "id": 3,
          "text": "Beat together the cream cheese and sugar in a large bowl. Stir in the eggs and 3/4 teaspoons vanilla extract. Pour the egg mixture over the crust."
        },
        {
          "id": 4,
          "text": "Combine the sliced apples, cinnamon, and 1/2 cup sugar in a bowl. Spoon apple mixture evenly over the cream cheese mixture. Place the springform pan on a baking sheet."
        },
        {
          "id": 5,
          "text": "Bake in preheated oven until center is set, 50 to 65 minutes."
        }
      ],
