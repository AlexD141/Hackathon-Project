{
  "source_url": "https://www.allrecipes.com/recipe/10244/strufoli-iii/",
  "extracted_at": "2026-10-18T01:41:28.894652+00:00",
  "recipes": [
    {
      "name": "Strufoli III",
      "ingredients_raw": [
        "2 cups sifted all-purpose flour",
        "3 eggs",
        "1 pinch salt",
        "2 cups vegetable oil",
        "1.25 cups honey",
        "0.5 cup white sugar",
        "3 tablespoons pine nuts",
        "2 teaspoons confectioners' sugar"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Sift flour. Make a well in center, and break eggs into it. Add salt, and knead until smooth."
        },
        {
          "id": 2,
          "text": "Roll dough out on lightly floured board until 1/4 inch thick. Cut into 1/2 inch strips, and cut strips into tiny pieces 1/2 inch long."
        },
        {
          "id": 3,
          "text": "With the palm of hands, shape these tiny pieces into balls the size of a filbert nut."
        },
        {
          "id": 4,
          "text": "Heat oil to 350 degrees F (175 degrees C)."
        },
        {
          "id": 5,
          "text": "Drop balls into oil 3 at a time. Fry until lightly browned, turning them constantly with a wooden spoon. Remove balls and drain them."
        },
        {
          "id": 6,
          "text": "Combine honey and sugar in saucepan and boil over low flame about 2 minutes, stirring constantly. Add fried dough balls, 1 cup at a time, and cook in honey syrup, stirring constantly, for 1 minute. Remove and put strufoli on flat plate to cool. Sprinkle with pine nuts and confectioners&#39; sugar as soon as they are cool enough to handle, and mold about 5 together in a cluster. Enough for 8, or so. Strufoli will stay fresh for weeks if they are kept in a cool place."
        }
      ],
