  "recipes": [
    {
      "name": "Spinach Watermelon-Mint Salad",
      "ingredients_raw": [
        "1 cup apple cider vinegar",
        "0.5 cup vegetable oil",
        "0.25 cup Worcestershire sauce",
        "0.25 cup white sugar",
        "1 tablespoon sesame seeds",
        "1 tablespoon poppy seeds",
        "2 cups cubed seeded watermelon",
        "1 small red onion, thinly sliced",
        "1 (10 ounce) bag baby spinach leaves",
        "1 cup chopped pecans, toasted",
        "1 cup mint leaves, finely chopped"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Whisk apple cider vinegar, oil, Worcestershire sauce, sugar, sesame seeds, and poppy seeds together in a large bowl until well combined; set vinaigrette aside."
        },
        {
          "id": 2,
          "text": "Combine watermelon, onion, spinach, pecans, and mint in a large serving bowl; toss with vinaigrette just before serving."
        }
      ],
