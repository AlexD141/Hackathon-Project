  "recipes": [
    {
      "name": "Zucchini Chocolate Chip Muffins",
      "ingredients_raw": [
        "1.5 cups all-purpose flour",
        "0.75 cup white sugar",
        "1 teaspoon baking soda",
        "1 teaspoon ground cinnamon",
        "0.5 teaspoon salt",
        "0.5 cup vegetable oil",
        "0.25 cup milk",
        "1 egg, lightly beaten",
        "1 tablespoon lemon juice",
        "1 teaspoon vanilla extract",
        "1 cup shredded zucchini",
        "0.5 cup miniature semisweet chocolate chips",
        "0.5 cup chopped walnuts"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 12-cup muffin tin or line cups with paper liners."
        },
        {
          "id": 3,
          "text": "Combine flour, sugar, baking soda, cinnamon, and salt in a large bowl."
        },
        {
          "id": 4,
          "text": "Whisk oil, milk, egg, lemon juice, and vanilla extract in a separate bowl."
        },
        {
          "id": 5,
          "text": "Stir oil mixture into flour mixture until just moistened; fold in zucchini, chocolate chips, and walnuts."
        },
        {
          "id": 6,
          "text": "Spoon batter into the prepared muffin cups, filling each 2/3 full."
        },
        {
          "id": 7,
          "text": "Bake in the preheated oven until tops spring back when lightly pressed, about 20 to 25 minutes. Let muffins cool in the tin briefly before transferring to a wire rack to cool completely"
        },
        {
          "id": 8,
          "text": "Enjoy!"
        }
      ],
