      "name": "Steamed Mussels I",
      "ingredients_raw": [
        "10 pounds mussels, cleaned and debearded",
        "1 onion, chopped",
        "1 clove garlic, minced"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Fill a large pot with mussels. Sprinkle chopped onions and garlic over the shellfish. Do not add water, as mussels produce all the water needed for steaming! Cook over high heat until most or all of the mussels open. Discard any that do not open."
        }
