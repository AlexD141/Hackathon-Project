  "recipes": [
    {
      "name": "Cranberry Carrot Cake",
      "ingredients_raw": [
        "2 cups flour",
        "1 tablespoon baking powder",
        "2 teaspoons baking soda",
        "2 teaspoons ground cinnamon",
        "0.5 teaspoon ground ginger",
        "1 pinch salt",
        "1.5 cups sugar",
        "1 cup mayonnaise",
        "3 eggs",
        "2 teaspoons vanilla extract",
        "2 cups grated carrots",
        "1 (8 ounce) can crushed pineapple, with juice",
        "0.75 cup dried cranberries",
        "0.5 cup chopped toasted pecans"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour three 8-inch round cake pans."
        },
        {
          "id": 2,
          "text": "Whisk flour, baking powder, baking soda, cinnamon, ginger, and salt together in a bowl; set aside."
        },
        {
          "id": 3,
          "text": "Beat sugar, mayonnaise, eggs, and vanilla extract together in a large bowl with an electric mixer until blended, scraping the bowl occasionally. Stir in flour mixture; fold in carrots, pineapple, cranberries, and pecans. Divide batter between the prepared cake pans."
        },
        {
          "id": 4,
          "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, 30 to 35 minutes. Cool in the pans for 10 minutes, then remove from the pans, and cool completely on wire racks, about 1 hour."
        }
      ],
