    {
      "name": "Licuado de Mango",
      "ingredients_raw": [
        "1 mango - peeled, seeded and diced",
        "1.5 cups milk",
        "3 tablespoons honey",
        "1 cup ice cubes"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place mango, milk, honey, and ice cubes into a blender. Cover and blend until smooth. Serve immediately."
        }
      ],
