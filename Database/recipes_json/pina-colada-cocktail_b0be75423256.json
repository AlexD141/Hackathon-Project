  "recipes": [
    {
      "name": "Pina Colada Cocktail",
      "ingredients_raw": [
        "3 fluid ounces light rum",
        "3 tablespoons cream of coconut",
        "3 tablespoons crushed pineapple",
        "2 cups ice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine rum, cream of coconut, pineapple, and ice in a blender. Puree on high speed until smooth. Pour into chilled Collins glass and serve with a straw."
        }
      ],
