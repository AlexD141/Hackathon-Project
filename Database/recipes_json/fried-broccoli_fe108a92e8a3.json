  "recipes": [
    {
      "name": "Pan-Fried Broccoli",
      "ingredients_raw": [
        "1 (16 ounce) package frozen broccoli, thawed",
        "1 tablespoon olive oil",
        "0.5 teaspoon crushed red pepper flakes",
        "salt, to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Rinse thawed broccoli and pat dry."
        },
        {
          "id": 2,
          "text": "Heat oil in a large skillet over medium heat. Add pepper flakes and cook for 1 minute. Add broccoli and sauté until it starts to get crispy, 5 to 7 minutes. Season with salt to serve."
        }
      ],
