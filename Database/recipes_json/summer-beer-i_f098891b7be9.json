  "recipes": [
    {
      "name": "Summer Beer",
      "ingredients_raw": [
        "4 cups ice cubes",
        "1 (12 fluid ounce) can or bottle beer",
        "12 fluid ounces vodka",
        "1 (6 ounce) can frozen lemonade concentrate"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Crush ice in a blender."
        },
        {
          "id": 3,
          "text": "Add beer, vodka, and lemonade concentrate to the blender; blend until smooth."
        },
        {
          "id": 4,
          "text": "Serve in frozen glasses."
        }
      ],
      "warnings": [],
