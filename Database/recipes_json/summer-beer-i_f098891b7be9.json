            "author": {
              "@type": "Person",
              "name": "kerman"
            },
            "reviewBody": "We made this drink with either vodka or whiskey, and either way we enjoyed it a lot on our family get-together vacations. Our recipe is called \"Strip and Go Naked\".",
            "datePublished": "2013-06-29T19:57:33.827Z"
          },
