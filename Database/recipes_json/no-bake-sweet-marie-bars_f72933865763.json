  "recipes": [
    {
      "name": "No Bake Sweet Marie Bars",
      "ingredients_raw": [
        "cooking spray",
        "0.5 cup peanut butter",
        "0.5 cup corn syrup",
        "0.5 cup brown sugar",
        "1 tablespoon butter",
        "2 cups crispy rice cereal",
        "1 cup peanuts",
        "1 cup chocolate chips"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Coat an 8-inch square baking dish with cooking spray."
        },
        {
          "id": 2,
          "text": "Cook and stir peanut butter, corn syrup, brown sugar, and butter together in a large saucepan over medium-low heat until boiling. Fold in crispy rice cereal and peanuts; press into the prepared baking dish."
        },
        {
          "id": 3,
          "text": "Sprinkle chocolate chips evenly over top hot peanut butter mixture. Let chocolate chips melt; spread chocolate over top in an even layer."
        },
        {
          "id": 4,
          "text": "Refrigerate until peanut butter mixture hardens, about 1 hour."
        }
      ],
