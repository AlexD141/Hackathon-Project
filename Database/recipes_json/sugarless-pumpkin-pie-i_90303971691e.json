  "recipes": [
    {
      "name": "Sugarless Pumpkin Pie I",
      "ingredients_raw": [
        "1 recipe pastry for a 9 inch single crust pie",
        "1 cup solid pack pumpkin puree",
        "0.5 teaspoon ground cloves",
        "1 egg",
        "1 cup milk",
        "0.5 teaspoon ground cinnamon",
        "6 packets granulated artificial sweetener"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Beat egg, sugar substitute and spices until fluffy. Add milk and pumpkin; mix well."
        },
        {
          "id": 2,
          "text": "Pour into unbaked 8-inch pie shell. Bake at 350 degrees F for 30 minutes or until inserted knife comes out clean."
        }
      ],
