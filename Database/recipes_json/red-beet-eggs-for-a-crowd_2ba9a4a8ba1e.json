  "recipes": [
    {
      "name": "Red Beet Eggs for a Crowd",
      "ingredients_raw": [
        "3 (15 ounce) cans sliced beets",
        "0.5 cup apple cider vinegar",
        "0.5 cup white sugar",
        "1 cup water, or as needed",
        "18 hard-cooked eggs, peeled",
        "1 sweet onion, sliced"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Drain juice from canned beets into a large container with a lid; stir in apple cider vinegar, sugar, and water until sugar has dissolved."
        },
        {
          "id": 2,
          "text": "Mix sliced beets, hard-cooked eggs, and sweet onion into the liquid; add more water so liquid covers eggs completely if needed."
        },
        {
          "id": 3,
          "text": "Cover container and refrigerate for 1 to 3 days, stirring the eggs and beets twice daily. The longer they soak, the deeper the eggs&#39; color will be."
        }
      ],
