  "recipes": [
    {
      "name": "Besan Laddu",
      "ingredients_raw": [
        "2 cups chickpea flour (besan)",
        "1 cup clarified butter (ghee)",
        "1 cup white sugar, or to taste",
        "2 teaspoons finely chopped pistachio nuts",
        "1 teaspoon finely chopped cashews"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Stir the chickpea flour and clarified butter together in a saucepan over medium-low heat until the mixture smells toasty, about 10 minutes. Set aside until cool enough to handle."
        },
        {
          "id": 2,
          "text": "Stir in the sugar, pistachios, and cashews until evenly mixed. Form the mixture into small balls the size of large cherries. Use some pressure when forming the balls so they don&#39;t come apart."
        }
      ],
