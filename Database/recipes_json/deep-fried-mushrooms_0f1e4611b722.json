  "recipes": [
    {
      "name": "Deep-Fried Mushrooms",
      "ingredients_raw": [
        "1 cup all-purpose flour",
        "1 teaspoon garlic salt",
        "1 cup water",
        "1 large egg",
        "2 cups oil for frying, or as needed",
        "1 pound button mushrooms, quartered"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Stir flour and garlic salt together in a medium bowl. Mix in water and egg until smooth."
        },
        {
          "id": 3,
          "text": "Heat oil in a large deep skillet over medium-high heat until a drop of batter will sizzle and float to the top."
        },
        {
          "id": 4,
          "text": "Working in small batches, dip mushrooms into batter and fry in hot oil until golden brown, 3 to 5 minutes. Remove with a slotted spoon and drain on paper towels."
        }
      ],
