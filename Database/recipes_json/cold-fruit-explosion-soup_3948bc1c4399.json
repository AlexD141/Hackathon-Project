  "recipes": [
    {
      "name": "Cold Fruit Explosion Soup",
      "ingredients_raw": [
        "4 cups cubed seeded watermelon",
        "2 cups cubed honeydew",
        "2 cups fresh blueberries, divided",
        "1.5 teaspoons minced fresh ginger root",
        "0.5 teaspoon ground nutmeg"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Blend the watermelon, honeydew, and about half the blueberries in a blender until smooth. Add the ginger and nutmeg; blend again until incorporated. Pour the soup into a bowl and stir the reserved blueberries to serve."
        }
      ],
