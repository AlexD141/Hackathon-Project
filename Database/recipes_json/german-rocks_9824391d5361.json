  "recipes": [
    {
      "name": "German Rocks",
      "ingredients_raw": [
        "0.5 cup butter",
        "1.5 cups white sugar",
        "3 eggs",
        "1 teaspoon baking soda",
        "1 teaspoon hot water",
        "2.5 cups sifted all-purpose flour",
        "1 teaspoon ground cinnamon",
        "2 cups dates, pitted and chopped",
        "3 cups chopped walnuts"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Beat butter and sugar together in a medium bowl until light and fluffy. Beat in eggs one at a time. Dissolve the baking soda in the hot water, add it to the egg mixture. Stir in the flour and cinnamon until well blended. Stir in dates and walnuts until evenly distributed."
        },
        {
          "id": 3,
          "text": "Drop by heaping spoonfuls onto an ungreased cookie sheet."
        },
        {
          "id": 4,
          "text": "Bake in the preheated oven until golden, 10 to 15 minutes."
        }
      ],
      "warnings": [],
