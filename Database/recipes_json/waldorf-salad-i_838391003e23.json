  "recipes": [
    {
      "name": "Creamy Waldorf Salad",
      "ingredients_raw": [
        "2 cups chopped apples",
        "1.5 lemons, juiced",
        "0.25 cup chopped celery",
        "0.25 cup chopped walnuts",
        "0.25 cup raisins",
        "0.25 cup seedless grapes, halved",
        "0.5 cup heavy cream, whipped",
        "0.25 cup mayonnaise",
        "1 pinch ground nutmeg"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Toss apples and lemon juice together in a large bowl; stir in celery, nuts, raisins and grapes."
        },
        {
          "id": 2,
          "text": "Fold whipped cream and mayonnaise together; add to salad and mix well."
        },
        {
          "id": 3,
          "text": "Sprinkle with nutmeg and chill for at least 1 hour before serving."
        }
      ],
