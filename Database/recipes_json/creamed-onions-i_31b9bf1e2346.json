  "recipes": [
    {
      "name": "Creamed Onions I",
      "ingredients_raw": [
        "2 tablespoons butter, softened",
        "2 tablespoons all-purpose flour",
        "1 cup milk",
        "salt and pepper to taste",
        "20 ounces pearl onions",
        "50 buttery round crackers, crumbled",
        "2 tablespoons butter, softened"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Prepare the sauce by whisking together and cooking the butter, flour, milk, salt and pepper. Cook until smooth."
        },
        {
          "id": 3,
          "text": "Place onions in a 2 quart casserole dish, pour in white sauce."
        },
        {
          "id": 4,
          "text": "In a saute pan, melt 2 tablespoons butter and toast cracker crumbs until golden. Sprinkle over onions. Bake 20 minutes or until steaming hot."
        }
      ],
