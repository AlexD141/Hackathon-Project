      "name": "Fiery Baked Beans",
      "ingredients_raw": [
        "0.5 cup chopped onion",
        "2 tablespoons maple syrup",
        "1 tablespoon Dijon mustard",
        "4 teaspoons canned chipotle chile peppers in adobo sauce, finely chopped",
        "2 (16 ounce) cans no-salt-added navy beans",
        "1 cup no-salt-added ketchup",
        "1 teaspoon ground cinnamon",
        "salt and pepper, to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees. In a large bowl combine all ingredients. Spray a 7x11 shallow baking dish. Add bean mixture. Bake 45 minutes."
        }
      ],
