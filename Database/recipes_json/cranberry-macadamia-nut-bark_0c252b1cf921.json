  "recipes": [
    {
      "name": "Cranberry Macadamia Nut Bark",
      "ingredients_raw": [
        "1 pound white confectioners' coating",
        "0.5 cup dried cranberries",
        "1 (3.5 ounce) package macadamia nuts"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Line one 10x15 inch cookie sheet with aluminum foil."
        },
        {
          "id": 2,
          "text": "Place white confectioners&#39; coating (almond bark) in a microwave safe bowl, and microwave on medium heat until melted. Stir in cranberries and nuts."
        },
        {
          "id": 3,
          "text": "Spread mixture out on foil, cool, and break into 1 1/ 2 inch pieces. Store in air tight container."
        }
      ],
