  "recipes": [
    {
      "name": "Awesome Sauce",
      "ingredients_raw": [
        "3 gallons water",
        "3 cups white sugar",
        "1 (16 ounce) can tomato paste (such as Contadina®)",
        "1 cup dried basil",
        "1 cup dried minced onion",
        "0.25 cup dried oregano",
        "0.25 cup granulated garlic",
        "0.25 cup salt",
        "1.5 teaspoons cayenne pepper",
        "1 pork neck"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Stir water, sugar, tomato paste, basil, minced onion, oregano, granulated garlic, salt, cayenne pepper, and pork neck together in a large pot."
        },
        {
          "id": 2,
          "text": "Bring the mixture to a simmer and cook until thickened to desired consistency, about 30 minutes."
        },
        {
          "id": 3,
          "text": "Remove pork neck bones to serve."
        }
      ],
