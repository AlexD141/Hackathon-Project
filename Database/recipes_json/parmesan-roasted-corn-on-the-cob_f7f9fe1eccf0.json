  "recipes": [
    {
      "name": "Parmesan Roasted Corn on the Cob",
      "ingredients_raw": [
        "0.5 cup mayonnaise",
        "5 ears corn, husk and silk removed",
        "1 cup shredded Parmesan cheese",
        "1 tablespoon chili powder",
        "1 teaspoon salt",
        "1 teaspoon ground black pepper"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate."
        },
        {
          "id": 2,
          "text": "Brush a thin layer mayonnaise on each ear of corn; sprinkle with Parmesan cheese, chili powder, salt, and black pepper. Wrap each ear in aluminum foil."
        },
        {
          "id": 3,
          "text": "Cook on the preheated grill, turning occasionally, until kernels begin to brown, about 10 minutes."
        }
      ],
