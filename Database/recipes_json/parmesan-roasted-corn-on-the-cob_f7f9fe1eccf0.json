            "author": {
              "@type": "Person",
              "name": "RainbowJewels"
            },
            "reviewBody": "We really enjoyed this corn! Made with butter instead of mayo (because gross!) and it worked perfectly. Will definitely make again.",
            "datePublished": "2020-07-01T02:02:29.847Z"
          },
          {
            "@type": "Review",
            "reviewRating": {
              "@type": "Rating",
