  "recipes": [
    {
      "name": "Streusel Apple Pie Topping",
      "ingredients_raw": [
        "0.5 cup all-purpose flour",
        "0.25 cup brown sugar",
        "0.25 cup cold butter, cubed",
        "0.25 cup chopped walnuts",
        "0.25 cup chopped dried apples"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Stir together flour and sugar in a bowl. Cut in cold butter with a pastry blender until the mixture resembles coarse crumbs. Stir in walnuts and apples."
        },
        {
          "id": 2,
          "text": "To use, sprinkle the mixture evenly over an apple pie, and bake according to recipe directions."
        }
      ],
