            "author": {
              "@type": "Person",
              "name": "Pam in CA"
            },
            "reviewBody": "I sliced the chicken into strips, added an extra lime to the marinade. Let the chicken sit in marinade for about 2 hours. Sauteed the chicken. Added sauteed bell peppers and onions. Served as soft tacos with shredded cheddar cheese and lettuce.",
            "datePublished": "2017-01-03T02:21:00.210Z"
          },
