  "recipes": [
    {
      "name": "Swedish Klimp",
      "ingredients_raw": [
        "1 egg, lightly beaten",
        "1.5 cups milk",
        "1.5 teaspoons salt",
        "0.5 teaspoon sugar",
        "1.75 cups all-purpose flour"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a medium bowl, whisk together egg, milk, salt and sugar. Gradually add flour, mixing until smooth."
        },
        {
          "id": 2,
          "text": "Drop flour mixture by tablespoonfuls into boiling soup or stew. When they float to the surface, they are done."
        }
      ],
