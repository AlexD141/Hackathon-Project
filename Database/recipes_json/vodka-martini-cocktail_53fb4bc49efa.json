    {
      "name": "Vodka Martini Cocktail",
      "ingredients_raw": [
        "3 fluid ounces vodka",
        "1 fluid ounce dry vermouth",
        "1 cup ice cubes",
        "3 small olives"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather ingredients."
        },
        {
          "id": 2,
          "text": "Combine vodka and dry vermouth in a cocktail mixing glass. Fill with ice and stir until chilled."
        },
        {
          "id": 3,
          "text": "Strain into a chilled martini glass."
        },
        {
          "id": 4,
          "text": "Garnish with three olives on a toothpick."
        }
      ],
