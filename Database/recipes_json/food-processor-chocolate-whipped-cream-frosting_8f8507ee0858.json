  "recipes": [
    {
      "name": "Food Processor Chocolate Whipped Cream Frosting",
      "ingredients_raw": [
        "1 cup heavy whipping cream",
        "2.5 tablespoons white sugar",
        "2.5 tablespoons unsweetened cocoa powder",
        "1 teaspoon vanilla extract"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place cream, sugar, cocoa powder, and vanilla in a food processor with the whip attachment. Mix on high until stiff peaks form, about 3 minutes."
        }
      ],
