    {
      "name": "Lime Mexicali Salad",
      "ingredients_raw": [
        "2 cups chopped romaine lettuce",
        "1 cup grapefruit sections",
        "0.66666668653488 cup chopped mango",
        "0.5 cup matchstick-cut jicama",
        "0.5 cup black beans",
        "0.5 cup corn",
        "0.5 cup shredded pepperjack cheese",
        "0.33333334326744 cup chopped fresh cilantro",
        "0.33333334326744 cup chopped fresh parsley",
        "0.5 cup lime juice",
        "2 teaspoons white sugar",
        "1 pinch ground black pepper",
        "salt to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine lettuce, grapefruit, mango, jicama, black beans, corn, pepper Jack cheese, cilantro, and parsley in a large bowl."
        },
        {
          "id": 2,
          "text": "Whisk lime juice, sugar, black pepper, and salt in a small bowl until sugar dissolves; pour over salad. Toss to serve."
        }
      ],
