  "recipes": [
    {
      "name": "Betty Tarts",
      "ingredients_raw": [
        "12 (2 inch) unbaked tart shells",
        "1 cup golden brown sugar",
        "0.25 cup butter, softened",
        "1 cup light corn syrup",
        "3 eggs",
        "1 pinch salt"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C). Place the tart shells onto a baking sheet lined with parchment paper."
        },
        {
          "id": 2,
          "text": "In a bowl, mash the brown sugar and butter until thoroughly combined, then mix in corn syrup, eggs, and salt to make a smooth mixture. Spoon into the tart shells, filling each one about 3/4 full."
        },
        {
          "id": 3,
          "text": "Bake in the preheated oven until golden brown and the filling is set, 25 to 30 minutes."
        }
      ],
