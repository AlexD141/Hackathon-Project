  "recipes": [
    {
      "name": "White Christmas Cocktail",
      "ingredients_raw": [
        "1 fluid ounce heavy cream",
        "1 fluid ounce vodka",
        "1 fluid ounce peppermint schnapps",
        "1 fluid ounce white creme de cacao",
        "1 cup ice cubes",
        "1 small candy cane"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Pour the heavy cream, vodka, schnapps, and white creme de cacao into a cocktail shaker over ice. Cover, and shake until the outside of the shaker has frosted. Strain into a chilled glass, and garnish with a mini candy cane to serve."
        }
      ],
