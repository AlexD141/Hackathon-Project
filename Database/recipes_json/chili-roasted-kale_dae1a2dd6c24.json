  "recipes": [
    {
      "name": "Chili-Roasted Kale",
      "ingredients_raw": [
        "4 cups kale, washed and stems removed",
        "1 tablespoon extra-virgin olive oil",
        "1 tablespoon chili powder",
        "0.5 teaspoon kosher salt"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 400 degrees F (200 degrees C)."
        },
        {
          "id": 2,
          "text": "Place kale into a large bowl and drizzle with olive oil; toss until evenly coated. Sprinkle with chili powder and kosher salt; toss again. Spread seasoned kale onto a baking sheet."
        },
        {
          "id": 3,
          "text": "Roast in the preheated oven for 5 minutes. Stir kale and continue roasting until the edges become brown and a little crispy, 5 to 8 minutes."
        }
      ],
