  "recipes": [
    {
      "name": "Carrot Cake Sandwich",
      "ingredients_raw": [
        "1 cinnamon-raisin English muffin, halved",
        "3 baby carrots, shredded",
        "1 pinch ground nutmeg",
        "1 tablespoon crunchy peanut butter",
        "1 tablespoon whipped cream cheese",
        "0.25 cup clover sprouts"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Lightly toast both halves of English muffin."
        },
        {
          "id": 2,
          "text": "Place shredded carrots in a small bowl and sprinkle with nutmeg."
        },
        {
          "id": 3,
          "text": "Spread peanut butter on one side of English muffin."
        },
        {
          "id": 4,
          "text": "Spread cream cheese on other side of English muffin. Top with carrots and sprouts. Put both sides together to make a sandwich."
        }
      ],
