    {
      "name": "Orange Johnny Cake",
      "ingredients_raw": [
        "1 (8.5 ounce) package dry corn muffin mix",
        "1 egg, beaten",
        "0.33300000429153 cup milk",
        "3 tablespoons grated orange zest"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 400 degrees F (200 degrees C). Lightly grease an 8x8 inch baking pan."
        },
        {
          "id": 2,
          "text": "In a large bowl, stir together muffin mix, egg, milk and orange zest. Pour batter into prepared pan."
        },
        {
          "id": 3,
          "text": "Bake in preheated oven for 20 to 25 minutes, until golden brown."
        }
      ],
