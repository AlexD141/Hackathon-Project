  "recipes": [
    {
      "name": "Vinegar Pie VII",
      "ingredients_raw": [
        "1 (9 inch) pie crust, baked",
        "1 cup white sugar",
        "2 tablespoons all-purpose flour",
        "2 tablespoons distilled white vinegar",
        "2 eggs, beaten",
        "1 cup water",
        "0.5 teaspoon lemon extract",
        "1 tablespoon butter"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a double boiler, combine sugar and flour. Mix well, then whisk in vinegar, eggs, and water. Cook until thickened, stirring constantly. Just before removing from heat, stir in butter or margarine and lemon extract."
        },
        {
          "id": 2,
          "text": "Pour mixture into baked pastry shell. Chill before serving."
        }
      ],
