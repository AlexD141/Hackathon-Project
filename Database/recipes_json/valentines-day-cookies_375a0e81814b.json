  "recipes": [
    {
      "name": "Valentine&#39;s Day Cookies",
      "ingredients_raw": [
        "1.25 cups all-purpose flour",
        "0.25 cup white sugar",
        "0.5 teaspoon baking soda",
        "2 pinches salt",
        "0.5 cup honey",
        "0.33333334326744 cup milk",
        "0.25 cup butter, softened",
        "0.25 teaspoon vanilla extract",
        "0.5 cup semisweet chocolate chips",
        "0.5 cup vanilla chips",
        "0.5 cup confectioners' sugar"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Whisk together the flour, white sugar, baking soda, and salt in a bowl."
        },
        {
          "id": 3,
          "text": "Beat honey, milk, butter, and vanilla extract together in a large bowl until smooth."
        },
        {
          "id": 4,
          "text": "Stir the flour mixture into the honey mixture until just combined."
        },
        {
          "id": 5,
          "text": "Fold in the chocolate and vanilla chips."
        },
        {
          "id": 6,
          "text": "Roll the dough into walnut-sized balls and place 2 inches apart onto nonstick baking sheets."
        },
        {
          "id": 7,
          "text": "Bake in the preheated oven until golden brown, 15 to 18 minutes."
        },
        {
          "id": 8,
          "text": "Allow cookies to cool; dust with confectioners&#39; sugar."
        }
      ],
