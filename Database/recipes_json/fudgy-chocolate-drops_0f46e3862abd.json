  "recipes": [
    {
      "name": "Fudgy Chocolate Drops",
      "ingredients_raw": [
        "2.666699886322 cups all-purpose flour",
        "1 teaspoon baking soda",
        "0.5 teaspoon salt",
        "0.5 cup shortening",
        "0.5 cup butter",
        "1.5 cups brown sugar",
        "2 eggs",
        "2 teaspoons vanilla extract",
        "4 (1 ounce) squares unsweetened chocolate, chopped",
        "1 cup sour milk"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C). Grease cookie sheets. Sift together the flour, baking soda and salt, set aside."
        },
        {
          "id": 2,
          "text": "Sift together the flour, baking soda, and salt. Set aside. In the microwave or over a double boiler, melt chocolate stirring frequently until smooth. Remove from heat."
        },
        {
          "id": 3,
          "text": "In a medium bowl, cream together the shortening, butter, and brown sugar. Beat in the eggs, one at a time, then stir in the vanilla and melted chocolate. Mix in the dry ingredients alternately with the sour milk. Drop dough by rounded teaspoonfuls onto the prepared cookie sheets about 2 inches apart."
        },
        {
          "id": 4,
          "text": "Bake for 8 to 10 minutes in the preheated oven, until firm to the touch. Remove from baking sheets to cool on wire racks."
        }
      ],
