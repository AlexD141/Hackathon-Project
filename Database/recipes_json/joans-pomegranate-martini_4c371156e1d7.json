  "recipes": [
    {
      "name": "Joan&#39;s Pomegranate Martini",
      "ingredients_raw": [
        "1 (1.5 fluid ounce) jigger pomegranate juice",
        "3 fluid ounces citron vodka",
        "1 fluid ounce orange-flavored liqueur",
        "1 cup crushed ice",
        "1 fluid ounce sparkling water",
        "1 wedge fresh lemon",
        "pomegranate seeds"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine pomegranate juice, vodka, orange liqueur, and ice in a shaker. Add sparkling water and a little lemon juice, if desired. Shake vigorously, and strain into a martini glass. Garnish with pomegranate seeds."
        }
      ],
