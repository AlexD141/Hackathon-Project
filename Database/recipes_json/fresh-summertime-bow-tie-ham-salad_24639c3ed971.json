  "recipes": [
    {
      "name": "Fresh Summertime Bow Tie Ham Salad",
      "ingredients_raw": [
        "1 (16 ounce) package bow-tie pasta",
        "1 pound ham chunks",
        "20 grape tomatoes, halved",
        "0.5 cup diced yellow bell pepper",
        "0.5 cup diced red bell pepper",
        "0.5 cup diced orange bell pepper",
        "6 green onions, chopped",
        "2 tablespoons minced garlic",
        "1.5 teaspoons ground black pepper",
        "1 teaspoon salt",
        "1.5 cups mayonnaise",
        "0.5 cup shredded Romano cheese",
        "0.25 cup chopped fresh cilantro"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Bring a large pot of lightly salted water to a boil. Cook bow tie pasta at a boil, stirring occasionally, until tender yet firm to the bite, about 12 minutes. Drain."
        },
        {
          "id": 2,
          "text": "Toss ham, tomatoes, bell peppers, green onions, garlic, black pepper, and salt together in a bowl."
        },
        {
          "id": 3,
          "text": "Stir pasta and mayonnaise into ham mixture; sprinkle with cheese and cilantro then stir until well combined. Chill before serving, at least 1 hour."
        }
      ],
