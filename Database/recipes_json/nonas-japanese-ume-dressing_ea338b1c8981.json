      "name": "Nona&#39;s Japanese Ume Dressing",
      "ingredients_raw": [
        "0.5 cup vegetable oil",
        "0.25 cup chopped onion",
        "0.25 cup rice vinegar",
        "1 tablespoon toasted sesame seeds",
        "1 tablespoon minced fresh ginger root",
        "1 tablespoon minced umeboshi",
        "1.5 teaspoons lemon juice",
        "1 teaspoon white sugar, or more to taste",
        "1 teaspoon salt",
        "ground black pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine oil, onion, vinegar, sesame seeds, ginger, umeboshi, lemon juice, sugar, salt, and pepper in a blender. Cover and purée until smooth, about 30 seconds."
        }
      ],
