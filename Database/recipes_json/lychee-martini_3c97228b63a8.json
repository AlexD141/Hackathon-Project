  "recipes": [
    {
      "name": "Lychee Martini",
      "ingredients_raw": [
        "5 ice cubes",
        "1 (1.5 fluid ounce) jigger vodka",
        "1 fluid ounce peach schnapps",
        "1 fluid ounce white cranberry juice",
        "1 ounce lychee juice (from a can of lychees)",
        "1 lychee, for garnish"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place ice into a cocktail shaker. Pour in vodka, peach schnapps, cranberry juice, and lychee juice. Cover and shake vigorously until the outside of the cocktail shaker has frosted."
        },
        {
          "id": 2,
          "text": "Strain into a chilled martini glass; garnish with a lychee fruit."
        }
      ],
