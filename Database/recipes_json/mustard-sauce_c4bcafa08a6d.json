  "recipes": [
    {
      "name": "Mustard Sauce",
      "ingredients_raw": [
        "0.33333334326744 cup white vinegar",
        "4.5 teaspoons dry mustard",
        "1 large egg, beaten",
        "0.5 cup white sugar"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather the ingredients."
        },
        {
          "id": 2,
          "text": "Mix vinegar and mustard together in a small bowl."
        },
        {
          "id": 3,
          "text": "Whisk egg and sugar together in a saucepan over medium heat."
        },
        {
          "id": 4,
          "text": "Slowly whisk in vinegar mixture; cook and stir until hot, 3 to 5 minutes."
        }
      ],
