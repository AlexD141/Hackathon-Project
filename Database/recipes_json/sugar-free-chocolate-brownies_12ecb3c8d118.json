  "recipes": [
    {
      "name": "Sugar-Free Chocolate Brownies",
      "ingredients_raw": [
        "1 cup butter spread, melted",
        "2 cups granular sucralose sweetener (such as Splenda®)",
        "0.5 cup unsweetened cocoa powder",
        "1 teaspoon vanilla extract",
        "4 eggs",
        "1 cup all-purpose flour",
        "0.5 teaspoon baking powder",
        "0.5 teaspoon salt"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan."
        },
        {
          "id": 2,
          "text": "Mix melted butter spread, sweetener, cocoa powder, vanilla extract, eggs, flour, baking powder, and salt together in a large bowl. Pour into the prepared pan."
        },
        {
          "id": 3,
          "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 20 minutes."
        }
      ],
