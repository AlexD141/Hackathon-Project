  "recipes": [
    {
      "name": "Sweet Potato Pudding II",
      "ingredients_raw": [
        "4 cups grated raw sweet potato",
        "0.5 cup white sugar",
        "0.5 cup light corn syrup",
        "1.5 cups milk",
        "0.33333334326744 cup melted butter",
        "3 eggs, beaten",
        "1 teaspoon ground nutmeg",
        "1 teaspoon ground cinnamon",
        "0.5 teaspoon salt",
        "0.5 cup flaked coconut",
        "0.5 cup chopped pecans",
        "0.5 cup raisins"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat an oven to 325 degrees F (165 degrees C). Lightly grease a 2-quart casserole dish."
        },
        {
          "id": 2,
          "text": "Mix together the sweet potato, sugar, light corn syrup, milk, melted butter, beaten eggs, ground nutmeg, ground cinnamon, salt, coconut, chopped pecans, and raisins in a large mixing bowl; spoon the mixture into the prepared dish."
        },
        {
          "id": 3,
          "text": "Bake in the preheated oven until the top is golden brown and the pudding is set, about 90 minutes."
        }
      ],
