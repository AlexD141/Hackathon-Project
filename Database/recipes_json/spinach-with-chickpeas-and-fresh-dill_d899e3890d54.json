  "recipes": [
    {
      "name": "Spinach with Chickpeas and Fresh Dill",
      "ingredients_raw": [
        "2 tablespoons olive oil",
        "1 large onion, thinly sliced",
        "1.5 cups canned chickpeas, drained",
        "1 pound spinach",
        "0.5 cup minced fresh dill weed",
        "2 lemons, juiced",
        "salt and pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a large skillet, heat olive oil over medium heat. Add onion, and saute until soft. Add chickpeas, and toss to coat in oil."
        },
        {
          "id": 2,
          "text": "Clean spinach well and cut away thick stems; add undrained spinach and dill to skillet, and cook until spinach is tender."
        },
        {
          "id": 3,
          "text": "Stir in lemon juice, and season with salt and pepper to taste. Serve warm."
        }
      ],
