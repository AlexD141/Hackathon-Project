  "recipes": [
    {
      "name": "Sweet Sesame Mahi Mahi",
      "ingredients_raw": [
        "2 cups pineapple chunks",
        "0.25 cup fresh cilantro, chopped",
        "1 tablespoon minced red onion",
        "2 tablespoons lime juice",
        "4 (8 ounce) mahi mahi fillets",
        "2 teaspoons sesame oil",
        "0.25 cup white sesame seeds",
        "1 tablespoon vegetable oil"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Toss the pineapple, cilantro, red onion, and lime juice together in a bowl until evenly mixed; set aside."
        },
        {
          "id": 2,
          "text": "Rub the mahi mahi fillets with the sesame oil to lightly coat."
        },
        {
          "id": 3,
          "text": "Sprinkle the sesame seeds evenly over one side of each fillets; gently press the seeds into the fish to assure they stick."
        },
        {
          "id": 4,
          "text": "Heat the vegetable oil in a large non-stick skillet over medium heat."
        },
        {
          "id": 5,
          "text": "Lay the fillets with the seeded side down into the hot oil; cook for 4 minutes, turn, and continue cooking until the flesh turns opaque and flakes easily with a fork, another 3 to 5 minutes. Serve with the pineapple mixture."
        }
      ],
