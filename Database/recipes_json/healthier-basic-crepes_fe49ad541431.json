  "recipes": [
    {
      "name": "Healthier Basic Crepês",
      "ingredients_raw": [
        "1 cup white whole wheat flour",
        "2 eggs",
        "0.5 cup low-fat (1%) milk",
        "0.5 cup water",
        "0.25 teaspoon salt",
        "2 tablespoons butter, melted",
        "0.5 cup non-fat plain Greek yogurt",
        "0.25 cup maple syrup",
        "0.5 cup blueberries"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Whisk together flour and eggs in a large mixing bowl. Gradually add milk and water, stirring to combine. Mix in butter and salt and beat until smooth."
        },
        {
          "id": 2,
          "text": "Heat a lightly oiled griddle or frying pan over medium-high heat. Pour or scoop 1/4 cup batter onto griddle. Tilt pan with a circular motion so batter coats the surface evenly."
        },
        {
          "id": 3,
          "text": "Cook crepe until bottom is light brown, about 2 minutes. Loosen with a spatula, turn and cook other side. Serve hot with yogurt, maple syrup, and blueberries."
        }
      ],
