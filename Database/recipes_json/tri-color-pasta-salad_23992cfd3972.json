  "recipes": [
    {
      "name": "Tri-Color Pasta Salad",
      "ingredients_raw": [
        "2 pounds uncooked tri-color spiral pasta",
        "10 ounces diced processed American cheese",
        "1 large head broccoli, cut into florets",
        "1 (16 ounce) bottle Italian-style salad dressing"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain."
        },
        {
          "id": 2,
          "text": "Toss cooled pasta with cheese, broccoli and Italian-style dressing to taste. Serve immediately."
        }
      ],
