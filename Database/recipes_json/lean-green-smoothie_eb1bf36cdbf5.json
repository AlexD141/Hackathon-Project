    {
      "name": "Lean Green Smoothie",
      "ingredients_raw": [
        "3 cups honeydew melon - peeled, seeded and cubed",
        "3 cups ice cubes",
        "1 cup green grapes",
        "1 cucumber, peeled and chopped",
        "0.5 cup broccoli florets",
        "1 sprig fresh mint"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place the honeydew melon, ice cubes, grapes, cucumber, broccoli, and mint into a blender. Cover, and puree until smooth."
        }
      ],
