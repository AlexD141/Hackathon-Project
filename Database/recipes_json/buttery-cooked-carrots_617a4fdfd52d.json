  "recipes": [
    {
      "name": "Buttery Cooked Carrots",
      "ingredients_raw": [
        "1 pound baby carrots",
        "0.33333334326744 cup brown sugar",
        "0.25 cup butter"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Cook carrots in a large pot of boiling water until tender, about 8 to 10 minutes."
        },
        {
          "id": 3,
          "text": "Strain carrots, reserve just enough of the cooking water to cover the bottom of the pot; set carrots aside."
        },
        {
          "id": 4,
          "text": "Add brown sugar and butter to the pot with the leftover cooking water; simmer and stir until butter melts."
        },
        {
          "id": 5,
          "text": "Return carrots to the pot and toss to coat. Turn off heat, cover and let carrots sit for a few minutes to allow flavors to mingle."
        },
        {
          "id": 6,
          "text": "Serve hot and enjoy!"
        }
      ],
