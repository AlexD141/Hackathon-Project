  "recipes": [
    {
      "name": "Ham Loaf",
      "ingredients_raw": [
        "2.5 pounds ground ham",
        "2 cups rolled oats",
        "1.5 cups evaporated milk",
        "0.5 pound ground pork",
        "0.5 onion, chopped",
        "2 eggs",
        "2.5 tablespoons chopped fresh parsley",
        "1 teaspoon ground mustard",
        "0.5 teaspoon ground black pepper",
        "1.5 cups brown sugar",
        "0.25 cup cider vinegar",
        "0.75 cup mayonnaise",
        "0.25 cup sour cream",
        "5 tablespoons prepared horseradish",
        "1 tablespoon lemon juice",
        "salt and black pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Combine ground ham, oats, evaporated milk, ground pork, onion, eggs, parsley, ground mustard, and pepper in a large bowl; mix well. Form into 2 loaves; place into two 9x13-inch baking dishes."
        },
        {
          "id": 3,
          "text": "Bake in the preheated oven for 30 minutes."
        },
        {
          "id": 4,
          "text": "A few minutes before the timer goes off, stir together brown sugar and vinegar in a small saucepan and boil for 1 minute. Remove loaves from the oven and pour brown sugar mixture over. Return loaves to the oven; baste frequently with the pan juices until browned and cooked through, 30 to 45 minutes more."
        },
        {
          "id": 5,
          "text": "Make sauce: Mix together mayonnaise, sour cream, horseradish, and lemon juice in a small bowl until well combined. Season with salt and pepper."
        },
        {
          "id": 6,
          "text": "Serve sauce over sliced ham loaves."
        }
      ],
