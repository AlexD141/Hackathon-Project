  "recipes": [
    {
      "name": "Cucumber-Mango Salsa",
      "ingredients_raw": [
        "3 mangos - peeled, seeded and diced",
        "1 large onion, finely diced",
        "1 cucumber - peeled, seeded, and diced",
        "2 jalapeno peppers, seeded and finely chopped",
        "0.25 cup chopped fresh cilantro",
        "1 clove garlic, minced",
        "1 tablespoon lime juice, or to taste",
        "salt and pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine mangoes, onion, cucumber, jalapeños, cilantro, and garlic in a mixing bowl; season with lime juice, salt, and black pepper. Refrigerate to allow flavors to blend before serving, at least 2 hours."
        }
      ],
