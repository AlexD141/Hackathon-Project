  "recipes": [
    {
      "name": "Special Spuds",
      "ingredients_raw": [
        "2 pounds potatoes, cubed",
        "2 tablespoons dried minced onion",
        "2.5 teaspoons dried parsley",
        "1.5 teaspoons garlic powder",
        "1 teaspoon seasoned salt",
        "0.25 teaspoon fresh-ground black pepper",
        "2.5 tablespoons olive oil"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 375 degrees F (190 degrees C)."
        },
        {
          "id": 2,
          "text": "Place the potatoes, minced onion, parsley, garlic powder, seasoned salt, pepper, and olive oil in a large bowl; toss together until potatoes are evenly coated. Spread potatoes in an even layer on a baking sheet lined with aluminum foil."
        },
        {
          "id": 3,
          "text": "Bake for 20 minutes in the preheated oven; flip the potatoes and continue to bake until tender, 20 to 25 minutes."
        }
      ],
