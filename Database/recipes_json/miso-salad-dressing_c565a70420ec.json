  "recipes": [
    {
      "name": "Miso Salad Dressing",
      "ingredients_raw": [
        "1 cup mellow white miso paste",
        "1 cup water",
        "1 cup vegetable oil",
        "0.25 cup chopped onion",
        "1 tablespoon honey",
        "2 tablespoons distilled white vinegar"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place the miso paste, water, vegetable oil, onion, honey, and white vinegar into a blender. Blend until smooth. Transfer the dressing to an airtight container and refrigerate until ready to use."
        }
      ],
