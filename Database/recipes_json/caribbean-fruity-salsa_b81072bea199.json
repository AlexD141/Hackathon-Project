      "name": "Caribbean Fruity Salsa",
      "ingredients_raw": [
        "1 cup diced fresh mango",
        "0.5 cup diced fresh pineapple",
        "0.5 cup diced papaya",
        "0.5 medium red onion, finely diced",
        "1 fresh jalapeno pepper, seeded and minced",
        "3 tablespoons lime juice",
        "1 tablespoon olive oil",
        "1 teaspoon salt, or to taste",
        "1 tablespoon chopped fresh mint"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Toss mango, pineapple, papaya, red onion, and jalapeño together in a large bowl until well combined; stir in lime juice and olive oil. Season with salt; stir to combine. Sprinkle with mint before serving."
        }
      ],
