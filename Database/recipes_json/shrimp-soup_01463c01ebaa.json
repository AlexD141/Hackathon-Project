  "recipes": [
    {
      "name": "Shrimp Soup",
      "ingredients_raw": [
        "2 (14.5 ounce) cans chicken broth",
        "2 (14.5 ounce) cans beef broth",
        "2 (10.5 ounce) cans shrimp consomme",
        "2.5 cups frozen shrimp, thawed",
        "1 teaspoon fresh dill weed",
        "salt and pepper to taste",
        "2 tablespoons sliced green onions"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a large saucepan over medium heat, combine chicken broth, beef broth and shrimp consomme. Bring to a simmer, then strain."
        },
        {
          "id": 2,
          "text": "Return broth to pot and add shrimp and dill. Heat through and adjust seasonings. Garnish with chopped green onion."
        }
      ],
