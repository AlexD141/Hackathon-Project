      "name": "Energetic Strawberry Smoothie",
      "ingredients_raw": [
        "2 cups frozen strawberries",
        "1 (8.3 ounce) can citrus flavored energy drink (e.g. Red Bull™)"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine strawberries and energy drink in a blender; blend until smooth and creamy, about 1 minute. Add some water if too thick and blending is difficult. Divide between 2 glasses."
        }
      ],
