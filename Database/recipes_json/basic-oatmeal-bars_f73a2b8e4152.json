  "recipes": [
    {
      "name": "Basic Oatmeal Bars",
      "ingredients_raw": [
        "1.5 cups quick cooking oats",
        "2 cups basic cookie mix",
        "1 egg",
        "0.75 cup butter",
        "0.25 cup cold water",
        "1 teaspoon vanilla extract",
        "0.5 teaspoon almond extract"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (180 degrees C)."
        },
        {
          "id": 2,
          "text": "Stir oats into Basic Cookie Mix. Lightly beat egg and add to mixture. Melt butter or margarine over low heat and stir in. Add cold water, vanilla and almond extract. Mix well."
        },
        {
          "id": 3,
          "text": "Spoon into a greased 13 x 9 inch pan. Bake for about 30 to 35 minutes until top is golden. Cool and cut into bars."
        }
      ],
