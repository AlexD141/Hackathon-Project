  "recipes": [
    {
      "name": "Corned Beef and Swiss Dip",
      "ingredients_raw": [
        "1 tablespoon vegetable oil",
        "0.75 medium onion, chopped",
        "2 (8 ounce) packages cream cheese, softened",
        "1 (8 ounce) carton sour cream",
        "3 (2.5 ounce) packages deli-sliced corned beef (such as Buddig ®), diced",
        "1.5 cups mayonnaise",
        "1 cup shredded Swiss cheese",
        "1 teaspoon garlic powder",
        "1 (1 pound) loaf unsliced Italian bread"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Heat oil in a skillet over medium heat. Cook and stir onion in the hot skillet until tender, 5 to 7 minutes."
        },
        {
          "id": 3,
          "text": "Transfer onion to a large mixing bowl. Add cream cheese, sour cream, and corned beef, then add mayonnaise, Swiss cheese, and garlic powder; mix until thoroughly combined."
        },
        {
          "id": 4,
          "text": "Cut off top of bread loaf. Create a bread bowl by tearing bread into chunks from the center of the loaf, leaving 1/2 inch bread on all sides. Reserve bread chunks for dipping if desired."
        },
        {
          "id": 5,
          "text": "Spoon corned beef mixture into bread bowl. Wrap bread bowl tightly with aluminum foil and place onto a baking sheet."
        },
        {
          "id": 6,
          "text": "Bake in the preheated oven until the dip is fully cooked and bubbling, 1 to 1 ½ hours."
        }
      ],
