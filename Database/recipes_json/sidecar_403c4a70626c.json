  "recipes": [
    {
      "name": "Sidecar",
      "ingredients_raw": [
        "ice cubes",
        "0.5 fluid ounce freshly squeezed lemon juice",
        "0.5 fluid ounce Cointreau or triple sec",
        "1 fluid ounce brandy",
        "1 lemon wedge"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Fill a cocktail shaker 3/4 full with ice cubes. Pour in lemon juice, Cointreau, and brandy."
        },
        {
          "id": 2,
          "text": "Cover and shake vigorously for about 30 seconds until the outside of the shaker becomes cold and frosty."
        },
        {
          "id": 3,
          "text": "Strain into a martini glass, garnish with a wedge of lemon, and serve."
        }
      ],
