  "recipes": [
    {
      "name": "Taffy Apple Salad IV",
      "ingredients_raw": [
        "1 (15 ounce) can crushed pineapple, drained",
        "4 cups miniature marshmallows",
        "0.5 cup white sugar",
        "1 tablespoon all-purpose flour",
        "1 egg, beaten",
        "1.5 tablespoons white wine vinegar",
        "3 cups diced apple without peel",
        "1 cup chopped Spanish peanuts",
        "1 (8 ounce) container frozen whipped topping, thawed"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Mix together the pineapple and marshmallows; set aside."
        },
        {
          "id": 2,
          "text": "In a saucepan, combine the reserved pineapple syrup, sugar, flour, egg and vinegar. Mix together well and cook over medium heat until slightly thickened. Set aside to cool."
        },
        {
          "id": 3,
          "text": "Add the whipped topping, pineapple mixture, apples and 3/4 cup peanuts. Mix together well and refrigerate until chilled. Sprinkle top with extra 1/4 cup peanuts."
        }
      ],
