  "recipes": [
    {
      "name": "Pancakes I",
      "ingredients_raw": [
        "1 cup all-purpose flour",
        "1 tablespoon white sugar",
        "1 teaspoon baking powder",
        "0.5 teaspoon baking soda",
        "0.25 teaspoon salt",
        "1 cup milk",
        "1 egg",
        "2 tablespoons vegetable oil"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat a lightly oiled griddle over medium-high heat."
        },
        {
          "id": 2,
          "text": "Combine flour, sugar, baking powder, baking soda and salt. Make a well in the center. In a separate bowl, beat together egg, milk and oil. Pour milk mixture into flour mixture. Beat until smooth."
        },
        {
          "id": 3,
          "text": "Pour or scoop the batter onto the hot griddle, using approximately 1/4 cup for each pancake. Brown on both sides and serve hot."
        }
      ],
