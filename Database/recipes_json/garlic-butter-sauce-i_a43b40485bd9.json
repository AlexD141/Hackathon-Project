  "recipes": [
    {
      "name": "Garlic Butter Sauce",
      "ingredients_raw": [
        "0.33333334326744 cup butter",
        "1 clove garlic, crushed",
        "2 teaspoons dried oregano",
        "0.25 tablespoon dried basil"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Melt butter in a small saucepan."
        },
        {
          "id": 3,
          "text": "Add garlic; sauté in hot butter until fragrant."
        },
        {
          "id": 4,
          "text": "Add oregano and basil; stir until heated through."
        },
        {
          "id": 5,
          "text": "Serve warm."
        }
      ],
