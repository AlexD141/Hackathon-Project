  "recipes": [
    {
      "name": "Rhubarb-Infused &#39;Barbtini",
      "ingredients_raw": [
        "2 cups water",
        "1 cup white sugar",
        "2 cups thinly sliced rhubarb",
        "1 cup crushed ice",
        "1.5 fluid ounces good-quality vodka",
        "0.5 fluid ounce triple sec liqueur"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place sugar and water in a saucepan; bring to a boil over high heat, stirring occasionally. Reduce the heat to medium; stir rhubarb into syrup. Simmer until rhubarb is softened and stringy, 5 to 7 minutes. Press rhubarb with a spoon to extract juice while straining syrup through cheesecloth or a strainer into a glass jar or bottle; discard solids. Cool; refrigerate syrup until needed."
        },
        {
          "id": 2,
          "text": "Fill a cocktail shaker with ice; add vodka, 2 tablespoons rhubarb syrup, and triple sec. Cover and shake until the outside of the shaker has frosted. Strain into a martini glass."
        }
      ],
