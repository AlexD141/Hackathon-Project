  "recipes": [
    {
      "name": "Cream Cheese Pickles",
      "ingredients_raw": [
        "8 kosher dill pickles, patted dry",
        "2 (8 ounce) packages cream cheese, softened",
        "2.5 ounces thin-sliced beef luncheon meat"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Spread or pat cream cheese onto each slice of meat."
        },
        {
          "id": 3,
          "text": "Wrap 2 sheets of meat around each pickle."
        },
        {
          "id": 4,
          "text": "Refrigerate pickles overnight, and slice before serving."
        }
      ],
