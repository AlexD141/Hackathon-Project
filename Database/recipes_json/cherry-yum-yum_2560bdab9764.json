  "recipes": [
    {
      "name": "Cherry Yum Yum",
      "ingredients_raw": [
        "1.5 cups all-purpose flour",
        "0.75 cup butter",
        "0.75 cup chopped pecans",
        "2 tablespoons white sugar",
        "1 (1.3 ounce) envelope whipped topping mix",
        "2 cups confectioners' sugar",
        "1 (8 ounce) package cream cheese",
        "1 (21 ounce) can cherry pie filling"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Combine flour, butter, pecans, and white sugar in a medium bowl; mix well, then press mixture into the bottom of a 9x13-inch baking dish. Bake in the preheated oven for 20 minutes. Allow crust to cool completely before preceding."
        },
        {
          "id": 3,
          "text": "Prepare whipped topping according to the package directions. Set aside."
        },
        {
          "id": 4,
          "text": "Blend confectioners’ sugar and cream cheese together in a large bowl until well mixed. Fold in whipped topping until incorporated."
        },
        {
          "id": 5,
          "text": "Spread over the top of cooled crust, then cover with cherry pie filling. Refrigerate for at least a few hours before serving."
        }
      ],
