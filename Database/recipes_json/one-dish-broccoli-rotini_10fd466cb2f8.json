  "recipes": [
    {
      "name": "One Dish Broccoli Rotini",
      "ingredients_raw": [
        "16 ounces fresh broccoli, chopped",
        "1 (16 ounce) package rotini pasta",
        "2 cloves garlic, minced",
        "0.5 cup olive oil",
        "0.5 cup grated Parmesan cheese",
        "salt to taste",
        "ground black pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a large pot, cook broccoli in boiling water until tender. Drain broccoli, but reserve cooking water."
        },
        {
          "id": 2,
          "text": "Reusing broccoli cooking water, cook rotini pasta until al dente. Drain and remove pasta."
        },
        {
          "id": 3,
          "text": "In a large pot, saute the garlic in the olive oil. Add the cooked pasta, broccoli, grated Parmesan cheese and toss together. If desired, add salt and pepper to taste."
        }
      ],
