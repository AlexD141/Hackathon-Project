  "recipes": [
    {
      "name": "Fruit and Yogurt Smoothie",
      "ingredients_raw": [
        "1 cup strawberries",
        "1 banana",
        "0.5 cup yogurt",
        "0.25 cup pineapple juice",
        "1.5 teaspoons white sugar",
        "1 teaspoon orange juice",
        "1 teaspoon milk"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Combine strawberries, banana, yogurt, pineapple juice, sugar, orange juice, and milk in a blender."
        },
        {
          "id": 3,
          "text": "Blend until smooth."
        }
      ],
