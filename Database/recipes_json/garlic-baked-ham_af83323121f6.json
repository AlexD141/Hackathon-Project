  "recipes": [
    {
      "name": "Garlic Baked Ham",
      "ingredients_raw": [
        "1 (8 pound) ham",
        "20 cloves garlic, peeled",
        "10 whole cloves",
        "1 (6 ounce) can pineapple juice",
        "2 tablespoons brown sugar",
        "2 teaspoons dry mustard powder",
        "0.5 teaspoon ground ginger"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 325 degrees F (165 degrees C)."
        },
        {
          "id": 2,
          "text": "Pat ham dry with paper towels; place cut-side down in a shallow roasting pan."
        },
        {
          "id": 3,
          "text": "Use the tip of a sharp knife to cut 20 small slits all over ham; insert 1 garlic clove into each slit. Press whole spice cloves into ham. Cover with aluminum foil."
        },
        {
          "id": 4,
          "text": "Bake in the preheated oven for 1 hour and 20 minutes."
        },
        {
          "id": 5,
          "text": "Meanwhile, combine pineapple juice, brown sugar, dry mustard, and ginger in a bowl. Remove foil from ham; pour pineapple juice glaze over ham."
        },
        {
          "id": 6,
          "text": "Continue baking, uncovered, basting every 15 minutes, until glaze thickens and an instant-read thermometer inserted into the center of ham reads 140 degrees F (60 degrees C), about 45 minutes more. Let rest for 5 to 10 minutes; remove garlic and whole cloves before slicing."
        }
      ],
