{
  "source_url": "https://www.allrecipes.com/recipe/146076/low-fat-chocolate-sicilian-gelato/",
  "extracted_at": "2026-10-18T02:00:57.878718+00:00",
  "recipes": [
    {
      "name": "Low-Fat Chocolate Sicilian Gelato",
      "ingredients_raw": [
        "1.75 cups skim milk, divided",
        "2 tablespoons cornstarch",
        "0.33333334326744 cup white sugar",
        "0.33333334326744 cup high-quality unsweetened cocoa powder",
        "2 teaspoons instant espresso powder",
        "1 teaspoon vanilla extract",
        "1 pinch salt"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Whisk 1/4 cup milk and cornstarch together in a small bowl until smooth to make a slurry."
        },
        {
          "id": 2,
          "text": "Combine the remaining milk, sugar, and cocoa powder in a small saucepan over medium heat. Bring to a boil while stirring constantly. Add espresso powder and the cornstarch slurry. Bring back to a boil; stir gelato mixture until thickened like pudding, about 2 minutes. Remove from heat; transfer to a metal bowl. Stir in vanilla extract and salt."
        },
        {
          "id": 3,
          "text": "Fill a large bowl with ice water; set the bowl of gelato mixture inside. Stir frequently until cooled, about 7 minutes. Remove metal bowl from ice bath; cover with plastic wrap. Refrigerate until completely chilled, about 20 minutes."
        },
        {
          "id": 4,
          "text": "Transfer gelato mixture into an ice cream maker; freeze according to manufacturer&#39;s instructions, about 20 minutes. Pour gelato into a freezer-safe container; cover and freeze until solid, about 10 minutes."
        }
      ],
