      "name": "Holiday Manhattan",
      "ingredients_raw": [
        "0.75 cup white sugar",
        "0.25 cup hot water",
        "1 (750 milliliter) bottle bourbon whiskey",
        "1.25 cups sweet vermouth",
        "0.25 cup cherry juice",
        "2 teaspoons aromatic bitters",
        "12 maraschino cherries"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Dissolve the sugar in hot water in a large pitcher. Stir in the whiskey, vermouth, cherry juice and bitters. Serve in glasses over ice and garnish with a maraschino cherry."
        }
      ],
