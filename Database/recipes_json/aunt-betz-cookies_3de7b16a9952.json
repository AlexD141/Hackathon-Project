  "recipes": [
    {
      "name": "Aunt Betz Cookies",
      "ingredients_raw": [
        "2 eggs",
        "1 cup white sugar",
        "0.75 cup butter",
        "2.5 cups graham cracker crumbs",
        "2 cups miniature marshmallows",
        "12 ounces semisweet chocolate chips",
        "3 tablespoons peanut butter",
        "0.5 cup chopped walnuts",
        "0.5 cup shredded coconut"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Beat eggs. Combine eggs, sugar, and butter or margarine in a large saucepan. Bring to a boil and let cook on low for 2 minutes, stirring constantly. Turn off heat. Add the crumbs, marshmallows and coconut."
        },
        {
          "id": 2,
          "text": "Spread mixture into a lightly buttered 9x13 inch dish."
        },
        {
          "id": 3,
          "text": "Melt the chocolate chips and peanut butter together and spread over the top of the bars. Refrigerate overnight. Cut into small squares to serve."
        }
      ],
