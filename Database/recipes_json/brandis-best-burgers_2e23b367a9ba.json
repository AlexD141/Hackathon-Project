            "author": {
              "@type": "Person",
              "name": "KRANEY"
            },
            "reviewBody": "I made these in the oven (450 for 20-25 minutes, turning halfway through). Turned out great! Served on onion rolls. Mmmm. Thanks for the recipe!",
            "datePublished": "2002-10-13T08:07:44.467Z"
          },
