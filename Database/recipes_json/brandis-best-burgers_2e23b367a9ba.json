  "recipes": [
    {
      "name": "Brandi&#39;s Best Burgers",
      "ingredients_raw": [
        "2 pounds lean ground beef",
        "1 packet dry onion soup mix",
        "0.5 cup water",
        "1 teaspoon hot pepper sauce",
        "0.75 cup dried bread crumbs"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat an outdoor grill for medium high heat and lightly oil grate."
        },
        {
          "id": 2,
          "text": "In a large bowl, combine the beef, onion soup mix, water, hot sauce and bread crumbs. Mix together well and form into patties."
        },
        {
          "id": 3,
          "text": "Grill patties over medium high heat for 10 to 20 minutes, or to desired doneness."
        }
      ],
