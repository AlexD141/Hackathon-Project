  "recipes": [
    {
      "name": "Pumpkin Raisin Cookies",
      "ingredients_raw": [
        "2 cups all-purpose flour",
        "2.5 teaspoons pumpkin pie spice",
        "1 teaspoon ground cinnamon",
        "1 teaspoon baking soda",
        "0.25 teaspoon salt",
        "1 cup packed brown sugar",
        "0.5 cup shortening",
        "1 egg",
        "1 teaspoon vanilla extract",
        "1 cup solid pack pumpkin puree",
        "1 cup raisins",
        "0.5 cup chopped walnuts",
        "1 cup confectioners' sugar",
        "2 tablespoons warm water"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease baking sheets."
        },
        {
          "id": 2,
          "text": "Combine flour, pumpkin pie spice, 1 teaspoon cinnamon, baking soda, and salt in a bowl. Set aside."
        },
        {
          "id": 3,
          "text": "Beat brown sugar and shortening together in a separate bowl with an electric mixer until smooth; beat in eggs and vanilla extract until fluffy. Stir in pumpkin purée; stir in flour mixture. Fold in raisins and walnuts."
        },
        {
          "id": 4,
          "text": "Drop spoonfuls of dough 2 inches apart onto the prepared baking sheets."
        },
        {
          "id": 5,
          "text": "Bake in the preheated oven until edges are golden, 10 to 12 minutes"
        },
        {
          "id": 6,
          "text": "Meanwhile, combine confectioners’ sugar and warm water until smooth; stir in remaining ½ teaspoon cinnamon."
        },
        {
          "id": 7,
          "text": "Brush cookies with cinnamon glaze. Cool on wire racks."
        }
      ],
