  "recipes": [
    {
      "name": "Grandma Augusta&#39;s Spaghetti Sauce",
      "ingredients_raw": [
        "3 slices bacon, diced",
        "2 pounds lean ground beef",
        "2.3333332538605 cups chopped onion",
        "0.5 cup red wine",
        "1 teaspoon salt",
        "1 teaspoon dried basil",
        "1 teaspoon dried oregano",
        "1 teaspoon minced garlic",
        "0.5 teaspoon ground black pepper",
        "1 (12 ounce) can tomato paste",
        "1 (28 ounce) can diced tomatoes",
        "2 (16 ounce) cans tomato sauce",
        "0.25 teaspoon hot pepper sauce (e.g. Tabasco™), or to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Cook the bacon in a heavy, 5 quart pot over medium-high heat until the grease begins to render out, about 3 minutes. Stir in the ground beef and onions. Cook and stir until the beef is crumbly, and beginning to brown, about 10 minutes. Pour in the wine, and season with salt, basil, oregano, garlic, and pepper. Simmer uncovered until most of the wine has evaporated, about 10 minutes."
        },
        {
          "id": 2,
          "text": "Stir in the tomato paste, diced tomatoes, tomato sauce, and hot pepper sauce. Bring to a simmer, then reduce heat to medium-low, cover, and simmer 20 minutes."
        }
      ],
