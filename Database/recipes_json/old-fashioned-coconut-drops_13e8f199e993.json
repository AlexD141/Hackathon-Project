  "recipes": [
    {
      "name": "Old Fashioned Coconut Drops",
      "ingredients_raw": [
        "1 cup sifted all-purpose flour",
        "4 tablespoons butter",
        "1 teaspoon baking powder",
        "2 teaspoons ground cinnamon",
        "0.5 cup white sugar",
        "2 teaspoons vanilla extract",
        "2 cups shredded coconut",
        "0.5 cup raisins",
        "1 egg, beaten"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 400 degrees F (200 degrees C). Grease cookie sheets."
        },
        {
          "id": 2,
          "text": "Combine flour and margarine in a medium size mixing bowl. Mix in sugar, cinnamon and baking powder. Stir the egg into the mixture. Once the egg is well incorporated stir in the coconut, raisins and vanilla. Drop the dough in rough heaps the size of an egg onto cookie sheets."
        },
        {
          "id": 3,
          "text": "Bake 8 minutes or until lightly browned."
        }
      ],
