  "recipes": [
    {
      "name": "Beef and Cheese Ball",
      "ingredients_raw": [
        "1 (8 ounce) package cream cheese, softened",
        "5 ounces dried beef",
        "1 small white onion, chopped",
        "1 small finely chopped green bell pepper",
        "1 tablespoon Worcestershire sauce",
        "1 teaspoon onion juice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a medium-sized mixing bowl, combine cream cheese, 2/3 of the beef, onion, green bell pepper, Worcestershire sauce, and onion juice. Mix well and shape mixture into a ball. Using the reserved beef, coat the rest of the ball with beef."
        }
      ],
