  "recipes": [
    {
      "name": "Really Simple Rice",
      "ingredients_raw": [
        "1 tablespoon olive oil",
        "1 cup long-grain white rice",
        "0.5 small onion, minced",
        "2 cups low-sodium chicken broth",
        "1 pinch garlic salt, or to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Heat oil in a nonstick saucepan over medium-high heat until almost smoking. Add rice; cook and stir quickly to toast, 2 to 3 minutes. Add onions and sauté for 1 minute."
        },
        {
          "id": 2,
          "text": "Stir in broth and garlic salt; bring to a boil. Reduce the heat to low, cover, and cook until liquid is absorbed and rice is tender, about 20 minutes. Remove from the heat and allow to rest for 5 minutes. Uncover and fluff with a fork."
        }
      ],
