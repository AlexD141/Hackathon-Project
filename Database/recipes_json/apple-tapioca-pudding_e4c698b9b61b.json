  "recipes": [
    {
      "name": "Apple Tapioca Pudding",
      "ingredients_raw": [
        "4 cups apples - peeled, cored and sliced",
        "0.5 cup brown sugar",
        "0.75 teaspoon ground cinnamon",
        "0.5 teaspoon salt",
        "2 tablespoons small pearl tapioca",
        "1 lemon, juiced",
        "1 cup boiling water",
        "0.5 cup raisins"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place the apples, brown sugar, cinnamon, salt, and tapioca into a bowl, and toss to coat apple slices."
        },
        {
          "id": 2,
          "text": "Place the apple mixture into a slow cooker. Pour lemon juice and boiling water over the apples."
        },
        {
          "id": 3,
          "text": "Set the cooker to High and cook until apples are tender and thickened, 3 to 4 hours."
        },
        {
          "id": 4,
          "text": "Mix in raisins if desired; serve warm."
        }
      ],
