  "recipes": [
    {
      "name": "Quick and Easy Root Beer",
      "ingredients_raw": [
        "3 cups white sugar, or to taste",
        "2 cups water",
        "2 tablespoons root beer extract",
        "2 liters carbonated water"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Mix sugar and water together in a saucepan. Bring to a boil, then reduce heat to a simmer and stir until sugar has dissolved."
        },
        {
          "id": 2,
          "text": "Remove from the heat, stir in root beer extract, and allow to cool for about 15 minutes."
        },
        {
          "id": 3,
          "text": "Pour root beer mixture into a 1-gallon pitcher or bottle, and slowly pour in carbonated water. Refrigerate until cold, at least 30 minutes."
        }
      ],
