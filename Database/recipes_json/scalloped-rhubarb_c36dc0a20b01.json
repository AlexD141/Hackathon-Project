  "recipes": [
    {
      "name": "Scalloped Rhubarb",
      "ingredients_raw": [
        "2 cups diced rhubarb",
        "1 cup white sugar",
        "1 tablespoon ground cinnamon",
        "6 plain rolls or buns",
        "0.5 cup butter, melted"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 2-quart casserole dish."
        },
        {
          "id": 2,
          "text": "Combine rhubarb, 1 cup sugar, and cinnamon in a large saucepan over medium-low heat; bring to a boil. Reduce heat to a simmer; cook, stirring frequently, until rhubarb breaks apart, about 10 minutes. Pour rhubarb mixture into the prepared dish."
        },
        {
          "id": 3,
          "text": "Cut rolls into cubes; spread over rhubarb. Sprinkle remaining ½ cup sugar over bread cubes; pour melted butter over sugar."
        },
        {
          "id": 4,
          "text": "Bake in the preheated oven until bread is lightly golden brown and rhubarb is bubbling, about 35 minutes."
        }
      ],
