  "recipes": [
    {
      "name": "Sautéed Fiddleheads",
      "ingredients_raw": [
        "3 cups fresh fiddlehead ferns, ends trimmed",
        "3 tablespoons unfiltered extra-virgin olive oil",
        "1 clove garlic, minced",
        "0.5 teaspoon sea salt",
        "0.5 teaspoon black pepper",
        "1 tablespoon fresh lemon juice"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Bring a large pot of salted water to a boil. Cook fiddlehead ferns in the boiling water until barely tender, 7 to 10 minutes. Drain."
        },
        {
          "id": 3,
          "text": "Heat olive oil in a large skillet over medium-high heat. Stir in prepared fiddlehead ferns, garlic, salt, and pepper. Cook and stir until ferns are lightly browned and tender, about 5 minutes. Remove from heat and sprinkle with lemon juice."
        }
      ],
