  "recipes": [
    {
      "name": "Sultana Cake",
      "ingredients_raw": [
        "2 cups sultana raisins",
        "water, or as needed",
        "10 tablespoons butter, diced",
        "2 cups white sugar",
        "3 eggs",
        "3 cups all-purpose flour",
        "1.5 teaspoons baking powder",
        "0.5 teaspoon vanilla extract"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat an oven to 325 degrees F (165 degrees C). Lightly grease a 9 inch round cake pan."
        },
        {
          "id": 2,
          "text": "Put the raisins in a saucepan with enough water to cover and bring to a boil; reduce heat to medium low and allow to simmer for 15 minutes. Drain the water from the raisins. Stir the butter into the raisins until it melts and coats the raisins."
        },
        {
          "id": 3,
          "text": "Beat the sugar into the eggs in a bowl. Sift the flour and baking powder together in a separate bowl. Stir the raisins and vanilla into the egg mixture; add the flour mixture and stir until just mixed. Pour the batter into the prepared cake pan."
        },
        {
          "id": 4,
          "text": "Bake in the preheated oven until a toothpick inserted into the center of the cake comes out clean, about 75 minutes. Cool in the pan for 10 minutes before removing to cool completely on a wire rack."
        }
      ],
