  "recipes": [
    {
      "name": "Pomacello Martini",
      "ingredients_raw": [
        "3 fluid ounces pomegranate juice",
        "1 fluid ounce limoncello liqueur",
        "1.5 fluid ounces vodka",
        "1 slice fresh lemon"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Pour the pomegranate juice, limoncello, and vodka into a cocktail shaker over ice. Cover and shake. Strain into a chilled martini glass, and garnish with a slice of lemon."
        }
      ],
