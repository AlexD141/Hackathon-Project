      "name": "Strawberry Salad",
      "ingredients_raw": [
        "1 head romaine lettuce, cut or torn into bite-size pieces",
        "1 (10 ounce) package shredded cabbage",
        "1.5 cups golden raisins",
        "1 pint strawberries, sliced",
        "1 cup red grapes, halved",
        "0.5 red onion, sliced",
        "1 (12 ounce) bottle creamy poppy seed salad dressing",
        "2 (2.45 ounce) packages sliced almonds",
        "2 (2.25 ounce) packages pine nuts"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Mix lettuce, cabbage, raisins, strawberries, grapes, and onion together in a large bowl; add dressing and toss to coat. Top with almonds and pine nuts."
        }
      ],
