  "recipes": [
    {
      "name": "Raisin Sour Cream Pie",
      "ingredients_raw": [
        "1 cup sour cream",
        "1 cup white sugar",
        "1 cup raisins",
        "2 eggs, beaten",
        "2 teaspoons distilled white vinegar",
        "0.5 teaspoon salt",
        "0.25 teaspoon ground cinnamon",
        "0.125 teaspoon ground cloves",
        "1 (9 inch) prepared graham cracker crust"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "In a large bowl, mix sour cream and sugar. Fold in raisins and beaten eggs. Stir in vinegar, salt, cinnamon and cloves. Pour mixture into pie crust."
        },
        {
          "id": 3,
          "text": "Bake pie for 40 minutes, or until knife inserted in center of pie comes out clean. Remove from oven and let cool slightly."
        }
      ],
