  "recipes": [
    {
      "name": "Blueberry Banana Pie",
      "ingredients_raw": [
        "1 (8 ounce) package cream cheese",
        "0.33300000429153 cup white sugar",
        "2 bananas, peeled and sliced",
        "1 cup blueberry pie filling",
        "1 cup heavy cream",
        "0.5 cup white sugar",
        "1 (9 inch) pie shell, baked"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a medium bowl, combine cream cheese and 1/3 cup sugar. Beat until fluffy. Spoon mixture into baked pie shell and spread evenly. Arrange banana slices on cream cheese layer. Spread pie filling on top of banana slices"
        },
        {
          "id": 2,
          "text": "In a medium bowl, combine 1 cup cream and 1/2 cup sugar. Beat until stiff. Spread whipped cream on top of pie. Chill in refrigerator until ready to serve."
        }
      ],
