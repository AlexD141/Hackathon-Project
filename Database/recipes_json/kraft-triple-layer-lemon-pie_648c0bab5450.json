  "recipes": [
    {
      "name": "Kraft® Triple-Layer Lemon Pie",
      "ingredients_raw": [
        "2 (3.4 ounce) packages JELL-O Lemon Flavor Instant Pudding",
        "2 cups cold milk",
        "1 tablespoon lemon juice",
        "1 (6 ounce) HONEY MAID Graham Pie Crust",
        "1 (8 ounce) tub COOL WHIP Whipped Topping, thawed, divided"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Beat pudding mixes, milk and juice with whisk 2 min. (Mixture will be thick.) Spread 1-1/2 cups onto bottom of crust."
        },
        {
          "id": 2,
          "text": "Whisk 1/2 the COOL WHIP into remaining pudding mixture; spread over pudding layer in crust. Top with remaining COOL WHIP."
        },
        {
          "id": 3,
          "text": "Refrigerate 3 hours or until set."
        }
      ],
