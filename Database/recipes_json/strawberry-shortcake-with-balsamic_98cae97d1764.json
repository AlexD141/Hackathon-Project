  "recipes": [
    {
      "name": "Strawberry Shortcake with Balsamic",
      "ingredients_raw": [
        "2 cups sliced strawberries",
        "0.25 cup balsamic vinegar",
        "1 tablespoon white sugar",
        "1 pinch ground black pepper",
        "4 slices angel food cake",
        "0.5 cup whipped cream"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat an outdoor grill for medium heat and lightly oil the grate."
        },
        {
          "id": 2,
          "text": "Combine strawberries, balsamic vinegar, sugar, and black pepper in a bowl; marinate for 10 to 15 minutes."
        },
        {
          "id": 3,
          "text": "Grill the slices of angel food cake on the preheated grill until toasted, 3 to 5 minutes on each side."
        },
        {
          "id": 4,
          "text": "Transfer the cake to 4 dessert plates and top with marinated strawberries and the liquid and a spoonful of whipped cream."
        }
      ],
