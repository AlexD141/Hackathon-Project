      "name": "Fresh Mango Salsa",
      "ingredients_raw": [
        "2 cups diced Roma tomatoes",
        "1.5 cups diced mango",
        "0.5 cup diced onion",
        "0.5 cup chopped fresh cilantro",
        "2 tablespoons fresh lime juice",
        "2 cloves garlic, minced",
        "1 tablespoon cider vinegar",
        "1 teaspoon white sugar",
        "0.5 teaspoon salt",
        "0.5 teaspoon black pepper"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Combine tomatoes, mango, onion, cilantro, lime juice, garlic, vinegar, sugar, salt, and black pepper in a bowl."
        }
      ],
