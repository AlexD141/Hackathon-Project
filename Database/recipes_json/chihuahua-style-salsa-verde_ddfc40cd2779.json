  "recipes": [
    {
      "name": "Chihuahua-Style Salsa Verde",
      "ingredients_raw": [
        "12 tomatillos, husked and chopped",
        "1 (7 ounce) can chopped jalapenos, drained",
        "0.5 head lettuce, chopped",
        "2 cloves garlic, chopped",
        "0.33333334326744 cup dried cilantro",
        "3 tablespoons ground cumin",
        "salt and pepper to taste",
        "2 tablespoons butter",
        "0.25 onion, chopped",
        "0.25 cup chicken broth"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine the tomatillos, jalapenos, lettuce, garlic, cilantro, cumin, salt, and pepper in a blender or food processor; process until chopped to desired consistency."
        },
        {
          "id": 2,
          "text": "Melt the butter in a saucepan over medium heat; cook the onions in the melted butter until clarified, about 5 minutes. Pour the tomatillo mixture and the chicken broth into the sauce pan; cook, stirring occasionally, until the salsa begins to thicken, about 20 minutes."
        }
      ],
