    {
      "name": "Arugula and Watermelon Salad",
      "ingredients_raw": [
        "2 (5 ounce) packages arugula",
        "0.5 large watermelon, seeded and cubed",
        "1 red onion, sliced",
        "1 cup crumbled feta cheese",
        "1.5 cups balsamic vinaigrette"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine arugula, watermelon, red onion, and feta cheese in a large bowl; drizzle with balsamic vinaigrette and toss until evenly coated. Serve cold."
        }
