  "recipes": [
    {
      "name": "Jeff Davis Pie II",
      "ingredients_raw": [
        "0.5 cup butter",
        "2 cups packed brown sugar",
        "4 egg yolks",
        "2 teaspoons all-purpose flour",
        "0.5 cup chopped pecans",
        "1 teaspoon ground nutmeg",
        "0.5 teaspoon ground allspice",
        "1 cup light cream",
        "0.5 cup dates, pitted and chopped",
        "0.5 cup raisins",
        "1 (9 inch) pie shell"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Cream butter or margarine, and add sugar; cream until light and fluffy. Mix in egg yolks. Combine flour and spices, and add to creamed mixture. Blend in cream. Stir in nuts, raisins, and dates. Pour filling into unbaked pie shell."
        },
        {
          "id": 2,
          "text": "Bake at 350 degrees F (175 degrees C) for 35 to 40 minutes, or until set. Cool."
        }
      ],
