      "name": "Brown Sugar and Honey Limeade",
      "ingredients_raw": [
        "1.75 cups freshly squeezed lime juice and pulp",
        "10 cups cool water",
        "0.5 cup honey, warmed",
        "0.5 cup brown sugar",
        "2 limes, sliced"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine the lime juice and water in a pitcher; mix in the warm honey. Stir the brown sugar into the mixture until dissolved completely. Pour over ice and top with a lime slice to serve."
        }
