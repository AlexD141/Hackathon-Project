  "recipes": [
    {
      "name": "Refrigerator Cookies II",
      "ingredients_raw": [
        "0.5 cup shortening",
        "1 cup packed brown sugar",
        "1 egg",
        "0.5 teaspoon vanilla extract",
        "1.75 cups all-purpose flour",
        "0.5 teaspoon baking soda",
        "0.25 teaspoon salt"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Mix shortening, sugar, egg and vanilla thoroughly. Blend flour, soda and salt; stir in."
        },
        {
          "id": 2,
          "text": "Form into roll 2 1/2&#34; across. Wrap in waxed paper. Chill until firm."
        },
        {
          "id": 3,
          "text": "Preheat oven to 400 degrees F (200 degrees C)."
        },
        {
          "id": 4,
          "text": "With a thin sharp knife, slice 1/8 inch thick. Place a little apart on ungreased baking sheet. Bake 8 to 10 minutes."
        }
      ],
