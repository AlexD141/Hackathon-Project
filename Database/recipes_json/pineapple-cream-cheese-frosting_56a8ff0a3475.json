  "recipes": [
    {
      "name": "Pineapple Cream Cheese Frosting",
      "ingredients_raw": [
        "0.5 cup butter, room temperature",
        "1 (8 ounce) package cream cheese, room temperature",
        "4 tablespoons pineapple juice",
        "4 cups sifted confectioners' sugar"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Beat butter and cream cheese in a large bowl with an electric mixer until light and fluffy. Beat in pineapple juice until fully absorbed. Gradually beat in confectioners&#39; sugar until fully incorporated."
        }
      ],
