  "recipes": [
    {
      "name": "Easy Pineapple Pie ",
      "ingredients_raw": [
        "1 (14 ounce) can sweetened condensed milk",
        "0.5 cup lemon juice",
        "1 (20 ounce) can crushed pineapple, drained",
        "1 (8 ounce) container frozen whipped topping, thawed",
        "1 (9 inch) prepared graham cracker crust"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Whisk sweetened condensed milk and lemon juice together in a large bowl until smooth and slightly thickened. Fold in crushed pineapple and whipped topping until evenly combined."
        },
        {
          "id": 2,
          "text": "Spoon filling into the prepared graham cracker crust; smooth the top. Refrigerate until set, at least 2 hours, before serving."
        }
      ],
