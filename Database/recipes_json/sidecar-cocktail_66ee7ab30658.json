  "recipes": [
    {
      "name": "Sidecar Cocktail",
      "ingredients_raw": [
        "1 teaspoon white sugar",
        "2 fluid ounces cognac",
        "1 fluid ounce orange-flavored liqueur (such as Cointreau®)",
        "0.5 fluid ounce lemon juice",
        "1 cup ice cubes"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather the ingredients."
        },
        {
          "id": 2,
          "text": "Sprinkle sugar onto a small plate. Lightly wet half the rim of a chilled martini glass with a damp paper towel. Dip the moistened rim in sugar to coat."
        },
        {
          "id": 3,
          "text": "Combine cognac, orange-flavored liqueur, and lemon juice in a cocktail shaker."
        },
        {
          "id": 4,
          "text": "Add ice, cover, and shake until chilled."
        },
        {
          "id": 5,
          "text": "Strain into the martini glass."
        }
      ],
