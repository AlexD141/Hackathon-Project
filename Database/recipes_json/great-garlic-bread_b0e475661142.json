  "recipes": [
    {
      "name": "Great Garlic Bread",
      "ingredients_raw": [
        "0.5 cup butter",
        "1.5 tablespoons garlic powder",
        "1 tablespoon dried parsley",
        "1 (1 pound) loaf Italian bread, cut into 1/2 inch slices",
        "1 (8 ounce) package shredded mozzarella cheese"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Preheat the oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 3,
          "text": "Melt butter in a small saucepan over medium heat; stir in garlic powder and dried parsley."
        },
        {
          "id": 4,
          "text": "Place bread slices on a medium baking sheet. Using a basting brush, brush bread generously with melted butter mixture."
        },
        {
          "id": 5,
          "text": "Bake in the preheated oven until lightly toasted, about 10 minutes."
        },
        {
          "id": 6,
          "text": "Sprinkle bread with mozzarella cheese and any remaining butter mixture. Continue baking until cheese is melted and bread is lightly browned, about 5 minutes."
        }
      ],
