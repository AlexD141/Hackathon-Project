  "recipes": [
    {
      "name": "Creamy Green Bean Soup",
      "ingredients_raw": [
        "8 cups water",
        "2 pounds chopped fully-cooked ham",
        "4 cups fresh green beans, trimmed and cut into 3/4-inch pieces",
        "3 cups cubed potatoes",
        "2 onions, sliced",
        "1 cup cream",
        "1 teaspoon salt, or to taste",
        "0.25 teaspoon ground black pepper, or to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place the water, ham, green beans, potatoes, and onions into a large saucepan or soup pot, bring to a boil, and reduce heat to medium-low. Simmer until the ham and vegetables are very tender, about 45 minutes. Skim off any excess fat. Pour in the cream, season to taste with salt and pepper, and serve."
        }
      ],
