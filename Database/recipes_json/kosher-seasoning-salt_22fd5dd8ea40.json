  "recipes": [
    {
      "name": "Kosher Seasoning Salt",
      "ingredients_raw": [
        "7 tablespoons kosher salt",
        "2 teaspoons paprika",
        "1 teaspoon dried thyme leaves",
        "1 teaspoon dried parsley",
        "1 teaspoon dry mustard powder",
        "1 teaspoon garlic powder",
        "0.5 teaspoon chili powder",
        "0.25 teaspoon curry powder",
        "0.25 teaspoon ground cumin",
        "0.25 teaspoon dried dill weed"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Pour the salt into a small mixing bowl. Whisk in the paprika, thyme, parsley, mustard powder, garlic powder, chili powder, curry powder, cumin, and dill until evenly blended. Store in a tightly sealed shaker jar."
        }
      ],
