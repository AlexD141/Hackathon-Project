  "recipes": [
    {
      "name": "Frosted Oatmeal Bars",
      "ingredients_raw": [
        "2 cups rolled oats",
        "0.5 cup packed brown sugar",
        "0.5 cup butter",
        "0.5 cup honey",
        "0.5 cup semisweet chocolate chips",
        "0.25 cup peanut butter"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In medium bowl, combine oats, sugar, butter, and honey. Microwave on high for 4 1/2 - 5 1/2 minutes or until bubbly, stirring twice."
        },
        {
          "id": 2,
          "text": "Spread honey mixture in an 8 x 8 inch pan. Cool in refrigerator."
        },
        {
          "id": 3,
          "text": "In small bowl, combine chocolate chips and peanut butter. Microwave on high for 1 - 1 1/2 minutes or until chips are soft, stirring once. Spread over cookie mixture. Refrigerate until chocolate is firm. Cut into squares."
        }
      ],
