      "name": "Creamy Sandwich Spread",
      "ingredients_raw": [
        "1 (8 ounce) jar sweet pickle relish",
        "1 (16 ounce) jar creamy salad dressing (such as Miracle Whip®)",
        "0.25 cup thousand island salad dressing (such as Kraft®)"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place the pickle relish into a colander set in the sink, and allow it to drain for about 30 minutes. Mix the drained relish, creamy salad dressing, and thousand island dressing in a large bowl until thoroughly combined. Place into a 1-quart jar, and refrigerate overnight to blend flavors."
        }
