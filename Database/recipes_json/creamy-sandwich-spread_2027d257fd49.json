            },
            "author": {
              "@type": "Person",
              "name": "DaringDish1885"
            },
            "reviewBody": "I substituted half of the sweet relish with sweet jalapeño relish. AMAZING!!",
            "datePublished": "2024-01-27T22:04:37.210Z"
          },
          {
            "@type": "Review",
