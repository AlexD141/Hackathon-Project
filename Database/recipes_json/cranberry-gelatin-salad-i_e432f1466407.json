  "recipes": [
    {
      "name": "Cranberry Jell-O Salad",
      "ingredients_raw": [
        "2 cups boiling water",
        "2 (0.3 ounce) packages sugar-free cherry-flavored gelatin mix (such as Jell-O®)",
        "1 (16 ounce) can jellied cranberry sauce",
        "1 (20 ounce) can crushed pineapple, drained",
        "0.5 cup chopped pecans"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Combine boiling water and gelatin mix in a bowl; stir until gelatin is dissolved."
        },
        {
          "id": 3,
          "text": "Stir in cranberry sauce and crushed pineapple."
        },
        {
          "id": 4,
          "text": "Transfer to a large glass serving dish or 12 individual dishes. Sprinkle pecans on top."
        },
        {
          "id": 5,
          "text": "Chill until set, 3 to 4 hours for individual dishes, or 4 hours to overnight for one large serving dish."
        }
      ],
      "warnings": [],
