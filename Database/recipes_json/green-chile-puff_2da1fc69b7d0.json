  "recipes": [
    {
      "name": "Green Chile Puff",
      "ingredients_raw": [
        "0.5 cup all-purpose flour",
        "1 teaspoon baking powder",
        "2 teaspoons garlic powder",
        "8 eggs",
        "2 cups small curd cottage cheese",
        "0.25 cup shredded Monterey Jack cheese",
        "0.25 cup shredded Cheddar cheese",
        "2 green onions, chopped",
        "1 (7 ounce) can diced green chilies, drained",
        "0.25 cup butter"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 7x11 inch casserole dish."
        },
        {
          "id": 2,
          "text": "Sift together flour, baking powder and garlic powder. In a separate bowl, beat eggs well. Gradually stir in flour mixture. Blend in cheeses, green onions, chilies and butter. Pour batter into prepared casserole dish."
        },
        {
          "id": 3,
          "text": "Bake in preheated oven until firm and a toothpick inserted into center of the loaf comes out clean, about 35 to 45 minutes."
        }
      ],
