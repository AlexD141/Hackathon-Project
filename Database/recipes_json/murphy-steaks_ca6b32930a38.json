  "recipes": [
    {
      "name": "Murphy Steaks",
      "ingredients_raw": [
        "2 pounds beef tenderloin steaks",
        "1 bulb garlic, cloves separated and peeled",
        "salt to taste",
        "ground black pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Separate garlic bulb into cloves, and peel. Cut into lengthwise strips."
        },
        {
          "id": 2,
          "text": "Using a sharp knife, punch holes into steak. Stuff holes with garlic strips. Cover, and refrigerate for at least 4 hours."
        },
        {
          "id": 3,
          "text": "Preheat grill for hot heat."
        },
        {
          "id": 4,
          "text": "Lightly oil grate. Place stuffed steaks on hot grill, garlic side up. Cook for 4 to 5 minutes, turn, and season with salt and pepper. Continue cooking until done, another 4 to 5 minutes."
        }
      ],
