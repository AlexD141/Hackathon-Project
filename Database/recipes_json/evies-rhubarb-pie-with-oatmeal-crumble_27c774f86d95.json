  "recipes": [
    {
      "name": "Evie&#39;s Rhubarb Pie with Oatmeal Crumble",
      "ingredients_raw": [
        "1 (9 inch) refrigerated pie crust",
        "4 cups sliced fresh rhubarb (about 1/2 inch thick)",
        "1.5 cups white sugar",
        "2 tablespoons quick-cooking tapioca",
        "1.5 tablespoons butter, melted",
        "0.5 cup regular rolled oats",
        "2 tablespoons all-purpose flour",
        "1 pinch ground cinnamon"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 400 degrees F (200 degrees C). Place crust in a 9-inch pie plate; set aside."
        },
        {
          "id": 2,
          "text": "Toss rhubarb, 1 ½ cups sugar, and tapioca together in a large bowl until evenly combined; drizzle with 1 ½ tablespoons melted butter and toss again to coat. Pour rhubarb mixture into pie crust; set aside."
        },
        {
          "id": 3,
          "text": "Combine oats, remaining ¼ cup sugar, flour, remaining 1 tablespoon melted butter, and cinnamon in a small bowl until evenly blended; sprinkle over rhubarb mixture."
        },
        {
          "id": 4,
          "text": "Bake in the preheated oven for 15 minutes. Reduce the oven temperature to 325 degrees F (165 degrees C). Continue baking until rhubarb is fork-tender, about 30 minutes more. Cool to room temperature before serving."
        }
      ],
