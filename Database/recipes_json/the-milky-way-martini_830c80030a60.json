  "recipes": [
    {
      "name": "The Milky Way Martini",
      "ingredients_raw": [
        "1.5 cups ice cubes",
        "0.25 cup cold water",
        "2 fluid ounces vanilla-flavored vodka",
        "2 fluid ounces white creme de cacao",
        "2 fluid ounces Irish cream liqueur",
        "1 tablespoon chocolate syrup"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Chill a martini glass by filling it with 1/2 cup of ice and cold water."
        },
        {
          "id": 2,
          "text": "Place 1 cup of ice cubes into a cocktail shaker. Pour vanilla-flavored vodka, white creme de cacao, and Irish cream liqueur over ice; cover and shake vigorously."
        },
        {
          "id": 3,
          "text": "Dump ice and water from the martini glass and drizzle the inside of the glass with chocolate syrup. Strain cocktail into the glass to serve."
        }
      ],
