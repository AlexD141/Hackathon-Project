  "recipes": [
    {
      "name": "Electric Lemonade",
      "ingredients_raw": [
        "ice cubes",
        "2 fluid ounces sour mix",
        "1 (1.5 fluid ounce) jigger citron vodka",
        "0.5 fluid ounce Blue Curacao",
        "1 (12 fluid ounce) can or bottle lemon-lime flavored carbonated beverage",
        "1 lemon - cut into wedges, for garnish"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Fill a Collins glass with ice. Pour sour mix, vodka, and blue curacao over ice."
        },
        {
          "id": 2,
          "text": "Fill to the top with lemon-lime soda. Garnish with lemon wedge; serve with a straw."
        }
      ],
