      "name": "The Best Cheeseball",
      "ingredients_raw": [
        "2 (8 ounce) packages cream cheese, softened",
        "0.75 cup shredded Cheddar cheese",
        "0.25 cup shredded pepperjack cheese",
        "0.5 green bell pepper, minced",
        "1 jalapeno peppers, seeded and minced",
        "1 teaspoon Worcestershire sauce",
        "0.5 teaspoon garlic salt"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a medium bowl combine the cream cheese, Cheddar cheese, Monterey Jack cheese, green bell pepper, jalapeno pepper, Worcestershire sauce and garlic salt. Mix together and form mixture into a ball. Roll ball in cilantro and serve with your favorite crackers."
        }
