      "name": "Creamy Pomegranate Ice Cream",
      "ingredients_raw": [
        "1 cup heavy cream",
        "1 cup white sugar",
        "1 cup pomegranate juice",
        "1 teaspoon vanilla extract",
        "1 pinch salt"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Stir together the heavy cream and sugar. Stir in the pomegranate juice, vanilla extract, and salt. Add the mixture to an ice cream maker and freeze according to the manufacturer&#39;s directions."
        }
