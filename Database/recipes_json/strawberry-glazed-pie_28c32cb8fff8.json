  "recipes": [
    {
      "name": "Strawberry Glazed Pie",
      "ingredients_raw": [
        "6 cups sliced fresh strawberries",
        "0.66666698455811 cup white sugar",
        "1 cup water",
        "4 tablespoons strawberry flavored Jell-O®",
        "4 tablespoons cornstarch",
        "1 (9 inch) prepared graham cracker crust"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Mix sugar, water, gelatin, and cornstarch together in a medium large saucepan. Boil for one minute, then remove from heat."
        },
        {
          "id": 3,
          "text": "Fold in sliced strawberries, toss until well coated."
        },
        {
          "id": 4,
          "text": "Pour into prepared graham cracker crust."
        },
        {
          "id": 5,
          "text": "Chill until well set, about 2 to 4 hours. Serve topped with whipped cream."
        }
      ],
