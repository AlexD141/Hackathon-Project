  "recipes": [
    {
      "name": "Simple Potato Salad",
      "ingredients_raw": [
        "3 red potatoes",
        "2 eggs",
        "1.5 cups creamy salad dressing"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather the ingredients."
        },
        {
          "id": 2,
          "text": "Bring a small pot of salted water to a boil. Add potatoes; cook until tender but still firm, about 15 minutes. Drain and cool."
        },
        {
          "id": 3,
          "text": "Place eggs in a saucepan, and cover completely with cold water. Bring water to a boil. Cover, remove from heat, and let eggs stand in hot water for 10 to 12 minutes. Remove from hot water, and cool."
        },
        {
          "id": 4,
          "text": "Peel the eggs and cut around the egg white; keep the yolk whole."
        },
        {
          "id": 5,
          "text": "Dice egg whites and potatoes. Combine in a mixing bowl and add salad dressing."
        },
        {
          "id": 6,
          "text": "Toss potatoes and egg; crumble egg yolk on top and serve chilled."
        }
      ],
