  "recipes": [
    {
      "name": "Party Pinwheels",
      "ingredients_raw": [
        "2 (8 ounce) packages cream cheese, softened",
        "2 green onions, minced",
        "1 (1 ounce) package ranch dressing mix",
        "4 (12 inch) flour tortillas",
        "0.5 cup shredded Cheddar cheese",
        "0.5 cup red bell pepper, diced",
        "0.5 cup diced celery",
        "1 (2 ounce) can sliced black olives"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Mix cream cheese, green onions, and ranch dressing mix together in a medium bowl until well combined."
        },
        {
          "id": 3,
          "text": "Spread onto each tortilla. Sprinkle evenly with cheese, red pepper, celery, and olives."
        },
        {
          "id": 4,
          "text": "Roll up tortillas, then wrap each one tightly in aluminum foil."
        },
        {
          "id": 5,
          "text": "Chill in the refrigerator, 2 hours to overnight."
        },
        {
          "id": 6,
          "text": "To serve, unwrap each rolled tortilla; trim ends and slice into 1-inch pieces."
        },
        {
          "id": 7,
          "text": "Enjoy!"
        }
      ],
