  "recipes": [
    {
      "name": "Semi-Indulgent Easy Brown Rice",
      "ingredients_raw": [
        "1 cup instant brown rice (such as Minute®)",
        "0.5 teaspoon dried parsley",
        "0.25 teaspoon ground black pepper",
        "1 tablespoon unsalted butter",
        "0.5 teaspoon lemon juice",
        "7 fluid ounces low-sodium chicken broth, or more if needed"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine instant brown rice, parsley, and black pepper in a microwave-safe dish."
        },
        {
          "id": 2,
          "text": "Place butter and lemon juice in a measuring cup."
        },
        {
          "id": 3,
          "text": "Pour chicken broth into measuring cup with butter and lemon juice to measure a total of 1 cup."
        },
        {
          "id": 4,
          "text": "Stir chicken broth mixture into rice mixture until all ingredients are moistened. Cover with microwave-safe lid."
        },
        {
          "id": 5,
          "text": "Heat in the microwave oven until rice is tender and has absorbed the liquid, about 7 minutes."
        },
        {
          "id": 6,
          "text": "Remove and let stand for 5 minutes. Fluff with fork before serving."
        }
      ],
