  "recipes": [
    {
      "name": "Honey Carrots With a Hint of Ginger",
      "ingredients_raw": [
        "1.25 cups butter",
        "0.75 cup honey",
        "1 teaspoon ground ginger",
        "0.33333334326744 cup lemon juice",
        "2 pounds baby carrots"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine the butter, honey, ginger and lemon juice in a large pot. Bring to a boil over medium-high heat. Add carrots and reduce heat to medium. Cover and simmer for about 10 minutes, or until carrots are tender. Simmer longer if you desire more tender carrots."
        }
      ],
