  "recipes": [
    {
      "name": "Cookies and Cream",
      "ingredients_raw": [
        "1 (3.9 ounce) package instant chocolate pudding mix",
        "1 (8 ounce) container frozen whipped topping, thawed",
        "1 cup crushed chocolate sandwich cookies",
        "1 (9 inch) prepared chocolate cookie crumb crust"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Prepare pudding as directed for pie filling; let set."
        },
        {
          "id": 2,
          "text": "When pudding is set, fold in whipped topping and crushed cookies. Pour pudding mixture into crust."
        },
        {
          "id": 3,
          "text": "Freeze overnight. Serve."
        }
      ],
