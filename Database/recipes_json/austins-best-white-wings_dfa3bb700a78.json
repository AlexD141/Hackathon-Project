  "recipes": [
    {
      "name": "Austin&#39;s Best White Wings",
      "ingredients_raw": [
        "4 fresh jalapeno peppers, quartered and seeded",
        "2 skinless, boneless chicken breast halves - pounded to about 3/4-inch thickness and cut into 8 strips each",
        "2 slices pepperjack cheese, each sliced into 8 strips",
        "8 slices bacon, cut in half",
        "toothpicks",
        "1 cup buffalo wing sauce",
        "1 cup blue cheese salad dressing"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven broiler."
        },
        {
          "id": 2,
          "text": "Place quartered jalapenos on a baking sheet, and broil just until they start to brown, about 5 minutes per side. Remove from heat, and allow to cool enough to handle. Leave the broiler on."
        },
        {
          "id": 3,
          "text": "Stuff each jalapeno quarter with a pepperjack cheese strip, and wrap with chicken and bacon strips, securing with toothpicks. Arrange on the baking sheet."
        },
        {
          "id": 4,
          "text": "Broil wrapped jalapenos until cheese is melted and bacon and chicken are cooked through, about 5 minutes on each side. Serve on a platter with buffalo wing sauce and bleu cheese dressing for dipping."
        }
      ],
