  "recipes": [
    {
      "name": "Caribbean Canadian Glazed Chicken",
      "ingredients_raw": [
        "0.5 cup ketchup",
        "4 tablespoons unsweetened pineapple juice",
        "4 tablespoons molasses",
        "2 tablespoons dark rum",
        "2 tablespoons prepared Dijon-style mustard",
        "2 cloves garlic, chopped",
        "salt and pepper to taste",
        "8 chicken thighs"
      ],
      "steps": [
        {
          "id": 1,
          "text": "To Make Glaze: In a medium bowl combine the ketchup, pineapple juice, molasses, rum, mustard and garlic. Season with salt and pepper to taste and mix well."
        },
        {
          "id": 2,
          "text": "Place chicken pieces in a lightly oiled 9x13 inch baking dish; brush both sides with prepared glaze, using about 1/2 of the glaze. Cover dish and refrigerate to marinate for at least 2 hours or overnight. Also, refrigerate remaining glaze."
        },
        {
          "id": 3,
          "text": "Preheat oven to 375 degrees F (190 degrees C)."
        },
        {
          "id": 4,
          "text": "Lightly brush chicken pieces on one side with some of the reserved glaze and bake uncovered in preheated oven for about 25 minutes. Turn pieces, brush with remaining glaze and bake for another 25 minutes or until chicken is tender."
        },
        {
          "id": 5,
          "text": "Preheat oven to broil."
        },
        {
          "id": 6,
          "text": "Put chicken under broiler and lightly brown on both sides, about 2 to 3 minutes each side. (Note: Watch chicken carefully, as this &#39;sugary&#39; glaze burns easily!)"
        }
      ],
