  "recipes": [
    {
      "name": "Honey Grilled Shrimp",
      "ingredients_raw": [
        "0.5 teaspoon garlic powder",
        "0.25 tablespoon ground black pepper",
        "0.33333334326744 cup Worcestershire sauce",
        "2 tablespoons dry white wine",
        "2 tablespoons Italian-style salad dressing",
        "1 pound large shrimp, peeled and deveined with tails attached",
        "0.25 cup honey",
        "0.25 cup butter, melted",
        "2 tablespoons Worcestershire sauce",
        "skewers"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a large bowl, mix together garlic powder, black pepper, 1/3 cup Worcestershire, wine, and dressing; add shrimp and toss to coat. Cover and marinate in the refrigerator for 1 hour."
        },
        {
          "id": 2,
          "text": "Preheat the grill to high heat. Thread shrimp onto skewers, piercing once near the tail and once near the head. Discard marinade."
        },
        {
          "id": 3,
          "text": "In a small bowl, stir together honey, melted butter, and remaining 2 tablespoons Worcestershire sauce. Set aside for basting."
        },
        {
          "id": 4,
          "text": "Lightly oil the grill grate. Grill shrimp for 2 to 3 minutes per side, or until opaque. Baste occasionally with the honey-butter sauce while grilling."
        }
      ],
