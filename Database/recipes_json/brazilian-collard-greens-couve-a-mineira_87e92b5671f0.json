  "recipes": [
    {
      "name": "Brazilian Collard Greens (Couve a Mineira)",
      "ingredients_raw": [
        "1 bunch collard greens, ribs removed",
        "2 tablespoons olive oil",
        "0.5 cup diced bacon",
        "0.5 onion, diced",
        "2 tablespoons sea salt",
        "3 cloves garlic, diced"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather collard leaves and roll into a log-shaped bundle; slice bundle crosswise into thin strips."
        },
        {
          "id": 2,
          "text": "Bring a large pot of salted water to a boil. Add collard greens; simmer until bright green, about 10 minutes. Drain."
        },
        {
          "id": 3,
          "text": "Heat olive oil in a large skillet over medium heat. Add bacon; cook and stir until browned, about 5 minutes. Stir in drained collard greens, onion, sea salt, and garlic; cook until flavors combine, about 10 minutes."
        }
      ],
