      "name": "Bahama Mama",
      "ingredients_raw": [
        "1 cup crushed ice",
        "1 fluid ounce orange juice",
        "1 fluid ounce pineapple juice",
        "0.5 fluid ounce rum",
        "0.5 fluid ounce coconut-flavored rum",
        "0.5 fluid ounce grenadine syrup"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Combine crushed ice, orange juice, pineapple juice, regular rum, coconut-flavored rum, and grenadine in a blender."
        },
        {
          "id": 3,
          "text": "Blend until the drink&#39;s consistency is slushy."
        },
        {
          "id": 4,
          "text": "Serve and enjoy."
        }
      ],
