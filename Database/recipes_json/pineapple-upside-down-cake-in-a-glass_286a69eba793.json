  "recipes": [
    {
      "name": "Pineapple Upside-Down Cake in a Glass",
      "ingredients_raw": [
        "ice",
        "1 splash grenadine syrup",
        "3 ounces pineapple juice",
        "1 (1.5 fluid ounce) jigger cake-flavored vodka",
        "1 maraschino cherry"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Fill a glass with ice. Splash grenadine over ice."
        },
        {
          "id": 3,
          "text": "Pour in pineapple juice and cake-flavored vodka; stir."
        },
        {
          "id": 4,
          "text": "Garnish with maraschino cherry to serve."
        }
      ],
