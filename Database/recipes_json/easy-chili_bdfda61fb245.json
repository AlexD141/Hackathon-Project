  "recipes": [
    {
      "name": "Granny&#39;s Easy Chili",
      "ingredients_raw": [
        "1 onion, chopped",
        "5 cloves crushed garlic",
        "1 stalk celery, chopped",
        "1 tablespoon olive oil",
        "8 ounces textured vegetable protein",
        "4 (16 ounce) cans chili beans",
        "1 (14.5 ounce) can stewed tomatoes",
        "4 cups water",
        "2 tablespoons brown sugar",
        "salt and pepper to taste",
        "2 teaspoons chili powder"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a large saucepan saute onion, garlic, celery and olive oil until onions are soft."
        },
        {
          "id": 2,
          "text": "Add to saucepan textured vegetable protein, chili beans, tomatoes, water, sugar, salt and pepper, and chili powder. Stir occasionally, let simmer for 30 minutes. The textured vegetable protein will expand when added to liquid."
        }
      ],
