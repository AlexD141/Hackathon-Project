  "recipes": [
    {
      "name": "Beefy Vegetable Soup",
      "ingredients_raw": [
        "12 cups diced peeled potatoes",
        "12 cups frozen sliced carrots",
        "12 cups frozen peas",
        "12 cups frozen lima beans",
        "9 cups frozen cut green beans",
        "9 cups diced celery",
        "1 (16 ounce) package small shell pasta",
        "water to cover",
        "4 quarts tomato sauce",
        "2 (32 ounce) cans chicken broth",
        "10 pounds ground beef",
        "4 cups diced onions",
        "3 tablespoons salt",
        "2 tablespoons dried basil",
        "1.5 teaspoons pepper"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In several large kettles, combine the first seven ingredients. Add water to cover. Add tomato sauce and broth."
        },
        {
          "id": 2,
          "text": "In other large skillet, cook ground beef and onions until meat is browned and crumbly, about 5 minutes. Drain. Add to vegetable mixture. Season with salt, basil and pepper; bring to a boil. Reduce heat; cover and simmer for 1-1/2 hours or until celery is tender."
        }
      ],
