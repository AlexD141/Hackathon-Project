  "recipes": [
    {
      "name": "Peanut Butter Banana Smoothie",
      "ingredients_raw": [
        "2 bananas, broken into chunks",
        "2 cups milk",
        "0.5 cup peanut butter",
        "2 tablespoons honey, or to taste",
        "2 cups ice cubes"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Place bananas, milk, peanut butter, honey, and ice cubes in a blender."
        },
        {
          "id": 3,
          "text": "Blend until smooth, about 30 seconds."
        },
        {
          "id": 4,
          "text": "Enjoy!"
        }
      ],
