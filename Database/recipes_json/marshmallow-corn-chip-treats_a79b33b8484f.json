  "recipes": [
    {
      "name": "Marshmallow Corn Chip Treats",
      "ingredients_raw": [
        "0.25 cup butter",
        "1 (7 ounce) jar marshmallow creme",
        "1 (14 ounce) bag corn chips such as Fritos®, coarsely crushed"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Butter a 9x13-inch pan. Melt butter in a saucepan over medium-low heat. Add the marshmallow creme and stir until melted. Stir in the corn chips, making sure they are well coated with the marshmallow mixture."
        },
        {
          "id": 2,
          "text": "Using buttered spatula or waxed paper, press mixture evenly and firmly into the prepared pan. Cut into squares when cool."
        }
      ],
