    {
      "name": "Gourmet Root Beer Float",
      "ingredients_raw": [
        "0.5 pint vanilla ice cream",
        "1 (12 fluid ounce) can or bottle root beer",
        "0.5 cup whipped cream",
        "4 maraschino cherries"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place 1 scoop of ice cream into each of two tall glasses. Pour root beer carefully over the ice cream. Add another scoop and repeat. If possible, repeat again. Top each with whipped cream and cherries."
        }
