      "name": "Frozen Fruit and Soda Cups",
      "ingredients_raw": [
        "2 cups cubed watermelon",
        "1 cup cubed cantaloupe",
        "1 cup sliced banana",
        "1 cup cubed fresh mango",
        "0.5 cup cubed honeydew",
        "0.5 cup diced apple",
        "3 cups lemon-lime flavored carbonated beverage, chilled"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Toss watermelon, cantaloupe, banana, mango, honeydew, and apple together in a large bowl; divide into 6 paper cups."
        },
        {
          "id": 2,
          "text": "Pour ½ cup lemon-lime soda into each cup. Place cups in the freezer before serving for 5 minutes."
        }
      ],
