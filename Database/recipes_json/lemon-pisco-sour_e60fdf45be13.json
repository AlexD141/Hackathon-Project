  "recipes": [
    {
      "name": "Lemon Pisco Sour",
      "ingredients_raw": [
        "1 tablespoon white sugar, or to taste",
        "1 fluid ounce fresh lemon juice",
        "2 fluid ounces Pisco",
        "ice cubes"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a small cup, dissolve the sugar in the lemon juice. Pour the lemon juice and sugar and Pisco into a cocktail shaker. Add ice, cover and shake until the outside is frosty, about 30 seconds. Strain into a cocktail glass and serve."
        }
      ],
