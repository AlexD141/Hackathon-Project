  "recipes": [
    {
      "name": "Baked Brie with Quebec Maple Syrup",
      "ingredients_raw": [
        "1 (14 ounce) round Brie cheese",
        "1 cup chopped walnuts",
        "2 cups real maple syrup (fine light grade)",
        "1 18-inch French baguette, cut into 3/4-inch slices"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 200 degrees F (95 degrees C)."
        },
        {
          "id": 2,
          "text": "Place the unwrapped Brie cheese in a baking dish, sprinkle with walnuts, and pour maple syrup over the walnuts and cheese."
        },
        {
          "id": 3,
          "text": "Bake in the preheated oven until the cheese warms and softens, about 10 minutes. Serve cheese with slices of baguette."
        }
      ],
