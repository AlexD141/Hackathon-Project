  "recipes": [
    {
      "name": "Summertime Baked Tomatoes",
      "ingredients_raw": [
        "3 tomatoes",
        "1 teaspoon salt, or as needed",
        "1 summer squash, finely diced",
        "0.5 cup dry herb stuffing mix",
        "0.25 cup shredded mozzarella cheese",
        "2 teaspoons dried basil",
        "0.25 teaspoon ground black pepper"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Halve tomatoes horizontally; sprinkle cut sides with salt. Place tomatoes on paper towels, cut-sides down, for about 5 minutes. Hollow out tomato halves, leaving sides ¼-inch thick; discard seeds and chop pulp."
        },
        {
          "id": 3,
          "text": "Place pulp, squash, herb stuffing, mozzarella, basil, and black pepper in a bowl; mix until well combined. Stuff mixture into tomato halves."
        },
        {
          "id": 4,
          "text": "Bake in the preheated oven until squash is tender and cheese melts, about 20 minutes."
        }
      ],
