  "recipes": [
    {
      "name": "Beatrice Savitz&#39;s Apricot Cookies",
      "ingredients_raw": [
        "8 ounces dried apricots",
        "0.5 cup white sugar",
        "2 tablespoons lemon juice",
        "water to cover",
        "1 cup all-purpose flour",
        "1 cup rolled oats",
        "1 cup packed brown sugar",
        "0.5 cup butter"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (180 degrees C)."
        },
        {
          "id": 2,
          "text": "Place apricots, lemon juice, white sugar in a small saucepan. Add enough water to just cover the apricots. Bring to a boil, and cook until fruit is soft. Chop coarsely."
        },
        {
          "id": 3,
          "text": "Sift flour, oatmeal and brown sugar together. Melt butter or margarine over low heat and stir into flour mixture. Put 2/3 of this mixture into 8 x 8 inch greased pan. Spread apricot mixture over crust. Sprinkle remaining oatmeal mixture over apricots."
        },
        {
          "id": 4,
          "text": "Bake for about 35 minutes."
        }
      ],
