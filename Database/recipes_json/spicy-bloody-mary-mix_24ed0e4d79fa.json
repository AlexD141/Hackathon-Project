      "name": "Spicy Bloody Mary Mix",
      "ingredients_raw": [
        "1 (46 fluid ounce) can tomato juice",
        "0.5 (10.5 ounce) can condensed beef consomme (such as Campbell's ®)",
        "3 tablespoons Worcestershire sauce",
        "1 tablespoon lemon juice",
        "1 tablespoon hot pepper sauce (such as Tabasco®)",
        "1 tablespoon celery salt",
        "1 tablespoon ground black pepper"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Mix the tomato juice, beef consomme, Worcestershire sauce, lemon juice, hot pepper sauce, celery salt, and black pepper together in a pitcher; chill."
        }
      ],
