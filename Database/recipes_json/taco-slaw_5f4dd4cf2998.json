      "name": "Taco Slaw",
      "ingredients_raw": [
        "0.5 small head cabbage, chopped",
        "1 carrot, chopped",
        "0.5 red onion, minced",
        "1 jalapeno pepper, seeded and minced",
        "1 tablespoon chopped fresh cilantro",
        "1 lime, juiced"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Finely chop the cabbage, carrot, and cilantro. Mince the red onion. Seed and mince the jalapeño."
        },
        {
          "id": 3,
          "text": "Combine chopped vegetables and lime juice in a bowl; toss to coat."
        }
