    {
      "name": "No Bake Cow Pies",
      "ingredients_raw": [
        "2 cups milk chocolate chips",
        "1 tablespoon shortening",
        "0.5 cup raisins",
        "0.5 cup blanched slivered almonds"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Melt the chocolate and shortening together over medium-low heat. Stir until smooth. Remove the mixture from heat and stir in raisins and nuts. Drop cookies by tablespoon onto waxed paper. Chill and serve."
        }
      ],
