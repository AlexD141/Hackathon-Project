    {
      "name": "John Collins Cocktail",
      "ingredients_raw": [
        "ice",
        "2 fluid ounces bourbon whiskey",
        "1 tablespoon fresh lemon juice",
        "1 teaspoon white sugar",
        "0.25 cup club soda, or as needed",
        "1 slice lemon"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Fill a chilled cocktail glass with ice; add whiskey and lemon juice. Stir in sugar until dissolved. Top off with club soda. Garnish with lemon slice."
        }
      ],
