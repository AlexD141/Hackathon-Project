  "recipes": [
    {
      "name": "Bread Dipping Oil",
      "ingredients_raw": [
        "2 cups olive oil",
        "1 tablespoon dried basil",
        "1 tablespoon dried parsley",
        "1 tablespoon minced garlic",
        "1 teaspoon dried thyme",
        "1 teaspoon dried oregano",
        "1 teaspoon ground black pepper",
        "0.5 teaspoon dried crushed rosemary",
        "0.5 teaspoon salt",
        "0.5 teaspoon crushed red pepper, or to taste",
        "0.5 teaspoon lemon juice",
        "2 tablespoons grated Parmesan cheese"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Stir together olive oil, basil, parsley, garlic, thyme, oregano, black pepper, rosemary, salt, red pepper, and lemon juice in a bowl."
        },
        {
          "id": 3,
          "text": "Sprinkle Parmesan cheese over the surface of the oil mixture."
        },
        {
          "id": 4,
          "text": "Serve and enjoy!"
        }
      ],
