  "recipes": [
    {
      "name": "Mushroom Broccoli Salad",
      "ingredients_raw": [
        "4 slices bacon",
        "4 cups broccoli florets",
        "1 cup chopped cremini mushrooms",
        "0.25 red onion, finely chopped",
        "0.25 cup raisins",
        "0.25 cup sunflower seed kernels",
        "1 cup mayonnaise",
        "0.25 cup white sugar",
        "3 tablespoons apple cider vinegar",
        "salt and ground black pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place bacon in a large, deep skillet, and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on a paper towel-lined plate. Crumble bacon."
        },
        {
          "id": 2,
          "text": "Combine broccoli, mushrooms, red onion, raisins, sunflower seeds, and crumbled bacon in a large bowl."
        },
        {
          "id": 3,
          "text": "Mix mayonnaise, sugar, vinegar, salt, and black pepper in a bowl until well blended."
        },
        {
          "id": 4,
          "text": "Pour mayonnaise mixture over vegetables. Toss to coat."
        }
      ],
