  "recipes": [
    {
      "name": "Fried Pie Crust",
      "ingredients_raw": [
        "0.5 cup butter",
        "0.5 cup flaked coconut",
        "0.75 cup all-purpose flour",
        "2 tablespoons brown sugar"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine butter, coconut, flour and brown sugar in a sauce pan. Cook on medium heat until a rich brown color, stirring frequently."
        },
        {
          "id": 2,
          "text": "Pour into pie plate and press out to edges evenly with a fork."
        },
        {
          "id": 3,
          "text": "Allow to cool before filling."
        }
      ],
