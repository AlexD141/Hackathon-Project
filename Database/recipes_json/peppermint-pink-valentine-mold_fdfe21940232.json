{
  "source_url": "https://www.allrecipes.com/recipe/16055/peppermint-pink-valentine-mold/",
  "extracted_at": "2026-10-18T02:18:45.160325+00:00",
  "recipes": [
    {
      "name": "Peppermint Pink Valentine Mold",
      "ingredients_raw": [
        "1 (.25 ounce) package unflavored gelatin",
        "0.5 cup white sugar, divided",
        "0.125 teaspoon salt",
        "2 eggs, separated",
        "1.25 cups milk",
        "0.25 teaspoon peppermint extract",
        "3 drops red food coloring",
        "1 cup whipping cream, whipped"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a medium saucepan over no heat, combine gelatin, 1/4 cup sugar and salt, mix well and reserve. In a medium bowl, beat together egg yolks and milk, add to gelatin mixture."
        },
        {
          "id": 2,
          "text": "Cook gelatin and egg mixture in saucepan over low heat; stir constantly until the gelatin dissolves and mixture thickens slightly or about 5 minutes. Remove from heat and add peppermint extract or candy."
        },
        {
          "id": 3,
          "text": "Add food coloring and mix. Chill in refrigerator until mixture is slightly thicker than the consistency of unbeaten egg whites."
        },
        {
          "id": 4,
          "text": "In a small bowl, beat egg whites until stiff, but not dry. Gradually add remaining sugar and beat until very stiff and fold into gelatin mixture; fold in whipped cream."
        },
        {
          "id": 5,
          "text": "Turn into a 5-cup heart-shaped mold; chill until firm. Unmold and garnish with additional whipped cream, if desired; serve."
        }
      ],
      "warnings": [],
