  "recipes": [
    {
      "name": "Italian Leafy Green Salad",
      "ingredients_raw": [
        "2 cups romaine lettuce - torn, washed and dried",
        "1 cup torn escarole",
        "1 cup torn radicchio",
        "1 cup torn red leaf lettuce",
        "12 cherry tomatoes",
        "0.5 red bell pepper, sliced into rings",
        "0.5 green bell pepper, sliced in rings",
        "0.25 cup chopped green onions",
        "0.25 cup grapeseed oil",
        "0.25 cup balsamic vinegar",
        "2 tablespoons lemon juice",
        "2 tablespoons chopped fresh basil",
        "salt and pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine romaine, escarole, radicchio, red leaf lettuce, cherry tomatoes, bell peppers, and green onions in a large bowl."
        },
        {
          "id": 2,
          "text": "Make dressing: Whisk together grapeseed oil, vinegar, lemon juice, basil, salt, and pepper in a small bowl."
        },
        {
          "id": 3,
          "text": "Pour dressing over salad and toss well."
        }
      ],
