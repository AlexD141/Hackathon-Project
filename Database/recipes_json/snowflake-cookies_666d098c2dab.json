  "recipes": [
    {
      "name": "Snowflake Cookies",
      "ingredients_raw": [
        "1.5 cups white sugar",
        "1 cup shortening",
        "3 eggs",
        "1 teaspoon vanilla extract",
        "3.75 cups all-purpose flour",
        "1.5 teaspoons salt"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Beat sugar and shortening with an electric mixer in a large bowl until smooth. Beat one egg into butter mixture, then beat in remaining eggs and vanilla. Add flour and salt; stir until dough is just combined. Wrap dough in plastic wrap and chill for at least 1 hour."
        },
        {
          "id": 2,
          "text": "When ready to bake, preheat the oven to 400 degrees F (200 degrees C)."
        },
        {
          "id": 3,
          "text": "Roll dough on a lightly floured surface to a thickness of 1/8 inch. Cut dough into desired shapes with a cookie cutter and place 1 inch apart on ungreased baking sheets."
        },
        {
          "id": 4,
          "text": "Bake in the preheated oven until edges are golden brown, about 6 to 8 minutes. Cool briefly on baking sheets, then remove to wire racks to cool completely before decorating."
        }
      ],
