  "recipes": [
    {
      "name": "Black Walnut Cookies I",
      "ingredients_raw": [
        "1 cup butter",
        "1 cup packed dark brown sugar",
        "1 egg",
        "0.5 teaspoon baking soda",
        "1 teaspoon maple flavored extract",
        "2 cups all-purpose flour",
        "1 teaspoon baking powder",
        "1.5 cups chopped black walnuts"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Cream butter and sugar. Beat in egg and add flavoring. Add in flour and baking powder dissolved in a couple drops of water. Add nuts and mix well."
        },
        {
          "id": 2,
          "text": "Divide dough into thirds and roll into logs. Refrigerate until firm (about 1 hour.)"
        },
        {
          "id": 3,
          "text": "Preheat oven to 400 degrees F (205 degrees C)."
        },
        {
          "id": 4,
          "text": "Slice logs into thin cookies. Bake for 9 minutes or until light brown in color."
        }
      ],
