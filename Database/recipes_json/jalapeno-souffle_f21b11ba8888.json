  "recipes": [
    {
      "name": "Jalapeno Souffle",
      "ingredients_raw": [
        "4 eggs",
        "2.5 cups shredded Mexican-style cheese",
        "16 ounces pickled jalapeno slices"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease an 8x8 inch baking dish."
        },
        {
          "id": 2,
          "text": "Whip the eggs in a small bowl and pour into the baking dish. Layer with jalapenos. Top jalapenos with the cheese. Top cheese with more jalapenos."
        },
        {
          "id": 3,
          "text": "Bake in the preheated oven 30 minutes, or until the cheese is bubbly and lightly brown."
        }
      ],
