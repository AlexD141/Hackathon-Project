    {
      "name": "French 75 Cocktail",
      "ingredients_raw": [
        "2 fluid ounces lemon juice",
        "2 fluid ounces gin",
        "2 teaspoons simple syrup",
        "1 cup ice cubes",
        "4 fluid ounces chilled Champagne",
        "1 lemon or orange slice for garnish",
        "1 maraschino cherry for garnish"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine lemon juice, gin, and simple syrup in a Collins glass. Add ice cubes, fill with Champagne, and stir."
        },
        {
          "id": 2,
          "text": "Garnish with a slice of lemon or orange and a maraschino cherry."
        }
      ],
