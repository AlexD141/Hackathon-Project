      "name": "Balsamic Vinegar and Olive Oil Dressing",
      "ingredients_raw": [
        "1 sprig fresh oregano",
        "1 sprig fresh thyme",
        "1 cup olive oil",
        "0.25 cup balsamic vinegar",
        "salt and pepper to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a medium glass mixing bowl combine the oregano, thyme, oil, vinegar, salt and pepper. Mix together and pour mixture into a bottle, using a funnel to keep yourself from losing oil. Cover tightly and store at room temperature."
        }
