  "recipes": [
    {
      "name": "Halloween Fruit Apple Teeth Treats",
      "ingredients_raw": [
        "4 Honeycrisp apples - cored and quartered",
        "1 teaspoon lemon juice",
        "1 (2.25 ounce) package blanched slivered almonds"
      ],
      "steps": [
        {
          "id": 1,
          "text": "With a small, sharp paring knife, cut a lengthwise wedge from the skin side of each apple quarter, leaving the peel around the wedge for lips. If desired, rub the cut portions of the apple quarters with lemon juice to prevent browning. Poke 5 or 6 slivered almonds into the top and bottom of the cut-out area to make snaggly teeth."
        }
      ],
