      "name": "Kiwi Margarita",
      "ingredients_raw": [
        "0.5 cup superfine sugar",
        "0.33333334326744 cup gold tequila",
        "0.33333334326744 cup triple sec",
        "2 large kiwis, peeled",
        "1 cup fresh lime juice",
        "2 cups small ice cubes"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine sugar, tequila, triple sec, kiwis, and lime juice in a blender. Fill with ice cubes; blend until smooth."
        }
