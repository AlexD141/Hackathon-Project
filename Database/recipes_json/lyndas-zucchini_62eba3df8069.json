  "recipes": [
    {
      "name": "Lynda&#39;s Zucchini",
      "ingredients_raw": [
        "2 tablespoons butter",
        "2 zucchini, cut into 1/2-inch slices",
        "1 cup shredded Cheddar cheese"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Set an oven rack about 6 inches from the heat source and preheat the oven&#39;s broiler. Lightly grease a medium baking sheet."
        },
        {
          "id": 2,
          "text": "Melt butter in a large saucepan over medium-low heat. Add zucchini; cook, stirring occasionally, until soft and golden brown."
        },
        {
          "id": 3,
          "text": "Evenly spread zucchini on the prepared baking sheet; top with cheese."
        },
        {
          "id": 4,
          "text": "Broil until cheese is melted."
        }
      ],
