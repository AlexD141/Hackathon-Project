  "recipes": [
    {
      "name": "Anzac Biscuits",
      "ingredients_raw": [
        "0.75 cup rolled oats",
        "0.75 cup sweetened flaked coconut",
        "0.5 cup all-purpose flour",
        "0.5 cup white sugar",
        "0.5 teaspoon baking powder",
        "2 tablespoons boiling water",
        "0.5 cup butter, melted",
        "1 tablespoon golden syrup"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease two baking sheets."
        },
        {
          "id": 2,
          "text": "Combine oats, coconut, flour, and sugar in a large bowl. Dissolve baking powder in water in a bowl; stir in butter and golden syrup. Stir butter mixture into oat mixture until dough is well combined."
        },
        {
          "id": 3,
          "text": "Drop level tablespoons of dough onto prepared baking sheets about 2 inches apart. Flatten dough with a fork lightly coated with flour."
        },
        {
          "id": 4,
          "text": "Bake in the preheated oven until golden, about 15 minutes."
        }
      ],
