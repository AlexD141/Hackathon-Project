    {
      "name": "Monkey Gland Cocktail",
      "ingredients_raw": [
        "1.5 cups ice",
        "2 fluid ounces gin",
        "1 fluid ounce fresh orange juice",
        "0.125 teaspoon Pernod",
        "2 dashes grenadine",
        "1 (3 inch) piece orange peel"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Fill a cocktail shaker with ice. Pour in gin, orange juice, Pernod, and grenadine. Shake well and strain into a chilled glass. Garnish with a twist of orange peel."
        }
      ],
