  "recipes": [
    {
      "name": "Almondy Warmth Cookies",
      "ingredients_raw": [
        "2 cups all-purpose flour",
        "0.5 teaspoon baking powder",
        "1 teaspoon baking soda",
        "0.125 teaspoon salt",
        "1 tablespoon ground cinnamon",
        "1.5 teaspoons ground nutmeg",
        "0.5 cup packed light brown sugar",
        "0.5 cup white sugar",
        "1 cup butter-flavored spread",
        "2 tablespoons sour cream",
        "1 tablespoon olive oil",
        "1.5 teaspoons almond extract",
        "1 tablespoon amaretto liqueur",
        "1.5 teaspoons bourbon",
        "0.5 cup chopped almonds"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 375 degrees F (190 degrees C). Grease a cookie sheet. Sift together flour, baking powder, baking soda, salt, cinnamon, and nutmeg in a medium bowl. Set aside."
        },
        {
          "id": 2,
          "text": "Cream together brown sugar, white sugar, and vegetable oil spread in a medium bowl. Stir in sour cream, olive oil, almond extract, amaretto and bourbon, blending well after each addition."
        },
        {
          "id": 3,
          "text": "Gradually stir flour mixture into sugar mixture until well blended. Stir in almonds if desired. Drop by rounded spoonfuls onto prepared cookie sheet."
        },
        {
          "id": 4,
          "text": "Bake until just crisp around the edges, 12 to 14 minutes."
        }
      ],
