  "recipes": [
    {
      "name": "Pawpaw (Papaya) And Mango Punch",
      "ingredients_raw": [
        "1 cup sliced mango",
        "1 cup diced, peeled papaya",
        "1 cup orange juice",
        "0.25 cup lime juice",
        "0.25 cup white sugar, or to taste",
        "1 teaspoon grated orange zest",
        "4 cups water"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place the mango and papaya into a blender. Cover, and puree until smooth; add the orange juice, lime juice, sugar, orange zest, and water. Blend well. Serve over crushed ice."
        }
      ],
