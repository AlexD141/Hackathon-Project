  "recipes": [
    {
      "name": "Noodles Romanoff I",
      "ingredients_raw": [
        "1 (8 ounce) package wide egg noodles",
        "1 (8 ounce) container cottage cheese",
        "1 (8 ounce) container sour cream",
        "0.25 tablespoon finely chopped onion",
        "0.25 teaspoon minced garlic",
        "0.5 teaspoon Worcestershire sauce",
        "1 dash hot pepper sauce",
        "0.5 teaspoon salt",
        "2 tablespoons shredded Cheddar cheese"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a large pot with boiling salted water cook egg noodles until al dente. Drain."
        },
        {
          "id": 2,
          "text": "In a large bowl mix together the cottage cheese, sour cream, minced onion, garlic, Worcestershire sauce, red pepper sauce, and salt. Stir in cooked egg noodles. Pour into a greased 2 quart casserole dish."
        },
        {
          "id": 3,
          "text": "Bake in a preheated 350 degree F (175 degrees C) for 30 minutes, or until heated through and bubbly. Serve warm."
        }
      ],
