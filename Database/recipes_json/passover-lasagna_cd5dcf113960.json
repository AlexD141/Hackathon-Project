  "recipes": [
    {
      "name": "Passover Lasagna",
      "ingredients_raw": [
        "1 (10 ounce) package matzo sheets",
        "1 quart tomato sauce",
        "salt and pepper to taste",
        "1 (8 ounce) package sliced Swiss cheese",
        "2 cups shredded mozzarella cheese",
        "0.25 cup grated Parmesan cheese",
        "1 teaspoon dried oregano"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat an oven to 350 degrees F (175 degrees C). Spray a 9x13-inch pan with cooking spray."
        },
        {
          "id": 2,
          "text": "Break matzo sheets in half and run under warm water to soften. Pour tomato sauce into bowl, and season with salt and pepper. Coat the bottom of the prepared pan with some of the tomato sauce, then begin layering with the softened matzo sheet, Swiss cheese, mozzarella cheese, and tomato sauce. Continue layering until the cheeses are used up, finishing with a layer of matzo. Top with the remaining tomato sauce, and sprinkle with Parmesan cheese and oregano."
        },
        {
          "id": 3,
          "text": "Bake in the preheated oven until the cheese is melted, 25 to 30 minutes."
        }
      ],
