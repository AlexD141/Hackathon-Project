  "recipes": [
    {
      "name": "Ring Tum Ditty",
      "ingredients_raw": [
        "2 tablespoons butter",
        "2 tablespoons flour",
        "2 cups milk",
        "1 (10.75 ounce) can condensed cream of tomato soup",
        "1 tablespoon white sugar",
        "0.5 pound American cheese, grated"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Melt butter in a saucepan over medium heat; stir in flour. Add milk, soup, and sugar; stir until incorporated. Heat until just about to boil; stir in cheese. Cook and stir until cheese is completely melted, but do not allow to boil."
        }
      ],
