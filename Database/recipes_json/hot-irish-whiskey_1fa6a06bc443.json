  "recipes": [
    {
      "name": "Hot Irish Whiskey",
      "ingredients_raw": [
        "8 whole cloves",
        "1 (1/4 inch thick) slice of lemon",
        "1 tablespoon white sugar",
        "0.75 cup boiling water",
        "1 (1.5 fluid ounce) jigger Irish whiskey"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Press cloves into lemon slice peel around entire peel; set aside."
        },
        {
          "id": 2,
          "text": "Add sugar to a wine glass; place a metal spoon into the glass with the curved side facing upwards. Pour boiling water over the back of the spoon; this will keep your wine glass from shattering. Stir until sugar dissolved; add whiskey and lemon slice. Steep before drinking, about 1 minute."
        }
      ],
