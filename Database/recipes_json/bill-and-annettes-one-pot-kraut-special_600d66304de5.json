  "recipes": [
    {
      "name": "Bill and Annette&#39;s One Pot Kraut Special",
      "ingredients_raw": [
        "2 Granny Smith apples - peeled, cored and diced",
        "1 large onion, diced",
        "1 (3 pound) boneless pork loin",
        "0.25 cup brown sugar",
        "1 (32 ounce) jar sauerkraut, drained",
        "1 (20 ounce) bottle peach-flavored iced tea"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place apples and onion into a slow cooker. Set the pork loin on top, then add the sugar, sauerkraut, and iced tea. Cover and cook on High 6 to 8 hours until the pork is tender."
        }
      ],
