  "recipes": [
    {
      "name": "Special Occasion Smoked Bluefish Pâté",
      "ingredients_raw": [
        "0.5 pound skinless, boneless smoked bluefish",
        "1 (8 ounce) package cream cheese, softened",
        "1.5 teaspoons prepared Dijon-style mustard",
        "1.5 teaspoons prepared horseradish"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Break up bluefish into pieces; place in the bowl of a food processor. Add cream cheese; pulse until smooth. Add Dijon and horseradish; pulse until reaches desired consistency."
        },
        {
          "id": 2,
          "text": "Transfer pâté to a bowl; cover the bowl. Refrigerate before serving, 6 hours to overnight."
        }
      ],
