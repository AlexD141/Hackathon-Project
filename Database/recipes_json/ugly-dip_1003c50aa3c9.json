      "name": "Ugly Dip",
      "ingredients_raw": [
        "1 (8 ounce) package cream cheese, softened",
        "1 cup mayonnaise",
        "1 (14 ounce) can diced tomatoes with green chile peppers, drained",
        "1 (7 ounce) can Mexican-style corn, drained",
        "1 green onion, chopped"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Stir cream cheese, mayonnaise, diced tomatoes, corn, and green onion together in a bowl."
        },
        {
          "id": 3,
          "text": "Serve immediately or chill."
        }
