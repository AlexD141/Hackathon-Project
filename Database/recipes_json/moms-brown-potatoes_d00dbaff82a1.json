    {
      "name": "Mom&#39;s Brown Potatoes",
      "ingredients_raw": [
        "2 cups oil for frying",
        "5 medium potatoes, cut into small cubes",
        "garlic salt to taste",
        "1 tablespoon dried parsley"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Heat the oil in a deep fryer or large, heavy saucepan to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "Deep fry the potatoes until golden brown. As you remove the potatoes from the oil, sprinkle them generously with garlic salt and parsley."
        }
      ],
