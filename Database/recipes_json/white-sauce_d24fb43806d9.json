  "recipes": [
    {
      "name": "White Sauce",
      "ingredients_raw": [
        "2 tablespoons butter",
        "2 tablespoons all-purpose flour",
        "1 cup milk, or more as needed"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather the ingredients."
        },
        {
          "id": 2,
          "text": "Melt butter in a small saucepan over medium-low heat."
        },
        {
          "id": 3,
          "text": "Whisk in flour to form a thick paste; cook and stir until golden in color, about 5 to 7 minutes."
        },
        {
          "id": 4,
          "text": "Whisk in 1 cup milk; cook and stir until thickened, about 5 minutes more. Add more milk to reach desired consistency."
        },
        {
          "id": 5,
          "text": "Enjoy!"
        }
      ],
