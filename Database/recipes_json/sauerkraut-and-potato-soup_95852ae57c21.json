  "recipes": [
    {
      "name": "Sauerkraut And Potato Soup",
      "ingredients_raw": [
        "1 pound beef stew meat, diced into 1 inch pieces",
        "1 onion, chopped",
        "3 tablespoons vegetable oil",
        "1.5 cups beer",
        "0.75 cup water",
        "0.25 cup tomato paste",
        "1 tablespoon paprika",
        "0.25 teaspoon salt",
        "0.25 teaspoon caraway seed",
        "0.25 teaspoon ground black pepper",
        "3 potatoes, cubed",
        "1 ounce sauerkraut",
        "2 tablespoons chopped fresh dill weed",
        "2 tablespoons chopped fresh parsley"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a Dutch oven, cook meat and onion in hot oil until meat is brown."
        },
        {
          "id": 2,
          "text": "Stir in beer, water, tomato paste, paprika, salt, caraway seed, and pepper. Cover, and simmer 1 1/4 to 1 1/2 hours."
        },
        {
          "id": 3,
          "text": "Add potatoes, undrained sauerkraut, and fresh dill to soup. Cover. Cook for about 20 minutes, or until vegetables are tender."
        },
        {
          "id": 4,
          "text": "Cook uncovered for 10 minutes more, or until mixture is thickened and most of the liquid is evaporated. Sprinkle parsley on top before serving."
        }
      ],
