  "recipes": [
    {
      "name": "Chicken with Plum Glaze",
      "ingredients_raw": [
        "cooking spray",
        "1 (2.5 pound) whole chicken, cut into pieces",
        "salt and ground black pepper to taste",
        "0.66666668653488 cup plum jam",
        "1.5 teaspoons ground black pepper",
        "1.5 teaspoons minced fresh ginger root",
        "1.25 teaspoons prepared horseradish"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a baking sheet with cooking spray."
        },
        {
          "id": 2,
          "text": "Season chicken pieces with salt and pepper. Place skin-side-up onto the prepared baking sheet."
        },
        {
          "id": 3,
          "text": "Bake in the preheated oven for 20 minutes."
        },
        {
          "id": 4,
          "text": "Meanwhile, stir together plum jam, 1 1/2 teaspoons pepper, ginger, and horseradish in a small bowl."
        },
        {
          "id": 5,
          "text": "After chicken has baked 20 minutes, brush with plum glaze and return to the oven. Continue baking until no longer pink at the bone and the juices run clear, 20 to 30 minutes more. An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C)."
        }
      ],
