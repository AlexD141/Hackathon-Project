            },
            "author": {
              "@type": "Person",
              "name": "Joel Wurzler"
            },
            "reviewBody": "I modified it, added diced celery, diced baby portobello mushrooms, fresh oregano, garlic, tyme rosemary, and tarragon, S&amp; White pepper",
            "datePublished": "2024-08-05T21:12:49.459Z"
