    {
      "name": "Strawberry Ambrosia",
      "ingredients_raw": [
        "1 (32 ounce) container plain yogurt",
        "2 (16 ounce) packages mini marshmallows",
        "1 (16 ounce) package frozen strawberries, thawed and drained",
        "2 (15 ounce) cans Mandarin oranges, drained"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Stir together the yogurt and marshmallows in a large bowl. Gently fold in the strawberries and Mandarin oranges. Scoop into a serving bowl, and refrigerate at least 30 minutes before serving."
        }
      ],
