  "recipes": [
    {
      "name": "Quick Egg Roll Dipping Sauce",
      "ingredients_raw": [
        "3 tablespoons soy sauce",
        "3 tablespoons rice vinegar",
        "1 teaspoon ground ginger",
        "0.5 teaspoon garlic powder",
        "0.5 teaspoon onion powder",
        "0.125 teaspoon sesame oil"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Whisk together soy sauce, rice vinegar, ginger, garlic powder, onion powder, and sesame oil in a bowl until smooth. Serve in small dipping dishes."
        }
      ],
