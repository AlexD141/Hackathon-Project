  "recipes": [
    {
      "name": "Sharp Cheddar Dip",
      "ingredients_raw": [
        "1 (8 ounce) package cream cheese, softened",
        "5 ounces sharp processed cheese spread",
        "1 pinch garlic powder",
        "6 bagels"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In an electric blender, combine cream cheese, sharp Cheddar cheese spread, and garlic powder. Blend until creamy."
        },
        {
          "id": 2,
          "text": "Cut bagels in half, and then into quarters. Arrange the bagels around the dip on a serving platter."
        }
      ],
