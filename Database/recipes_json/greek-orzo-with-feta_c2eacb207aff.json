  "recipes": [
    {
      "name": "Greek Orzo with Feta",
      "ingredients_raw": [
        "0.25 cup olive oil",
        "0.5 cup fresh lemon juice",
        "0.5 cup pitted kalamata olives, chopped",
        "2 ripe tomatoes, seeded and diced",
        "1 red bell pepper, chopped",
        "1 red onion, chopped",
        "2 cloves garlic, minced",
        "1 teaspoon finely chopped fresh oregano",
        "1 (8 ounce) package crumbled feta cheese",
        "0.5 pound dried orzo pasta",
        "1 cup chopped fresh parsley"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Stir together olive oil, lemon juice, olives, tomatoes, red pepper, red onion, garlic, oregano, and feta cheese in a large bowl. Let stand at room temperature for 1 hour."
        },
        {
          "id": 2,
          "text": "Bring a large pot of lightly salted water to a boil. Add the orzo and cook for 8 to 10 minutes or until al dente; drain and toss the tomato mixture. Sprinkle with chopped parsley to serve."
        }
      ],
