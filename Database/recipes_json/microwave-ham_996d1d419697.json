  "recipes": [
    {
      "name": "Microwave Ham",
      "ingredients_raw": [
        "1 (3 pound) boneless ham",
        "0.5 cup packed brown sugar",
        "0.25 cup soy sauce",
        "3 tablespoons Dijon mustard"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Cut the ham in half lengthwise. Place into a large pot, and fill with enough water to cover. Bring to a boil and cook for 1 hour, replenishing water as needed. Drain."
        },
        {
          "id": 2,
          "text": "Meanwhile, stir together the brown sugar, soy sauce and mustard in a small bowl. Set aside until the ham is done."
        },
        {
          "id": 3,
          "text": "Place the ham halves into a glass or ceramic baking dish with the cut sides facing up. Cover the ham with the brown sugar mixture. Cook in the microwave for 15 minutes. Slice and serve."
        }
      ],
