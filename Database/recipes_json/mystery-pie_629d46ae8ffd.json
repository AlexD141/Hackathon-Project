  "recipes": [
    {
      "name": "Mystery Pie",
      "ingredients_raw": [
        "3 egg whites",
        "1 cup white sugar",
        "1 teaspoon baking powder",
        "1.5 teaspoons vanilla extract",
        "18 buttery round crackers, crushed",
        "0.66670000553131 cup chopped pecans",
        "1 cup frozen whipped topping, thawed",
        "1.5 cups fresh strawberries, sliced"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C). Generously grease a 9 inch pie pan."
        },
        {
          "id": 2,
          "text": "In a large glass or metal bowl, beat egg whites until foamy. Mix together sugar and baking powder, then slowly add mixture to egg whites, continuing to beat until stiff peaks form. Beat in vanilla extract. Fold in crushed crackers and pecans. Spread mixture evenly into pie pan."
        },
        {
          "id": 3,
          "text": "Place pie in preheated oven and reduce temperature to 325 degrees F (165 degrees C). Bake for 30 minutes. Cool thoroughly. Top with whipped topping and fresh fruit."
        }
      ],
