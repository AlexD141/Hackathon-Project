  "recipes": [
    {
      "name": "Lynchburg Lemonade Cocktail",
      "ingredients_raw": [
        "1 fluid ounce Tennessee whiskey (such as Jack Daniels ®)",
        "1 fluid ounce triple sec",
        "1 fluid ounce sweet and sour mix",
        "1.5 cups ice",
        "2 fluid ounces lemon-lime soda",
        "1 lemon wheel"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine whiskey, triple sec, and sweet and sour mix in a pint glass. Add ice and top with lemon lime soda."
        },
        {
          "id": 2,
          "text": "Garnish with lemon wheel."
        }
      ],
