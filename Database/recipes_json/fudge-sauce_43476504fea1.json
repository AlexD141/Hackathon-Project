  "recipes": [
    {
      "name": "Fudge Sauce",
      "ingredients_raw": [
        "1 cup white sugar",
        "3 tablespoons unsweetened cocoa powder",
        "0.5 teaspoon salt",
        "1 teaspoon ground cinnamon",
        "0.75 cup evaporated milk",
        "1 teaspoon vanilla extract",
        "2 tablespoons butter"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a medium saucepan, combine sugar, cocoa, salt and cinnamon. Stir to mix and to eliminate lumps."
        },
        {
          "id": 2,
          "text": "Pour in evaporated milk and bring to a boil over medium-high heat; boil for 2 minutes, remove from heat and stir in vanilla and butter."
        }
      ],
