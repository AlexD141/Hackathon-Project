  "recipes": [
    {
      "name": "BBQ Pork-Stuffed Corn Muffins",
      "ingredients_raw": [
        "cooking spray",
        "1 (8.5 ounce) package dry corn muffin mix (such as Jiffy®)",
        "1 egg",
        "0.33333334326744 cup milk",
        "0.25 cup shredded pepperjack cheese",
        "1 cup pulled pork in barbeque sauce",
        "0.25 cup shredded pepperjack cheese"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat the oven to 400 degrees F (200 degrees C)."
        },
        {
          "id": 2,
          "text": "Line muffin tin with paper baking cups. Spray each cup with cooking spray."
        },
        {
          "id": 3,
          "text": "Stir together muffin mix, egg, milk, and 1/4 cup of shredded cheese in a bowl until combined."
        },
        {
          "id": 4,
          "text": "Fill muffin cups halfway with batter."
        },
        {
          "id": 5,
          "text": "Add 1 to 2 tablespoons of pulled pork to each cup."
        },
        {
          "id": 6,
          "text": "Top with remaining batter."
        },
        {
          "id": 7,
          "text": "Use the remaining 1/4 of shredded cheese to top each muffin."
        },
        {
          "id": 8,
          "text": "Bake in the preheated oven until a toothpick inserted into the batter comes out clean, about 20 minutes."
        }
      ],
