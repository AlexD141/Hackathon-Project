  "recipes": [
    {
      "name": "Filipino Polvoron",
      "ingredients_raw": [
        "2 cups all-purpose flour",
        "2 cups unsalted butter, melted",
        "1 cup white sugar",
        "1 cup powdered milk",
        "1 tablespoon lemon extract"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Toast flour in a nonstick skillet over medium heat, stirring constantly to prevent burning, until light brown, about 5 minutes. Let cool for at least 15 minutes."
        },
        {
          "id": 2,
          "text": "Meanwhile, cut waxed paper into twenty 4-inch squares."
        },
        {
          "id": 3,
          "text": "Stir butter, sugar, powdered milk, and lemon extract into cooled flour until well combined. Fill a polvoron mold tightly with a portion of the mixture. Press the plunger down to release the candy onto a square of waxed paper. Wrap candy in the waxed paper and twist the ends. Repeat until all of the candy mixture is used up."
        }
      ],
