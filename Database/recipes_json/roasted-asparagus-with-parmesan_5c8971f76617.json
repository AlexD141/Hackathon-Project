  "recipes": [
    {
      "name": "Roasted Asparagus with Parmesan",
      "ingredients_raw": [
        "olive oil cooking spray",
        "1 pound fresh asparagus, tough ends trimmed",
        "0.25 cup shredded Parmesan cheese",
        "1 teaspoon sea salt",
        "0.25 teaspoon garlic powder, or to taste"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather the ingredients. Preheat the oven to 400 degrees F (200 degrees C)."
        },
        {
          "id": 2,
          "text": "Spray the inside of a 9x13 casserole dish with olive oil cooking spray. Place asparagus in the dish and lightly spray spears with cooking spray."
        },
        {
          "id": 3,
          "text": "Sprinkle asparagus with Parmesan cheese, sea salt, and garlic powder."
        },
        {
          "id": 4,
          "text": "Roast in preheated oven until fork easily punctures thickest part of stem, about 12 minutes."
        },
        {
          "id": 5,
          "text": "Enjoy!"
        }
      ],
