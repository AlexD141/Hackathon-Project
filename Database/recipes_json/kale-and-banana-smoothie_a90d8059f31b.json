  "recipes": [
    {
      "name": "Kale and Banana Smoothie",
      "ingredients_raw": [
        "2 cups chopped kale",
        "1 banana",
        "0.5 cup light unsweetened soy milk",
        "1 tablespoon flax seeds",
        "1 teaspoon maple syrup"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Place kale, banana, soy milk, flax seeds, and maple syrup into a blender."
        },
        {
          "id": 3,
          "text": "Cover and purée until smooth."
        },
        {
          "id": 4,
          "text": "Serve over ice."
        }
      ],
