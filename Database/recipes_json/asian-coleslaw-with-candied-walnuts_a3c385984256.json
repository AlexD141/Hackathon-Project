  "recipes": [
    {
      "name": "Asian Coleslaw with Candied Walnuts",
      "ingredients_raw": [
        "4 cups shredded red cabbage",
        "1 cup shredded jicama",
        "0.5 cup shredded carrots",
        "2 tablespoons chopped cilantro",
        "0.5 cup Kikkoman Lime Ponzu",
        "6 tablespoons sesame oil",
        "0.25 cup orange juice",
        "0.5 teaspoon grated ginger",
        "1 cup walnuts",
        "0.5 cup sugar",
        "0.5 teaspoon vanilla",
        "0.5 teaspoon cinnamon"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a large bowl, toss together cabbage, jicama, carrots and cilantro. Whisk together ponzu, sesame oil, orange juice and ginger; pour over cabbage mixture and toss together. Sprinkle with candied walnuts."
        },
        {
          "id": 2,
          "text": "To make candied walnuts, place 1 cup walnuts and 1/2 cup sugar in a skillet over medium heat. Cook, stirring constantly, until sugar dissolves and turns light brown. Toss to coat walnuts. Remove skillet from heat; stir in 1/2 teaspoon vanilla and 1/2 teaspoon cinnamon. Spread walnuts on aluminum foil to cool."
        }
      ],
