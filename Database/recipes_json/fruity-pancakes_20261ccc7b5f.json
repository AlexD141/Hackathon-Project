  "recipes": [
    {
      "name": "Fruity Pancakes",
      "ingredients_raw": [
        "2 cups all-purpose flour",
        "1 cup white sugar",
        "1 teaspoon baking soda",
        "0.5 teaspoon salt",
        "2 egg whites, beaten",
        "1 (15.25 ounce) can fruit cocktail, drained"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C). Coat two non-stick baking sheets with cooking spray."
        },
        {
          "id": 2,
          "text": "Sift together the flour, sugar, baking soda, and salt. Gradually beat the flour mixture into the egg whites to form a batter. Evenly fold the fruit cocktail into the batter. Dollop the batter in 2 tablespoon portions onto the prepared baking pans, leaving at least 2 inches between pancakes."
        },
        {
          "id": 3,
          "text": "Bake in preheated oven until puffed and golden brown, 10 to 15 minutes."
        }
      ],
