  "recipes": [
    {
      "name": "Sazerac Cocktail",
      "ingredients_raw": [
        "ice",
        "3 dashes Peychaud's Bitters®",
        "2 dashes Angostura Bitters®",
        "1 sugar cube",
        "2 fluid ounces rye whiskey",
        "1 lemon peel"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Fill a rocks glass with 1 cup ice; set aside to chill, about 5 minutes. Discard ice."
        },
        {
          "id": 2,
          "text": "Meanwhile, place Peychaud&#39;s bitters, Angostura bitters, and sugar cube in a cocktail shaker; mash well with a cocktail muddler. Add remaining 1 cup ice and whiskey; stir until chilled. Strain into the chilled glass."
        },
        {
          "id": 3,
          "text": "Twist lemon peel over surface of cocktail to extract its essence; discard lemon peel."
        }
      ],
