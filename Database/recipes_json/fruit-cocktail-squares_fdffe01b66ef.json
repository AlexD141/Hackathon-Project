  "recipes": [
    {
      "name": "Fruit Cocktail Squares",
      "ingredients_raw": [
        "1 (8 ounce) can fruit cocktail",
        "0.25 cup butter, softened",
        "0.33329999446869 cup white sugar",
        "1 egg",
        "0.25 teaspoon vanilla extract",
        "1.25 cups all-purpose flour",
        "0.25 teaspoon baking powder",
        "0.25 teaspoon baking soda",
        "0.25 teaspoon salt",
        "1 tablespoon maraschino cherry juice",
        "0.5 cup flaked coconut",
        "0.25 cup maraschino cherries, chopped"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Drain the fruit cocktail and reserve 1/3 cup of the syrup. Add the 1 tablespoon maraschino cherry syrup to the reserved fruit cocktail syrup. Chop the drained fruit, and set it aside."
        },
        {
          "id": 2,
          "text": "Stir together in a bowl the flour, baking soda, baking powder, and salt."
        },
        {
          "id": 3,
          "text": "In a large bowl, cream together the butter or margarine and sugar. Beat in the egg and vanilla extract."
        },
        {
          "id": 4,
          "text": "Add the flour mixture, alternating with the syrups, to the creamed mixture. Mix well. Stir in the chopped fruit, the coconut and the cherries."
        },
        {
          "id": 5,
          "text": "Spread dough into a greased 9 inch square pan. Bake at 350 degrees F (175 degrees C) for 30 to 35 minutes. Cool. Sprinkle sifted confectioners&#39; sugar over the top if desired. Cut into squares."
        }
      ],
