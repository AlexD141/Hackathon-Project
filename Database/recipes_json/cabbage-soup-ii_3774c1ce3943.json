      "name": "Cabbage Soup II",
      "ingredients_raw": [
        "6 (14.5 ounce) cans chicken broth",
        "4 stalks celery, chopped",
        "6 carrots, chopped",
        "1 onion, chopped",
        "2 cloves garlic, minced",
        "1 medium head cabbage, shredded",
        "0.5 cup barley",
        "2 cups diced ham",
        "1 tablespoon dried parsley"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Place the chicken broth, celery, carrots, onion, garlic, cabbage, barley, ham and parsley in a large pot over high heat. Bring to a boil, reduce heat to low and simmer for 1 1/2 hours."
        }
      ],
