    {
      "name": "Sherry Cobbler",
      "ingredients_raw": [
        "1 tablespoon white sugar",
        "1 tablespoon water",
        "3 orange slices",
        "0.5 cup dry sherry (such as fino or amontillado)",
        "1.5 cups crushed ice",
        "0.25 cup fresh raspberries and/or blackberries, for garnish"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Put sugar and water into a cocktail shaker and stir to dissolve. Add orange slices to the shaker and pour in sherry. Fill with ice, shake well, and strain into a tall glass full of crushed ice. Garnish with seasonal berries and a fresh slice of orange."
        }
      ],
