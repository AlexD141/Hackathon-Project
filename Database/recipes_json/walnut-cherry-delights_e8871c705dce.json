  "recipes": [
    {
      "name": "Walnut Cherry Delights",
      "ingredients_raw": [
        "1 cup all-purpose flour",
        "0.33333298563957 cup white sugar",
        "0.5 cup butter, softened",
        "2 eggs",
        "1.5 cups packed brown sugar",
        "0.25 cup all-purpose flour",
        "0.5 teaspoon baking powder",
        "1 cup chopped walnuts",
        "0.5 cup maraschino cherries"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (180 degrees C). Grease a 9 inch square pan."
        },
        {
          "id": 2,
          "text": "Mix 1 cup flour, white sugar and butter by hand. Pat into pan. Bake for 8 - 10 minutes."
        },
        {
          "id": 3,
          "text": "With a whisk, beat 2 eggs. Whisk in brown sugar, then add 1/4 cup flour and baking powder. Stir in nuts and cherries. Pour over baked crust."
        },
        {
          "id": 4,
          "text": "Bake for 20 - 25 minutes more."
        }
      ],
