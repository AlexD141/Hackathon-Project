  "recipes": [
    {
      "name": "Brandy Alexander Cocktail",
      "ingredients_raw": [
        "1 cup ice, or as needed",
        "0.5 fluid ounce creme de cacao",
        "0.5 fluid ounce brandy",
        "0.5 fluid ounce heavy cream"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Fill a cocktail shaker with ice."
        },
        {
          "id": 3,
          "text": "Add crème de cacao, brandy, and heavy cream. Cover and shake until the outside of the shaker has frosted."
        },
        {
          "id": 4,
          "text": "Strain into a chilled glass."
        },
        {
          "id": 5,
          "text": "Serve and enjoy."
        }
      ],
