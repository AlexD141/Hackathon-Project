  "recipes": [
    {
      "name": "Sweet and Sour Salad Dressing",
      "ingredients_raw": [
        "1 cup minced onion",
        "0.75 cup white sugar",
        "0.33333334326744 cup ketchup",
        "0.25 cup apple cider vinegar",
        "1 tablespoon Worcestershire sauce",
        "1 cup vegetable oil"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Whisk onion, sugar, ketchup, vinegar, and Worcestershire sauce together in a bowl until sugar has dissolved. Whisk in vegetable oil until incorporated. Cover and refrigerate 1 hour; whisk well before using."
        }
      ],
