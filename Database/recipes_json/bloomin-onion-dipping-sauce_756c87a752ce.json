  "recipes": [
    {
      "name": "Bloomin&#39; Onion Dipping Sauce",
      "ingredients_raw": [
        "0.5 cup sour cream",
        "2 tablespoons ketchup",
        "0.5 teaspoon seasoned salt",
        "0.125 teaspoon crushed red pepper flakes",
        "1.5 teaspoons finely grated raw horseradish",
        "0.25 teaspoon paprika"
      ],
      "steps": [
        {
          "id": 1,
          "text": "In a medium mixing bowl, combine sour cream, ketchup, seasoning salt, red pepper flakes, horseradish, and paprika. Serve immediately or refrigerate before serving."
        }
      ],
