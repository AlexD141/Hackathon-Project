  "recipes": [
    {
      "name": "Million Dollar Pie",
      "ingredients_raw": [
        "1 (14 ounce) can sweetened condensed milk",
        "0.5 cup lemon juice",
        "1 (8 ounce) can crushed pineapple, drained",
        "0.5 cup chopped pecans",
        "1 (16 ounce) package frozen whipped topping, thawed",
        "1 (9 inch) prepared graham cracker crust"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Whisk condensed milk and lemon juice together in a large bowl."
        },
        {
          "id": 3,
          "text": "Stir in drained pineapple and pecans, then fold in whipped topping."
        },
        {
          "id": 4,
          "text": "Pour mixture into prepared graham cracker crust. Refrigerate for at least 2 hours before serving."
        }
      ],
