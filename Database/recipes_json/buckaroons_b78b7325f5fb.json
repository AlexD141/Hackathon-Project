  "recipes": [
    {
      "name": "Buckaroons",
      "ingredients_raw": [
        "3 cups all-purpose flour",
        "1.5 teaspoons baking soda",
        "0.75 teaspoon salt",
        "0.75 teaspoon baking powder",
        "1.5 cups butter",
        "1.5 cups white sugar",
        "1.5 cups packed brown sugar",
        "1.5 teaspoons vanilla extract",
        "3 eggs",
        "4 cups semisweet chocolate chips",
        "0.30000001192093 cup wheat germ",
        "3 cups rolled oats"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Preheat oven to 350 degrees F (175 degrees C)."
        },
        {
          "id": 2,
          "text": "In a medium size mixing bowl sift together flour, baking soda, salt and baking powder."
        },
        {
          "id": 3,
          "text": "In a large mixing bowl cream butter, white and brown sugars together until light and fluffy. Dribble vanilla into the creamed mixture. Beat the eggs, one at a time, into the mixture. Add the sifted ingredients to the creamed mixture. Beat until well mixed."
        },
        {
          "id": 4,
          "text": "Pour chocolate chips, wheat germ and oats into the mixture; fold into dough until well combined. Drop the dough by rounded teaspoonful onto an ungreased cookie sheet."
        },
        {
          "id": 5,
          "text": "Bake 8 to 10 minutes or until the edges are just slightly brown. The cookies will look undercooked but that is the correct consistency. Cool on a wire rack."
        }
      ],
      "warnings": [],
