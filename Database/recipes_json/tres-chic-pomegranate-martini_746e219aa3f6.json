  "recipes": [
    {
      "name": "Tres Chic Pomegranate Martini",
      "ingredients_raw": [
        "1 cup crushed ice",
        "1 (1.5 fluid ounce) jigger vodka",
        "1 (1.5 fluid ounce) jigger pomegranate juice",
        "1 wedge fresh lime",
        "1 tablespoon rimming sugar",
        "3 fluid ounces club soda",
        "1 slice fresh lime"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Combine crushed ice, vodka, and pomegranate juice in a shaker, Squeeze juice of lime wedge into mixture. Shake vigorously, and set aside."
        },
        {
          "id": 2,
          "text": "Using the same lime wedge, wet the edge of a martini glass. Dip edge of glass into sugar. Strain liquid into glass, and top with club soda. Garnish with a slice of lime."
        }
      ],
