    {
      "name": "Venison Barbeque",
      "ingredients_raw": [
        "1 (16 ounce) bottle Italian-style salad dressing",
        "4 (1/2 pound) venison steaks"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Marinate the venison meat over night in the Italian dressing. Flip over at least one time during the marinade."
        },
        {
          "id": 2,
          "text": "Cook meat on the grill over medium-high heat. Cook for 20 to 30 minutes or until done to your taste."
        }
      ],
