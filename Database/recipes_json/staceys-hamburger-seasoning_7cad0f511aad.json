  "recipes": [
    {
      "name": "Stacey&#39;s Hamburger Seasoning",
      "ingredients_raw": [
        "1 tablespoon paprika",
        "1.25 teaspoons salt",
        "1 teaspoon ground black pepper",
        "0.5 teaspoon brown sugar",
        "0.5 teaspoon garlic powder",
        "0.5 teaspoon onion powder",
        "0.25 teaspoon ground cayenne pepper"
      ],
      "steps": [
        {
          "id": 1,
          "text": "Gather all ingredients."
        },
        {
          "id": 2,
          "text": "Combine paprika, salt, pepper, brown sugar, garlic powder, onion powder, and cayenne in an airtight container."
        },
        {
          "id": 3,
          "text": "Seal and shake to combine. Store in a cool, dry place between uses."
        },
        {
          "id": 4,
          "text": "Enjoy!"
        }
      ],
